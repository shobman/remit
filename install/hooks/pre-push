#!/bin/sh
# remit pre-push guard — installed by remit's installer into the repository's
# shared hooks directory ($GIT_COMMON_DIR/hooks), so every linked worktree
# inherits it.
#
# Two guards, both mechanical:
#
#   1. Pushes to main are permitted only from the repository's primary
#      worktree. Linked worktrees are builders' territory; builders deliver on
#      work/* branches and never move main.
#
#   2. Commits newly introduced on work/* branches must either be the one exact
#      neutral candidate handed to this hook by remit's coordinator, from the
#      primary worktree, or carry the two legacy provenance trailers. The
#      coordinator handoff is process-local and contains no model, session or
#      private-item metadata. It is an accidental-publication guard, not a
#      same-host security boundary. Only commits the pusher introduces are
#      linted: commits already on any remote are not linted again.
#
# stdin: <local ref> SP <local sha1> SP <remote ref> SP <remote sha1> LF
set -u

zero=0000000000000000000000000000000000000000

if ! git_dir_path=$(git rev-parse --git-dir) ||
	! common_dir_path=$(git rev-parse --git-common-dir) ||
	! git_dir=$(CDPATH= cd -- "$git_dir_path" && pwd -P) ||
	! common_dir=$(CDPATH= cd -- "$common_dir_path" && pwd -P); then
	printf 'remit pre-push: REFUSED — repository worktree identity could not be established.\n' >&2
	exit 1
fi
if [ "$git_dir" = "$common_dir" ]; then primary=yes; else primary=no; fi

fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "$remote_ref" ] || continue
	case "$remote_ref" in
	refs/heads/main)
		if [ "$primary" != yes ]; then
			printf 'remit pre-push: REFUSED — main moves only from the primary worktree at %s; this is a linked worktree.\n' \
				"$(dirname "$common_dir")" >&2
			fail=1
		fi
		;;
	refs/heads/work/*)
		# Deleting a work branch carries no commits to lint.
		[ "$local_sha" != "$zero" ] || continue
		# Lint only commits this push introduces: nothing already on any
		# remote (an inherited, already-landed mainline is not the pusher's
		# to answer for), and nothing already at the branch's remote tip.
		if [ "$remote_sha" = "$zero" ]; then
			set -- "$local_sha" --not --remotes
		else
			set -- "$local_sha" --not "$remote_sha" --remotes
		fi
		if ! commits=$(git rev-list "$@"); then
			printf 'remit pre-push: REFUSED — could not enumerate commits introduced on %s.\n' "$remote_ref" >&2
			fail=1
			continue
		fi
		for commit in $commits; do
			if ! body=$(git log -1 --format=%B "$commit") ||
				! subject=$(git log -1 --format=%s "$commit"); then
				printf 'remit pre-push: REFUSED — could not inspect commit %s on %s.\n' "$commit" "$remote_ref" >&2
				fail=1
				continue
			fi
			if [ "$primary" = yes ] &&
				[ "${REMIT_PUBLICATION_CANDIDATE:-}" = "$local_sha" ] &&
				[ "${REMIT_PUBLICATION_CANDIDATE:-}" = "$commit" ] &&
				[ "${REMIT_PUBLICATION_REF:-}" = "$remote_ref" ]; then
				case "$subject" in
				"Delivery r-"????????????????????????????????)
					_id=${subject#Delivery r-}
					case "$_id" in *[!0-9a-f]*) ;; *) [ "$body" = "$subject" ] && continue ;; esac
					;;
				esac
				printf 'remit pre-push: REFUSED — coordinator candidate %s does not have the neutral Delivery <opaque-id> subject.\n' \
					"$commit" >&2
				fail=1
				continue
			fi
			case "$subject" in
			"Delivery r-"????????????????????????????????)
				printf 'remit pre-push: REFUSED — neutral candidate %s on %s was not handed off by remit from the primary worktree.\n' \
					"$commit" "$remote_ref" >&2
				fail=1
				continue
				;;
			esac
			if ! printf '%s\n' "$body" | grep -qi '^Co-Authored-By:'; then
				printf 'remit pre-push: REFUSED — commit %s on %s has no Co-Authored-By: trailer; nothing anonymous lands on work/* branches.\n' \
					"$commit" "$remote_ref" >&2
				fail=1
				continue
			fi
			if ! printf '%s\n' "$body" | grep -qi '^Claude-Session:'; then
				printf 'remit pre-push: REFUSED — commit %s on %s has no Claude-Session: trailer; the session trailer is required on all work/* commits.\n' \
					"$commit" "$remote_ref" >&2
				fail=1
			fi
		done
		;;
	esac
done

exit "$fail"
