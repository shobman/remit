#!/bin/sh
# remit — the work item state machine.
#
# A work item is a folder `.remit/work-items/<slug>/` in the current Git
# repository holding exactly two script-owned files:
#
#   brief.md   the practitioner's words and the brief. Its header lines are this
#              script's and nobody else's:
#
#                 **Attention:** parked | active | escalated
#                 **Stage:**     new | refined | accepted | closed
#                 **Until:**     refined | accepted | closed        (optional)
#                                or `<stop>, then park`
#
#              THREE script-owned lines and no fourth. `--until X` given with
#              `--park` is ONE ruling — run to X and rest there — recorded as
#              ONE value, `**Until:** X, then park`. THIS IS THE ONE STATEMENT
#              OF THAT RULING; every other mention points here.
#
#              PARK IS A CEILING, NOT A BRAKE. `--until X --park`:
#
#                * RUNS, when it was given — at `new`, in that same command,
#                  exactly as far as `--until X` alone would; and at a `resume`
#                  from wherever the item stands;
#                * lets NO promote carry the item past X, then or on any later
#                  run, until a later `--until` replaces the recorded value;
#                * on REACHING X puts the attention back to `parked`, so no
#                  later `promote` is consulted and a bare `resume` moves it
#                  nowhere;
#                * is still stoppable EARLIER — a `hold`, a must-fix, a
#                  dependency, an escalation — and that stop stands exactly as
#                  it would with no park: active at the earlier stop with the
#                  rule named, the `, then park` still recorded as the ceiling.
#
#              `--park` with NO `--until` is the other thing entirely: nothing
#              runs, and the item is born parked at `new` with no `until`.
#
#              plus **Migrated:** — written only by `remit migrate`.
#
#              and **Depends on:** — HIS line. Optional, read before every
#              build, written by nobody here; `put_header` leaves it where it
#              is, as it does `**Research:**` and `**Current phase:**`. WHAT A
#              BRIEF DEPENDS ON below is its law.
#   log.md     append-only. Every verdict as it was returned, every finding with
#              its disposition, every delivery, every escalation, every ruling.
#
# NOTHING INFERS A STAGE. Not file presence, not commit count, not elapsed time,
# not the text of a brief. The header is the state and the record is the reason.
# Only this script writes either, and only from the repository's primary
# worktree, so the work surface has exactly one mechanical writer.
#
# Research, phase and evidence files may sit beside the two. This script reads a
# phase pointer and writes `research.md`; nothing else about them is structural.
#
# Field reports (`.remit/field-reports/<name>.md`) are observations, never work:
# never listed, never evaluated, never read by any mechanism here.
#
# The law documents (`problem.md`, `solution.md`, `tech-design.md`) stay at the
# `.remit/` root; the practitioner's rubrics sit in `.remit/rules/`. That folder
# is READ here and its FORM is checked here. Its CONTENT is written only by the
# retro convention, on the practitioner's ruling; the one thing this script
# writes there is the shipped shape, once, on `remit rules init` (which
# `remit migrate` also runs) — `rubrics_shipped` below, and nowhere else.
#
# Durability rule: change -> commit [-> push]. Exit 3 means committed locally
# and the remote has NOT accepted it.
#
# ==============================================================================
# THE VERBS
# ==============================================================================
#
#   remit new <slug> [--until refined|accepted|closed] [--park]
#       Create the item from the brief on stdin, which must carry a title. A
#       `**Depends on:**` line is optional — omitted is `none` — and one that is
#       there is REFUSED unless every name on it can be read. Born ACTIVE at
#       `new`. `--park` ALONE files it parked at `new`, and it moves for
#       nothing. `--until X --park` is ONE ruling and runs like `--until X`:
#       `**Until:**` above states it.
#
#   remit resume <slug> [--until refined|accepted|closed [--park]]
#       The whole chain. Activates a parked or escalated item, records a new
#       `until` if one is given, then moves the item ONE GATE AT A TIME as far
#       as that `until` reaches, or as far as a `promote` rubric a gate's
#       evaluator cited carries it, and never past a `hold` one cited, a
#       must-fix that still stands, or a `**Depends on:**` work item that does
#       not satisfy — then prints the row `list` would show, and why it
#       stopped. `--park` attaches to the `--until` beside it and is refused on
#       its own; `remit park <slug>` is that instruction.
#
#   remit park <slug>            attention -> parked; the stage does not move
#   remit stop <slug>            end the chain running on this item. Refuses only
#                                when there is no marker at all. The worktree's
#                                in-flight changes are discarded, the marker is
#                                disposed of, one line is recorded, and THE
#                                STAGE IS NOT TOUCHED. A marker whose chain is
#                                already gone is a CRASH, and this ends that
#                                too, saying which it found. THE AUTHORITY LOCK
#                                and THE CRASHED CLASS below.
#   remit close <slug>           final. Seals every standing finding as
#                                `pre-authorised`, records the delivery links on
#                                stdin and archives the whole folder to
#                                `.remit/work-items/.archive/<slug>/` AT THE
#                                STAGE IT HAD REACHED — the verb stamps no stage
#   remit list [--parked]        the projection (below)
#   remit review [today | yesterday | week | since <date> | <slug>...] [--attest]
#                                the standing findings of every item at any
#                                stage, open or archived — THE REVIEW PROJECTION
#                                below. `--attest` raises ONE context to say of
#                                each whether it stands, is fixed, or is moot
#   remit answer <slug> <n> "<words>" [--conductor]
#                                answer question <n> of the item's last `asked:`
#                                stop, verbatim, as a ruling; then resume
#   remit report new <name>      file a field report from stdin
#   remit report close <name>    archive it to `field-reports/.archive/`
#   remit rules init             lay down `.remit/rules/` — the three gate files
#                                — with the rubrics remit ships. Idempotent; it
#                                NEVER overwrites a file that is already there.
#   remit rules ship|seed|read|apply
#                                the payload-only four: no repository, no
#                                commit — `install.sh`'s migration drives them.
#   remit setup [--write]        read this host and PROPOSE a registry on stdout.
#                                Bare it writes nothing; `--write` saves the
#                                proposal atomically, having read the registry
#                                already there first
#   remit migrate                the one-time move of a pre-`work-items/` layout
#   remit version                the installed version, from the manifest
#   remit activate | kill        retired: each prints what replaced it, exits 2
#
# EXIT CODES, every one of them:
#
#   0  done. The change is committed, and pushed when a remote is configured. A
#      `resume` that stopped where it was told to stop is 0 with its row
#      printed: stopping is the design working.
#   2  usage or precondition error. NOTHING was changed.
#   3  committed locally, PUSH FAILED — not durable beyond this machine.
#   4  ESCALATED. `resume` tried to move the item on the practitioner's behalf
#      and could not: the loop stopped, a capability it needs is absent, or the
#      authority changed under it. Attention is now `escalated`, the STAGE IS
#      UNCHANGED, and the reason is appended to `log.md`. It sorts first in
#      `list` and needs one word to continue.
# 130  a running `resume` was ENDED — by a signal, or by `remit stop` clearing
#      its marker. `stop` records what happened; the chain that was ended
#      records nothing further.
#
# ==============================================================================
# THE LIST PROJECTION
# ==============================================================================
#
#   work-items/* -> read the header, the last recorded stop, and the marker
#                -> report unreadable or invalid entries on stderr, never drop
#                   them in silence
#                -> exclude closed; show parked only with --parked, EXCEPT a
#                   parked item that crashed, which is on the plain list under
#                   the crashed class and says in its row that it is parked
#                -> CRASHED first, then escalated, then active
#                -> within each, by stage rank: accepted, refined, new
#                -> tie-break by slug
#
# There is ONE projection and every glance at the board reads it.
#
# Each row is five tab-separated columns — class, stage, the reason it stopped,
# slug, title. The CLASS is the item's attention — `active`, `escalated`,
# `parked` — or `crashed`, which outranks it: a marker this machine can see no
# running process for says the chain crashed (THE CRASHED CLASS below). A live
# marker appends ` [working]` to the title; a crashed one appends the step it
# died at, the dead pid, and how stale. A crashed row whose header still says
# parked appends ` [parked]` after the crash note.
#
# The reason is READ FROM THE RECORD — the most recent `## stopped —` or
# `## escalated —` entry in `log.md` — never computed, and is one of: `until
# ran out`, `promote: <id>`, `hold: <id>`, `fix: <id>`, `depends on: <why>`,
# `<n> fails`, `same must-fix twice`, `FAIL with nothing to act on`, `asked:
# <n> question(s)`, `cannot act: <what>`, `stalled: <what the seam said>`,
# `authority changed`, `stopped on the practitioner's word at <step>`, `stopped
# a crashed chain at <step>`, `queued phase: <file>`, `parked`, `parked at
# until`. An item with nothing recorded shows `-`.
#
# The working marker IS the lock: `.remit/work-items/<slug>/.working`, created by
# `resume` after its preconditions pass and removed however it exits. A second
# `resume` of the same item refuses while the chain it names is RUNNING. It is
# MACHINE STATE, never repository state: kept out of every commit, and one an
# older remit did commit is taken back out by `markers_untrack`. It carries
# seven `key: value` lines — `pid:` the resume that owns it, `host:` the machine,
# `authority:` the file it raised from relative to the item folder, `hash:` that
# file's digest, `step:` what the chain is doing now, rewritten as it moves,
# `raise:` the pid of the fresh context in flight, EMPTY between raises, and
# `at:` the second the marker was last written.
#
# ==============================================================================
# THE REVIEW PROJECTION
# ==============================================================================
#
#   remit review [today | yesterday | week | since <date> | <slug>...] [--attest]
#
# Per item at ANY stage — open or archived — its STANDING findings: the findings
# the last verdict at each gate still carried with no disposition, READ FROM THE
# VERDICTS and never from the seal. `standing_findings` below is the ONE reader,
# and `close` seals from it too.
#
# One row per finding, seven tab-separated columns: item, stage, gate, verdict
# date, finding number, the finding's first line, and the delivery it stood
# against — what the last `## delivery` entry before that verdict names; `-` at
# the gate into `refined`, which judges a brief. No ranking, no triage, no
# proposal.
#
# THE WINDOW is the item's last verdict date, or its closure where it is closed.
# `today`, `yesterday` and `week` — the last seven days — are read against this
# host's date; `since <date>` takes YYYY-MM-DD; one or more slugs name items
# outright, open or archived, and one that is nowhere is refused. Nothing said
# is every item.
#
# `--attest` raises ONE `evaluate` context — the registry's evaluate seat — in
# the PRIMARY worktree at HEAD, one raise per review, briefed with the standing
# set and nothing else: no gate's rubric file and no delivery. For each finding
# it returns one line
#
#   Attest: <item> <n>: stands | fixed | moot — <evidence from the tree>
#
# three words and no fourth, parsed as the verdict lines are, the prose after
# the dash carried verbatim. `stands` is still true in the code now, naming
# where; `fixed` names the commit or file that closed it, a fix made outside the
# loop included; `moot` says the code it was about no longer exists and what
# replaced it. The mechanism appends `## reviewed — <date>` to EVERY reviewed
# item's `log.md` — the archive is history and a review is an event in it —
# carrying the tree's HEAD, the raise, and one line per standing finding: its
# attestation, or `not attested`. A line naming a finding that is not standing
# reaches no record. Then the count per category is printed and the records
# are committed.
#
# A FINDING ATTESTED `fixed` IS NOT RE-JUDGED: it leaves the standing set, for
# this projection and for the seal alike. `stands` and `moot` stay standing, and
# what becomes of them is his — admit one as an item, or leave it.
#
# ==============================================================================
# WHAT A BRIEF DEPENDS ON
# ==============================================================================
#
#   **Depends on:** none
#   **Depends on:** raised-contexts-are-visible
#   **Depends on:** raised-contexts-are-visible, every-pr-names-its-item — both
#                   from the retro
#
# ONE LINE, HIS WORDS, and it names WORK ITEMS BY SLUG. Nothing else: not a pull
# request, not a branch, not a URL. A line naming a `#<n>`, a `.../pull/<n>` or
# a `<a>/<b>` branch is REFUSED at `new` and HOLDS wherever the line is
# observed, saying so.
#
# WHEN IT IS OBSERVED — TWO POINTS, on every run: AT `new`, BEFORE THE RESEARCH
# RAISE AND BEFORE GATE 1; and again BEFORE A BUILD. An unsatisfied name holds
# the item AT `new`, whatever `--until` he gave: what the named build actually
# ships is what this brief has to name, and the gate into `refined` judges the
# brief and not the tree. An item already past `new` that gains an unsatisfied
# name by a later edit, or whose dependency regressed, still must not build.
# Both points stop with the same reason, `depends on: <why>`; only the note
# beneath it says which point it was.
#
# NOTHING WAKES A HELD ITEM. The road back in is his own `remit resume <slug>`.
#
# WHAT SATISFIES ONE — TWO ways, and no third. FIRST, the named item's
# **Stage:** reads `closed` — only the closing gate stamps that. SECOND, the
# item is ARCHIVED and every delivery its record names is MERGED. Nothing else
# satisfies. Its stage is read from its own brief, wherever that brief now sits;
# ARCHIVING PRESERVES THE STAGE, so an item in the archive below `closed` is
# asked the second question, and an item IN FLIGHT below `closed` satisfies
# nothing.
#
# HOW "MERGED" IS WITNESSED: by the pull request's own state — `gh pr view
# --json state` reading `MERGED` — for EVERY distinct pull request the item's
# record names on a `## delivery —` entry, never by sha, because deliveries are
# squash merged. Where the record names no delivery, where an entry names a
# commit and no pull request, where `gh` is absent, or where a state cannot be
# read, THE DEPENDENCY HOLDS and the reason says which. A hold is his to lift,
# never an escalation.
#
# The value is comma-separated slugs, and his prose starts at the first ` — `;
# everything after it is his and is not resolved. `**Builds on:**` is the
# superseded name and is refused, never silently read as `none`.
#
# ==============================================================================
# THE AI SEAM — ONE COMMAND
# ==============================================================================
#
#   bin/remit-invoke <role> <slug> <worktree>
#       role in research | build | evaluate
#
# stdout is the step's text and nothing else. `REMIT_INVOKE=<path>` substitutes
# the command (the test suite drives the chain with a scripted stand-in). That
# script resolves the role to a harness and a model, refuses before anything is
# billed when either is absent, raises the context with an allow-listed
# environment, and writes its provenance to the sidecar below; how is ITS
# header's to say. An invoke that exits non-zero is recorded as `cannot act:
# remit-invoke` and escalates the item at the stage it could not leave — EXCEPT
# exit 8, the seam's idle bound, recorded as `stalled: <what the seam said>`.
#
# WHAT THE SEAM IS GIVEN, in the environment:
#
#   REMIT_ITEM        absolute path of the item folder
#   REMIT_AUTHORITY   absolute path of the brief, or of the current phase file
#                     when the brief names one (a pointer that is dangling or
#                     named twice stops the mechanism instead of guessing)
#   REMIT_RUBRICS     absolute path of THE GATE'S OWN rubric file, WHOLE — and of
#                     no other. Empty for every role but `evaluate`, and empty
#                     when the file is not there.
#   REMIT_STANDARDS   absolute path of a DERIVED file this script writes into its
#                     own scratch: the `## fix` section of the gate the work is
#                     heading into, and nothing else from that file. Handed to
#                     `research` and `build` and to no other role; empty when
#                     the section is empty or the file is not there. `fix`
#                     rubrics are the bar and go to the author; `promote`,
#                     `hold` and `accept` are judgements about the work and stay
#                     with the evaluator: an author who can see the oracle
#                     optimises for it rather than for the work.
#   REMIT_SETTINGS    absolute path of `.remit/settings.json` — the REGISTRY of
#                     which harnesses and models this repository may raise a
#                     context on, and which seat each role takes. Its shape and
#                     its refusals are `bin/remit-invoke`'s header; nothing
#                     here reads it.
#   REMIT_PROVENANCE  absolute path of a file the invoke writes its provenance
#                     into, as `key: value` lines. Keys read here: `session:`,
#                     `model:`, `harness:`. An empty or absent file is recorded
#                     as absent — never invented.
#   REMIT_ROUND       the round number in the author/evaluate loop; 1 first time
#   REMIT_MUSTFIX     absolute path of a file holding the must-fix being sent
#                     back, or empty on a first attempt
#   REMIT_RESEARCH_AUTHOR
#                     `yes` for the ONE raise that is the gate into `refined`
#                     evaluating an item whose authority asks for research, and
#                     empty everywhere else: it tells that evaluator
#                     `research.md` HAS an author (THE THREE GATES below).
#   REMIT_DELIVERY    the commit the LAST recorded delivery names, handed to the
#                     `evaluate` raise at a gate after a delivery and EMPTY
#                     everywhere else. WHERE AN EVALUATOR IS RAISED below.
#   REMIT_RUNS        absolute path of the KEPT-OUTPUT HOME this raise writes
#                     into, already made and already ignoring itself. Handed to
#                     every role; ALWAYS INSIDE THE WORKTREE THE RAISE RUNS IN,
#                     and for a role that JUDGES it is filled with the whole of
#                     what the item has kept before the raise starts —
#                     `runs_seed` below.
#   REMIT_RUNS_NAMING one line of text: the name a kept run takes, passed
#                     THROUGH the seam into the briefing verbatim.
#   REMIT_REVIEW      `yes` on the ONE raise `review --attest` makes, and empty
#                     everywhere else: the evaluate seat asked for attestations
#                     rather than a verdict (THE REVIEW PROJECTION above).
#
# THE SEAM'S STDERR is captured to a file of this script's own and printed ONLY
# when the seam exits non-zero. A caller that wants progress sets
# `REMIT_PROGRESS=<path>`, which passes through untouched; the seam writes each
# raise's run directory there as that raise begins, and its `progress` file
# carries the heartbeat. Both are `bin/remit-invoke`'s header's to define.
#
# WHAT THE SEAM RETURNS, per role — the whole text contract, and the only thing
# this script parses:
#
#   research      free text. Written to `research.md` beside the brief, REPLACING
#                 whatever was there. Runs only when the item's authority carries
#                 a `**Research:**` line, while there is no `research.md` yet,
#                 AND on every later round of the gate into `refined` where a
#                 must-fix against `research.md` is coming back (THE THREE GATES
#                 below).
#   build         the builder's own final message. It authored the worktree; the
#                 text is untrusted and travels into the pull request body inside
#                 a code fence, below this script's provenance.
#   evaluate      a verdict. Parsed line by line:
#
#         Verdict: PASS | PASS WITH FINDINGS | FAIL      (required, first wins;
#                       prose after the verdict word is kept, not read)
#         Must-fix: <text>                (zero or more; a FAIL with none — and no
#                       applied `fix:` citation — has its `Finding:` lines
#                       promoted to the must-fix by the mechanism, once, where
#                       the author is a builder; with no findings either, or
#                       after a promoted round, it is a FAIL with nothing to act
#                       on: the item stops, ACTIVE, for the practitioner.
#                       Markdown emphasis around any of these line shapes is
#                       stripped before the line is read.)
#         Finding: <text>                 (zero or more)
#         Ask: <text>                     (zero to four, read only in a FAIL and
#                       only following a `Finding:`, `Must-fix:`, `fix:` or
#                       another `Ask:` line. ANY question stops the item for the
#                       practitioner, whatever else the verdict carries.)
#         Back to: research               (zero or one, and ONLY at the gate into
#                       `refined` where the authority carries a `**Research:**`
#                       line: the must-fix is against `research.md`, and this is
#                       the whole of what sends the round back to the research
#                       role. Without it the item stops at `new`.)
#
#      and the CITATION LINES — the evaluator's four words, one per section of
#      the gate file it was handed, each naming the rubric's id and the evidence:
#
#         promote: <id>: <evidence>   this item passes THIS gate whatever the
#                       practitioner's `until` said — this gate, never the next.
#         hold: <id>: <evidence>      this item stops in the stage it is in, for
#                       the practitioner's eyes. A hold BEATS a promote.
#         fix: <id>: <evidence>       a must-fix, treated exactly as a `Must-fix:`
#                       line is. When it follows a `Finding:` it also makes THAT
#                       finding the must-fix; standing alone it is the gate's
#                       standard missed. A verdict carrying one is a FAIL
#                       whatever its `Verdict:` line said.
#         accept: <id>: <evidence>    disposes the `Finding:` above it.
#
#      ALL FOUR CITATIONS ARE SYMMETRIC. A citation is applied only when the gate
#      file actually carries a rubric with that id, in that section. One that
#      does not is recorded `— NOT APPLIED: <id> is not a rubric this gate
#      carries` and changes NOTHING. The one stop that needs no rubric is a
#      plain `Must-fix:` line. Discretion, where it is wanted, is a rubric he
#      writes.
#
#      Every other line is carried into `log.md` verbatim. The WHOLE returned
#      text is appended as it was returned. A return with no `Verdict:` line is
#      unusable and escalates as `cannot act: verdict`.
#
# ==============================================================================
# .remit/rules/ — THE RUBRICS, AND THE READ SIDE
# ==============================================================================
#
# THREE GATES, ONE FILE EACH:
#
#   .remit/rules/refined.md    what it takes to become `refined`
#   .remit/rules/accepted.md   what it takes to become `accepted`
#   .remit/rules/closed.md     what it takes to become `closed`
#
# Which harness and model a role sits on is NOT in this folder: it is
# `.remit/settings.json`, and `bin/remit-invoke`'s header is its law.
#
# A GATE FILE has four sections, each a level-2 heading whose text is exactly
# `promote`, `hold`, `fix` or `accept` — the whole vocabulary. Inside a section,
# a line beginning `- ` is a rubric; every other line is prose and is ignored
# here. Text outside those four sections is ignored entirely. A missing folder,
# a missing file or an empty section matches nothing and changes nothing.
#
#   - <id>: <criterion in prose>        in any of the four sections
#
# NOTHING HERE IS MATCHED MECHANICALLY. A rubric is a criterion a fresh context
# judges: this script hands the gate's file to the evaluate role, reads back the
# citation lines it returned, and acts on those and on nothing else. The one
# thing read OUT of a gate file, beyond its form, is whether a section carries
# the id a citation names, and whether the `promote` section has anything in it
# at all — an item whose `until` does not reach the next stage can only get
# there on a promote, so where a gate file has no `promote` rubric the item
# waits without a fresh context ever being raised.
#
# A malformed line inside one of the known sections is refused (exit 2) with its
# file and line number: applying half a file is worse than refusing it.
#
# PRECEDENCE, once: a `hold` beats a `promote`; a `promote` beats the
# practitioner's `until`; a missed `fix` sends the work back before any of
# that; a parked item moves for nothing; an empty folder changes nothing —
# every gate waits for him. An `until` recorded `, then park` is a CEILING on
# the promotes, not a brake on the run.
#
# ==============================================================================
# log.md — THE ENTRY SHAPES
# ==============================================================================
#
#   ## verdict — evaluate — into <gate> — <commit> — <date>
#   ## delivery — <pull request or commit> — <date>
#   ## research — <commit> — <date>
#   ## ruling — <the practitioner's words> — <date>
#   ## admitted — <date>          (only when `new` goes straight on to the chain)
#   ## amended — <what changed> — <date>
#   ## resumed — <label> — <date>  (a run going back in where the record left
#                                   off, or picking a crashed chain up)
#   ## promoted — <date>          (a FAIL's findings became its must-fix)
#   ## stopped — <reason> — <date>
#   ## escalated — <reason> — <date>
#   ## closed — <date>
#   ## reviewed — <date>          (a `review --attest`; the archive included)
#   ## migrated — evaluation.md — <date>
#
# Every entry where the item COMES TO REST — the stops, the escalations, the
# admission, and the amendment — carries two lines naming the authority it
# rests with, and so does the resume that goes back in:
#
#   - authority: <file, relative to the item folder>
#   - authority hash: <its digest>
#
# That pair is how a later `resume` knows the practitioner changed his mind: it
# hashes the authority in hand and compares it with the last pair on the record.
# A resume records the pair IT RAN FROM, never one that appeared under it while
# it ran.
#
# Every entry that RECORDS A RAISE carries one line naming it, and beneath it the
# provenance the seam reported, indented under it:
#
#   - raise: <role> — <harness> — <seconds>s
#   - raise: <role> — <harness> — not timed: <why>
#     - model: <THE MODEL THAT AUTHORED, as served, or the id asked for with
#               ` (asked)`>
#     - models: <every model the run reported, with its tokens and cost>
#     - consulted: <the run's own count of what it looked up outside itself,
#                   with the scope of that count in the same line. Evidence,
#                   never a verdict>
#     - session: <the run id the harness reports>
#     - run-log: <the seam's run directory>
#     - boundary: <user|container|none — attested by …>
#     - containment: <what actually held the raise>
#     - permission-mode: / sandbox: / scrub: / effort: / cost:
#                  <each where the harness reports one>
#
# EVERY KEY THE SEAM REPORTED AND NOT ONE MORE: absent is absent, never a
# default written in its place. The RUN'S OWN LOG is kept too (`raise_log_keep`
# below), in the item's runs home, and the `run-log:` line names where it came
# from.
#
# `<role>` is research, build or evaluate. `<harness>` is the sidecar's
# `harness:`, or `an unreported harness`. `<seconds>` is whole seconds of wall
# clock taken around the raise by this script; where the clock could not be
# read, or moved backwards, the second shape says so.
#
# ONE LINE FOR EVERY RAISE THAT RAN TO COMPLETION: the seam exited zero and the
# marker was still this run's when it came back. A raise `stop` ended, and one
# the seam refused before any context was raised, gets no line. The line is
# written into the NEXT entry this script appends — a build's in the
# `delivery`, an evaluate's in the `verdict`, research's in the `research`, and
# where the round failed before that entry could be written, the `escalated`
# entry. A raise that completed inside a run `stop` then ended before the entry
# could be written leaves its line behind rather than race for the lock.
#
# WHAT IS SAID TO THE PRACTITIONER from these seconds is
# `install/skills/remit-resume/SKILL.md`'s, under "The leave line"; this script
# writes the line and stops.
#
# Findings and their dispositions are lines inside an entry, numbered once per
# item and never renumbered:
#
#   - finding <n>: <text>
#   - finding <n> disposition: accepted by rubric <id>: <evidence>
#   - finding <n> disposition: fix by rubric <id>: <evidence>
#   - finding <n> disposition: pre-authorised — <text>
#
# and the citations the gate's evaluator made:
#
#   - rubric promote: <id>: <evidence>
#   - rubric hold: <id>: <evidence>
#   - rubric fix: <id>: <evidence>
#
# and what a review attested of a standing finding, with the tree it read:
#
#   - tree: <commit> — the primary worktree at HEAD
#   - finding <n> attested: stands | fixed | moot — <the context's evidence>
#   - finding <n>: not attested
#
# `close` seals every STANDING `- finding <n>:` that has no `- finding <n>
# disposition:` as `pre-authorised` — standing meaning the last verdict at its
# gate still carried it, and no review attested it fixed. A finding an earlier
# round raised and the gate's last verdict does not carry was cleared by that
# round, and is not sealed. That is what the closure did — never a ruling the
# practitioner made on each one — and the verb says the number.
# `standing_findings` is the one reader of that set.
#
# ==============================================================================
# THE DELIVERY SEAM
# ==============================================================================
#
# After a `build` invoke has authored the worktree, `resume` stages everything,
# commits with the authorship and committing-session trailers, pushes
# `work/<slug>`, and puts the delivery in that branch's pull request — `gh pr
# create --draft` when it has none, `gh pr edit` when it already has one, this
# delivery's section added ON TOP of the body already there, which is copied
# through byte for byte; where `gh pr edit` fails, the same body over REST,
# `gh api -X PATCH repos/{owner}/{repo}/pulls/<n>`. The builder's returned text
# is fenced below the provenance, in a fence longer than any run of backticks in
# it, so nothing it contains can render as this script's own record. THE SEAM
# EXISTS ONCE, here; `t/unit/repro-pr-body-second-delivery.sh` asserts it.
#
# The build worktree is `<repo>-remit-worktrees/<slug>` — a SIBLING of the
# primary worktree — on branch `work/<slug>`, branched from the base branch. It
# sits outside every working tree, so it is never committed by accident, and
# outside `.git/`, which a seat's guard may refuse to write. `REMIT_WORKTREE_DIR`
# overrides the parent. A `work/<slug>` that is already checked out anywhere is
# USED where it is, never refused and never duplicated.
#
# DELIVERY ENDS AT THE PULL REQUEST, and the LAST thing this script does to one
# is flip it out of draft:
#
#   * NOTHING HERE MERGES. There is no `gh pr merge` in this script. The closing
#     gate licenses the CLOSURE of the item, never a merge; the pull request is
#     left open for the host repository and for him.
#   * NOTHING HERE READS A CHECK. Not `gh pr checks`, not `gh run view`, not a
#     workflow file. CI is the host repository's business.
#   * `gh pr ready` STAYS, at the gate into `accepted` and nowhere else: a
#     recorded passing verdict is what takes a delivery out of draft.
#   * A DELIVERY THAT PUSHED IS ON THE RECORD, whatever became of its pull
#     request afterwards: the `## delivery` entry is written for the commit on
#     the branch, carrying `pull request: NOT updated — <why>` where the body
#     could not be written, and the item then escalates on that reason. The
#     next `resume` reads a delivery with no verdict on it and EVALUATES that
#     round; it never builds it again.
#   * If `gh` is absent, that is recorded as `cannot act: gh` and the item
#     escalates with the commit on the branch.
#
# THE ACCEPTED GATE IS THE GATE, full stop: a fresh evaluator's rubric verdict.
#
# ==============================================================================
# KEPT OUTPUT HAS A HOME
# ==============================================================================
#
# THE HOME IS ONE FOLDER IN THE ITEM: `.remit/work-items/<slug>/runs/`. A raise
# is handed it, already made and ignoring itself, as `REMIT_RUNS`; the roles
# that author keep their run output there, and the roles that judge read it
# there. Nothing in it reaches a commit while the item is in flight.
#
# THE SWEEP IS AT CLOSE: for each suite-and-shell key, the last run survives and
# is carried into the archive by the closing commit; superseded runs are
# removed; a name the sweep cannot key is kept untouched and reported. The
# closing entry says what it kept, swept and could not key.
#
# THE NAME A RUN TAKES is `runs_naming` below, stated there and nowhere else:
# the seam prints it into every briefing verbatim, so the convention a context
# is given and the convention the sweep keys on are one string.
#
# ==============================================================================
# THE THREE GATES
# ==============================================================================
#
# Each stage move is a gate, and each gate is an `evaluate` invoke handed that
# gate's rubric file and nothing else:
#
#   new -> refined      everything said at filing, against the brief the
#                       practitioner wrote.        REMIT_RUBRICS=rules/refined.md
#   refined -> accepted after the build and its delivery: everything in the work
#                       item's folder, against the delivery.
#                                                 REMIT_RUBRICS=rules/accepted.md
#   accepted -> closed  with no build in front of it: the whole folder, `log.md`
#                       and every evaluator's notes included, against the item.
#                       It licenses the closure and nothing else.
#                                                 REMIT_RUBRICS=rules/closed.md
#
# A gate is ASKED when the practitioner's `until` reaches the stage beyond it,
# or when its file carries a `promote` rubric that could carry the item there
# anyway. It is PASSED when the `until` reaches that stage or the gate's
# evaluator cited a `promote` — and never while it cited a `hold`, or while a
# `fix` or any other must-fix stands.
#
# GATE 1 HAS NO AUTHOR — THE BRIEF HAS NONE. Only the practitioner writes a
# brief; no role here can. So:
#
#   * The gate into `refined` is: research IF the brief carries a
#     `**Research:**` line in his words, then evaluate.
#   * A FAIL there whose must-fix is the BRIEF'S has nowhere to go but to him.
#     The item STOPS at `new`, ACTIVE, with the must-fix on the record and the
#     stop naming it — `fix: <id>` where a `fix` rubric was cited, the
#     must-fix's own first line otherwise. No second round is run for it.
#   * An escalation RAISES NOTHING and proposes nothing. The entry carries the
#     reason, the round, the repeat count and the authority; the verdicts above
#     it are the analysis; the brief is his to amend, from the record.
#   * AN EVALUATOR MAY ASK. An `Ask:` line in a FAIL verdict stops the item for
#     him under `asked: <n> question(s)`, the questions numbered on the entry,
#     and nothing is raised — at every gate, whatever else the verdict carries.
#     His answer comes back through `answer`: filed VERBATIM under `## Rulings`
#     in the authority beside the question it answers, recorded as a `## ruling`
#     with the new digest, and the chain resumes AT THE STAGE IT IS AT. An
#     answer is a ruling, not an amendment: a hand amendment resets the stage to
#     `new`; an answer adds a decision the brief was missing. A question he
#     leaves unanswered blocks nothing. The authority's `## Rulings` are
#     SETTLED GROUND to every later raise. `--conductor` files the words as the
#     conductor's, PROVISIONAL, built on by later raises and flagged where found
#     wrong, never defended as his. A question may be answered again by anyone;
#     the latest line stands, nothing above it is edited, and the record names
#     what each answer superseded.
#   * A FAIL'S FINDINGS ARE ITS MUST-FIX WHEN IT NAMES NONE — ONCE. Where the
#     author is a builder (gates 2 and 3) and a FAIL carries findings and no
#     must-fix text, the mechanism promotes the findings to the must-fix, says
#     so on the record (`## promoted`), and runs one builder round on them.
#   * A FAIL WITH NOTHING TO ACT ON — no must-fix text, and either no findings
#     or findings that were already promoted once — stops for him: the item
#     stays where it is, ACTIVE, the findings on the record, no further round.
#     At gate 1 a finding on the brief is his and is never promoted.
#
# THE ONE EXCEPTION — `research.md` HAS AN AUTHOR. It is MACHINE-AUTHORED,
# exactly as a build is. So, ONLY where the authority carries a `**Research:**`
# line:
#
#   * THE AUTHOR AT GATE 1 IS THE `research` ROLE, and the loop it runs in is the
#     SAME LOOP gates 2 and 3 run — `run_gate` handed `research` where they hand
#     it `build`. Rounds are numbered and recorded the same way, and the two
#     stops are the same two: the round cap ESCALATES, and the same must-fix
#     twice ESCALATES.
#   * A must-fix comes back to a FRESH research raise in `REMIT_MUSTFIX`, which
#     authors a REPLACEMENT `research.md` and has its round recorded.
#   * THE BRIEF IS STILL UNTOUCHABLE BY EVERY RAISE. WHAT ROUTES a gate-1
#     must-fix to research IS THE EVALUATOR'S OWN WORD: the verdict line
#     `Back to: research`. A verdict that does not carry it stops the item at
#     `new`.
#
# An item at `new` with nothing said runs no chain at all until it is resumed —
# unless `refined.md` carries a `promote` that could carry it, which is the one
# thing `new` asks the gate for on its own.
#
# ==============================================================================
# WHERE AN EVALUATOR IS RAISED
# ==============================================================================
#
# AN EVALUATOR IS RAISED WHERE THE THING IT JUDGES IS ON DISK:
#
#   into `refined`   the BRIEF, and nothing built yet: the primary worktree.
#   into `accepted`  the DELIVERY: the item's own worktree — THE SAME PATH THE
#   into `closed`    build used, `build_worktree`/`worktree_path` below, on
#                    `work/<slug>`. There is no second resolver.
#
# The briefing NAMES the delivered commit — `recorded_delivery` reads it off the
# last `## delivery —` entry, the record being the authority on what was
# delivered — and states that the delivered tree IS the files at that path.
# WHERE THE TREE CANNOT BE OPENED — no `work/<slug>`, or a worktree git refuses
# — the raise still happens, in the primary worktree, with the commit unnamed
# and the briefing saying which tree it stands in.
#
# AND WHATEVER IT IS ASKED TO JUDGE, IT CAN READ: at every gate, the item's kept
# run output AND the item's own artefacts are on disk in the worktree the raise
# stands in, at `.remit/work-items/<slug>/`, and they are the record's current
# copies. `runs_seed` and `item_seed` below hold that up, in both modes:
#
#   personal-records mode  the item folder is in the records clone, outside the
#                          repository, and a seat scoped to its worktree cannot
#                          open it. Both seeds COPY IN.
#   all-in mode            the item folder is committed, so it is already checked
#                          out in `work/<slug>` — as the SNAPSHOT that branch was
#                          cut from, never refreshed. Both seeds still run, and
#                          what they replace is a stale file. A copy already
#                          identical to the record's is left untouched.
#
# The runs copy stays (its home ignores itself); the item copy is REMOVED again
# the moment the raise returns, because a tracked artefact cannot be ignored out
# of the next `git add -A`.
#
# ==============================================================================
# THE AUTHORITY LOCK — STOP, AMENDMENT AND THE PHASE QUEUE
# ==============================================================================
#
# Every cell below is decided by the STAGE and by WHETHER THE MARKER EXISTS.
# Nothing here reads what he said, and nothing here judges what a half-built
# tree is worth.
#
#   | state                 | `remit stop`               | he adds "also do Y"    |
#   |-----------------------|----------------------------|------------------------|
#   | new, stopped          | refused, nothing running   | brief edited; the next |
#   |                       |                            | resume runs gate 1     |
#   | new, running          | ends; research discarded;  | refused (locked); a    |
#   |                       | stays new                  | second item is allowed |
#   | refined, stopped      | refused                    | brief edited -> stage  |
#   |                       |                            | new -> judged, built   |
#   | refined, running      | ends; the worktree's       | a phase file, queued;  |
#   |                       | changes discarded; stays   | adopted at the         |
#   |                       | refined                    | `accepted` stop        |
#   | accepted, stopped     | refused                    | a phase file; pointer  |
#   |                       |                            | moves; stage new; the  |
#   |                       |                            | pull request to draft  |
#   | accepted, running     | ends; stays accepted       | a queued phase, as     |
#   |                       |                            | above                  |
#   | escalated             | refused                    | brief edited -> stage  |
#   |                       |                            | new                    |
#   | closed                | refused                    | refused — a new item   |
#
# THE HASH. Every `resume` hashes the authority it raises from — the brief, or
# the phase file the brief points at — and writes that digest into the marker
# and onto the record. The digest is of the practitioner's words alone: this
# script's own header lines are cut out before hashing.
#
# WHILE THE MARKER EXISTS the authority is LOCKED. The chain re-hashes it before
# every raise and before every commit; a digest that no longer matches is
# refused — nothing is raised against text nobody judged, and no delivery is
# committed or pull request touched for a round built against text he has
# since replaced — and the item escalates at the stage it could not leave, with
# `authority changed` on the record. The escalation's own commit carries what he
# wrote, as his change and not as anything this run judged, and the record's
# authority pair still names what the run raised from — so it is still a change
# at his next resume. What is NOT locked: a new item elsewhere, and a phase
# file written beside the brief.
#
# AT A STOP the same comparison decides one thing: an authority whose digest
# differs from the last one on the record sends the stage to `new`, so gate 1
# judges it again. Before `accepted` that is the same brief modified; after
# `accepted` it is the next phase. The script NOTICES this; nobody declares it.
# A digest that has not changed moves nothing. This is the one direction a
# stage moves other than forward. An item whose record carries NO pair yet
# moves nothing on its next resume and records a pair at its next stop.
#
# THE PHASE QUEUE. A phase cannot be named in the brief while the brief is
# locked, so the file alone is the queue: `phase-<n>.md` beside the brief,
# named nowhere in its `## Phases` section. When a resume finds the item at
# `accepted` with one waiting — resting there, or arriving there — the chain
# STOPS at `accepted` and hands over: the lowest such file is named in that
# section and the pointer moved to it, the stage goes to `new`, the pull request
# goes back to draft, and the run ENDS. His next resume evaluates the phase.
# That is the whole of what this script writes inside a brief, and it never
# runs while a chain that could be building from that brief is in flight. The
# item is left ACTIVE at `new`, even where his `until` carried a `, then park`
# he had just reached: work he queued is not work he parked.
#
# `remit stop` is his word that the in-flight work is gone. It ends the CHAIN,
# not the item: abandoning the item is `close`. It refuses only when there is
# NO MARKER AT ALL, and IN THIS ORDER: it ends the tree of the RAISE the marker
# names; it sends TERM to the chain's own pid; it WAITS for that pid to be gone,
# and says so on the record where it was not; then it discards the build
# worktree's changes, removes the marker, and records one line naming the step
# the marker said it was at. It does NOT touch the header. It signals NOTHING
# when the marker names another machine. A pid can be reused between the marker
# being written and `stop` reading it; this script cannot tell that apart, and
# says so. The chain also stops itself at its next step when its marker is gone
# or is no longer its own.
#
# THAT IT ALWAYS DISPOSES ITS OWN MARKER IS LOAD-BEARING: it is what leaves a
# marker with no running chain meaning ONE thing — THE CRASHED CLASS below.
#
# ==============================================================================
# THE ROAD BACK IN
# ==============================================================================
#
# A chain that stopped — his `stop`, an escalation, or a crash — RESUMES AT THE
# STEP IT STOPPED AT AND NEVER EARLIER. The record says where that is, and
# `resume_point` is the whole of how it is read.
#
# ONLY `resume` CONTINUES A CRASHED RUN, and it is never automatic: it stays on
# his board until he deals with it. Every OTHER verb wipes the marker as part of
# doing its own job — `stop` ends the dead chain and says so, `park` parks,
# `close` archives — so no verb ever refuses until a person hand-deletes a file.
# That is `crash_take`.

set -u

ME=remit
TAB=$(printf '\t')

usage() {
	cat >&2 <<'EOF'
usage:
  remit new <slug> [--until refined|accepted|closed] [--park]
                         create .remit/work-items/<slug>/ from the brief on
                         stdin, which must begin with a `# Title`. A
                         `**Depends on:**` line — the work items it depends on,
                         by slug, or `none` — is optional, and omitting it means
                         none; one that is THERE and cannot be read whole is
                         REFUSED, and nothing is written in its place. Never
                         truncated: naming one dependency and dropping another is
                         what it exists to prevent.
                         Born ACTIVE at stage `new`. With --until it then
                         RUNS THE CHAIN, here, in this same command, exactly as
                         `resume` would, and prints the row where it stopped.
                         With nothing said it runs the chain only if refined.md
                         carries a promote a gate could cite; otherwise it sits.
                         --park ALONE files it instead and nothing runs: a
                         parked item moves for nothing. --until X --park is ONE
                         ruling and runs like --until X: the chain runs NOW, as
                         far as X, and PARKS IT THERE — no promote carries it
                         past X, then or ever.
  remit resume <slug> [--until refined|accepted|closed [--park]]
                         the whole chain: activate, record the ruling, then move
                         one gate at a time as far as the until says, or as far
                         as a promote rubric a gate's evaluator cited carries it,
                         and never past a hold it cited. Prints the row and why
                         it stopped. At `new` before anything is raised, and
                         again before every build, it reads the brief's
                         `**Depends on:**` line and stops the item where it is,
                         naming the dependency, when a work item it names has
                         not closed — WHEN IT IS OBSERVED in this script's header
                         is that rule, and this is not a second statement of it.
                         --park attaches to the --until beside it; on its own it
                         is refused — `remit park <slug>` is that instruction.
  remit park <slug>      attention -> parked. The stage does not move.
  remit stop <slug>      end the chain running on this item — his word that the
                         in-flight work is gone. Refused only when there is no
                         marker at all.
                         Ends the fresh context it had raised and everything
                         under it, waits for the chain to be gone, discards the
                         build worktree's changes, disposes the marker, records
                         one line naming the step it was at, and leaves the item
                         AT THE STAGE IT LAST STOPPED AT. A marker whose chain is
                         already gone is a CRASH: this ends that too and says so.
                         It ends the CHAIN, not the item — `close` abandons an
                         item.
  remit close <slug>     FINAL. Seals every finding with no disposition as
                         `pre-authorised`, keeps anything on stdin as the
                         delivery links, and archives the whole folder to
                         .remit/work-items/.archive/<slug>/ AT THE STAGE IT HAD
                         REACHED. This verb stamps NO stage: work abandoned at
                         `refined` is archived at `refined`, and a brief that
                         depends on it is not let through by its archiving.
  remit list [--parked]  the board — everything not closed, in the order THE
                         LIST PROJECTION in this script's header fixes, which is
                         the one place that ordering is stated; --parked lists
                         the parked instead. A crashed row is an item whose
                         marker names no chain this machine can see running: it
                         says the step it died at, the dead pid and how stale,
                         and only `resume` continues it.
  remit review [today | yesterday | week | since <date> | <slug>...] [--attest]
                         the standing findings — per item at ANY stage, open or
                         archived: what the last verdict at each gate still
                         carried with no disposition, read from the verdicts and
                         never from the seal. One row per finding: item, stage,
                         gate, verdict date, number, first line, and the
                         delivery it stood against. The window is the item's
                         last verdict date, or its closure; nothing said is every
                         item. --attest raises ONE context, in the primary
                         worktree at HEAD, to say of each finding whether it
                         stands, is fixed, or is moot — recorded on every item's
                         log.md as `## reviewed`, the archive included, and
                         committed. A finding attested fixed is not re-judged.
                         THE REVIEW PROJECTION in this script's header is the
                         one statement of it.
  remit report new <name>    file .remit/field-reports/<name>.md from stdin
  remit report close <name>  archive it to field-reports/.archive/
  remit rules init       lay down .remit/rules/ — refined.md, accepted.md,
                         closed.md — with the four section headings the
                         practitioner writes his rubrics under, and the rubrics
                         remit ships. Idempotent; it never overwrites a file that
                         is already there, and it writes no rubric of its own
                         beyond those.
  remit rules ship       print the rubrics remit ships, one per line:
                         <gate> <section> <id> <criterion>, tab separated
  remit rules seed <dir> lay the shipped shape down in <dir>, creating only the
                         files that are absent; prints their names. Commits
                         nothing.
  remit rules read <dir> print the rubrics <dir>'s gate files carry now, in the
                         same four columns as `ship`
  remit rules apply <dir>  apply the edit list on stdin — one
                         <gate> <section> <id> add|set|del <text> per line — to
                         <dir>'s gate files, touching nothing else in them, and
                         print any `add` whose section heading is absent.
                         The last four need no repository and change no work
                         surface: they are how `install.sh` reads the shipped
                         rubrics from their one home and migrates a target's,
                         rubric by rubric.
  remit setup [--write]  read this host — which harness CLIs are here, what each
                         one says about its account and its models — and PROPOSE
                         a .remit/settings.json on stdout, with a report of what
                         it found and how it drifts from the registry already
                         there. Bare, it WRITES NOTHING. With --write it saves
                         that proposal to .remit/settings.json itself, having
                         read the one already there first, and commits nothing.
                         Never redirect this command over the registry: that
                         empties the file it reads before it runs.
  remit migrate          one-time: .remit/<slug>/ -> .remit/work-items/<slug>/,
                         evaluation.md -> log.md, **State:** -> **Attention:** +
                         **Stage:**, root field-reports/ -> .remit/field-reports/
  remit answer <slug> <n> "<words>" [--conductor]
                         answer question <n> of the item's last `asked:` stop.
                         The words are appended VERBATIM under `## Rulings` in
                         the authority, beside the question, as a RULING — not an
                         amendment: the stage does not go back to `new`. The
                         record carries the ruling and the new digest, and the
                         chain then resumes exactly as `resume` would, at the
                         stage it is at. Without --conductor the words are the
                         practitioner's and the ruling is settled; with it they
                         are the conductor's, under the elevation he gave it,
                         and the line and the record say so — provisional, and
                         his to supersede. A question may be answered again by
                         anyone: the latest line stands and the record names
                         what it superseded. Refused (exit 2, nothing written)
                         only when the record carries no open question by that
                         number.
  remit version          `remit <version>`, from .remit/.install/manifest — the
                         one place the installer wrote it. A copy nobody
                         installed says so and exits 2. `--version` is the same.
  remit activate <slug>  retired into `resume` — it says so and exits 2
  remit kill <slug>      retired into `stop` — it says so and exits 2

Only the practitioner decides an item is closed, or how far it may go without
them. This script records and applies that; it decides nothing.

list, review without --attest, and setup without --write, only read. `setup
--write` writes the one file
it was asked to and commits nothing. Every other change is committed, and pushed
when a remote is configured.

Exit codes: 0 done — committed, and pushed if a remote exists. A `resume` that
              stopped where it was told to stop is 0.
            2 usage or precondition error; NOTHING was changed
            3 committed locally, PUSH FAILED — not durable beyond this machine
            4 ESCALATED — `resume` could not move the item: the loop stopped, a
              capability it needs is absent, or the authority changed under it.
              Attention is now `escalated`, the stage is unchanged, and log.md
              says why.
          130 a running `resume` was ENDED — by a signal, or by `remit stop`.
              `stop` records what happened; the chain it ended records nothing.
EOF
	exit 2
}

die() { printf '%s: %s\n' "$ME" "$1" >&2; exit 2; }
say() { printf '%s\n' "$1"; }
now() { date +%Y-%m-%d; }
# Whole seconds since the epoch, or nothing where this host will not say — a raise
# is then recorded as not timed.
secs() {
	_s=$(date +%s 2>/dev/null) || return 0
	case $_s in '' | *[!0-9]*) return 0 ;; esac
	printf '%s\n' "$_s"
}
nocr() { tr -d '\015' <"$1"; }

# Makes only the missing components — never `mkdir -p`, which attempts every
# ancestor and fails on one a sandbox holds read-only. install.sh carries the same
# helper; neither can source the other.
ensure_dir() { # $1 a directory
	[ -d "$1" ] && return 0
	_parent=$(dirname "$1")
	[ "$_parent" = "$1" ] || ensure_dir "$_parent" || return 1
	mkdir "$1"
}

# --- argument parsing ---------------------------------------------------------
[ $# -ge 1 ] || usage
cmd=$1
shift

slug=''
want_until=''
want_park=no
listing=active
want_write=no
report_cmd=''
report_name=''
rules_cmd=''
rules_dir=''

check_slug() {
	case "$1" in
	*[!a-z0-9-]* | -* | '') die "invalid name '$1' — use lower-case letters, digits and hyphens" ;;
	esac
}

check_stop() {
	case "$1" in
	refined | accepted | closed) ;;
	*) die "--until takes refined, accepted or closed — not '$1'" ;;
	esac
}

case "$cmd" in
new)
	[ $# -ge 1 ] || usage
	slug=$1
	shift
	check_slug "$slug"
	while [ $# -gt 0 ]; do
		case "$1" in
		--until) [ $# -ge 2 ] || die "--until needs a value"; want_until=$2; check_stop "$want_until"; shift 2 ;;
		--park) want_park=yes; shift ;;
		*) usage ;;
		esac
	done
	;;
resume)
	[ $# -ge 1 ] || usage
	slug=$1
	shift
	check_slug "$slug"
	while [ $# -gt 0 ]; do
		case "$1" in
		--until) [ $# -ge 2 ] || die "--until needs a value"; want_until=$2; check_stop "$want_until"; shift 2 ;;
		--park) want_park=yes; shift ;;
		*) usage ;;
		esac
	done
	# `--park` at a resume is the second half of one ruling — run to that stop
	# and rest there. On its own it is two commands arguing, and the one that
	# means "do not move" already exists.
	if [ "$want_park" = yes ] && [ -z "$want_until" ]; then
		die "--park at a resume attaches to the --until beside it. To park this item where it is, run: $ME park $slug"
	fi
	;;
answer)
	# `answer <slug> <n> "<words>" [--conductor]`: the number is the record's, the
	# words are filed verbatim. Without the flag the ruling is his and settled; with
	# it, the conductor's and provisional. `record_answer` checks both against the
	# record before anything is written.
	[ $# -ge 3 ] || usage
	slug=$1
	answer_n=$2
	answer_text=$3
	shift 3
	answer_by=practitioner
	while [ $# -gt 0 ]; do
		case "$1" in
		--conductor) answer_by=conductor; shift ;;
		*) usage ;;
		esac
	done
	check_slug "$slug"
	case "$answer_n" in
	'' | *[!0-9]* | 0*) die "the question is named by its number on the record — not '$answer_n'" ;;
	esac
	[ -n "$(printf '%s' "$answer_text" | tr -d '[:space:]')" ] || die "an answer is his words, and there are none here"
	;;
park | stop | close)
	[ $# -eq 1 ] || usage
	slug=$1
	check_slug "$slug"
	;;
activate)
	[ $# -eq 1 ] || usage
	printf '%s: `activate` has retired into `resume`. Run `remit resume %s` — it activates the item and then moves it as far as you said it may go.\n' \
		"$ME" "$1" >&2
	exit 2
	;;
kill)
	[ $# -eq 1 ] || usage
	printf '%s: `kill` has retired into `stop`. Run `remit stop %s` — it ends the chain running on that item, exactly as `kill` did.\n' \
		"$ME" "$1" >&2
	exit 2
	;;
list)
	[ $# -le 1 ] || usage
	case "${1-}" in
	'') listing=active ;;
	--parked) listing=parked ;;
	*) usage ;;
	esac
	;;
review)
	# A window OR a list of items, never both, and `--attest` beside either.
	review_window=all
	review_since=''
	review_slugs=''
	want_attest=no
	while [ $# -gt 0 ]; do
		case "$1" in
		today | yesterday | week)
			[ "$review_window" = all ] && [ -z "$review_slugs" ] || usage
			review_window=$1
			shift
			;;
		since)
			[ $# -ge 2 ] || usage
			[ "$review_window" = all ] && [ -z "$review_slugs" ] || usage
			case "$2" in
			[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
			*) die "since takes a date as YYYY-MM-DD — not '$2'" ;;
			esac
			review_window=since
			review_since=$2
			shift 2
			;;
		--attest) want_attest=yes; shift ;;
		-*) usage ;;
		*)
			[ "$review_window" = all ] || usage
			check_slug "$1"
			review_slugs="$review_slugs $1"
			shift
			;;
		esac
	done
	;;
report)
	[ $# -eq 2 ] || usage
	report_cmd=$1
	report_name=$2
	case "$report_cmd" in new | close) ;; *) usage ;; esac
	case "$report_name" in
	*[!a-z0-9.-]* | -* | '') die "invalid report name '$report_name' — use lower-case letters, digits, hyphens and dots" ;;
	esac
	;;
setup)
	# `--write` is the ONLY way this script saves the registry, and it exists so
	# that saving never means aiming a shell redirection at the file `setup`
	# reads. Without it: propose on stdout, change nothing.
	case "${1-}" in
	'') ;;
	--write) want_write=yes ;;
	*) usage ;;
	esac
	[ $# -le 1 ] || usage
	;;
rules)
	rules_cmd=${1-}
	case "$rules_cmd" in
	init | ship)
		[ $# -eq 1 ] || usage
		;;
	seed | read | apply)
		[ $# -eq 2 ] || usage
		rules_dir=$2
		;;
	*) die "the only thing this script writes of its own in .remit/rules/ is its shipped shape: \`$ME rules init\`. Every rubric beyond that is the practitioner's, through a retro." ;;
	esac
	;;
migrate)
	[ $# -eq 0 ] || usage
	;;
version | --version)
	cmd=version
	[ $# -eq 0 ] || usage
	;;
-h | --help)
	usage
	;;
*)
	usage
	;;
esac

# ==============================================================================
# ONE PATH NAMESPACE
# ==============================================================================
#
# On Windows one directory has two names: the MSYS shell's `/c/Users/...` and the
# drive-lettered `C:/Users/...` that git, native CLIs and a sandboxed seat under
# another account can all open. THE NAME THAT TRAVELS IS THE DRIVE-LETTERED ONE.
# Every path derived from `$root` crosses the seam — the kept-output home, the
# worktree a raise is handed — so the conversion happens ONCE, where a path is
# first resolved, and everything downstream inherits it. `cygpath` is the
# authority (`/tmp` is not `C:/tmp`); without it there is one spelling and this is
# the identity.
CYGPATH=$(command -v cygpath 2>/dev/null) || CYGPATH=''
one_namespace() { # $1 an absolute path -> it, in the spelling everything resolves
	if [ -n "$CYGPATH" ]; then
		_ns=$("$CYGPATH" -m "$1" 2>/dev/null)
		if [ -n "$_ns" ]; then
			printf '%s\n' "$_ns"
			return 0
		fi
	fi
	printf '%s\n' "$1"
}

# A directory that EXISTS, resolved: symlinks followed, then spelled the one way.
# Returns non-zero, saying nothing, when it cannot be entered.
resolve_dir() { # $1 a directory
	_rd=$(CDPATH= cd -- "$1" 2>/dev/null && pwd -P) || return 1
	one_namespace "$_rd"
}

# `rules ship|seed|read|apply` answer from this script and a directory on the
# command line: no work surface, no git, no repository. Every other verb changes
# the work surface.
PAYLOAD_ONLY=no
if [ "$cmd" = rules ]; then
	case "$rules_cmd" in ship | seed | read | apply) PAYLOAD_ONLY=yes ;; esac
fi

# `version` answers from the installed manifest, which stays with the project
# wherever the record lives; a copy nobody installed has none and says so.
if [ "$cmd" = version ]; then
	_vroot=$(git rev-parse --show-toplevel 2>/dev/null) || _vroot=.
	_vman="$_vroot/.remit/.install/manifest"
	[ -f "$_vman" ] || die "no .remit/.install/manifest under $_vroot — this copy was not installed here, and the version is the installer's to write. A clone of remit is its tag."
	_v=$(nocr "$_vman" | sed -n 's/^version //p' | sed -n 1p)
	[ -n "$_v" ] || die "$_vman carries no \`version\` line"
	printf 'remit %s
' "$_v"
	exit 0
fi

git_dir=''
common_dir=''
if [ "$PAYLOAD_ONLY" = yes ]; then
	root=$(resolve_dir .) || die "cannot resolve the current directory"
else
	root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a Git repository"

	# `rev-parse` answers in the spelling that travels; the `cd` follows symlinks and
	# the conversion keeps that spelling on a shell that would hand back its own.
	root=$(resolve_dir "$root") || die "cannot resolve the repository root at $root"

	# The work surface changes from one place only — the repository's primary
	# worktree. A linked worktree is a builder's territory; a state change made
	# there would race the primary view and could land on a work branch. In the
	# primary worktree the git dir and the common git dir are the same directory.
	git_dir=$(resolve_dir "$(git rev-parse --git-dir)")
	common_dir=$(resolve_dir "$(git rev-parse --git-common-dir)")
	# `setup` without `--write` changes nothing, so it may run from a linked worktree;
	# `--write` would save into that worktree's own registry, so it is refused where
	# every other change is.
	if [ "$git_dir" != "$common_dir" ] && { [ "$cmd" != setup ] || [ "$want_write" = yes ]; }; then
		die "refusing to run from a linked worktree — the work surface changes only from the primary worktree at $(dirname "$common_dir")"
	fi
fi

# ==============================================================================
# WHERE THE RECORD LIVES — the one indirection, resolved here and nowhere else
# ==============================================================================
#
# THE RECORD is what this script authors: work items, their archive, the kept run
# output inside them, and field reports. By default it lives in the project
# repository. `.remit/settings.local.json` — per-user, gitignored, never shipped —
# points it elsewhere:
#
#     { "records": { "remote": "git@host:me/my-records.git",
#                    "folder": "this-project",        (optional)
#                    "clone":  "/where/the/clone/is"  (optional) } }
#
# `remote` ALONE turns personal mode on. `folder` defaults to the project
# repository's directory name, so one records repository holds many projects.
# `clone` defaults to `$HOME/.remit/records/<the remote's last path segment,
# `.git` stripped>`; `REMIT_RECORDS_HOME` moves that default's parent. The clone
# is configured or derived by this rule — never searched for.
#
# WHAT MOVES: `ITEMS` and `REPORTS`, and nothing else; every item path, brief,
# log, marker, archive path and runs home derives from those two.
#
# WHAT STAYS WITH THE PROJECT, as installed payload: `.remit/rules/`,
# `.remit/settings.json` (never committed by this script), `.remit/hooks/` and
# `.remit/.install/`.
#
# `$rec_root` is the repository the record is committed in and `$rec_pfx` is
# `$rec` relative to it; `commit_locked` and `marker_glob` read them.
rec=$root
rec_root=$root
rec_pfx=''
RECORDS_REMOTE=''
LOCALSETTINGS="$root/.remit/settings.local.json"

# A flat reader, not a JSON parser: one string value out of the `"records"`
# object. `jq` is not a dependency of the verbs that read this.
local_record_setting() { # $1 key -> its string value, or nothing
	[ -f "$LOCALSETTINGS" ] || return 0
	tr -d '\n\r\t' <"$LOCALSETTINGS" |
		sed -n 's/.*"records"[[:space:]]*:[[:space:]]*{\([^}]*\)}.*/\1/p' |
		sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' |
		sed -n 1p
}

# ONE PATH NAMESPACE between what git STORED and what he TYPED: a remote that is a
# directory here is compared as a directory, every real URL as the string it is.
same_remote() { # $1 $2 -> 0 when both name the same repository
	[ "$1" = "$2" ] && return 0
	_s1=${1#file://}
	_s2=${2#file://}
	[ "$_s1" = "$_s2" ] && return 0
	{ [ -d "$_s1" ] && [ -d "$_s2" ]; } || return 1
	_p1=$(resolve_dir "$_s1") || return 1
	_p2=$(resolve_dir "$_s2") || return 1
	[ "$_p1" = "$_p2" ]
}

[ "$PAYLOAD_ONLY" = yes ] || RECORDS_REMOTE=$(local_record_setting remote)
if [ -n "$RECORDS_REMOTE" ]; then
	_rfolder=$(local_record_setting folder)
	[ -n "$_rfolder" ] || _rfolder=${root##*/}
	case "$_rfolder" in
	*/* | . | ..) die "records.folder in $LOCALSETTINGS must be one directory name, not '$_rfolder'" ;;
	esac
	_rclone=$(local_record_setting clone)
	if [ -z "$_rclone" ]; then
		_rbase=${RECORDS_REMOTE%/}
		_rbase=${_rbase##*/}
		_rbase=${_rbase%.git}
		[ -n "$_rbase" ] ||
			die "cannot derive a clone directory name from records.remote '$RECORDS_REMOTE' — name records.clone in $LOCALSETTINGS"
		_rclone="${REMIT_RECORDS_HOME:-${HOME:-.}/.remit/records}/$_rbase"
	fi

	# A clone already there is checked against the remote it is supposed to be.
	if [ -d "$_rclone/.git" ]; then
		_rhave=$(git -C "$_rclone" remote get-url origin 2>/dev/null) || _rhave=''
		same_remote "$_rhave" "$RECORDS_REMOTE" ||
			die "the records clone $_rclone has origin '$_rhave', not the records.remote '$RECORDS_REMOTE' named in $LOCALSETTINGS"
	else
		[ -e "$_rclone" ] && die "records.clone $_rclone exists and is not a Git repository"
		printf '%s: cloning the records repository %s into %s\n' "$ME" "$RECORDS_REMOTE" "$_rclone" >&2
		mkdir -p "${_rclone%/*}" 2>/dev/null || :
		git clone -q "$RECORDS_REMOTE" "$_rclone" >/dev/null 2>&1 ||
			die "could not clone the records repository $RECORDS_REMOTE into $_rclone"
		# AN UNBORN HEAD after a clone is resolved against what the REMOTE has — `main`
		# when it is there, else its first branch — and only an empty repository names
		# `main` for the first commit to create. Committing on an unborn default builds
		# a second root and every push is rejected.
		if ! git -C "$_rclone" rev-parse HEAD >/dev/null 2>&1; then
			_rbr=''
			git -C "$_rclone" show-ref --verify --quiet refs/remotes/origin/main && _rbr=main
			[ -n "$_rbr" ] || _rbr=$(git -C "$_rclone" for-each-ref --format='%(refname:strip=3)' \
				refs/remotes/origin 2>/dev/null | grep -v '^HEAD$' | sed -n 1p)
			if [ -n "$_rbr" ]; then
				git -C "$_rclone" checkout -q -B "$_rbr" "origin/$_rbr" >/dev/null 2>&1 ||
					die "the records repository $RECORDS_REMOTE carries '$_rbr' and this clone could not check it out"
			else
				git -C "$_rclone" symbolic-ref HEAD refs/heads/main >/dev/null 2>&1 || :
			fi
		fi
	fi
	# The clone takes the project's committer identity when it has none of its
	# own, so that a fresh clone can make its first record commit on a machine
	# whose git carries no global identity — a build agent's, for instance.
	if [ -z "$(git -C "$_rclone" config user.email 2>/dev/null)" ]; then
		_rid=$(git -C "$root" config user.email 2>/dev/null) &&
			[ -n "$_rid" ] && git -C "$_rclone" config user.email "$_rid"
		_rid=$(git -C "$root" config user.name 2>/dev/null) &&
			[ -n "$_rid" ] && git -C "$_rclone" config user.name "$_rid"
	fi

	# ONE PATH NAMESPACE, for the same reason `$root` is resolved this way above.
	rec_root=$(resolve_dir "$_rclone") ||
		die "cannot resolve the records clone at $_rclone"
	rec="$rec_root/$_rfolder"
	rec_pfx="$_rfolder/"
	mkdir -p "$rec" 2>/dev/null || die "cannot create the records home at $rec"
fi

REMITDIR="$root/.remit"
# The record's own root: `$REMITDIR` unless personal records moved it.
RECDIR="$rec/.remit"
ITEMS="$RECDIR/work-items"
ITEMARCH="$ITEMS/.archive"
REPORTS="$RECDIR/field-reports"
REPORTARCH="$REPORTS/.archive"
RUBRICS="$REMITDIR/rules"
SETTINGS_REL=".remit/settings.json"
SETTINGSFILE="$root/$SETTINGS_REL"
# RETIRED into the registry. Nothing writes it; `setup` and `migrate` read it
# once to carry its lines forward.
ROLESFILE="$RUBRICS/roles.md"

# The gate a stage is entered THROUGH, and the file that gate is judged against.
gate_file() { # $1 the stage being entered -> a path, whether or not it exists
	printf '%s/%s.md\n' "$RUBRICS" "$1"
}

# The `## fix` section of a gate file, verbatim, and nothing else from it — the
# bar an authoring role is held to. Prints nothing when the section is empty, so
# a caller can tell "no standards here" from "standards, and they are these".
gate_fix_section() { # $1 refined|accepted|closed -> the `- ` lines of its `## fix`
	_gp=$(gate_file "$1")
	[ -f "$_gp" ] || return 0
	nocr "$_gp" | awk '
		/^##/ {
			sec = $0
			sub(/^##[ \t]*/, "", sec)
			sub(/[ \t]*$/, "", sec)
			infix = (tolower(sec) == "fix")
			next
		}
		infix && /^- / { print }
	'
}

item="$ITEMS/$slug"
brief="$item/brief.md"
log="$item/log.md"
marker_name=.working
marker="$item/$marker_name"
# EVERY marker this repository could hold, for EVERY item, as a repository-
# relative pathspec built from the same two values the marker is. `*` crosses
# `/`, so it reaches `<items>/.archive/<slug>/.working` too — `close` moves a
# folder whole. Relative to `$rec_root`, the repository whose index it is handed
# to.
marker_glob="${ITEMS#"$rec_root"/}/*/$marker_name"
# The marker is machine state — see the note at the head of this script — so it
# is excluded from every pathspec `commit_and_push` stages and commits.
marker_exclude=":(exclude)$marker_glob"
itemarchive="$ITEMARCH/$slug"
# WHERE THIS ITEM'S KEPT RUN OUTPUT LIVES — KEPT OUTPUT HAS A HOME in this
# script's header. `$runs` is THE HOME, inside the item wherever the record
# lives; `$runs_rel` is where a raise WRITES, inside the working tree it was
# given; `runs_harvest` is the crossing. `$item_rel` is the same crossing for the
# item folder, and both names derive from it so `item_seed` and `runs_seed`
# agree.
item_rel=".remit/work-items/$slug"
runs_rel="$item_rel/runs"
runs="$ITEMS/$slug/runs"

# ==============================================================================
# the header: written here, read here, inferred nowhere
# ==============================================================================

hdr() { # $1 file  $2 name -> the value, or empty
	[ -f "$1" ] || return 0
	nocr "$1" | sed -n "s/^\*\*$2:\*\* *//p" | sed -n 1p | sed 's/[[:space:]]*$//'
}

# The ONE refusal for a file the script-owned header cannot be written into;
# asked by `put_header` and by every verb before it takes a crashed marker off
# the board (`crash_take`).
require_title() { # $1 file
	nocr "$1" | grep -q '^# ' ||
		die "$1 has no '# Title' heading — the header has nowhere to go"
}

# The pull request's title is the brief's own — the practitioner's words, not
# the slug. Falls back to the slug where the brief has no heading a raise could
# be started from, which `require_title` refuses before a chain runs anyway.
pr_title() {
	_pt=$(nocr "$brief" | sed -n 's/^# //p' | sed -n 1p)
	[ -n "$_pt" ] || _pt=$slug
	printf '%s: %s\n' "$slug" "$_pt"
}

# Re-emit the whole script-owned header as one block directly under the title.
# Every existing header line is removed first, so this is idempotent and cannot
# leave two of anything. An empty value omits the line entirely.
put_header() { # $1 file  $2 attention  $3 stage  $4 until  $5 migrated (KEEP preserves)
	_f=$1 _at=$2 _st=$3 _un=$4 _mg=$5
	require_title "$_f"
	[ "$_mg" = KEEP ] && _mg=$(hdr "$_f" Migrated)
	awk -v at="$_at" -v st="$_st" -v un="$_un" -v mg="$_mg" '
		BEGIN { ins = 0; eat = 0 }
		{ sub(/\r$/, "") }
		/^\*\*(Attention|Stage|Until|Migrated|State):\*\*/ { next }
		ins == 0 && /^# / {
			print
			print ""
			if (at != "") print "**Attention:** " at
			if (st != "") print "**Stage:** " st
			if (un != "") print "**Until:** " un
			if (mg != "") print "**Migrated:** " mg
			print ""
			ins = 1
			eat = 1
			next
		}
		eat == 1 && $0 == "" { next }
		{ eat = 0; print }
		END { if (ins == 0) exit 3 }
	' "$_f" >"$_f.tmp" || { rm -f "$_f.tmp"; die "the header of $_f could not be rewritten — $ME left it as it was"; }
	mv "$_f.tmp" "$_f"
}

# `--until X --park` is one ruling and is recorded as one value, `X, then park`.
# These two are the only places that know that spelling: everywhere else passes
# the recorded value through whole, so no path can carry half of it.
until_value() { # $1 stop (may be empty)  $2 yes|no -> the value to record
	[ -n "$1" ] || return 0
	if [ "$2" = yes ]; then
		printf '%s, then park\n' "$1"
	else
		printf '%s\n' "$1"
	fi
}

read_until() { # $1 a recorded **Until:** value -> sets UNTIL_STOP, UNTIL_PARK
	UNTIL_STOP=$1
	UNTIL_PARK=no
	case "$UNTIL_STOP" in
	*', then park')
		UNTIL_STOP=${UNTIL_STOP%', then park'}
		UNTIL_PARK=yes
		;;
	esac
}
UNTIL_STOP=''
UNTIL_PARK=no

valid_attention() { case "$1" in parked | active | escalated) return 0 ;; esac; return 1; }
valid_stage() { case "$1" in new | refined | accepted | closed) return 0 ;; esac; return 1; }

rank() { # stage -> 0..3; -1 for nothing recognisable
	case "$1" in
	new) printf '0\n' ;;
	refined) printf '1\n' ;;
	accepted) printf '2\n' ;;
	closed) printf '3\n' ;;
	*) printf -- '-1\n' ;;
	esac
}

# ==============================================================================
# the record
# ==============================================================================

log_ensure() {
	[ -f "$log" ] && return 0
	{
		printf '# Record — %s\n\n' "$slug"
		printf 'Append-only. Written by `bin/remit`; the entry shapes are in its header.\n'
	} >"$log"
}

log_append() { # $1 heading text; the body on stdin
	log_ensure
	{
		printf '\n## %s\n\n' "$1"
		# The raises since the last entry, at the top of this one and cleared as they
		# go — log.md — THE ENTRY SHAPES.
		if [ -n "${RAISES:-}" ] && [ -s "$RAISES" ]; then
			cat "$RAISES"
			printf '\n'
			: >"$RAISES"
		fi
		cat
	} >>"$log"
}

# The reason column is read from the record and never computed.
last_reason() { # $1 item dir -> reason, or empty
	[ -f "$1/log.md" ] || return 0
	nocr "$1/log.md" |
		sed -n 's/^## stopped — \(.*\) — [0-9-]*$/\1/p;s/^## escalated — \(.*\) — [0-9-]*$/\1/p' |
		sed -n '$p'
}

next_finding_no() {
	_n=0
	[ -f "$log" ] && _n=$(nocr "$log" | grep -c '^- finding [0-9][0-9]*: ')
	[ -n "$_n" ] || _n=0
	printf '%s\n' $((_n + 1))
}

# ==============================================================================
# committing: report exactly what Git accepted, never more
# ==============================================================================
#
# CONCURRENCY LIVES HERE AND NOWHERE ELSE. Several runs share one repository, one
# working tree and one branch, and two things race: `.git/index.lock` and the
# branch ref. Both are held in this one function, the only place a record
# touches the index or the remote.
#
# The mutex is a DIRECTORY — `mkdir` is the one atomic create-or-fail in every
# POSIX shell, and `flock` is not on Git Bash. It lives in the git directory
# (machine state, never committed), holds the owning pid, and wraps THIS FUNCTION
# ONLY: a run waiting on a model never blocks a run committing.
#
# The wait is bounded by `REMIT_LOCK_WAIT` seconds. A run that waits says so
# once; an expiry is reported and the commit attempted anyway — a lock a stopped
# run left behind costs one loud wait, never a repository that cannot commit.
# Nothing reaps a lock or judges whether its owner is alive.
#
# Inside the mutex A REJECTED PUSH IS RETRIED: fetch the branch, replay this
# commit on top, push again — three pushes at most, and stopping at once when the
# fetch brings nothing new. The replay is `reset --soft` and a fresh pathspec
# commit, NOT `git rebase`, which needs a clean tree the next waiting run has
# already written into. It runs only where the fetched tip contains everything
# this branch held before this commit (`merge-base --is-ancestor`).
#
# The replay does not update the working tree with what the fetch brought back,
# and where that fetch changed the same paths this commit occupies, this working
# tree's version supersedes it with nothing raised: a pathspec commit has no
# conflict to raise. On one machine every commit on the branch came through this
# mutex, so it cannot arise.

LOCKDIR="$common_dir/remit-commit.lock"
LOCK_WAIT=${REMIT_LOCK_WAIT:-120}
# THE BOUND MUST BE A NUMBER: a value that is not digits is refused, said out
# loud, and the default stands — an error in `[ -ge ]` is not true, and the
# bounded wait would become unbounded.
case "$LOCK_WAIT" in
'' | *[!0-9]*)
	printf '%s: REMIT_LOCK_WAIT=%s is not a number of seconds — the record lock will wait 120.\n' \
		"$ME" "$LOCK_WAIT" >&2
	LOCK_WAIT=120
	;;
esac
LOCK_HELD=no

lock_take() { # -> 0 it is held, 1 the bounded wait expired and it is not
	_waited=0
	_said=no
	while ! mkdir "$LOCKDIR" 2>/dev/null; do
		if [ "$_said" = no ]; then
			_owner=$(cat "$LOCKDIR/pid" 2>/dev/null)
			printf 'waiting for the record lock, held by pid %s — another remit run is committing.\n' \
				"${_owner:-unknown}"
			_said=yes
		fi
		if [ "$_waited" -ge "$LOCK_WAIT" ]; then
			printf '%s: waited %ss for the record lock at %s and it did not clear. Committing WITHOUT it — if no remit run is alive, remove that directory.\n' \
				"$ME" "$LOCK_WAIT" "$LOCKDIR" >&2
			return 1
		fi
		sleep 1
		_waited=$((_waited + 1))
	done
	LOCK_HELD=yes
	printf '%s\n' "$$" >"$LOCKDIR/pid" 2>/dev/null
	return 0
}

lock_drop() {
	[ "$LOCK_HELD" = yes ] || return 0
	LOCK_HELD=no
	rm -rf "$LOCKDIR"
}

# A MARKER THAT IS ALREADY IN THE TREE CANNOT REMOVE ITSELF: an excluded path is
# never matched, in either direction, so a marker an older remit or another clone
# committed would sit in the tree for ever. This takes every such marker out on
# the next commit any run makes.
#
# Not `git commit -- <paths>`, which would re-commit a marker that is live on
# disk; not `git rm --cached` and a plain commit, which would publish whatever he
# has staged. The removal is built in an index of its own — HEAD's tree with the
# marker paths taken out — committed by an ordinary `git commit` against that
# index, so hooks and signing apply; the real index is then brought into line.
# It never deletes the marker from disk. It sets MARKER_SWEPT and never fails
# its caller: a marker that could not be untracked is not a durability problem.
MARKER_SWEPT=no

# THE ITEM FOLDER IS RECORD, NOT SCRATCH. What it holds is known: `brief.md`,
# `log.md`, `research.md`, the phase files (any `*.md` at the top) and `runs/`.
# Anything else under it is NOT record: left where it is, UNSTAGED, never
# deleted, and the run says what it left and where, once. The archive the same.
record_only() { # $@ the pathspecs about to be committed
	_ro_left=''
	for _ro_p in "$@"; do
		case "$_ro_p" in
		*/.remit/work-items/* | .remit/work-items/*) ;;
		*) continue ;;
		esac
		for _ro_f in $(git -C "$CIN_ROOT" diff --cached --name-only -- "$_ro_p" 2>/dev/null); do
			_ro_rel=${_ro_f#"$_ro_p"/}
			[ "$_ro_rel" = "$_ro_f" ] && continue
			case "$_ro_rel" in
			*/*)
				case "$_ro_rel" in runs/*) continue ;; esac
				;;
			*.md | "$marker_name") continue ;;
			esac
			git -C "$CIN_ROOT" reset -q -- "$_ro_f" 2>/dev/null
			_ro_left="${_ro_left:+$_ro_left }$_ro_f"
		done
	done
	[ -n "$_ro_left" ] &&
		printf '%s: not record, left unstaged — a work item holds brief.md, log.md, research.md, its phase files and runs/, and nothing else: %s\n' "$ME" "$_ro_left" >&2
	return 0
}
markers_untrack() {
	MARKER_SWEPT=no
	# Read against HEAD as well as the index: after a rejected push has been
	# reset away, the index no longer holds the marker but the tip this commit
	# will sit on does, and that tip is what the removal has to be made against.
	_mtracked=$(git -C "$CIN_ROOT" ls-files --with-tree=HEAD -- "$marker_glob" 2>/dev/null) || _mtracked=''
	[ -n "$_mtracked" ] || return 0
	_midx="$common_dir/remit-marker-sweep.index"
	rm -f "$_midx"
	if GIT_INDEX_FILE="$_midx" git -C "$CIN_ROOT" read-tree HEAD 2>/dev/null &&
		GIT_INDEX_FILE="$_midx" git -C "$CIN_ROOT" rm -q --cached --ignore-unmatch -- "$marker_glob" 2>/dev/null &&
		GIT_INDEX_FILE="$_midx" git -C "$CIN_ROOT" commit -q -m "remit: untrack the working marker — it is machine state" 2>/dev/null; then
		MARKER_SWEPT=yes
		# The real index still holds the entry the commit removed and would read it as
		# a staged ADDITION; `reset -- <paths>` puts it back to HEAD's nothing, touching
		# no file.
		git -C "$CIN_ROOT" reset -q -- "$marker_glob" 2>/dev/null ||
			printf '%s: the marker is out of the tree, but the index still stages it — `git reset -- %s` clears that.\n' \
				"$ME" "$marker_glob" >&2
		printf 'untracked a working marker this repository was carrying — machine state, and it stays on disk:\n'
		printf '%s\n' "$_mtracked" | sed 's/^/  /'
	else
		printf '%s: could not untrack the working marker(s) below — they are still in the tree, and the record commit below still stands.\n' \
			"$ME" >&2
		printf '%s\n' "$_mtracked" | sed 's/^/  /' >&2
	fi
	rm -f "$_midx"
	return 0
}

# `commit_and_push` is the RECORD's repository; `commit_project_and_push` is the
# PROJECT's, for installed payload. Without personal records they are the same
# commit.
CIN_ROOT=$rec_root
CIN_PFX=$rec_pfx

commit_and_push() { # $1 message, then every path this change occupies
	lock_take || :
	commit_locked "$@"
	_caprc=$?
	lock_drop
	return $_caprc
}

# For a path that is the PROJECT's — `.remit/rules/` — committed into `$root`
# with paths spelled from `$root`.
commit_project_and_push() { # $1 message, then every path this change occupies
	CIN_ROOT=$root
	CIN_PFX=''
	commit_and_push "$@"
	_cprc=$?
	CIN_ROOT=$rec_root
	CIN_PFX=$rec_pfx
	return $_cprc
}

# The body of the above, run with the mutex held. Called from there and nowhere
# else, so that every path out of it releases the lock in one place.
commit_locked() { # $1 message, then every path this change occupies
	_msg=$1
	shift
	# EVERY CALLER SPELLS ITS PATHS FROM THE PROJECT. In personal mode the same path
	# sits one folder down in the clone, so the prefix goes on ONCE, here, by
	# rotating the positional parameters — a path with a space survives.
	if [ -n "$CIN_PFX" ]; then
		_cn=$#
		while [ "$_cn" -gt 0 ]; do
			set -- "$@" "$CIN_PFX$1"
			shift
			_cn=$((_cn - 1))
		done
	fi
	# The tip everything below sits on, read BEFORE anything is committed — the
	# marker sweep included, because the remote has not seen that commit either
	# and the replay further down asks whether the remote has moved on from a
	# commit the remote could have had.
	_pre=$(git -C "$CIN_ROOT" rev-parse HEAD 2>/dev/null) || _pre=''
	markers_untrack
	git -C "$CIN_ROOT" add -A -- "$@" "$marker_exclude" ||
		{ printf '%s: could not stage %s\n' "$ME" "$*" >&2; return 2; }
	record_only "$@"
	if git -C "$CIN_ROOT" diff --cached --quiet -- "$@" "$marker_exclude" 2>/dev/null; then
		# Nothing of THIS change is left to record. A sweep may still have made a
		# commit of its own, and that one has a remote to reach.
		if [ "$MARKER_SWEPT" = no ]; then
			printf 'nothing changed on disk — nothing to commit.\n'
			return 0
		fi
	else
		git -C "$CIN_ROOT" commit -q -m "$_msg" -- "$@" "$marker_exclude" ||
			{ printf '%s: commit failed\n' "$ME" >&2; return 2; }
	fi

	remote=origin
	git -C "$CIN_ROOT" remote get-url origin >/dev/null 2>&1 || remote=$(git -C "$CIN_ROOT" remote | sed -n 1p)
	# EXIT 3 NAMES THE REMOTE THAT DID NOT ACCEPT THIS: by URL where the repository
	# committed in is not the project.
	remote_said=$remote
	if [ "$CIN_ROOT" != "$root" ] && [ -n "$remote" ]; then
		remote_said="the records remote $remote ($(git -C "$CIN_ROOT" remote get-url "$remote" 2>/dev/null))"
	fi
	if [ -z "$remote" ]; then
		printf 'committed. No remote configured — durable on this machine only.\n'
		return 0
	fi
	branch=$(git -C "$CIN_ROOT" rev-parse --abbrev-ref HEAD)
	if [ "$branch" = HEAD ]; then
		printf 'committed. Detached HEAD — NOT pushed; durable on this machine only.\n' >&2
		return 3
	fi

	_try=1
	while :; do
		if out=$(git -C "$CIN_ROOT" push "$remote" "HEAD:refs/heads/$branch" 2>&1); then
			printf 'committed and pushed to %s/%s.\n' "$remote" "$branch"
			return 0
		fi
		[ "$_try" -lt 3 ] || break
		git -C "$CIN_ROOT" fetch -q "$remote" "$branch" 2>/dev/null || break
		_new=$(git -C "$CIN_ROOT" rev-parse FETCH_HEAD 2>/dev/null) || break
		{ [ -n "$_new" ] && [ -n "$_pre" ]; } || break
		[ "$_new" = "$_pre" ] && break
		git -C "$CIN_ROOT" merge-base --is-ancestor "$_pre" "$_new" 2>/dev/null || break
		_had=$(git -C "$CIN_ROOT" rev-parse HEAD) || break
		git -C "$CIN_ROOT" reset -q --soft "$_new" || break
		# The reset put HEAD back on a tip that still carries whatever markers
		# the remote holds, so the sweep is made again against THAT tip. Its
		# earlier commit went away with the reset, and an unrepeated sweep would
		# leave the marker in the tree while reporting the push as landed.
		markers_untrack
		git -C "$CIN_ROOT" add -A -- "$@" "$marker_exclude" ||
			{ git -C "$CIN_ROOT" reset -q --soft "$_had"; break; }
		if git -C "$CIN_ROOT" diff --cached --quiet -- "$@" "$marker_exclude" 2>/dev/null; then
			if [ "$MARKER_SWEPT" = no ]; then
				printf 'the remote already carries this change — nothing left to push.\n'
				return 0
			fi
		else
			git -C "$CIN_ROOT" commit -q -m "$_msg" -- "$@" "$marker_exclude" ||
				{ git -C "$CIN_ROOT" reset -q --soft "$_had"; break; }
		fi
		printf 'the push was rejected; %s had moved. Replayed this commit on top of it.\n' "$remote"
		_pre=$_new
		_try=$((_try + 1))
	done
	printf 'committed. PUSH FAILED — %s has NOT accepted this change; durable on this machine only.\n%s\n' \
		"$remote_said" "$out" >&2
	return 3
}

# `resume` commits many times. A failed push on any of them is the same
# not-durable-beyond-this-machine that exit 3 means, and it is remembered rather
# than swallowed.
PUSH_FAILED=no
commit_step() {
	commit_and_push "$@"
	_crc=$?
	[ "$_crc" = 3 ] && PUSH_FAILED=yes
	[ "$_crc" = 2 ] && return 2
	return 0
}

# ==============================================================================
# .remit/rules/ — read, validated for FORM, and never judged here
# ==============================================================================
#
# Dumps one record per rubric line: <file> <section> <id> <text>, tab separated.
# A malformed line inside a known section dumps `!` <file> <lineno> <text>
# instead, so the caller can refuse the folder rather than apply half of it.
#
# This reads the FORM and nothing else. No criterion is interpreted here: what a
# rubric means is the evaluate role's to judge, and the citation it returns is
# all this script acts on.
rubrics_dump_file() { # $1 refined|accepted|closed
	_p="$RUBRICS/$1.md"
	[ -f "$_p" ] || return 0
	nocr "$_p" | awk -v file="$1" '
		function bad(n, t) { print "!" "\t" file "\t" n "\t" t; next }
		/^##/ {
			sec = $0
			sub(/^##[ \t]*/, "", sec)
			sub(/[ \t]*$/, "", sec)
			sec = tolower(sec)
			next
		}
		/^#/ { next }
		sec != "promote" && sec != "hold" && sec != "fix" && sec != "accept" { next }
		!/^- / { next }
		{
			line = $0
			sub(/^- /, "", line)
			p = index(line, ":")
			if (p < 2) bad(NR, $0)
			id = substr(line, 1, p - 1)
			rest = substr(line, p + 1)
			sub(/^[ \t]+/, "", rest)
			sub(/[ \t]+$/, "", rest)
			if (id == "" || id ~ /[ \t]/) bad(NR, $0)
			if (rest == "") bad(NR, $0)
			print file "\t" sec "\t" id "\t" rest
		}
	'
}

rubrics_dump() {
	[ -d "$RUBRICS" ] || return 0
	for _f in refined accepted closed; do
		rubrics_dump_file "$_f"
	done
}

# NO REGISTRY, NO RAISE — said before a chain starts, where it costs nothing.
# Only the verbs that RUN A CHAIN ask: a registry is host configuration.
registry_check() { # -> dies 2 when no chain could raise anything
	[ -s "$SETTINGSFILE" ] ||
		die "no registry at .remit/settings.json — nothing can be raised on this host until one names its seats. \`$ME setup\` reads the host and proposes one; \`$ME setup --write\` saves it."
	refused_check
	return 0
}

# A REFUSED SEAT. `bin/remit-invoke` marks the host — `<git dir>/remit-refused`,
# one line per harness: name, epoch, what the CLI said — when a run fails with a
# signature that names the seat (out of credits, quota, unauthenticated). This
# refuses while a line is fresh (`REFUSED_FRESH`); a completed run on that
# harness clears its line, `setup --write` clears all, and so does deleting the
# file. Nothing is changed: the chain never started.
REFUSED_FRESH=1800
refused_check() {
	_rf="$common_dir/remit-refused"
	[ -f "$_rf" ] || return 0
	_rnow=$(now_secs)
	[ -n "$_rnow" ] || return 0
	while IFS="$TAB" read -r _rh _rt _rr; do
		case "$_rt" in '' | *[!0-9]*) continue ;; esac
		_rage=$((_rnow - _rt))
		[ "$_rage" -lt "$REFUSED_FRESH" ] || continue
		die "the $_rh seat refused $((_rage / 60)) minute(s) ago on this host — \"$_rr\" — and no chain raises into it while that is fresh (${REFUSED_FRESH}s). Re-seat it with \`$ME setup --write\`, wait, or remove $_rf if the seat is back."
	done <"$_rf"
	return 0
}
rubrics_check() {
	_bad=$(rubrics_dump | grep '^!' | head -5)
	[ -z "$_bad" ] && return 0
	printf '%s: .remit/rules/ has lines this script cannot read, so NONE of it is applied:\n' "$ME" >&2
	printf '%s\n' "$_bad" | while IFS="$TAB" read -r _x _f _n _t; do
		printf '  %s.md line %s: %s\n' "$_f" "$_n" "$_t" >&2
	done
	printf 'The form is in `bin/remit`'"'"'s header: `- <id>: <criterion in prose>` under\n' >&2
	printf '`## promote`, `## hold`, `## fix` or `## accept`. Only the retro convention\n' >&2
	printf 'writes these files, on the practitioner'"'"'s ruling.\n' >&2
	exit 2
}

# The ids one section of one gate file carries, space separated. Used for exactly
# two things: whether a citation that MOVES work names a rubric that exists, and
# whether a gate has any `promote` rubric at all — which is whether asking that
# gate could move an item the practitioner's `until` does not reach.
rubric_ids() { # $1 refined|accepted|closed  $2 promote|hold|fix|accept
	rubrics_dump_file "$1" | awk -F"$TAB" -v s="$2" '$1 != "!" && $2 == s { printf "%s ", $3 }'
}

# ==============================================================================
# how far the practitioner's own word reaches
# ==============================================================================
#
# This is HIS word and nothing else — the `until` he gave, or the stage a parked
# item rests at. No rule raises it and no rule lowers it here: a `promote` and a
# `hold` are citations a gate's evaluator makes about ONE gate, and they are
# applied at that gate, in `resume`, where the citation is read. Sets LIM.
compute_limit() {
	_att=$(hdr "$brief" Attention)
	_stage=$(hdr "$brief" Stage)
	read_until "$(hdr "$brief" Until)"

	if [ "$_att" = parked ]; then
		LIM=$(rank "$_stage")
		LIM_REASON=parked
		return 0
	fi

	LIM=0
	[ -n "$UNTIL_STOP" ] && LIM=$(rank "$UNTIL_STOP")
	LIM_REASON='until ran out'
	return 0
}

# ==============================================================================
# the projection
# ==============================================================================

list_items() { # $1 active|parked
	if [ ! -d "$ITEMS" ]; then
		# Named from the pointer, so a practitioner with a records repository is sent to
		# the right place.
		printf 'no work items: %s does not exist.\n' "$ITEMS"
		printf 'A repository laid out before work-items/ is migrated once, with `remit migrate`.\n'
		return 0
	fi
	rows=$(
		for dir in "$ITEMS"/*/; do
			[ -d "$dir" ] || continue
			s=${dir%/}
			s=${s##*/}
			b="$dir"brief.md
			if [ ! -f "$b" ]; then
				printf '%s: work-items/%s has no brief.md — not listed.\n' "$ME" "$s" >&2
				continue
			fi
			at=$(hdr "$b" Attention)
			st=$(hdr "$b" Stage)
			[ "$st" = closed ] && continue
			if ! valid_stage "$st"; then
				printf '%s: work-items/%s has no readable **Stage:** line — not listed.\n' "$ME" "$s" >&2
				continue
			fi
			if ! valid_attention "$at"; then
				printf '%s: work-items/%s has no readable **Attention:** line — not listed.\n' "$ME" "$s" >&2
				continue
			fi
			# THE CLASS, computed once and read by filter, order and row alike — THE LIST
			# PROJECTION.
			mark=''
			cls=$at
			if [ -f "${dir}.working" ]; then
				if marker_alive "${dir}.working"; then
					mark=' [working]'
				else
					cls=crashed
					mark=" [$(crashed_note "${dir}.working")]"
					# The class column lost `parked`, so the row says it.
					[ "$at" = parked ] && mark="$mark [parked]"
				fi
			fi
			case "$1" in
			active) [ "$cls" = active ] || [ "$cls" = escalated ] || [ "$cls" = crashed ] || continue ;;
			parked) [ "$cls" = parked ] || continue ;;
			esac
			reason=$(last_reason "${dir%/}")
			[ -n "$reason" ] || reason='-'
			title=$(nocr "$b" | sed -n '/^# /{s/^# *//p;q;}')
			case "$cls" in crashed) k1=0 ;; escalated) k1=1 ;; *) k1=2 ;; esac
			k2=$((3 - $(rank "$st")))
			printf '%s%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$k1" "$k2" "$s" "$cls" "$st" "$reason" "$s" "$title$mark"
		done
	)
	if [ -z "$rows" ]; then
		printf 'no %s work items.\n' "$1"
		return 0
	fi
	printf '%s\n' "$rows" | LC_ALL=C sort | cut -f3-
}

# ==============================================================================
# the AI seam
# ==============================================================================

INVOKE=${REMIT_INVOKE:-}
[ -n "$INVOKE" ] || INVOKE="$root/bin/remit-invoke"

# Which file is this item's authority: the brief, or the phase it points at. The
# pointer is read by `phase_pointer`, once, for this and for the queue both.
authority_file() {
	_ptr=$(phase_pointer)
	if [ -z "$_ptr" ]; then
		printf '%s\n' "$brief"
		return 0
	fi
	if [ "$(printf '%s\n' "$_ptr" | wc -l | tr -d ' ')" != 1 ]; then
		printf 'AMBIGUOUS\n'
		return 0
	fi
	if [ -f "$item/$_ptr" ]; then
		printf '%s\n' "$item/$_ptr"
	else
		printf 'DANGLING %s\n' "$_ptr"
	fi
}

# ==============================================================================
# the authority, and its digest
# ==============================================================================
#
# The digest is of the PRACTITIONER'S WORDS ALONE: the script-owned header lines
# are cut out, so a stage this script wrote is not a change he made. `git
# hash-object`, because git is already required and answers the same on both
# shells; CRs stripped as every other read here does.
hash_of() { # $1 file -> a digest of its content, or empty when it is not there
	[ -f "$1" ] || return 0
	nocr "$1" | awk '!/^\*\*(Attention|Stage|Until|Migrated):\*\*/' |
		git -C "$root" hash-object --stdin
}

# AUTHORITY is the file, AUTHORITY_REL its name inside the item folder, and
# AUTHORITY_HASH its digest. A pointer this script cannot follow leaves the last
# two EMPTY and AUTHORITY holding the word the caller has to rule on: `resume`
# refuses on it, and the verbs that only record leave the pair off the entry
# rather than record a file they could not read.
resolve_authority() {
	AUTHORITY=$(authority_file)
	case "$AUTHORITY" in
	AMBIGUOUS | "DANGLING "*)
		AUTHORITY_REL=''
		AUTHORITY_HASH=''
		return 0
		;;
	esac
	AUTHORITY_REL=${AUTHORITY#"$item/"}
	AUTHORITY_HASH=$(hash_of "$AUTHORITY")
}

# The two lines that put the authority in hand onto an entry. Nothing is printed
# when there is no digest — an entry that named a file this script could not read
# would be a record of a hash nobody took.
authority_lines() {
	[ -n "$AUTHORITY_HASH" ] || return 0
	printf -- '- authority: %s\n' "$AUTHORITY_REL"
	printf -- '- authority hash: %s\n' "$AUTHORITY_HASH"
}

# The last pair the record carries. Read separately and each from the last line
# that carries it, because they are only ever written together.
last_authority() { # $1 item dir -> the file name, or empty
	[ -f "$1/log.md" ] || return 0
	nocr "$1/log.md" | sed -n 's/^- authority: *//p' | sed -n '$p'
}
last_authority_hash() { # $1 item dir -> the digest, or empty
	[ -f "$1/log.md" ] || return 0
	nocr "$1/log.md" | sed -n 's/^- authority hash: *//p' | sed -n '$p'
}

# ==============================================================================
# the marker: the lock, and everything `stop` needs to know
# ==============================================================================

# The machine the marker was written on. A pid means nothing without it: this
# script commits what it writes, so a marker can reach another machine, and a pid
# read there names whatever local process happens to hold that number.
this_host() { uname -n 2>/dev/null || printf 'an unnameable machine\n'; }

# `step:` and `raise:` are held here as well as written, because each is rewritten
# without the other being re-derived and a marker missing one of them would leave
# a `stop` guessing.
MARK_STEP=''
MARK_RAISE=''

# Seconds since the epoch, or empty where this host's `date` will not say. It is
# read through a digit filter rather than trusted, because a `date` that answers
# `%s` literally would otherwise be arithmetic in a later subtraction.
now_secs() { date +%s 2>/dev/null | sed -n 's/^\([0-9][0-9]*\)$/\1/p' | sed -n 1p; }

marker_write() { # $1 the step the chain is at
	MARK_STEP=$1
	{
		printf 'pid: %s\n' "$$"
		printf 'host: %s\n' "$(this_host)"
		printf 'authority: %s\n' "$AUTHORITY_REL"
		printf 'hash: %s\n' "$AUTHORITY_HASH"
		printf 'step: %s\n' "$MARK_STEP"
		printf 'raise: %s\n' "$MARK_RAISE"
		printf 'at: %s\n' "$(now_secs)"
	} >"$marker"
}

# One reader for every marker, this item's or another item's. `list` asks about
# markers it does not own, so the file is a parameter and `marker_field` is the
# same question asked about this run's own.
marker_read() { # $1 marker file  $2 key -> the value, or empty
	[ -f "$1" ] || return 0
	nocr "$1" | sed -n "s/^$2: *//p" | sed -n 1p
}

marker_field() { # $1 key -> the value, or empty
	marker_read "$marker" "$1"
}

# Rewrites the step and nothing else, so that a `stop` can name what it ended.
mark_step() { # $1 the step
	[ -f "$marker" ] || return 0
	marker_write "$1"
	# Said as well as marked, so a capture of a resume can be followed without the
	# marker.
	say "step: $1"
}

# The pid of the raise IN FLIGHT, empty between raises. It is on the marker and
# not merely in this process because the practitioner's `stop` runs in another
# one, and a chain is inside a raise for almost all of the time it is running.
mark_raise() { # $1 the pid, or empty
	MARK_RAISE=${1:-}
	[ -f "$marker" ] || return 0
	marker_write "$MARK_STEP"
}

marker_is_ours() { # 0 while this process still holds the lock
	[ -f "$marker" ] || return 1
	[ "$(marker_field pid)" = "$$" ] || return 1
	return 0
}

# Puts the lock down ONLY when it is still this process's: a `stop` may have
# ended this chain and a second resume may already hold the marker.
marker_release() {
	marker_is_ours && rm -f "$marker"
	return 0
}

# ==============================================================================
# the crashed class
# ==============================================================================
#
# `stop` disposes its own marker before it signals anything, and no other verb
# leaves one behind — THE ROAD BACK IN in this script's header. So a marker
# whose chain is not running means ONE thing: THE CHAIN CRASHED.
#
# LIVE IS THE NARROW ANSWER: written on this machine, and a pid that still
# answers. A marker that arrived in a commit names a process on another machine
# and is treated as the crash it looks like from here. Pid reuse on this machine
# is something this script cannot see.
marker_alive() { # $1 marker file -> 0 the chain it names is running on this host
	_mh=$(marker_read "$1" host)
	[ -z "$_mh" ] || [ "$_mh" = "$(this_host)" ] || return 1
	_mp=$(marker_read "$1" pid)
	case "$_mp" in '' | *[!0-9]*) return 1 ;; esac
	kill -0 "$_mp" 2>/dev/null || return 1
	return 0
}

# How long since the chain last wrote its marker, in the coarsest unit that is
# still true, or an absence where this host will not answer.
stale_note() { # $1 the marker's `at` value -> a phrase
	case "$1" in '' | *[!0-9]*)
		printf 'the marker does not say when it was last written'
		return 0
		;;
	esac
	_nw=$(now_secs)
	if [ -z "$_nw" ]; then
		printf 'last written at %s, and this host will not say how long ago' "$1"
		return 0
	fi
	_ag=$((_nw - $1))
	[ "$_ag" -lt 0 ] && _ag=0
	if [ "$_ag" -lt 60 ]; then
		printf 'last wrote %ss ago' "$_ag"
	elif [ "$_ag" -lt 3600 ]; then
		printf 'last wrote %sm ago' $((_ag / 60))
	elif [ "$_ag" -lt 86400 ]; then
		printf 'last wrote %sh ago' $((_ag / 3600))
	else
		printf 'last wrote %sd ago' $((_ag / 86400))
	fi
}

# What the marker knows, in one sentence — the step, the dead pid, how stale —
# printed by every place that says it.
crashed_note() { # $1 marker file
	_cs=$(marker_read "$1" step)
	[ -n "$_cs" ] || _cs='a step it did not record'
	_cp=$(marker_read "$1" pid)
	case "$_cp" in *[!0-9]*) _cp='' ;; esac
	_ch=$(marker_read "$1" host)
	if [ -n "$_ch" ] && [ "$_ch" != "$(this_host)" ]; then
		_cw="its marker was written on $_ch, not on this machine ($(this_host)), so no chain of this one's is running for it"
	elif [ -n "$_cp" ]; then
		_cw="pid $_cp is gone"
	else
		_cw='its marker names no pid this machine can ask about'
	fi
	printf 'crashed at %s — %s — %s' "$_cs" "$_cw" "$(stale_note "$(marker_read "$1" at)")"
}

# THE ONE implementation of THE ROAD BACK IN for a crashed marker, so `park`,
# `close` and `resume` cannot answer three ways: a chain genuinely running here
# refuses the caller; a crashed marker is read, wiped, and handed back as
# CRASH_NOTE for the caller to say in its own words (empty with no marker).
#
# IT IS CALLED LAST AMONG A VERB'S PRECONDITIONS, because it WRITES: a verb wipes
# the marker AS PART OF DOING ITS OWN JOB, and one that wiped it and then refused
# would take the crash off his board while doing nothing. Every check that can
# refuse runs BEFORE this; the one refusal here wipes nothing.
CRASH_NOTE=''
crash_take() { # 0 nothing is running here; 1 a chain is
	CRASH_NOTE=''
	[ -f "$marker" ] || return 0
	marker_alive "$marker" && return 1
	CRASH_NOTE=$(crashed_note "$marker")
	rm -f "$marker"
	return 0
}

# ==============================================================================
# ending what a chain raised
# ==============================================================================
#
# A raise is a PROCESS, and his word that a chain is over has to reach it, or it
# goes on writing into the worktree `stop` is about to discard.
#
# `ps -ef` finds it: both required shells answer it, and its second and third
# columns are a pid and its parent. NOTHING IS MATCHED ON A COMMAND LINE.
#
# WHAT THIS CANNOT REACH: on Windows a harness CLI is a native executable that
# `ps -ef` under Git Bash does not list, so there this ends the seam and every
# shell beneath it, and ending the CLI is `bin/remit-invoke`'s.

# The pids to end and the order to end them in: everything under $1 deepest
# first, then $1 itself. THIS PROCESS AND EVERY PROCESS IT IS RUNNING UNDER ARE
# LEFT OUT — `remit stop` can be run from inside a raise, and a walk that ended
# its own caller would take the record it was about to write with it.
raise_tree() { # $1 pid -> the pids to end, in the order to end them
	case "${1:-}" in '' | *[!0-9]*) return 0 ;; esac
	ps -ef 2>/dev/null | awk -v top="$1" -v self="$$" '
		NR > 1 && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $2 != $3 {
			par[$2] = $3
			kid[$3] = kid[$3] " " $2
		}
		END {
			p = self
			while (p != "" && !(p in mine)) { mine[p] = 1; p = par[p] }
			q[1] = top; seen[top] = 1; head = 1; tail = 1; out = 0
			while (head <= tail) {
				n = split(kid[q[head++]], c, " ")
				for (i = 1; i <= n; i++) {
					if (c[i] != "" && !(c[i] in seen)) {
						seen[c[i]] = 1
						q[++tail] = c[i]
						if (!(c[i] in mine)) res[++out] = c[i]
					}
				}
			}
			for (i = out; i >= 1; i--) print res[i]
			if (!(top in mine)) print top
		}
	'
}

# TERM the tree deepest first, so no shell is signalled before the thing it is
# waiting on, then KILL whatever is still there a second later. Returns a sentence
# naming what it did, for the practitioner to read on the record.
end_raised() { # $1 the pid the marker names as the raise in flight
	_top=${1:-}
	case "$_top" in '' | *[!0-9]*)
		printf 'no raise was in flight, so no raised process was signalled\n'
		return 0
		;;
	esac
	# The pid is asked whether it is there at all before anything is signalled: a
	# reused number would be somebody else's process.
	if ! kill -0 "$_top" 2>/dev/null; then
		printf 'the raise the marker names (pid %s) was no longer running, so nothing was signalled\n' "$_top"
		return 0
	fi
	_tree=$(raise_tree "$_top")
	if [ -z "$_tree" ]; then
		printf 'nothing this shell can see was still running under the raise at pid %s\n' "$_top"
		return 0
	fi
	for _p in $_tree; do kill -TERM "$_p" 2>/dev/null; done
	sleep 1
	for _p in $_tree; do kill -0 "$_p" 2>/dev/null && kill -KILL "$_p" 2>/dev/null; done
	printf 'the raise at pid %s was ended, and the %s process(es) in its tree with it\n' \
		"$_top" "$(printf '%s\n' "$_tree" | grep -c '')"
	return 0
}

# ==============================================================================
# the phase queue
# ==============================================================================
#
# A queued phase is a FILE and nothing else: `phase-<n>.md` in the item folder at
# a number above the one the pointer names — no line in the brief, which is what
# lets one be written while the brief is locked. The `## Phases` section is his
# PROSE; the reader takes the POINTER out of it and nothing else, the FILES decide
# the queue, and the writer APPENDS to his section.

# Every `**Current phase:**` pointer, read only as far as the file name; a
# pointer that names no file is not returned as one.
phase_pointer() {
	nocr "$brief" |
		sed -n 's/.*\*\*Current phase:\*\* *[^A-Za-z0-9_.-]*\([A-Za-z0-9_.-]*\.md\).*/\1/p'
}

# The lowest-numbered phase file the pointer has NOT reached, or empty. Decided
# by NUMBER against the pointer's number, in NUMERIC order (`phase-10.md` after
# `phase-2.md`). A pointer at a file with no number, or no pointer at all, is
# BEFORE every number.
queued_phase() {
	_here=$(phase_pointer | sed -n 1p)
	_here=${_here#phase-}
	_here=${_here%.md}
	case "$_here" in '' | *[!0-9]*) _here=0 ;; esac
	_best=''
	_bestn=''
	for _f in "$item"/phase-*.md; do
		[ -f "$_f" ] || continue
		_b=${_f##*/}
		_n=${_b#phase-}
		_n=${_n%.md}
		case "$_n" in '' | *[!0-9]*) continue ;; esac
		[ "$_n" -gt "$_here" ] || continue
		if [ -z "$_bestn" ] || [ "$_n" -lt "$_bestn" ]; then
			_bestn=$_n
			_best=$_b
		fi
	done
	printf '%s\n' "$_best"
}

# Names the phase in the brief's `## Phases` section and moves the pointer to it.
# THIS IS THE ONLY THING THIS SCRIPT WRITES INSIDE A BRIEF'S BODY. His words are
# carried through untouched and in place: one line is appended naming the phase,
# the pointer goes at the end, and the only thing taken out is the pointer being
# replaced — the whole line where it stood alone, the pointer only where it
# ended a sentence of his. A brief with no such section gets one, at the end.
phase_adopt() { # $1 the phase file name
	_new=$1
	: >"$WORK/ph.pre"
	: >"$WORK/ph.sec"
	: >"$WORK/ph.post"
	nocr "$brief" |
		awk -v pre="$WORK/ph.pre" -v sec="$WORK/ph.sec" -v post="$WORK/ph.post" '
			BEGIN { where = "pre" }
			/^## / {
				if (where == "pre" && $0 == "## Phases") { where = "sec"; next }
				if (where == "sec") { where = "post" }
			}
			{
				if (where == "pre") print > pre
				else if (where == "sec") print > sec
				else print > post
			}
		'
	sed 's/[[:space:]]*\*\*Current phase:\*\* *[^A-Za-z0-9_.-]*[A-Za-z0-9_.-]*\.md.*$//' \
		"$WORK/ph.sec" | trimblank >"$WORK/ph.body"
	trimblank <"$WORK/ph.pre" >"$WORK/ph.head"
	{
		if [ -s "$WORK/ph.head" ]; then
			cat "$WORK/ph.head"
			printf '\n'
		fi
		printf '## Phases\n\n'
		if [ -s "$WORK/ph.body" ]; then
			cat "$WORK/ph.body"
			printf '\n'
		fi
		printf -- '`%s` — adopted at the `accepted` stop, %s.\n\n' "$_new" "$(now)"
		printf '**Current phase:** %s\n' "$_new"
		if [ -s "$WORK/ph.post" ]; then
			printf '\n'
			cat "$WORK/ph.post"
		fi
	} >"$brief.tmp"
	mv "$brief.tmp" "$brief"
}

# Blank lines off both ends, and a run in the middle down to one.
trimblank() {
	awk '
		{ line[++n] = $0 }
		END {
			s = 1
			while (s <= n && line[s] ~ /^[ \t]*$/) s++
			while (n >= s && line[n] ~ /^[ \t]*$/) n--
			for (i = s; i <= n; i++) {
				if (line[i] ~ /^[ \t]*$/) { gap = 1; continue }
				if (gap) print ""
				gap = 0
				print line[i]
			}
		}
	'
}

# EVERY pull request a record's `## delivery —` entries name, in order, one per
# line — the ONE reader of that shape; four moves ask it. An entry naming a
# commit prints nothing.
delivery_pr_urls() { # $1 a record file
	[ -f "$1" ] || return 0
	nocr "$1" | sed -n 's|^## delivery — \(https://[^ ]*\) — .*|\1|p'
}
delivery_count() { # $1 a record file -> how many deliveries it records at all
	[ -f "$1" ] || { printf '0\n'; return 0; }
	nocr "$1" | awk 'index($0, "## delivery — ") == 1 { n++ } END { print n + 0 }'
}

# The pull request this item's record names — the LAST delivery entry's.
recorded_pr_url() {
	delivery_pr_urls "$log" | sed -n '$p'
}
recorded_pr() {
	recorded_pr_url | sed -n 's|.*/\([0-9][0-9]*\)$|\1|p'
}

# The COMMIT the last recorded delivery names, off the entry's own first line
# (``Commit `<sha>` on `work/<slug>` ``): THE RECORD IS THE AUTHORITY on what was
# delivered. Empty where it names none.
recorded_delivery() {
	[ -f "$log" ] || return 0
	nocr "$log" | sed -n 's|^Commit `\([0-9a-fA-F][0-9a-fA-F]*\)` on `work/.*|\1|p' | sed -n '$p'
}

# The same pair, taken into the two variables the moves use, and ONLY where this
# run did not open one itself: a run that delivered knows its own.
pr_from_record() {
	[ -n "$PR_NUM" ] && return 0
	PR_URL=$(recorded_pr_url)
	PR_NUM=$(recorded_pr)
	[ -n "$PR_NUM" ] || PR_URL=''
	return 0
}

# ==============================================================================
# where the chain stopped — the road back in
# ==============================================================================
#
# THE RESUME POINT: a chain that stopped resumes at the step it stopped at and
# never earlier, decided by THE RECORD — the last entry that is a `delivery` or a
# `verdict`:
#
#   the last of the two is a VERDICT   that round was judged; the next round
#                                      authors.
#   the last of the two is a DELIVERY  a tree is on the branch unjudged; that
#                                      round is EVALUATED, not rebuilt.
#
# The ROUND continues from the last verdict AT THIS GATE; a verdict at another
# gate leaves this one at 1. Nothing here reads the marker.
#
# GATE 1 IS NOT IN THIS: its rounds belong to the run that ran them, and a resume
# judges the `research.md` the record carries at its own first round.
#
# WHAT IT CANNOT SEE: a chain that died between committing a delivery and
# recording it leaves a commit the record does not name, read as a round still to
# be built. A CONTINUED BUILD ROUND IS HANDED NO MUST-FIX: the previous round's
# went with the ended run's scratch.
#
# Set by `resume`, consumed by the first `run_gate` whose gate matches, then
# cleared so no later gate in the run reads it.
AT_GATE=''
AT_ROUND=1
AT_AWAITING=no

resume_point() { # $1 the gate the item's stage will run
	AT_GATE=''
	AT_ROUND=1
	AT_AWAITING=no
	case "$1" in accepted | closed) ;; *) return 0 ;; esac
	[ -f "$log" ] || return 0
	# kind, then the gate the last verdict was into, then its round.
	_rp=$(nocr "$log" | awk '
		index($0, "## delivery — ") == 1 { kind = "delivery"; next }
		index($0, "## verdict — evaluate — into ") == 1 {
			kind = "verdict"
			split($0, f, " — ")
			vgate = f[3]
			sub(/^into /, "", vgate)
			vround = ""
			next
		}
		kind == "verdict" && vround == "" && index($0, "- round: ") == 1 {
			vround = substr($0, 10)
		}
		END { print kind; print vgate; print vround }
	')
	_rkind=$(printf '%s\n' "$_rp" | sed -n 1p)
	_rgate=$(printf '%s\n' "$_rp" | sed -n 2p)
	_rround=$(printf '%s\n' "$_rp" | sed -n 3p)
	[ -n "$_rkind" ] || return 0
	AT_GATE=$1
	case "$_rround" in '' | *[!0-9]*) _rround=0 ;; esac
	# ONE arithmetic, both kinds. A verdict at this gate for round N means the
	# next round is N+1; a delivery standing after that verdict IS round N+1,
	# waiting to be judged. A last verdict at another gate — or none at all —
	# leaves this gate at its first round either way.
	[ "$_rgate" = "$1" ] && [ "$_rround" -gt 0 ] && AT_ROUND=$((_rround + 1))
	[ "$_rkind" = delivery ] && AT_AWAITING=yes
	return 0
}

# What the resume point amounts to, for the practitioner to read. Composed here
# so the line he sees and the line the record carries are the same line.
resume_point_note() {
	[ -n "$AT_GATE" ] || return 0
	if [ "$AT_AWAITING" = yes ]; then
		printf 'a delivery is on the branch with no verdict on it, so round %s at the gate into %s is EVALUATED, not rebuilt' \
			"$AT_ROUND" "$AT_GATE"
		return 0
	fi
	[ "$AT_ROUND" -gt 1 ] || return 0
	printf 'the record'"'"'s last verdict at the gate into %s was round %s, so this run continues at round %s' \
		"$AT_GATE" "$((AT_ROUND - 1))" "$AT_ROUND"
	return 0
}

# An item that leaves `accepted` for `new` has a delivery that is no longer at the
# stop it was accepted at, so its pull request goes back to draft. It is BEST
# EFFORT and says which: the practitioner's word is what moved the stage, and a
# `gh` that is absent or refuses does not get to hold that up. What could not be
# done is named on the record rather than passed over. Sets PR_DRAFT_NOTE.
PR_DRAFT_NOTE=''
pr_to_draft() {
	PR_DRAFT_NOTE=''
	_pn=$(recorded_pr)
	if [ -z "$_pn" ]; then
		PR_DRAFT_NOTE='no pull request is recorded for this item, so there was none to put back to draft'
		return 0
	fi
	if ! command -v gh >/dev/null 2>&1; then
		PR_DRAFT_NOTE="\`gh\` is not on this PATH, so pull request #$_pn was NOT put back to draft"
		return 0
	fi
	if out=$(cd "$root" && gh pr ready "$_pn" --undo 2>&1); then
		PR_DRAFT_NOTE="pull request #$_pn is back to draft"
		return 0
	fi
	PR_DRAFT_NOTE="pull request #$_pn could NOT be put back to draft: $(printf '%s' "$out" | tr '\n' ' ')"
	return 0
}

# ==============================================================================
# the lock, checked
# ==============================================================================
#
# Asked before every raise and before every commit a running chain makes. Either
# he ENDED this chain — `stop` took the marker and recorded it, so this exits and
# records nothing — or he CHANGED THE AUTHORITY under it, which returns 1 and the
# caller escalates at the stage it could not leave.

# The one way a chain leaves when the lock has been taken from it; two accounts
# of one stop is one too many.
chain_ended() {
	say ""
	say "ended: the marker this resume held is gone. \`$ME stop\` records what it ended; nothing further is recorded here."
	exit 130
}

chain_intact() { # 0 carry on; 1 the authority changed
	marker_is_ours || chain_ended
	[ "$(hash_of "$AUTHORITY")" = "$AUTHORITY_HASH" ] && return 0
	return 1
}

# One raise, named, for the record — the fields and what they are for are in this
# script's header, under `log.md — THE ENTRY SHAPES`. It is queued rather than
# written, because the entry that will carry it has not been composed yet;
# `log_append` empties the queue into the next entry it writes.
raise_line() { # $1 role  $2 the epoch second it started  $3 the second it came back
	_rl_h=$(prov harness)
	[ -n "$_rl_h" ] || _rl_h='an unreported harness'
	if [ -z "$2" ] || [ -z "$3" ]; then
		printf -- '- raise: %s — %s — not timed: this host does not answer `date +%%s` with whole seconds\n' \
			"$1" "$_rl_h" >>"$RAISES"
	elif [ "$3" -lt "$2" ]; then
		printf -- '- raise: %s — %s — not timed: the clock moved backwards while it ran\n' \
			"$1" "$_rl_h" >>"$RAISES"
	else
		printf -- '- raise: %s — %s — %ss\n' "$1" "$_rl_h" "$(($3 - $2))" >>"$RAISES"
	fi
	# THEN THE SIDECAR, indented under the line: every key the seam reported and no
	# line for one it did not. `model` is the AUTHOR; `models` is everything the run
	# billed; `consulted` is the run's own count, evidence and never a verdict;
	# `containment` is what actually held the raise. What the keys mean is
	# `bin/remit-invoke`'s header.
	for _rl_k in model models consulted session run-log boundary containment permission-mode sandbox scrub effort cost; do
		_rl_v=$(prov "$_rl_k")
		[ -n "$_rl_v" ] || continue
		printf -- '  - %s: %s\n' "$_rl_k" "$_rl_v" >>"$RAISES"
	done
	return 0
}

# THE RUN'S OWN LOG, written into the home the raise was given so `runs_harvest`
# carries it and the sweep at close keys it like any run. The seam's run
# directory is temporary and nothing here owns it; this copy is the record's.
# BEST EFFORT: returns 0 whatever happens. THE NAME follows `runs_naming`, with
# the HARNESS in the `<shell>` field and the round in the suite field.
raise_log_keep() { # $1 role  $2 the working tree the raise ran in
	_klh=$(prov harness)
	[ -n "$_klh" ] || _klh=unreported
	# No `.` may appear in any of the three fields, or the sweep cannot key it.
	_klh=$(printf '%s' "$_klh" | tr -c 'A-Za-z0-9-' '-')
	_klstamp=$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null) || _klstamp=''
	[ -n "$_klstamp" ] || return 0
	_kldir=$(runs_home "$2")
	runs_open_at "$_kldir" || return 0
	_klf="$_kldir/raise-$1-round$ROUND.$_klh.$_klstamp.log"
	_klr=$(prov run-log)
	{
		printf 'raise: %s — round %s — item %s — %s\n\n' "$1" "$ROUND" "$slug" "$(now)"
		printf '## provenance, as the seam reported it\n\n'
		if [ -s "$WORK/prov" ]; then nocr "$WORK/prov"; else printf '(the seam reported none)\n'; fi
		printf '\n## the seam'"'"'s own narration — its stderr\n\n'
		if [ -s "$WORK/invoke.err" ]; then nocr "$WORK/invoke.err" | sed -n '1,2000p'; else printf '(none)\n'; fi
		printf '\n## the run directory — %s\n\n' "${_klr:-<the seam reported none>}"
		if [ -n "$_klr" ] && [ -d "$_klr" ]; then
			for _klx in stderr progress final-message; do
				[ -f "$_klr/$_klx" ] || continue
				printf '### %s\n\n' "$_klx"
				nocr "$_klr/$_klx" | sed -n '1,2000p'
				printf '\n'
			done
		else
			printf 'It is not readable from here, so what it held is not in this file.\n'
		fi
	} >"$_klf" 2>/dev/null || return 0
	return 0
}

# Runs the seam. Its stdout lands in $2 and its provenance in $WORK/prov.
invoke() { # $1 role  $2 output file  $3 worktree  [$4 must-fix file]
	_role=$1 _out=$2 _wt=$3
	_mf=${4:-}
	: >"$WORK/prov"
	# The gate's own file, WHOLE, to the gate's own evaluator, and to nobody else.
	_rub=''
	if [ "$_role" = evaluate ] && [ -n "$GATE" ] && [ -f "$(gate_file "$GATE")" ]; then
		_rub=$(gate_file "$GATE")
	fi
	# And the `fix` section of the gate the work is HEADING INTO — the bar, and
	# nothing else from that file — to the roles that author. Derived here into
	# this script's own scratch: the gate file itself never leaves for them.
	_std=''
	if [ -n "$STANDARDS_GATE" ]; then
		case "$_role" in
		build | research)
			if [ -n "$(gate_fix_section "$STANDARDS_GATE")" ]; then
				{
					printf '# The standards this work is held to\n\n'
					printf 'The `## fix` section of `.remit/rules/%s.md`, verbatim: the practitioner'"'"'s own\n' "$STANDARDS_GATE"
					printf 'bar for the gate this work is heading into. What falls short of one of these is\n'
					printf 'a must-fix and comes back to a fresh author. Nothing else from that file is\n'
					printf 'here, and nothing here is a rubric for you to cite — citing is the evaluator'"'"'s.\n\n'
					printf '## fix\n\n'
					gate_fix_section "$STANDARDS_GATE"
				} >"$WORK/standards.md"
				_std="$WORK/standards.md"
			fi
			;;
		esac
	fi
	# THE RAISE RUNS IN THE BACKGROUND and this waits on it: a shell blocked on a
	# foreground command does not act on a trapped signal, `wait` is interrupted by
	# one, and `stop` needs a pid. stdin is `/dev/null` said out loud. THE
	# KEPT-OUTPUT HOME is opened before the raise; one that cannot be opened is SAID
	# and the raise still runs, told it has nowhere to keep output.
	_runs=''
	if runs_open "$_wt"; then
		_runs=$(runs_home "$_wt")
		# A ROLE THAT JUDGES is shown ALL that was kept, somewhere it can open —
		# `runs_seed` and `item_seed`.
		if [ "$_role" = evaluate ]; then
			runs_seed "$_wt"
			item_seed "$_wt"
		fi
	else
		printf '%s: could not open the kept-output home at %s — this raise is told it has nowhere to keep what it runs.\n' \
			"$ME" "$(runs_home "$_wt")" >&2
	fi
	# The clock is read immediately before and after the raise: the wall clock he
	# waited through.
	_t0=$(secs)
	REMIT_ITEM="$item" \
		REMIT_RUNS="$_runs" \
		REMIT_RUNS_NAMING="$(runs_naming)" \
		REMIT_AUTHORITY="$AUTHORITY" \
		REMIT_RUBRICS="$_rub" \
		REMIT_STANDARDS="$_std" \
		REMIT_SETTINGS="$SETTINGSFILE" \
		REMIT_PROVENANCE="$WORK/prov" \
		REMIT_ROUND="$ROUND" \
		REMIT_DELIVERY="${EVAL_DELIVERY:-}" \
		REMIT_RESEARCH_AUTHOR="${RESEARCH_AUTHOR:-}" \
		REMIT_MUSTFIX="$_mf" \
		sh "$INVOKE" "$_role" "$slug" "$_wt" >"$_out" 2>"$WORK/invoke.err" </dev/null &
	RAISE_PID=$!
	mark_raise "$RAISE_PID"
	wait "$RAISE_PID"
	_irc=$?
	_t1=$(secs)
	RAISE_PID=''
	# WHAT THE RAISE KEPT COMES HOME FIRST, before the kill check below, which does
	# not return; the raise's own log is written into that home first so one harvest
	# carries it — for EVERY raise, including one the seam refused.
	raise_log_keep "$_role" "$_wt"
	runs_harvest "$_wt"
	# AND THE SEEDED ARTEFACTS COME BACK OUT here, the last point every road out of a
	# raise passes through: nothing seeded is on disk when the next `git add -A`
	# runs.
	item_unseed "$_wt"
	# A raise ENDED by his `stop` is not a raise that FAILED: `stop` removes the
	# marker BEFORE it signals, so this tells them apart without a signal number.
	marker_is_ours || chain_ended
	mark_raise ''
	# It ran to completion: past the kill check above, and the seam exited zero.
	# That is the whole of what earns a `- raise:` line, and a refusal earns none.
	[ "$_irc" = 0 ] && raise_line "$_role" "$_t0" "$_t1"
	# Exit 8 is the seam's idle bound — a silent CLI it ended — recorded as
	# `stalled: <what the seam said>`; every other non-zero exit is `cannot act:
	# remit-invoke`.
	INVOKE_STOP=''
	if [ "$_irc" = 8 ]; then
		INVOKE_STOP=$(prov note | sed 's/\..*//')
		case "$INVOKE_STOP" in
		stalled*) ;;
		*) INVOKE_STOP="stalled: the seam's idle bound ended a silent CLI" ;;
		esac
	fi
	if [ "$_irc" != 0 ]; then
		printf '%s: the seam refused `%s` (exit %s):\n' "$ME" "$_role" "$_irc" >&2
		sed 's/^/    /' "$WORK/invoke.err" >&2
	fi
	return $_irc
}

prov() { # $1 key -> value, or empty
	[ -f "$WORK/prov" ] || return 0
	nocr "$WORK/prov" | sed -n "s/^$1: *//p" | sed -n 1p
}

# ==============================================================================
# escalation
# ==============================================================================

print_row() {
	_at=$(hdr "$brief" Attention)
	_st=$(hdr "$brief" Stage)
	_re=$(last_reason "$item")
	[ -n "$_re" ] || _re='-'
	_ti=$(nocr "$brief" | sed -n '/^# /{s/^# *//p;q;}')
	printf '%s\t%s\t%s\t%s\t%s\n' "$_at" "$_st" "$_re" "$slug" "$_ti"
}

# THE SAME STOP, AGAIN, said rather than left to be counted: the trailing run of
# `## escalated` entries on this reason, derived from `log.md`. A different
# reason ends the run; entries of other kinds between them do not. It changes
# nothing else — not the loop, the cap, or the reason line.
escalation_run() { # $1 the reason -> how many consecutive escalations it makes, >= 1
	_n=1
	[ -f "$log" ] || { printf '%s\n' "$_n"; return 0; }
	_n=$(nocr "$log" |
		sed -n 's/^## escalated — \(.*\) — [0-9-]*$/\1/p' |
		awk -v r="$1" '
			{ seen[++c] = $0 }
			END {
				n = 1
				for (i = c; i >= 1 && seen[i] == r; i--) n++
				print n
			}
		')
	case "$_n" in '' | *[!0-9]*) _n=1 ;; esac
	printf '%s\n' "$_n"
}

# In words, because "4" in a sentence about a fourth time reads as a quantity of
# something else. Past what is worth spelling, the numeral with its own suffix.
ordinal() { # $1 a whole number >= 1
	case "$1" in
	1) printf 'first\n' ;;
	2) printf 'second\n' ;;
	3) printf 'third\n' ;;
	4) printf 'fourth\n' ;;
	5) printf 'fifth\n' ;;
	6) printf 'sixth\n' ;;
	7) printf 'seventh\n' ;;
	8) printf 'eighth\n' ;;
	9) printf 'ninth\n' ;;
	10) printf 'tenth\n' ;;
	*11 | *12 | *13) printf '%sth\n' "$1" ;;
	*1) printf '%sst\n' "$1" ;;
	*2) printf '%snd\n' "$1" ;;
	*3) printf '%srd\n' "$1" ;;
	*) printf '%sth\n' "$1" ;;
	esac
}

escalate() { # $1 reason
	_reason=$1
	# Counted BEFORE this escalation is appended, so the run it counts is the one
	# already on the record and this entry is the one being added to it.
	_runlen=$(escalation_run "$_reason")
	_repeat=''
	[ "$_runlen" -gt 1 ] &&
		_repeat="this is the $(ordinal "$_runlen") consecutive escalation on this reason"
	# NOTHING IS RAISED HERE. The verdicts above this entry ARE the analysis; what
	# the brief needs is his, from the record, and the entry carries the reason, the
	# round, whether this road has been walked before, and the authority the run
	# raised from.
	{
		printf 'The chain stopped and could not move this item further.\n\n'
		printf -- '- reason: %s\n' "$_reason"
		[ -n "$_repeat" ] &&
			printf -- '- repeating: %s.\n' "$_repeat"
		[ -n "$LOOP_STOP_DETAIL" ] &&
			printf -- '- the loop stopped: %s\n' "$LOOP_STOP_DETAIL"
		[ -n "$GATE" ] &&
			printf -- '- gate: into %s\n' "$GATE"
		printf -- '- stage: %s (UNCHANGED — an escalation holds the stop it could not leave)\n' "$(hdr "$brief" Stage)"
		# THE ROUND IT REACHED, not a count of rounds this run made: a run that
		# continued from the record began above 1, and the two are only the same
		# number when it began at the beginning.
		printf -- '- round reached: %s\n' "$ROUND"
		# The authority THIS RUN RAISED FROM, not whatever is on disk now. An
		# escalation is where a changed authority lands, and recording the one
		# that changed would be this script agreeing to it.
		authority_lines
		printf '\n'
		printf 'The brief is untouched, and what it needs is the practitioner'\''s: the verdicts\n'
		printf 'above are the record he rules from.\n'
	} | log_append "escalated — $_reason — $(now)"
	put_header "$brief" escalated "$(hdr "$brief" Stage)" "$(hdr "$brief" Until)" KEEP
	commit_step "remit: $slug escalated — $_reason" ".remit/work-items/$slug"
	marker_release
	say ""
	if [ -n "$_repeat" ]; then
		say "ESCALATED — $_reason — $_repeat"
	else
		say "ESCALATED — $_reason"
	fi
	print_row
	[ "$PUSH_FAILED" = yes ] && exit 3
	exit 4
}

# ==============================================================================
# the delivery seam — the one place a builder's tree becomes a pull request
# ==============================================================================

# The composed body, moved OUT of this run's scratch so that the remedy a failure
# prints names a file that is still there after the run exits. A remedy pointing
# at a path the exit trap has just removed is not a remedy.
# It sets KEPT_BODY and KEPT_NOTE rather than printing, because a `$(...)` around
# it would set them in a subshell and the caller would name a path it never got.
KEPT_BODY=''
KEPT_NOTE=''
keep_pr_body() {
	KEPT_BODY="${TMPDIR:-/tmp}/remit-$slug-pr-body-$SHA.md"
	if cp "$WORK/pr-body" "$KEPT_BODY" 2>/dev/null; then
		KEPT_NOTE="The body it should carry — this delivery on top, every earlier one kept beneath — is composed at $KEPT_BODY: apply it with: gh pr edit $PR_NUM --body-file $KEPT_BODY — or, where gh pr edit fails on this host, with: gh api -X PATCH repos/{owner}/{repo}/pulls/$PR_NUM -F body=@$KEPT_BODY"
	else
		KEPT_BODY=''
		KEPT_NOTE="The body it should carry was composed and could NOT be kept anywhere a later command could read it, so there is no file to point you at"
	fi
}

# Returns 0 delivered and the pull request carries it; 1 NOT delivered, DELIVER_ERR
# says why and nothing is on the branch that the record should name; 2 delivered,
# no `gh` on this host; 3 DELIVERED — committed and pushed — and the pull request
# step failed, DELIVER_ERR saying how. The caller records 2 and 3 as deliveries.
deliver() { # $1 worktree  $2 file holding the builder's returned text
	_wt=$1 _final=$2
	_branch="work/$slug"

	git -C "$_wt" add -A || { DELIVER_ERR="could not stage the authored tree"; return 1; }
	if git -C "$_wt" diff --cached --quiet; then
		DELIVER_ERR="the build changed nothing — an empty stage is not a delivery"
		return 1
	fi
	# THE DELIVERY'S SIZE IS READ BEFORE IT IS COMMITTED: files added and bytes
	# staged, counted from the index and recorded on the delivery entry. Past
	# REMIT_DELIVERY_FILES (2000) or REMIT_DELIVERY_MB (100) the delivery stops as
	# `cannot act` with both numbers, before a commit exists.
	DELIVERY_FILES=$(git -C "$_wt" diff --cached --name-only --diff-filter=A | wc -l | tr -d ' ')
	DELIVERY_BYTES=$(git -C "$_wt" diff --cached --name-only --diff-filter=AM -z | (cd "$_wt" && xargs -0 wc -c 2>/dev/null) | awk 'END { print ($1 + 0) }')
	DELIVERY_MB=$(( (DELIVERY_BYTES + 524288) / 1048576 ))
	_dfc=${REMIT_DELIVERY_FILES:-2000}
	_dmc=${REMIT_DELIVERY_MB:-100}
	if [ "$DELIVERY_FILES" -gt "$_dfc" ] || [ "$DELIVERY_MB" -gt "$_dmc" ]; then
		git -C "$_wt" reset -q 2>/dev/null
		DELIVER_ERR="delivery too large: $DELIVERY_FILES files added, $DELIVERY_MB MB staged — past the ceiling of $_dfc files / $_dmc MB (REMIT_DELIVERY_FILES / REMIT_DELIVERY_MB). Nothing was committed; the tree is as the builder left it at $_wt, for a reader to see what grew"
		return 1
	fi

	_model=$(prov model)
	_session=$(prov session)
	_harness=$(prov harness)
	{
		printf '%s: delivery from the build role\n\n' "$slug"
		printf 'Tree authored by %s in %s; git mechanics performed by %s from the\n' \
			"${_model:-a model the invoke did not name}" \
			"${_harness:-a harness the invoke did not name}" "$ME"
		printf 'resuming session. The builder did not run git.\n\n'
		[ -n "$_model" ] || printf 'No authoring model was reported by the invoke — absent, never invented.\n'
		[ -n "$_session" ] || printf 'No session was reported by the invoke — absent, never invented.\n'
		[ -n "$_model" ] && printf 'Co-Authored-By: %s <noreply@anthropic.com>\n' "$_model"
		[ -n "$_session" ] && printf 'Claude-Session: %s\n' "$_session"
	} >"$WORK/commit-message"

	if ! out=$(git -C "$_wt" commit -q -F "$WORK/commit-message" 2>&1); then
		DELIVER_ERR="commit failed: $(printf '%s' "$out" | tr '\n' ' ')"
		return 1
	fi
	SHA=$(git -C "$_wt" rev-parse --short HEAD)
	say "commit: $SHA on $_branch."

	# Nothing reads the delivery's paths. A rubric is a criterion a fresh context
	# judges, not a glob this script matches, and the diff is the evaluator's to
	# read in the worktree it is given.

	if git -C "$_wt" remote get-url origin >/dev/null 2>&1; then
		if ! out=$(git -C "$_wt" push -u origin "HEAD:refs/heads/$_branch" 2>&1); then
			DELIVER_ERR="push failed — committed locally as $SHA, NOT accepted by the remote: $(printf '%s' "$out" | tr '\n' ' ')"
			return 1
		fi
		say "push: $_branch accepted by origin."
	else
		say "push: no remote configured — the delivery is durable on this machine only."
	fi

	if ! command -v gh >/dev/null 2>&1; then
		PR_URL=''
		PR_NUM=''
		return 2
	fi

	# The fence is longer than the longest run of backticks in the builder's
	# text, so a fence of its own cannot close ours and escape into this
	# script's record.
	ticks=$(grep -o '`\{1,\}' "$_final" 2>/dev/null | awk '{ if (length($0) > m) m = length($0) } END { print m + 0 }')
	[ -n "$ticks" ] || ticks=0
	fence_len=$((ticks + 1))
	[ "$fence_len" -ge 3 ] || fence_len=3
	FENCE=$(awk -v n="$fence_len" 'BEGIN { s = ""; while (length(s) < n) s = s "`"; print s }')

	# Does this branch already have a pull request? Asked before anything is
	# composed, because the answer decides whether this delivery opens one or is
	# added to the one that is there. A lookup that FAILS is not read as "there
	# is none": it is said out loud.
	PR_NUM='' PR_URL='' PR_DRAFT=''
	if existing=$(cd "$_wt" && gh pr list --head "$_branch" --state open --limit 1 \
		--json number,url,isDraft --jq '.[] | "\(.number) \(.url) \(.isDraft)"' 2>"$WORK/pr-lookup.err"); then
		existing=$(printf '%s\n' "$existing" | sed -n 1p)
		PR_NUM=$(printf '%s\n' "$existing" | awk '{print $1}')
		PR_URL=$(printf '%s\n' "$existing" | awk '{print $2}')
		PR_DRAFT=$(printf '%s\n' "$existing" | awk '{print $3}')
		case "$PR_NUM" in '' | *[!0-9]*) PR_NUM='' PR_URL='' PR_DRAFT='' ;; esac
	else
		say "note: the existing-pull-request lookup FAILED, so whether $_branch already has one is unknown here: $(tr '\n' ' ' <"$WORK/pr-lookup.err")"
	fi

	if [ -n "$PR_NUM" ]; then
		if [ "$PR_DRAFT" = false ]; then
			_dstate="It is NOT a draft — an earlier delivery took it ready — and this delivery does not put it back."
		else
			_dstate="It is a draft."
		fi
		say "pull request: #$PR_NUM already exists for $_branch — this delivery goes on top of its body, and the record already there is kept beneath it. $_dstate"
		if ! (cd "$_wt" && gh pr view "$PR_NUM" --json body --jq .body) >"$WORK/pr-body-existing" 2>"$WORK/pr-body-existing.err"; then
			DELIVER_ERR="the existing pull request body could not be read back, and a body this script never read is never replaced — that would delete the earlier delivery's record: $(tr '\n' ' ' <"$WORK/pr-body-existing.err")"
			return 3
		fi
		{
			delivery_section update
			printf '\n---\n\n'
			cat "$WORK/pr-body-existing"
		} >"$WORK/pr-body"
		# TWO ROADS TO THE BODY. `gh pr edit` first; where it refuses, the same
		# body over REST, which does not depend on the GraphQL schema the gh
		# binary was built against.
		_edited=''
		if out=$(cd "$_wt" && gh pr edit "$PR_NUM" --body-file "$WORK/pr-body" 2>&1); then
			_edited='gh pr edit'
		else
			_edit_err=$(printf '%s' "$out" | tr '\n' ' ')
			if out=$(cd "$_wt" && gh api -X PATCH "repos/{owner}/{repo}/pulls/$PR_NUM" -F "body=@$WORK/pr-body" 2>&1); then
				_edited='REST'
				say "pull request: gh pr edit refused ($_edit_err) — the body of #$PR_NUM was written over REST instead."
			else
				keep_pr_body
				DELIVER_ERR="gh pr edit failed, and so did the REST route — the delivery IS on the branch, and the body of #$PR_NUM still describes an EARLIER delivery. $KEPT_NOTE — gh pr edit: $_edit_err — gh api: $(printf '%s' "$out" | tr '\n' ' ')"
				return 3
			fi
		fi
		if verify=$( (cd "$_wt" && gh pr view "$PR_NUM" --json body --jq .body) 2>/dev/null ); then
			if ! printf '%s\n' "$verify" | grep -qF -- "- Commit: $SHA"; then
				keep_pr_body
				DELIVER_ERR="$_edited reported success, but the body read back afterwards does not record commit $SHA. $KEPT_NOTE"
				return 3
			fi
			say "pull request: #$PR_NUM updated, and read back — its body now records commit $SHA."
		else
			say "note: #$PR_NUM was updated and its body could not be read back to confirm it, so the update is UNCONFIRMED here. Said, not assumed."
		fi
	else
		# Nothing exists yet, so this one is opened as a draft and the section
		# says so because that is what is about to be true.
		PR_DRAFT=true
		delivery_section create >"$WORK/pr-body"
		if ! out=$(cd "$_wt" && gh pr create --draft --base "$BASE" --head "$_branch" \
			--title "$(pr_title)" --body-file "$WORK/pr-body" 2>&1); then
			DELIVER_ERR="gh pr create failed — committed as $SHA and pushed, but no pull request was opened: $(printf '%s' "$out" | tr '\n' ' ')"
			return 3
		fi
		PR_URL=$(printf '%s\n' "$out" | sed -n 's|.*\(https://[^ ]*\).*|\1|p' | sed -n 1p)
		PR_NUM=$(printf '%s\n' "$PR_URL" | sed -n 's|.*/\([0-9][0-9]*\)$|\1|p')
		say "pull request: opened as a draft — $PR_URL"
	fi
	return 0
}

# This script's provenance is written FIRST inside each section, so nothing the
# builder writes can render above it; the builder's words go LAST, inside the
# fence, so a `---` or a copied heading in them renders as the literal characters
# it is rather than as document structure.
delivery_section() { # $1 create|update
	if [ "$1" = update ]; then
		printf '## This pull request now carries a later delivery\n\n'
		printf 'The branch has been delivered to again. What it carries now is the delivery\n'
		printf 'recorded immediately below — commit `%s`. Everything past the divider that\n' "$SHA"
		printf 'closes this section is the record of the deliveries before it, kept exactly as\n'
		printf 'it was written: this script adds a delivery on top, and never edits or removes\n'
		printf 'one that is already here. Where a section further down names a different\n'
		printf 'commit, this one supersedes it.\n\n'
	fi
	printf '## Provenance — recorded by the mechanism, not by the builder\n\n'
	printf 'The working tree is the builder'"'"'s authorship. Branch, commit, push and this\n'
	printf 'pull request are `%s`'"'"'s mechanics, performed by the resuming session: the\n' "$ME"
	printf 'builder never ran git.\n\n'
	printf -- '- Item: %s (stage %s, until %s)\n' "$slug" "$(hdr "$brief" Stage)" "$(hdr "$brief" Until | sed 's/^$/none/')"
	printf -- '- Harness: %s\n' "${_harness:-not reported by the invoke — absent, never invented}"
	printf -- '- Model: %s\n' "${_model:-not reported by the invoke — absent, never invented}"
	printf -- '- Session: %s\n' "${_session:-not reported by the invoke — absent, never invented}"
	printf -- '- Commit: %s\n' "$SHA"
	printf -- '- Round: %s\n' "$ROUND"
	if [ "$PR_DRAFT" = false ]; then
		printf '\nThis pull request is NOT a draft: an earlier delivery on this branch passed its\n'
		printf 'gate and `%s` flipped it ready. THIS delivery arrives unverified like any other,\n' "$ME"
		printf 'and the verdict on it is the one below this section when it is written.\n'
	else
		printf '\nThis pull request is a draft: this delivery arrives unverified, and only a\n'
		printf 'recorded passing verdict takes it out of draft.\n'
	fi
	printf '\n## What the builder returned\n\n'
	printf 'Everything below is the builder'"'"'s own text, reproduced verbatim and unedited.\n'
	printf 'It is quoted, not endorsed, and nothing in it is this script'"'"'s record of what\n'
	printf 'ran — that record is the section above, which no builder can write.\n\n'
	printf '%s\n' "$FENCE"
	cat "$FINALTEXT"
	printf '%s\n' "$FENCE"
}

# WHERE this item's build worktree is, decided in ONE place for the move that
# builds it and the `stop` that discards it. `one_namespace` and not
# `resolve_dir`: this answers before the worktree exists, and the override was
# typed in the shell's own namespace.
worktree_path() {
	# A checkout of `work/<slug>` that already exists is the worktree, wherever
	# it is: git is asked, not the default.
	_wpx=$(git -C "$root" worktree list --porcelain 2>/dev/null |
		awk -v b="branch refs/heads/work/$slug" '/^worktree / { p = substr($0, 10) } $0 == b { print p; exit }')
	if [ -n "$_wpx" ]; then
		one_namespace "$_wpx"
		return 0
	fi
	one_namespace "${REMIT_WORKTREE_DIR:-$root-remit-worktrees}/$slug"
}

build_worktree() {
	WT=$(worktree_path)
	[ -e "$WT/.git" ] && return 0
	ensure_dir "$(dirname "$WT")" || return 1
	if git -C "$root" show-ref --verify --quiet "refs/heads/work/$slug"; then
		git -C "$root" worktree add "$WT" "work/$slug" >/dev/null 2>&1 || return 1
	else
		git -C "$root" worktree add "$WT" -b "work/$slug" "$BASE" >/dev/null 2>&1 || return 1
	fi
	return 0
}

# ==============================================================================
# kept output — the home, the hop, and the sweep
# ==============================================================================
#
# The law is KEPT OUTPUT HAS A HOME in this script's header. This is only its
# code, and every part of it is here rather than spread across the three places
# that call it.

runs_home() { # $1 a working tree -> where a raise in it keeps its output
	# A raise in the PRIMARY worktree is handed THE HOME itself, wherever the record
	# lives; a raise in a build worktree is handed its own worktree-local one, and
	# `runs_harvest` crosses the gap. Both are the same string when the record is in
	# the project.
	printf '%s/runs\n' "$(item_home "$1")"
}

# THE SAME CROSSING FOR THE ITEM FOLDER, which `runs_home` is built on.
item_home() { # $1 a working tree -> the item folder a raise in it can open
	[ "$1" = "$root" ] && { printf '%s\n' "$item"; return 0; }
	printf '%s\n' "$1/$item_rel"
}

# THE NAME A KEPT RUN TAKES, the ONE copy: the sweep keys on this sentence and
# `bin/remit-invoke` prints it into the briefing verbatim. ONE LINE OF TEXT,
# because it is printed where a broken line would arrive broken. What closure
# does with what is named is KEPT OUTPUT HAS A HOME.
runs_naming() {
	printf 'one file per run, named `<suite>.<shell>.<stamp>.log` — '
	printf '`<suite>` what was run (`unit`, `integration`, or the suite'"'"'s own name), '
	printf '`<shell>` the shell it ran under (`gitbash`, `dash`, `bash`, `zsh`), '
	printf '`<stamp>` the UTC time it finished, as `YYYYMMDDThhmmssZ`. '
	printf 'None of the three may contain a `.`, and the stamp is fixed-width so that '
	printf 'the last run of a suite-and-shell is the last one by name. '
	printf 'What closure does with a file named this way, and with one named otherwise, '
	printf 'is `KEPT OUTPUT HAS A HOME` in `bin/remit`'"'"'s header — read it there.\n'
}

# Make the home and make it invisible to git: a `*` ignore that TRAVELS with the
# directory, holding the home out of every record commit without
# `commit_and_push` knowing it exists.
runs_open_at() { # $1 the directory itself
	_rh=$1
	ensure_dir "$_rh" 2>/dev/null || return 1
	[ -f "$_rh/.gitignore" ] && return 0
	printf '*\n' >"$_rh/.gitignore" || return 1
	return 0
}

runs_open() { # $1 a working tree
	runs_open_at "$(runs_home "$1")"
}

# THE HARVEST'S MIRROR: the WHOLE home copied INTO the worktree a raise is about
# to run in, before the raise. In personal-records mode the home is in the
# records clone, outside the repository; every gate after a delivery raises its
# evaluator in the item's own worktree; and a seat scoped to its worktree cannot
# open the clone (a devin evaluator that asks to ends its own run). So the
# pointer names something INSIDE the worktree, holding everything the item has
# kept — research kept at gate 1 included.
#
# IT IS NOT REMOVED AFTERWARDS: the destination is the worktree's own home,
# where a copied file cannot be told from an authored one; the home's `*` ignore
# keeps all of it out of every stage and commit, and `runs_harvest` copying a
# file back over itself is a no-op.
runs_seed() { # $1 the working tree the raise will run in
	_ssdst=$(runs_home "$1")
	[ "$_ssdst" = "$runs" ] && return 0
	[ -d "$runs" ] || return 0
	runs_open_at "$_ssdst" || {
		printf '%s: could not open %s — this raise is not shown what earlier rounds kept.\n' \
			"$ME" "$_ssdst" >&2
		return 1
	}
	_ssn=0
	for _ssf in "$runs"/*; do
		[ -f "$_ssf" ] || continue
		cp "$_ssf" "$_ssdst/${_ssf##*/}" && _ssn=$((_ssn + 1))
	done
	[ "$_ssn" -gt 0 ] && say "kept output: $_ssn file(s) copied into $runs_rel for this raise to read."
	return 0
}

# THE ITEM'S OWN ARTEFACTS, put where the raise that has to JUDGE them can open
# them — the same mirror as `runs_seed`, one level up. In personal-records mode
# the item folder is in the records clone, which a seat scoped to its worktree
# cannot open. In all-in mode it is on disk in the evaluate worktree as the
# SNAPSHOT `work/<slug>` was cut from — never refreshed, while every record
# commit since landed on the base branch — so the file is there and STALE. ONE
# MECHANISM ENDS BOTH: before an evaluate raise the record's own copy is put in
# the worktree at `$item_rel`, beside the seeded `runs/`.
#
# WHAT TRAVELS: `brief.md`, `research.md`, the phase files, and any other regular
# file kept beside them. WHAT DOES NOT: `log.md` (no briefing names it, and a
# FRESH evaluator is not shown earlier rounds' verdicts), the marker, and
# `runs/`, which is `runs_seed`'s.
#
# IT IS TAKEN AWAY AGAIN, unlike `runs_seed`, because in all-in mode these
# artefacts are TRACKED and no ignore rule holds a modified tracked file out of
# the next round's `git add -A`. What was overwritten is put back and what was
# not there is removed the moment the raise returns — after a stop and a refusal
# as well as a run that finished (`invoke` unseeds beside the harvest).
ITEM_SEEDED=''
item_seed() { # $1 the working tree the raise will run in
	ITEM_SEEDED=''
	_isdst=$(item_home "$1")
	[ "$_isdst" = "$item" ] && return 0
	[ -d "$item" ] || return 0
	ensure_dir "$_isdst" || {
		printf '%s: could not open %s — this raise is not shown the item'"'"'s own artefacts.\n' \
			"$ME" "$_isdst" >&2
		return 1
	}
	_isbak="$WORK/item-seed"
	rm -rf "$_isbak"
	ensure_dir "$_isbak" || return 1
	_isn=0
	# `*` never matches a leading dot, so the marker and any ignore file are out
	# before the name test; the test is there for a marker whose name stops starting
	# with one.
	for _isf in "$item"/*; do
		[ -f "$_isf" ] || continue
		_isb=${_isf##*/}
		[ "$_isb" = log.md ] && continue
		[ "$_isb" = "$marker_name" ] && continue
		# A copy already byte-for-byte the record's is left alone: nothing seeded,
		# nothing to put back.
		cmp -s "$_isf" "$_isdst/$_isb" && continue
		if [ -e "$_isdst/$_isb" ]; then
			cp "$_isdst/$_isb" "$_isbak/$_isb" || {
				printf '%s: could not set %s aside, so it was NOT replaced — the raise reads the worktree'"'"'s own copy.\n' \
					"$ME" "$_isb" >&2
				continue
			}
		fi
		cp "$_isf" "$_isdst/$_isb" || continue
		ITEM_SEEDED="$ITEM_SEEDED$_isb
"
		_isn=$((_isn + 1))
	done
	[ "$_isn" -gt 0 ] && say "item artefacts: $_isn file(s) copied into $item_rel for this raise to read."
	return 0
}

# And put the worktree back exactly as it was found. Called after EVERY raise
# that was seeded, whatever became of it.
item_unseed() { # $1 the working tree the raise ran in
	[ -n "$ITEM_SEEDED" ] || return 0
	_iudst=$(item_home "$1")
	_iubak="$WORK/item-seed"
	printf '%s' "$ITEM_SEEDED" | while IFS= read -r _iub; do
		[ -n "$_iub" ] || continue
		if [ -f "$_iubak/$_iub" ]; then
			cp "$_iubak/$_iub" "$_iudst/$_iub" ||
				printf '%s: could not restore %s in %s — it still holds the record'"'"'s copy.\n' \
					"$ME" "$_iub" "$_iudst" >&2
		else
			rm -f "$_iudst/$_iub" ||
				printf '%s: could not remove the seeded %s from %s.\n' \
					"$ME" "$_iub" "$_iudst" >&2
		fi
	done
	rm -rf "$_iubak"
	ITEM_SEEDED=''
	return 0
}

# What a raise kept, brought home — COPIED, not moved: a build worktree resumed
# into for a later round must still carry what its earlier rounds kept. Both
# copies are ignored.
runs_harvest() { # $1 the working tree that raise ran in
	# `_hsrc` and not `_rh`: `runs_open` below sets `_rh` to the DESTINATION, and
	# a source read back out of it afterwards would copy the home onto itself and
	# report a harvest that never happened.
	_hsrc=$(runs_home "$1")
	[ "$_hsrc" = "$runs" ] && return 0
	[ -d "$_hsrc" ] || return 0
	runs_open_at "$runs" || {
		printf '%s: could not open the kept-output home at %s — what the raise kept is still at %s and NOTHING was lost, but it is not in the item and a close will not archive it.\n' \
			"$ME" "$runs" "$_hsrc" >&2
		return 1
	}
	# `*` never matches a leading dot, so the home's own `.gitignore` is not one
	# of the things carried across; the one already at the far end stays.
	_hv=0
	for _hf in "$_hsrc"/*; do
		# REGULAR FILES only — the convention is one file per run. What is left behind
		# is NAMED, never dropped in silence. An empty home leaves the glob unmatched.
		[ -e "$_hf" ] || continue
		if [ ! -f "$_hf" ]; then
			printf '%s: %s is not a file, so it was NOT brought home — kept output is one file per run. It is still at %s.\n' \
				"$ME" "${_hf##*/}" "$_hf" >&2
			continue
		fi
		if cp "$_hf" "$runs/${_hf##*/}"; then
			_hv=$((_hv + 1))
		else
			printf '%s: could not bring %s home to %s — it stays where the raise left it.\n' \
				"$ME" "$_hf" "$runs" >&2
		fi
	done
	[ "$_hv" -gt 0 ] && say "kept output: $_hv file(s) now in $runs_rel."
	return 0
}

# THE SWEEP, run by `close` before the archive move and by nothing else.
#
# Sets three lists, each a run of newline-terminated names: RUNS_KEPT (the last
# run of each suite-and-shell, which the move carries into the archive),
# RUNS_SWEPT (superseded, removed here, and in no commit anywhere because the
# home was never committed) and RUNS_UNKEYED (a name this cannot key, kept
# untouched). It also takes the ignore file away, which is what lets the archive
# move deliver the survivors into the next record commit.
RUNS_KEPT=''
RUNS_SWEPT=''
RUNS_UNKEYED=''
runs_sweep() {
	RUNS_KEPT='' RUNS_SWEPT='' RUNS_UNKEYED=''
	[ -d "$runs" ] || return 0
	# ONLY A REGULAR FILE IS CONSIDERED — anything else is reported and kept, never a
	# candidate for removal. `*` never matches the home's own ignore file.
	: >"$WORK/runs-names"
	for _f in "$runs"/*; do
		if [ -f "$_f" ]; then
			printf '%s\n' "${_f##*/}" >>"$WORK/runs-names"
		elif [ -e "$_f" ]; then
			RUNS_UNKEYED="$RUNS_UNKEYED${_f##*/}
"
		fi
	done
	# `<key>\t<name>`, sorted. The key is the first two dot-fields of a
	# conforming name and EMPTY for one this cannot read, and a tab sorts below
	# every printable character, so the unkeyable ones land together at the top
	# and each key's own runs land adjacent in ascending order. The stamp is
	# fixed-width, so last in that order is the newest.
	awk -F. -v OFS="$TAB" '
		NF == 4 && $4 == "log" && $1 != "" && $2 != "" && $3 != "" { print $1 "." $2, $0; next }
		{ print "", $0 }
	' "$WORK/runs-names" | LC_ALL=C sort >"$WORK/runs-keyed"
	# A run survives when the line after it does not carry its key.
	awk -F"$TAB" '
		{ k[NR] = $1; n[NR] = $2 }
		END {
			for (i = 1; i <= NR; i++) {
				if (k[i] == "") { print "unkeyed " n[i]; continue }
				if (i < NR && k[i + 1] == k[i]) print "sweep " n[i]
				else print "keep " n[i]
			}
		}
	' "$WORK/runs-keyed" >"$WORK/runs-verdict"
	while IFS= read -r _line; do
		_what=${_line%% *}
		_name=${_line#* }
		case "$_what" in
		sweep)
			if rm -f "$runs/$_name"; then
				RUNS_SWEPT="$RUNS_SWEPT$_name
"
			else
				printf '%s: could not remove the superseded run %s — it is archived with the rest.\n' \
					"$ME" "$_name" >&2
				RUNS_KEPT="$RUNS_KEPT$_name
"
			fi
			;;
		keep) RUNS_KEPT="$RUNS_KEPT$_name
" ;;
		unkeyed) RUNS_UNKEYED="$RUNS_UNKEYED$_name
" ;;
		esac
	done <"$WORK/runs-verdict"
	# The home stops ignoring itself: from here the survivors are ordinary files
	# in the item folder, and the move puts them where the closing commit stages
	# them. An empty home is taken away rather than archived as a bare directory.
	rm -f "$runs/.gitignore"
	rmdir "$runs" 2>/dev/null || :
	return 0
}

# What the sweep did, for the `closed` entry. Says something in every case,
# including the case where there was nothing to say something about.
runs_report() {
	if [ -z "$RUNS_KEPT$RUNS_SWEPT$RUNS_UNKEYED" ]; then
		printf 'No run output was kept for this item.\n'
		return 0
	fi
	printf 'Kept output, swept to the last run of each suite-and-shell:\n\n'
	printf '%s' "$RUNS_KEPT" | while IFS= read -r _r; do
		[ -n "$_r" ] && printf -- '- archived: runs/%s\n' "$_r"
	done
	printf '%s' "$RUNS_UNKEYED" | while IFS= read -r _r; do
		[ -n "$_r" ] && printf -- '- archived UNSWEPT, the sweep could not key it: runs/%s\n' "$_r"
	done
	printf '%s' "$RUNS_SWEPT" | while IFS= read -r _r; do
		[ -n "$_r" ] && printf -- '- superseded: removed by this closure, and in no commit anywhere — runs/%s\n' "$_r"
	done
	return 0
}

# ==============================================================================
# what this brief depends on, and whether that work item satisfies
# ==============================================================================
#
# The law is WHAT A BRIEF DEPENDS ON in this script's header; this is only its
# code. Nothing below writes a brief, and nothing below guesses: a line it cannot
# read whole stops the item, and so does a name that does not satisfy.

# THE LINE, REDUCED TO THE WORK ITEMS IT NAMES.
#   0, DEPENDS_ON_LIST empty   it names none — absent, blank, `none` or `nothing`
#   0, DEPENDS_ON_LIST set     the slugs it names, one per line
#   1, DEPENDS_ON_BAD set      it is there and cannot be read whole, saying why
DEPENDS_ON_LIST=''
DEPENDS_ON_BAD=''
depends_on_names() { # $1 the file to read the line from
	DEPENDS_ON_LIST=''
	DEPENDS_ON_BAD=''
	if ! nocr "$1" | grep -q '^\*\*Depends on:\*\*'; then
		# THE SUPERSEDED NAME is never silently ignored: it would otherwise read as
		# `none`.
		if nocr "$1" | grep -q '^\*\*Builds on:\*\*'; then
			DEPENDS_ON_BAD="it carries a \`**Builds on:**\` line and no \`**Depends on:**\` line — that line was renamed by the practitioner's ruling of 2026-08-24, it names work items by slug now, and nothing here reads the old one"
			return 1
		fi
		return 0
	fi

	# HIS PROSE COMES LAST and starts at the first ` — `; everything after it is
	# his and is not resolved, so a comma inside a sentence he wrote is a comma.
	_val=$(hdr "$1" 'Depends on')
	_emdash=' — '
	case "$_val" in
	*"$_emdash"*) _val=${_val%%"$_emdash"*} ;;
	esac

	_names=''
	_oifs=$IFS
	set -f
	IFS=,
	for _field in $_val; do
		IFS=$_oifs
		set +f
		_w=$(printf '%s\n' "$_field" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
		if [ -n "$_w" ]; then
			# HIS PUNCTUATION IS NOT PART OF THE NAME — a bracket he put round
			# it, a backtick he set it in, a bold marker, the full stop he ended
			# the line with. A slug is word characters and hyphens throughout, so
			# nothing a name can legitimately carry is stripped.
			_w=$(printf '%s\n' "$_w" | sed 's/^[`*_([{"]*//; s/[].,;:!?)}`*_"]*$//')
			case "$_w" in
			'')
				DEPENDS_ON_BAD="one of its comma-separated fields carries no word a work item could be named by — punctuation and nothing else"
				;;
			*[[:space:]]*)
				DEPENDS_ON_BAD="the field \`$_w\` carries more than one word, and naming the first of them and dropping the rest is exactly what this line exists to prevent — separate work items with a comma"
				;;
			'#'*)
				DEPENDS_ON_BAD="\`$_w\` names a pull request, and this line names work items by slug: \"PRs are the partial delivery vehicles for work items; the work item itself is not done until i say\" (2026-08-24)"
				;;
			*/*)
				DEPENDS_ON_BAD="\`$_w\` names a branch or a URL, and this line names work items by slug: \"PRs are the partial delivery vehicles for work items; the work item itself is not done until i say\" (2026-08-24)"
				;;
			*)
				_names="$_names$_w
"
				;;
			esac
			[ -n "$DEPENDS_ON_BAD" ] && break
		fi
		set -f
		IFS=,
	done
	IFS=$_oifs
	set +f
	[ -n "$DEPENDS_ON_BAD" ] && return 1

	# `none` and `nothing` are the same answer as an absent line, and they are
	# the WHOLE answer: beside another name they contradict it, and nothing here
	# decides which half he meant. The probe carries a newline at BOTH ends of
	# every name, so a slug that merely ends in `none` is not one.
	_probe="
$_names"
	case "$_probe" in
	*'
none
'* | *'
nothing
'*)
		case "$_probe" in
		'
none
' | '
nothing
') return 0 ;;
		esac
		DEPENDS_ON_BAD="it names \`none\` beside a work item, and those are two different answers — nothing here picks one"
		return 1
		;;
	esac
	[ -n "$_names" ] || return 0
	DEPENDS_ON_LIST=$_names
	return 0
}

# AN ARCHIVED ITEM'S DELIVERIES: is every one merged? WHAT SATISFIES ONE in the
# header says why; 0 = every distinct pull request its record names reads
# MERGED. `_d`-prefixed locals: this runs two loops down inside
# `depends_on_ok`.
depends_on_merged() { # $1 slug  $2 its record  $3 the stage it archived at
	_dat="archived at ${3:-no readable stage}"
	_dn=$(delivery_count "$2")
	if [ "$_dn" -eq 0 ]; then
		DEPENDS_ON_WHY="work item $1 was $_dat and its record names no delivery at all — there is nothing here to witness merged"
		return 1
	fi
	_dnamed=$(delivery_pr_urls "$2" | awk 'END { print NR + 0 }')
	if [ "$_dnamed" -lt "$_dn" ]; then
		DEPENDS_ON_WHY="work item $1 was $_dat and $((_dn - _dnamed)) of its $_dn recorded deliveries name a commit and no pull request — nothing here can witness those merged"
		return 1
	fi
	if ! command -v gh >/dev/null 2>&1; then
		DEPENDS_ON_WHY="work item $1 was $_dat, so whether its delivery merged is read from the pull request itself — and there is no \`gh\` on this PATH to read it with"
		return 1
	fi
	_durls=$(delivery_pr_urls "$2" | awk '!seen[$0]++')
	_doifs=$IFS
	IFS='
'
	for _durl in $_durls; do
		IFS=$_doifs
		if ! _dstate=$(cd "$root" && gh pr view "$_durl" --json state --jq .state 2>"$WORK/dep-pr.err"); then
			DEPENDS_ON_WHY="work item $1 was $_dat and the state of its delivery $_durl could not be read: $(tr -d '\015' <"$WORK/dep-pr.err" | tr '\n\t' '  ')"
			return 1
		fi
		_dstate=$(printf '%s\n' "$_dstate" | tr -d '\015' | sed -n 1p)
		if [ "$_dstate" != MERGED ]; then
			DEPENDS_ON_WHY="work item $1 was $_dat and its delivery $_durl reads ${_dstate:-no state at all}, not MERGED"
			return 1
		fi
		IFS='
'
	done
	IFS=$_doifs
	return 0
}

# ONE WORK ITEM: does it satisfy? Its stage is read from its own brief, wherever
# that brief now sits, and an archived one that never reached `closed` is asked
# the second question rather than refused outright.
DEPENDS_ON_WHY=''
depends_on_one() { # $1 one slug -> 0 it satisfies, 1 it does not, with the why
	DEPENDS_ON_WHY=''
	if [ -f "$ITEMS/$1/brief.md" ]; then
		_st=$(hdr "$ITEMS/$1/brief.md" Stage)
		[ "$_st" = closed ] && return 0
		DEPENDS_ON_WHY="work item $1 is at ${_st:-no readable stage}, not closed, and is still in flight — an item that is not over satisfies nothing, whatever its branch has done"
		return 1
	fi
	if [ -f "$ITEMARCH/$1/brief.md" ]; then
		_st=$(hdr "$ITEMARCH/$1/brief.md" Stage)
		[ "$_st" = closed ] && return 0
		depends_on_merged "$1" "$ITEMARCH/$1/log.md" "$_st" && return 0
		return 1
	fi
	DEPENDS_ON_WHY="$1 is not a work item here — neither .remit/work-items/$1 nor its archive is there"
	return 1
}

# THE WHOLE LINE, AT ONE OF THE TWO POINTS IT IS OBSERVED. 0 = every work item it
# names satisfies, or it names none; 1 = one does not, with DEPENDS_ON_STOP the
# reason and DEPENDS_ON_NOTE the prose. The point is the argument and changes
# only the note's sentence. The line is read from the AUTHORITY, and from the
# brief where a phase file carries none.
DEPENDS_ON_STOP=''
DEPENDS_ON_NOTE=''
depends_on_ok() { # $1 `new` — before the research raise and gate 1 — or `build`
	DEPENDS_ON_STOP=''
	DEPENDS_ON_NOTE=''
	DEPENDS_ON_WHY=''
	if [ "${1:-build}" = new ]; then
		_didnot='Nothing was raised and the item stays at `new`'
	else
		_didnot='The build did not start'
	fi

	_src=$AUTHORITY
	nocr "$_src" | grep -q -e '^\*\*Depends on:\*\*' -e '^\*\*Builds on:\*\*' || _src=$brief

	if ! depends_on_names "$_src"; then
		DEPENDS_ON_STOP='depends on: the line cannot be read whole'
		DEPENDS_ON_NOTE="This brief's \`**Depends on:**\` line cannot be read whole: $DEPENDS_ON_BAD.
$_didnot. Nothing here reads part of a line and starts on the rest —
naming one dependency and dropping the other is the incident this check exists for.
One line from the practitioner, naming the work items by slug or the word \`none\`,
lifts this."
		return 1
	fi
	[ -n "$DEPENDS_ON_LIST" ] || return 0

	# EVERY NAME IS OBSERVED, and the first that does not satisfy is the one the
	# reason names.
	_held=''
	_oifs=$IFS
	IFS='
'
	for _n in $DEPENDS_ON_LIST; do
		IFS=$_oifs
		if ! depends_on_one "$_n"; then
			_held=$_n
			break
		fi
		IFS='
'
	done
	IFS=$_oifs
	[ -n "$_held" ] || return 0

	DEPENDS_ON_STOP="depends on: $DEPENDS_ON_WHY"
	DEPENDS_ON_NOTE="The brief's \`**Depends on:**\` line names a work item that does not satisfy it:
$DEPENDS_ON_WHY.
$_didnot — a brief written, or a delivery authored, against a tree that lacks what it
depends on is the incident this check exists for, and what that build actually ships is
what this brief has to name. The item waits here until that one closes through its gate
or ends with its delivery merged, or until the practitioner rules that the line has
changed. NOTHING WAKES IT: when that item satisfies, \`remit resume $slug\` is the road
back in."
	return 1
}

# NOTHING HERE WRITES A BRIEF'S BODY. The header block is this script's
# (`put_header`); every word below it is his.

# ==============================================================================
# the loop
# ==============================================================================
#
# A FAIL sends the must-fix back to a fresh author and the changed work to a
# fresh evaluator. It stops at four FAILs, or when the must-fix of round n is the
# must-fix of round n-1. Round five never runs.
#
# One run of this is ONE GATE. `$1` is the stage the gate leads into, whose
# rubric file the evaluator is handed. `$2` names the author a must-fix goes back
# to — `build`; `research` at the gate into `refined` where the authority asks
# for research; `none` where there is nobody. `$3` says whether that author runs
# before the first evaluate: yes at the gate that produces a delivery, no at the
# closing gate's first round, yes on every later round.
#
# `none` IS GATE 1 WITH NOTHING BUT A BRIEF: only he changes a brief, so a
# must-fix there has no author. This returns 2 for that — distinct from the 1
# that means escalate — with LOOP_STOP the reason, and the caller stops the item
# where it is, for him. `research` IS GATE 1 WITH RESEARCH BESIDE THE BRIEF: the
# author writes `research.md` and never the brief, and a must-fix comes back to
# it only on a `Back to: research` line; the rest of the round is what a build
# gets, because it is the same loop.
#
# What the gate's evaluator cited is left in GATE_PROMOTE and GATE_HOLD for the
# caller, the only thing that moves a stage.
run_gate() { # $1 gate stage  $2 build|none  $3 yes|no — author before the first evaluate
	GATE=$1
	STANDARDS_GATE=$1
	_author=$2
	_authornow=$3
	# WHAT THE GATE'S EVALUATOR IS TOLD IT CAN REACH. It is one fact — whether
	# `research.md` has an author at this gate — and it is set from the author
	# this gate was given rather than from anything the seam works out for itself.
	RESEARCH_AUTHOR=''
	[ "$_author" = research ] && RESEARCH_AUTHOR=yes
	GATE_PROMOTE=''
	GATE_HOLD=''
	LOOP_STOP_DETAIL=''
	LOOP_STOP_NOTE=''
	ROUND=1
	# THE RESUME POINT, consumed here and by nothing else. It belongs to ONE gate
	# — the one the item's stage runs when the resume begins — so a later gate in
	# the same run starts at its own first round, and a run that never reaches
	# the gate it was computed for leaves it unused.
	if [ -n "$AT_GATE" ] && [ "$AT_GATE" = "$GATE" ] && [ "$_author" = build ]; then
		ROUND=$AT_ROUND
		if [ "$AT_AWAITING" = yes ]; then
			# A delivery already on the branch is JUDGED, not built again.
			_authornow=no
		elif [ "$ROUND" -gt 1 ]; then
			# ANY round above the first authors, whatever the caller said. The
			# closing gate's FIRST round judges the folder as it stands and
			# authors nothing — that is what its `no` means — but its second and
			# every round after it are rounds a builder was sent back into, and a
			# continued one is no different.
			_authornow=yes
		fi
	fi
	AT_GATE=''
	# Whether a must-fix from the round BEFORE this one is in hand, which is not
	# the same question as `ROUND > 1` once a round can be continued from the
	# record: a continued round has a number above 1 and no must-fix behind it,
	# and comparing its verdict against an empty one would stop the loop for a
	# sameness that is really two absences.
	_prev=''
	_have_prev=no
	_promoted_prev=no
	_seen_mf=''
	: >"$WORK/mustfix"
	while :; do
		chain_intact || { LOOP_STOP="authority changed"; return 1; }
		if [ "$_author" = none ] || [ "$_authornow" != yes ]; then
			# Nothing authors here: either this gate has no author at all, or
			# what it judges is already on disk from an earlier step.
			_authornow=yes
		elif [ "$_author" = research ]; then
			# GATE 1'S AUTHOR, and the only one it has: `research.md`, never the brief.
			# Nothing is built here, so no worktree and no delivery; the `**Depends on:**`
			# line was observed at the entry from `new`.
			mark_step "research round $ROUND, at the gate into $GATE"
			if ! invoke research "$WORK/research" "$root" "$WORK/mustfix"; then
				LOOP_STOP=${INVOKE_STOP:-"cannot act: remit-invoke"}
				return 1
			fi
			chain_intact || { LOOP_STOP="authority changed"; return 1; }
			cat "$WORK/research" >"$item/research.md"
			commit_step "remit: $slug research" ".remit/work-items/$slug"
			{
				printf -- '- round: %s\n' "$ROUND"
				[ -s "$WORK/mustfix" ] &&
					printf -- '- a must-fix came back to a fresh research raise, and what it returned REPLACED the `research.md` the round before it wrote\n'
				printf '\nWritten to `research.md` beside the brief.\n'
			} | log_append "research — $(git -C "$root" rev-parse --short HEAD) — $(now)"
			commit_step "remit: $slug record the research" ".remit/work-items/$slug"
		else
			# BEFORE THE BUILD, before any worktree exists: does each work item this brief
			# depends on satisfy? One that does not stops the item where it is — nothing
			# failed, nothing escalates; a `gh` that is absent HOLDS it too. THE SECOND OF
			# THE TWO POINTS: an item past `new` can gain an unsatisfied name by a later
			# edit, or see its dependency regress.
			if ! depends_on_ok build; then
				LOOP_STOP=$DEPENDS_ON_STOP
				LOOP_STOP_NOTE=$DEPENDS_ON_NOTE
				return 2
			fi
			if ! build_worktree; then
				LOOP_STOP="cannot act: could not prepare the build worktree"
				return 1
			fi
			mark_step "build round $ROUND, at the gate into $GATE"
			if ! invoke build "$WORK/final" "$WT" "$WORK/mustfix"; then
				LOOP_STOP=${INVOKE_STOP:-"cannot act: remit-invoke"}
				return 1
			fi
			# The build took as long as it took. Nothing it authored is committed
			# or delivered against an authority that changed while it ran.
			chain_intact || { LOOP_STOP="authority changed"; return 1; }
			DELIVER_ERR=''
			FINALTEXT="$WORK/final"
			deliver "$WT" "$WORK/final"
			_drc=$?
			if [ "$_drc" = 1 ]; then
				LOOP_STOP="cannot act: $DELIVER_ERR"
				return 1
			fi
			{
				printf 'Commit `%s` on `work/%s`%s\n\n' "$SHA" "$slug" "${PR_URL:+, pull request $PR_URL}"
				printf -- '- delivery size: %s file(s) added, %s MB staged\n' "${DELIVERY_FILES:-?}" "${DELIVERY_MB:-?}"
				[ "$_drc" = 3 ] && printf -- '- pull request: NOT updated — %s\n' "$DELIVER_ERR"
			} | log_append "delivery — ${PR_URL:-$SHA} — $(now)"
			commit_step "remit: $slug record delivery $SHA" ".remit/work-items/$slug"
			if [ "$_drc" = 2 ]; then
				LOOP_STOP="cannot act: gh"
				return 1
			fi
			if [ "$_drc" = 3 ]; then
				LOOP_STOP="cannot act: $DELIVER_ERR"
				return 1
			fi
		fi

		# THE EVALUATOR IS RAISED WHERE THE DELIVERY IS — the law is WHERE AN
		# EVALUATOR IS RAISED in this script's header, and this is only its code.
		# The gate into `refined` judges the brief, before any worktree exists, so
		# it is raised in the primary worktree; every gate after a delivery is
		# raised in the ITEM'S OWN worktree, on `work/<slug>`, which is the only
		# tree where the delivered files are on disk.
		EVAL_DELIVERY=''
		_evalwt=$root
		if [ "$GATE" != refined ]; then
			EVAL_DELIVERY=$(recorded_delivery)
			if git -C "$root" show-ref --verify --quiet "refs/heads/work/$slug" && build_worktree; then
				_evalwt=$WT
			else
				# No delivery branch, or a worktree that would not open. Said out
				# loud and raised in the primary worktree anyway: an evaluation
				# that runs on the record alone is worth more than none, and the
				# briefing tells it which tree it is standing in either way.
				EVAL_DELIVERY=''
				say "the delivered tree could not be opened at $(worktree_path) — this evaluate is raised in $root and judges the record and the kept runs."
			fi
		fi
		mark_step "evaluate round $ROUND, at the gate into $GATE"
		if ! invoke evaluate "$WORK/verdict" "$_evalwt"; then
			LOOP_STOP=${INVOKE_STOP:-"cannot act: remit-invoke"}
			return 1
		fi
		chain_intact || { LOOP_STOP="authority changed"; return 1; }
		# A LINE WRITTEN IN EMPHASIS IS STILL THE LINE: `*`, `_` and backticks around a
		# parsed line shape are stripped before anything below reads it, and the
		# verbatim copy the record carries is the normalised one.
		nocr "$WORK/verdict" | sed \
			-e 's/^[*_`]\{1,3\}\(Verdict\|Must-fix\|Finding\|Ask\|Back to\|fix\|hold\|promote\|accept\):[*_`]\{0,3\} */\1: /' \
			-e '/^\(Verdict\|Must-fix\|Finding\|Ask\|Back to\|fix\|hold\|promote\|accept\): /s/[*_`]\{1,3\}$//' \
			>"$WORK/verdict.plain" && mv "$WORK/verdict.plain" "$WORK/verdict"
		_v=$(nocr "$WORK/verdict" | sed -n 's/^Verdict: *//p' | sed -n 1p)
		case "$_v" in
		FAIL*) V=FAIL ;;
		"PASS WITH FINDINGS"*) V="PASS WITH FINDINGS" ;;
		PASS*) V=PASS ;;
		*)
			LOOP_STOP="cannot act: verdict"
			return 1
			;;
		esac

		# What this gate's file actually carries. ALL FOUR citations are applied only
		# against these: an evaluator with no rubric to cite can neither promote, hold,
		# fix nor accept.
		_promote_ids=$(rubric_ids "$GATE" promote)
		_accept_ids=$(rubric_ids "$GATE" accept)
		_hold_ids=$(rubric_ids "$GATE" hold)
		_fix_ids=$(rubric_ids "$GATE" fix)

		GATE_PROMOTE=''
		for _cid in $(nocr "$WORK/verdict" | sed -n 's/^promote: *//p' | sed 's/:.*//'); do
			case " $_promote_ids" in
			*" $_cid "*)
				GATE_PROMOTE=$_cid
				break
				;;
			esac
		done
		GATE_HOLD=''
		for _cid in $(nocr "$WORK/verdict" | sed -n 's/^hold: *\([^:]*\).*/\1/p'); do
			case " $_hold_ids" in
			*" $_cid "*)
				GATE_HOLD=$_cid
				break
				;;
			esac
		done
		_fixid=''
		for _cid in $(nocr "$WORK/verdict" | sed -n 's/^fix: *\([^:]*\).*/\1/p'); do
			case " $_fix_ids" in
			*" $_cid "*)
				_fixid=$_cid
				break
				;;
			esac
		done

		# A `fix:` citation is a must-fix, and a must-fix means the loop runs
		# whatever the verdict line said it was.
		V_EFF=$V
		[ -n "$_fixid" ] && V_EFF=FAIL

		_n=$(next_finding_no)
		{
			printf -- '- verdict: %s\n' "$V_EFF"
			[ "$V_EFF" = "$V" ] ||
				printf -- '- the verdict line returned `%s`; a `fix:` citation is a must-fix, so it is a FAIL and the loop runs\n' "$V"
			printf -- '- gate: into %s, judged against %s\n' "$GATE" ".remit/rules/$GATE.md"
			printf -- '- round: %s\n' "$ROUND"
			nocr "$WORK/verdict" |
				awk -v start="$_n" -v pids=" $_promote_ids" -v aids=" $_accept_ids" \
					-v hids=" $_hold_ids" -v fids=" $_fix_ids" '
				function known(list, id) { return index(list, " " id " ") > 0 }
				function idof(l, i) { i = l; sub(/:.*/, "", i); return i }
				function unknown(word, l) {
					return "- rubric " word ": " l " — NOT APPLIED: " idof(l) " is not a rubric this gate carries"
				}
				/^Finding: / { n = start++; sub(/^Finding: /, ""); print "- finding " n ": " $0; last = n; next }
				/^accept: / {
					l = substr($0, 9)
					if (!known(aids, idof(l))) {
						print unknown("accept", l)
					} else if (last > 0) {
						print "- finding " last " disposition: accepted by rubric " l
					} else {
						print "- rubric accept: " l " — NOT APPLIED: no `Finding:` line stood above it"
					}
					next
				}
				/^fix: / {
					l = substr($0, 6)
					if (!known(fids, idof(l))) { print unknown("fix", l); next }
					print "- rubric fix: " l
					if (last > 0) print "- finding " last " disposition: fix by rubric " l
					next
				}
				/^promote: / {
					l = substr($0, 10)
					if (known(pids, idof(l))) print "- rubric promote: " l
					else print unknown("promote", l)
					next
				}
				/^hold: / {
					l = substr($0, 7)
					if (known(hids, idof(l))) print "- rubric hold: " l
					else print unknown("hold", l)
					next
				}
			'
			printf '\nReturned by the evaluate role, verbatim:\n\n'
			cat "$WORK/verdict"
		} | log_append "verdict — evaluate — into $GATE — $(git -C "$root" rev-parse --short HEAD) — $(now)"
		commit_step "remit: $slug verdict $V_EFF at the $GATE gate (round $ROUND)" ".remit/work-items/$slug"

		[ "$V_EFF" != FAIL ] && return 0

		# A `fix:` citation the gate file carries is must-fix text exactly as a
		# `Must-fix:` line is, and is compared as such by the same-must-fix-twice
		# stop. One it does not carry was NOT APPLIED above and is not must-fix
		# text either — it raised nothing, so there is nothing to send back.
		nocr "$WORK/verdict" | awk -v fids=" $_fix_ids" '
			function idof(l, i) { i = l; sub(/:.*/, "", i); return i }
			/^Must-fix: / { print substr($0, 11); next }
			/^fix: / {
				l = substr($0, 6)
				if (index(fids, " " idof(l) " ") > 0) print "fix " l
				next
			}
		' >"$WORK/mustfix.new"
		_mf=$(cat "$WORK/mustfix.new")
		mv "$WORK/mustfix.new" "$WORK/mustfix"

		# A FAIL WITH NOTHING TO ACT ON is the practitioner's, at once: no `Must-fix:`
		# line and no applied `fix:` citation has said what is wrong to a reader and
		# nothing to a builder, and a round on an empty must-fix ends in "the same
		# must-fix twice", a stop that names nothing. So the item stops where it is,
		# ACTIVE, with the findings on the record.
		# AN EVALUATOR MAY ASK — THE THREE GATES. Anchored: an `Ask:` counts only after
		# a `Finding:`, `Must-fix:`, `fix:` or `Ask:` line, and four is the bound.
		_asked=$(nocr "$WORK/verdict" | awk '
			/^(Finding|Must-fix): / { anchored = 1; next }
			/^fix: / { anchored = 1; next }
			/^Ask: / {
				if (anchored && n < 4) { n++; print "- question " n ": " substr($0, 6) }
				anchored = 1
				next
			}
			{ anchored = 0 }
		')
		if [ -n "$_asked" ]; then
			_nq=$(printf '%s\n' "$_asked" | grep -c '^- question ')
			_qs=questions
			[ "$_nq" = 1 ] && _qs=question
			LOOP_STOP_DETAIL="asked: $_nq $_qs at the gate into $GATE"
			LOOP_STOP="asked: $_nq $_qs"
			LOOP_STOP_NOTE="The gate into \`$GATE\` asked $_nq $_qs. A decision that is the practitioner's
is not something a fresh author can be sent back to discharge, so no round was run and
nothing escalated; the findings and any must-fix are on the record above. Answer one
with \`$ME answer $slug <n> \"<your words>\"\`, and the chain resumes where it is.

$_asked"
			return 2
		fi

		# A FAIL'S FINDINGS ARE ITS MUST-FIX WHEN IT NAMES NONE — once, and only where
		# the author is a builder: promoted by this script and said so on the record. A
		# second findings-only FAIL after a promoted round is the stop.
		_promoted_now=no
		if [ -z "$_mf" ] && [ "$_author" = build ] && [ "$_promoted_prev" != yes ]; then
			_findings=$(nocr "$WORK/verdict" | sed -n 's/^Finding: //p')
			if [ -n "$_findings" ]; then
				printf '%s\n' "$_findings" >"$WORK/mustfix"
				_mf=$_findings
				_promoted_now=yes
				{
					printf 'The verdict above failed the work and attached that to no `Must-fix:` line\n'
					printf 'and no `fix:` citation. Its findings are promoted to the must-fix by the\n'
					printf 'mechanism and go to a fresh builder as one round; a second such verdict\n'
					printf 'after it stops for the practitioner.\n\n'
					printf '%s\n' "$_findings" | sed 's/^/- must-fix: /'
				} | log_append "promoted — the findings are the must-fix — round $ROUND — $(now)"
				say "promoted: the verdict named findings and no must-fix; the findings go to a builder as the must-fix, once."
			fi
		fi

		_mf_key="<$(printf '%s' "$_mf" | tr '\n' ' ')>"

		if [ -z "$_mf" ]; then
			LOOP_STOP_DETAIL="FAIL with nothing to act on at the gate into $GATE"
			LOOP_STOP="FAIL with nothing to act on"
			if [ "$_promoted_prev" = yes ]; then
				LOOP_STOP_NOTE="The gate into \`$GATE\` returned FAIL with no \`Must-fix:\` line and no
\`fix:\` citation the gate file carries, for the second time running: the findings of
the first were handed to a fresh builder as the must-fix, and the gate still names
nothing a builder can act on. No further round was run and nothing escalated: the
findings are on the record above, and what to do with them is the practitioner's."
			else
				LOOP_STOP_NOTE="The gate into \`$GATE\` returned FAIL with no \`Must-fix:\` line and no
\`fix:\` citation the gate file carries — and no findings either, so nothing a fresh
author could be sent back to discharge. No round was run on an empty must-fix and
nothing escalated: what to do with it is the practitioner's."
			fi
			return 2
		fi

		# WHO MAY ACT ON A GATE-1 MUST-FIX, and it is the evaluator that says so.
		# `Back to: research` names `research.md` — the one artefact at this gate
		# a fresh context may author — and nothing else in the verdict routes
		# anything. The first word is all that is read, so the evidence an
		# evaluator writes after it costs nothing.
		_backto=$(nocr "$WORK/verdict" | sed -n 's/^Back to: *//p' | sed -n 1p |
			sed 's/[^A-Za-z-].*//' | tr 'A-Z' 'a-z')

		# GATE 1 WITH NOBODY TO SEND IT TO: the must-fix goes on the record and the item
		# waits for him at the stage it is in. No round two, no escalation. An item with
		# research reaches this same stop whenever the verdict did not send the must-fix
		# back to it.
		if [ "$_author" = none ] ||
			{ [ "$_author" = research ] && [ "$_backto" != research ]; }; then
			LOOP_STOP_DETAIL="a must-fix at the gate into $GATE"
			if [ -n "$_fixid" ]; then
				LOOP_STOP="fix: $_fixid"
			else
				LOOP_STOP=$(printf '%s\n' "$_mf" | sed -n 1p)
			fi
			[ "$_author" = research ] && LOOP_STOP_NOTE="The gate into \`$GATE\` returned a must-fix: $LOOP_STOP
The verdict did not carry \`Back to: research\`, so this is not a must-fix a fresh
research raise may discharge — and a brief is the practitioner's, his alone. The
item waits at \`new\` with the must-fix on the record above, \`research.md\` was not
re-run, and no second round was run."
			return 2
		fi

		# THE ROUND IS NAMED, not assumed to be four. The cap is four rounds and
		# a run that began at round 1 reaches it having failed four times — but a
		# run continued from the record can reach it at a higher number, and a
		# stop that said `4 fails` there would be a count nobody took.
		if [ "$ROUND" -ge 4 ]; then
			LOOP_STOP_DETAIL="$ROUND fails"
			LOOP_STOP="$ROUND fails"
			[ -n "$_fixid" ] && LOOP_STOP="fix: $_fixid"
			return 1
		fi
		if [ "$_have_prev" = yes ] && [ "$_mf" = "$_prev" ]; then
			LOOP_STOP_DETAIL="same must-fix twice"
			LOOP_STOP="same must-fix twice"
			[ -n "$_fixid" ] && LOOP_STOP="fix: $_fixid"
			return 1
		fi
		# THE RECORD ARGUING WITH ITSELF: a must-fix that RETURNS after being displaced
		# — A, B, A — is not a builder's to discharge; the two verdicts want opposite
		# things. The loop stops for him at the round the return shows, both must-fixes
		# named. `same must-fix twice` is the consecutive case and escalates; this is a
		# stop.
		case "$_seen_mf" in
		*"$_mf_key"*)
			LOOP_STOP_DETAIL="the record is arguing with itself at the gate into $GATE"
			LOOP_STOP="the record is arguing with itself"
			LOOP_STOP_NOTE="Round $ROUND's must-fix is one an earlier round at this gate already raised and a
round between them displaced: the verdicts want opposite things, and no builder can
satisfy both. That is the brief's to settle, not a round's. No further round was run
and nothing escalated; the must-fixes are on the record above.

- returned: $(printf '%s\n' "$_mf" | sed -n 1p)"
			return 2
			;;
		esac
		_seen_mf="${_seen_mf}
${_mf_key}"
		_prev=$_mf
		_promoted_prev=$_promoted_now
		_have_prev=yes
		ROUND=$((ROUND + 1))
	done
}

# ==============================================================================
# closing
# ==============================================================================
#
# Seals every standing finding as `pre-authorised`, records the delivery links
# and archives the whole folder. WHETHER IT STAMPS `closed` IS THE CALLER'S TO
# SAY, and only the closing gate says yes: `remit close` moves the folder and
# leaves the stage exactly as it was, and a brief that depends on that item is
# not let through by its archiving.
# ==============================================================================
# ==============================================================================
# the standing set — read once, for the seal and for the review
# ==============================================================================
#
# What the LAST verdict at each gate still carried, with no disposition made
# inside a verdict and no review since attesting it fixed. A `pre-authorised`
# disposition is the SEAL and is not read here. A finding outside any verdict
# entry stands as written. THE REVIEW PROJECTION in this script's header is the
# law; this is its one reader.
standing_findings() { # $1 a record file -> one standing finding a line, tab-separated:
	# number, gate, verdict date, the delivery it stood against, the finding's text
	[ -f "$1" ] || return 0
	nocr "$1" | awk '
		/^## delivery — / { split($0, f, " — "); delivery = f[2]; gate = ""; next }
		/^## verdict — evaluate — into / {
			k = split($0, f, " — ")
			g = f[3]
			sub(/^into /, "", g)
			gate = g
			vdate = f[k]
			for (n in seen) if (gateof[n] == g) delete seen[n]
			next
		}
		/^## / { gate = ""; next }
		/^- finding [0-9]+: / {
			n = $3
			sub(/:$/, "", n)
			text[n] = substr($0, index($0, ": ") + 2)
			gateof[n] = gate
			dateof[n] = (gate == "" ? "-" : vdate)
			delof[n] = (gate == "" || gate == "refined" || delivery == "" ? "-" : delivery)
			seen[n] = 1
			if (!(n in known)) { order[++c] = n; known[n] = 1 }
			next
		}
		/^- finding [0-9]+ disposition: pre-authorised/ { next }
		/^- finding [0-9]+ disposition: / { d[$3] = 1; next }
		/^- finding [0-9]+ attested: fixed/ { fixed[$3] = 1; next }
		END {
			for (i = 1; i <= c; i++) {
				n = order[i]
				if ((n in seen) && !(n in d) && !(n in fixed))
					print n "\t" (gateof[n] == "" ? "-" : gateof[n]) "\t" dateof[n] "\t" delof[n] "\t" text[n]
			}
		}
	'
}

# ==============================================================================
# `review`: the standing findings, and one context's word on the tree
# ==============================================================================
#
# THE REVIEW PROJECTION in this script's header is the whole of what these do.
# `review_collect` writes `$WORK/standing` — the rows with the item folder in an
# eighth column — and `review_attest` reads it. The window and the slugs are the
# argument parse's.

day_before() { # $1 days ago -> that date, or nothing where this host cannot say
	date -d "$1 days ago" +%Y-%m-%d 2>/dev/null && return 0
	date -v-"$1"d +%Y-%m-%d 2>/dev/null && return 0
	return 1
}

review_window_of() { # $1 a record file -> the item's closure date, else its last verdict's, else nothing
	[ -f "$1" ] || return 0
	nocr "$1" | awk '
		/^## verdict — evaluate — into / { k = split($0, f, " — "); v = f[k] }
		/^## closed — / { k = split($0, f, " — "); c = f[k] }
		END { if (c != "") print c; else if (v != "") print v }
	'
}

review_in_window() { # $1 an item's window date -> 0 it is in this review
	case "$review_window" in
	all) return 0 ;;
	today) [ "$1" = "$review_today" ] ;;
	yesterday) [ "$1" = "$review_from" ] ;;
	week | since)
		# Fixed-width dates compare as numbers once the dashes are gone.
		[ -n "$1" ] || return 1
		[ "$(printf '%s' "$1" | tr -d -)" -ge "$(printf '%s' "$review_from" | tr -d -)" ] 2>/dev/null
		;;
	esac
}

review_dirs() { # -> the item folders this review reads, one a line
	if [ -n "$review_slugs" ]; then
		for _rd in $review_slugs; do
			if [ -f "$ITEMS/$_rd/brief.md" ]; then
				printf '%s\n' "$ITEMS/$_rd"
			else
				printf '%s\n' "$ITEMARCH/$_rd"
			fi
		done
		return 0
	fi
	for _rd in "$ITEMS"/*/ "$ITEMARCH"/*/; do
		[ -f "${_rd}brief.md" ] || continue
		printf '%s\n' "${_rd%/}"
	done
}

review_collect() { # -> $WORK/standing: item, stage, gate, date, n, text, delivery, folder
	review_dirs | while IFS= read -r _rc_d; do
		_rc_s=${_rc_d##*/}
		review_in_window "$(review_window_of "$_rc_d/log.md")" || continue
		_rc_st=$(hdr "$_rc_d/brief.md" Stage)
		[ -n "$_rc_st" ] || _rc_st='-'
		standing_findings "$_rc_d/log.md" | while IFS="$TAB" read -r _rc_n _rc_g _rc_dt _rc_dl _rc_tx; do
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$_rc_s" "$_rc_st" "$_rc_g" "$_rc_dt" "$_rc_n" "$_rc_tx" "$_rc_dl" "$_rc_d"
		done
	done | sort -t "$TAB" -k1,1 -k5,5n >"$WORK/standing"
}

# ONE raise, and not the chain's `invoke`: that one is bound to an item — its
# marker, its runs home, its seeded artefacts — and a review has no item. What
# the two share is the seam's contract and the `- raise:` line, and both are
# reached the same way.
review_raise() { # $1 the briefing  $2 where the seam's text lands -> the seam's exit
	: >"$WORK/prov"
	_rr_t0=$(secs)
	REMIT_ITEM='' \
		REMIT_RUNS='' \
		REMIT_RUNS_NAMING='' \
		REMIT_AUTHORITY="$1" \
		REMIT_RUBRICS='' \
		REMIT_STANDARDS='' \
		REMIT_SETTINGS="$SETTINGSFILE" \
		REMIT_PROVENANCE="$WORK/prov" \
		REMIT_ROUND=1 \
		REMIT_DELIVERY='' \
		REMIT_RESEARCH_AUTHOR='' \
		REMIT_MUSTFIX='' \
		REMIT_REVIEW=yes \
		sh "$INVOKE" evaluate review "$root" >"$2" 2>"$WORK/invoke.err" </dev/null &
	RAISE_PID=$!
	wait "$RAISE_PID"
	_rr_rc=$?
	_rr_t1=$(secs)
	RAISE_PID=''
	[ "$_rr_rc" = 0 ] && raise_line evaluate "$_rr_t0" "$_rr_t1"
	if [ "$_rr_rc" != 0 ]; then
		printf '%s: the seam refused the review raise (exit %s):\n' "$ME" "$_rr_rc" >&2
		sed 's/^/    /' "$WORK/invoke.err" >&2
	fi
	return $_rr_rc
}

review_attest() { # reads $WORK/standing; returns what the commit returned
	# `grep -c` prints its 0 AND exits 1 on nothing, so the fallback is not `||`.
	_ra_count=$(grep -c . "$WORK/standing" 2>/dev/null)
	[ -n "$_ra_count" ] || _ra_count=0
	if [ "$_ra_count" = 0 ]; then
		say "nothing standing in this window — nothing raised, nothing recorded."
		return 0
	fi
	_ra_head=$(git -C "$root" rev-parse --short HEAD 2>/dev/null) || _ra_head='an unreadable HEAD'
	{
		printf '# A review of the standing findings\n\n'
		printf 'These are the findings the last verdict at each gate of a work item still\n'
		printf 'carried with no disposition — %s of them, across the items named below. Each\n' "$_ra_count"
		printf 'was made against a delivery at the time; you are standing in the primary\n'
		printf 'worktree at HEAD, `%s`, and the question is what is true of THE TREE NOW.\n\n' "$_ra_head"
		printf 'For EACH finding return exactly one line, in this shape and no other:\n\n'
		printf '  Attest: <item> <n>: stands | fixed | moot — <evidence from the tree, never the record>\n\n'
		printf '  stands  the finding is still true in the code now — name where.\n'
		printf '  fixed   name the commit or file that closed it. A fix made outside the loop —\n'
		printf '          by hand, by another item, by a refactor — counts exactly the same.\n'
		printf '  moot    the code it was about no longer exists — name what replaced it.\n\n'
		printf 'Three words, and no fourth. The prose after the dash is carried into the record\n'
		printf 'verbatim, so make it the evidence: a path, a line, a commit. A finding you\n'
		printf 'cannot attest is left out and is recorded as not attested; never guess one.\n'
		printf 'You are attesting the tree, not re-judging the work: no verdict, no must-fix,\n'
		printf 'and no finding of your own.\n\n'
		printf '## The standing findings\n\n'
		awk -F'\t' '{ printf "- %s %s — at the gate into %s, %s, against %s:\n  %s\n", $1, $5, $3, $4, $7, $6 }' "$WORK/standing"
	} >"$WORK/review.md"
	review_raise "$WORK/review.md" "$WORK/attest" ||
		die "the seam refused the review raise — nothing was recorded"
	# The three words, parsed as the verdict lines are: emphasis stripped, the
	# first line for a finding wins, the prose after the dash carried whole.
	nocr "$WORK/attest" | sed \
		-e 's/^[*_`]\{1,3\}Attest:[*_`]\{0,3\} */Attest: /' \
		-e '/^Attest: /s/[*_`]\{1,3\}$//' |
		sed -n "s/^Attest: *\([a-z0-9-][a-z0-9-]*\) *\([0-9][0-9]*\): *\(stands\|fixed\|moot\)\( *\(—\|--\|-\) *\(.*\)\)\{0,1\}\$/\1$TAB\2$TAB\3$TAB\6/p" \
		>"$WORK/attested"
	# One result a standing finding: folder, number, word, evidence.
	: >"$WORK/results"
	while IFS="$TAB" read -r _ra_s _ra_st _ra_g _ra_dt _ra_n _ra_tx _ra_dl _ra_d; do
		_ra_a=$(awk -F'\t' -v s="$_ra_s" -v n="$_ra_n" '$1 == s && $2 == n { print $3 "\t" $4; exit }' "$WORK/attested")
		[ -n "$_ra_a" ] || _ra_a="not attested$TAB"
		printf '%s\t%s\t%s\t%s\n' "$_ra_d" "$_ra_n" "${_ra_a%%"$TAB"*}" "${_ra_a#*"$TAB"}" >>"$WORK/results"
	done <"$WORK/standing"
	# The raise line goes into EVERY entry this review writes, so it is taken
	# out of the queue `log_append` would otherwise hand to the first alone.
	_ra_rl=''
	[ -s "$RAISES" ] && _ra_rl=$(cat "$RAISES")
	: >"$RAISES"
	_ra_paths=''
	cut -f1 "$WORK/results" | sort -u >"$WORK/dirs"
	while IFS= read -r _ra_d; do
		_ra_s=${_ra_d##*/}
		case "$_ra_d" in
		"$ITEMARCH"/*) _ra_rel=".remit/work-items/.archive/$_ra_s" ;;
		*) _ra_rel=".remit/work-items/$_ra_s" ;;
		esac
		log="$_ra_d/log.md"
		{
			[ -n "$_ra_rl" ] && printf '%s\n\n' "$_ra_rl"
			printf -- '- tree: %s — the primary worktree at HEAD\n' "$_ra_head"
			awk -F'\t' -v d="$_ra_d" '$1 == d {
				if ($3 == "not attested") print "- finding " $2 ": not attested"
				else if ($4 == "") print "- finding " $2 " attested: " $3
				else print "- finding " $2 " attested: " $3 " — " $4
			}' "$WORK/results"
		} | log_append "reviewed — $(now)"
		_ra_paths="$_ra_paths $_ra_rel"
	done <"$WORK/dirs"
	_ra_n_stands=$(awk -F'\t' '$3 == "stands" { c++ } END { print c + 0 }' "$WORK/results")
	_ra_n_fixed=$(awk -F'\t' '$3 == "fixed" { c++ } END { print c + 0 }' "$WORK/results")
	_ra_n_moot=$(awk -F'\t' '$3 == "moot" { c++ } END { print c + 0 }' "$WORK/results")
	_ra_n_none=$(awk -F'\t' '$3 == "not attested" { c++ } END { print c + 0 }' "$WORK/results")
	say ""
	say "attested $_ra_count standing finding(s): $_ra_n_stands stands, $_ra_n_fixed fixed, $_ra_n_moot moot, $_ra_n_none not attested"
	say "recorded as ## reviewed on $(grep -c . "$WORK/dirs") item(s), at tree $_ra_head."
	# shellcheck disable=SC2086
	commit_and_push "remit: review — $_ra_count standing finding(s) attested at $_ra_head" $_ra_paths
}

# The one line the closing verb says about the seal, so that closing on his word
# is informed by a number he can read rather than a scroll he cannot.
SEALED=0
seal_line() {
	if [ "$SEALED" = 0 ]; then
		printf 'No finding was standing.'
	elif [ "$SEALED" = 1 ]; then
		printf '1 finding standing at the last verdict, sealed pre-authorised — log.md names it.'
	else
		printf '%s findings standing at the last verdict, sealed pre-authorised — log.md names them.' "$SEALED"
	fi
}
do_close() { # $1 authority for this closure, in words  $2 delivery text  $3 `closed` to stamp it
	_auth=$1 _delivery=$2 _stamp=${3:-}
	log_ensure
	# THE SWEEP, before anything is written and well before the move: what it
	# leaves is what the move carries into the archive, and what it says is part
	# of the entry composed below.
	runs_sweep
	# THE STANDING SET, not every round's — `standing_findings` above is the one
	# reader of it, and the seal is that set written as dispositions.
	standing_findings "$log" |
		awk -F'\t' '{ print "- finding " $1 " disposition: pre-authorised — " $5 }' >"$WORK/seals"
	SEALED=$(grep -c '^- finding ' "$WORK/seals" 2>/dev/null)
	[ -n "$SEALED" ] || SEALED=0
	{
		printf -- '- authority: %s\n\n' "$_auth"
		if [ -n "$_delivery" ]; then
			printf 'Delivery:\n\n'
			printf '%s\n\n' "$_delivery"
		fi
		if [ -s "$WORK/seals" ]; then
			printf '%s standing finding(s) — those the last verdict at each gate still\n' "$SEALED"
			printf 'carried, with no disposition — sealed by this closure as pre-authorised.\n'
			printf 'That is what the closure did — never a ruling the practitioner made on\n'
			printf 'each one. A finding an earlier round raised and the last verdict did not\n'
			printf 'carry was cleared, and is not sealed.\n\n'
			cat "$WORK/seals"
		else
			printf 'No finding was standing without a disposition.\n'
		fi
		printf '\n'
		runs_report
		if [ "$_stamp" = closed ]; then
			printf '\nStage: closed — this closure came through the closing gate and stamped it.\n'
		else
			printf '\nStage: %s — ARCHIVED AS IT STOOD. This closure stamped no stage: the\n' "$(hdr "$brief" Stage)"
			printf 'practitioner ended the work, and ending it is not taking it through the\n'
			printf 'gate. A brief that depends on this item still waits.\n'
		fi
	} | log_append "closed — $(now)"
	if [ "$_stamp" = closed ]; then
		put_header "$brief" '' closed "$(hdr "$brief" Until)" KEEP
	else
		put_header "$brief" '' "$(hdr "$brief" Stage)" "$(hdr "$brief" Until)" KEEP
	fi
	ensure_dir "$ITEMARCH" || die "could not create $ITEMARCH"
	# THE MARKER GOES BEFORE THE FOLDER MOVES: a chain closing its own item still
	# holds it here, and the exit trap could not find it in the archive.
	marker_release
	[ -f "$item/$marker_name" ] && ! marker_alive "$item/$marker_name" && rm -f "$item/$marker_name"
	mv "$item" "$itemarchive" || die "could not archive $slug"
}

# ==============================================================================
# the shape of .remit/rules/, and the rubrics remit ships
# ==============================================================================
#
# The four section headings a gate file is written under, and the rubrics remit
# ships under them. `rubrics_shipped` is the ONE home of the shipped rubric text:
# the installer reads it through `remit rules ship`. `rubrics_seed` NEVER
# overwrites a file that is already there — what is there is the practitioner's
# — and sets SEEDED to what it wrote; migrating a target rubric by rubric is
# `install.sh`'s, through `rules read` and `rules apply`.

# One line per shipped rubric: <gate> <section> <id> <criterion>, tab separated.
# r0 is the universal first question: an idea nobody could judge delivered or not
# is not yet a brief. r1 asks it of the one machine-authored artefact at that
# gate, and is the rubric a `Back to: research` verdict cites. Its evidence is
# the DOCUMENT against ITS OWN kept manifests and citations — a zero or absent
# `consulted` count proves nothing — its defect is FINITE (a fabricated
# quotation, a claim its source contradicts, a wrong assumption a design rests
# on), mapping incompleteness is a `Finding:` and not a must-fix, and a claim the
# research MARKS unestablished is a `Finding:` too. THE BOUND IS IN THE RUBRIC'S
# OWN TEXT, not in this script's parser: what counts as a must-fix is a judgement
# standard, and those are his, in gate files a retro rewrites. a4 and a5 are what
# a delivery owes its own proof: what one of remit's own scripts decides is
# asserted, and what a third party decides is asserted against that third party.
rubrics_shipped() {
	printf 'refined\tfix\tr0\tthere is enough here to evaluate — an outcome a stranger could judge delivered or not\n'
	printf 'refined\tfix\tr1\tresearch states as established what its own kept evidence contradicts or does not carry — a fabricated or misquoted source, a claim the source it cites does not support, or an unsourced vendor behaviour that BEARS ON A DECISION the brief asks this research to inform AND IS ASSERTED RATHER THAN MARKED. A claim the research itself records as unestablished — naming what it could not establish and why — is not stated as established: it is a `Finding:`, never a must-fix, however much it bears on a decision, because there is no page to cite for what no page says, and a research pass that marks its unknowns honestly must not read as one that invented them. Judge the document against its own citations and against the fetch manifests kept for this item, read on their merits. A claim that is merely UNMAPPED — not shown wrong, and changing no decision the brief asks for — is a `Finding:` and cites nothing, never a must-fix: unmapped sentences grow with the document and every repair round adds more, so a rubric satisfied only by total mapping has no stopping condition. A zero or absent `consulted` count is NOT evidence of non-consultation: it counts server-side web tools only, a client-side fetch path is counted in no channel this mechanism reads, and there a research pass that did the work looks identical to one that invented it\n'
	printf 'accepted\tfix\ta4\ta change to what a script decides, reads, writes, refuses, reports or exits with lands a unit test for that behaviour in the same delivery\n'
	printf 'accepted\tfix\ta5\ta behaviour that depends on a third party that can change under us — a CLI, an account, a model, a network — lands an integration assertion, or names itself uncovered with the reason\n'
}

SEEDED=''
rubrics_seed() {
	ensure_dir "$RUBRICS" || die "could not create .remit/rules"
	SEEDED=''
	for _g in refined accepted closed; do
		_p="$RUBRICS/$_g.md"
		[ -e "$_p" ] && continue
		{
			printf '# What it takes to become `%s`\n\n' "$_g"
			printf 'The practitioner'"'"'s rubrics for this gate, in his words, each under the ruling\n'
			printf 'it came from and its date. `bin/remit` hands THIS FILE, and no other, to the\n'
			printf 'fresh context that evaluates at this gate, and acts only on the citations that\n'
			printf 'context returns. What each section does, and the shape of a line, are in\n'
			printf '`bin/remit`'"'"'s header. Only a retro he calls writes here.\n\n'
			for _s in promote hold fix accept; do
				printf '## %s\n' "$_s"
				_lines=$(rubrics_shipped |
					awk -F"$TAB" -v g="$_g" -v s="$_s" '$1 == g && $2 == s { printf "- %s: %s\n", $3, $4 }')
				[ -n "$_lines" ] && printf '\n%s\n' "$_lines"
				[ "$_s" = accept ] || printf '\n'
			done
		} >"$_p"
		SEEDED="$SEEDED $_g.md"
	done
	# NO roles.md: seats live in `.remit/settings.json`, the practitioner's own file,
	# which nothing writes unasked.
	return 0
}

# What a directory's gate files carry NOW, in the same four columns
# `rubrics_shipped` prints, read with the same parser this script judges a gate
# by — so the installer's view of a rubric cannot drift from the one that decides
# anything. A line this script cannot read is emitted as
# `!<TAB><gate><TAB><line-number><TAB><text>`, exactly as `rubrics_dump` does,
# and it is the caller's to refuse on.
rubrics_read_dir() { # $1 a directory holding refined.md, accepted.md, closed.md
	RUBRICS=$1
	for _f in refined accepted closed; do
		rubrics_dump_file "$_f"
	done
	return 0
}

# Apply an edit list to a directory's gate files. One op per stdin line —
# `<gate><TAB><section><TAB><id><TAB><op><TAB><text>`, op one of `add`, `set`,
# `del` — and NOTHING else in a file is touched. ONE EXCEPTION: a rewritten file
# comes out with LF endings, because it is read through `nocr` like every other
# reader of these files. An `add` whose section heading is not in the file is
# NOT invented: it is reported on stdout as
# `unplaced<TAB><gate><TAB><section><TAB><id>`.
rubrics_apply_dir() { # $1 the directory; the edit list on stdin
	RUBRICS=$1
	_ops="$WORK/rules-ops"
	tr -d '\015' >"$_ops"
	for _g in refined accepted closed; do
		_p="$RUBRICS/$_g.md"
		[ -f "$_p" ] || continue
		awk -F"$TAB" -v g="$_g" '$1 == g { print $2 "\t" $3 "\t" $4 "\t" $5 }' "$_ops" >"$WORK/rules-ops.$_g"
		[ -s "$WORK/rules-ops.$_g" ] || continue
		: >"$WORK/rules-unplaced.$_g"
		nocr "$_p" | awk -v opsfile="$WORK/rules-ops.$_g" -v unplaced="$WORK/rules-unplaced.$_g" -v g="$_g" '
			function secname(l,   s) {
				s = l
				sub(/^##[ \t]*/, "", s)
				sub(/[ \t]*$/, "", s)
				return tolower(s)
			}
			# Emit the section just closed: its own lines, then any rubric added
			# to it, after the last thing already in it and before the blank line
			# that separates it from the next heading.
			function flush(atend,   i, n) {
				n = nbuf
				if (nadd[sec] > 0) {
					while (n > 0 && buf[n - 1] ~ /^[ \t]*$/) n--
					for (i = 0; i < n; i++) print buf[i]
					if (n == 0 || buf[n - 1] !~ /^- /) print ""
					for (i = 0; i < nadd[sec]; i++) print addline[sec, i]
					if (!atend) print ""
					nadd[sec] = 0
				} else {
					for (i = 0; i < n; i++) print buf[i]
				}
				nbuf = 0
			}
			BEGIN {
				while ((getline opline < opsfile) > 0) {
					if (split(opline, f, "\t") < 4) continue
					if (f[3] == "add") {
						# +0 first: an unset count subscripts as "", not as 0,
						# and the add would then be stored where flush never
						# looks for it.
						k = nadd[f[1]] + 0
						addline[f[1], k] = "- " f[2] ": " f[4]
						addid[f[1], k] = f[2]
						nadd[f[1]] = k + 1
					} else if (f[3] == "set") {
						newtext[f[1], f[2]] = f[4]
						isset[f[1], f[2]] = 1
					} else if (f[3] == "del") {
						drop[f[1], f[2]] = 1
					}
				}
				close(opsfile)
				sec = ""
				nbuf = 0
			}
			/^##/ { flush(0); sec = secname($0); print; next }
			{
				if (sec != "" && $0 ~ /^- /) {
					rest = substr($0, 3)
					p = index(rest, ":")
					if (p >= 2) {
						id = substr(rest, 1, p - 1)
						if (id != "" && id !~ /[ \t]/) {
							if ((sec, id) in drop) next
							if ((sec, id) in isset) {
								buf[nbuf++] = "- " id ": " newtext[sec, id]
								next
							}
						}
					}
				}
				buf[nbuf++] = $0
			}
			END {
				flush(1)
				for (s in nadd) {
					for (i = 0; i < nadd[s]; i++) {
						u = "unplaced\t" g "\t" s "\t" addid[s, i]
						print u > unplaced
					}
				}
			}
		' >"$_p.remit-tmp" || die "could not rewrite $_p"
		mv "$_p.remit-tmp" "$_p" || die "could not replace $_p"
		cat "$WORK/rules-unplaced.$_g"
	done
	return 0
}

# ==============================================================================
# scratch, and the values every verb shares
# ==============================================================================

WORK=$(mktemp -d 2>/dev/null) || WORK=${TMPDIR:-/tmp}/remit-$$
ensure_dir "$WORK" || die "cannot make a scratch directory"
# `SAVETMP` is the half-written registry `setup --write` builds beside the real
# one. It is named here so that an interrupt between building it and renaming it
# leaves nothing behind: the registry is either the old file or the new one.
SAVETMP=''
# The raise in flight, so `invoke` can hand its pid to the marker. Ending it is
# `remit stop`'s, not this trap's: a trap that ended the very command that was
# ending it would lose the record.
RAISE_PID=''
# The `- raise:` lines that have not reached an entry yet. It goes with the run:
# a line names a raise THIS process made, and a run that ends without an entry to
# put it in leaves nothing behind rather than seeding the next one's record.
RAISES="$WORK/raises"
: >"$RAISES"
cleanup() { lock_drop; rm -rf "$WORK"; [ -n "$SAVETMP" ] && rm -f "$SAVETMP"; return 0; }
trap 'cleanup' EXIT
trap 'cleanup; marker_release; exit 130' INT TERM

ROUND=1
SHA=''
PR_NUM=''
PR_URL=''
FINALTEXT=''
# THE BASE IS THE REPOSITORY'S DEFAULT BRANCH, never whatever the primary
# worktree has checked out: origin's HEAD; failing that `main`; failing that
# `master`; only with none of those the current branch.
BASE=$(git -C "$root" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
if [ -z "$BASE" ]; then
	if git -C "$root" show-ref --verify --quiet refs/heads/main 2>/dev/null; then
		BASE=main
	elif git -C "$root" show-ref --verify --quiet refs/heads/master 2>/dev/null; then
		BASE=master
	else
		BASE=$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'main\n')
	fi
fi
AUTHORITY="$brief"
AUTHORITY_REL=''
AUTHORITY_HASH=''
# A phase found waiting at the `accepted` stop, adopted after the chain stops.
PHASE_QUEUED=''

# The gate a run of the loop is judging, and what its evaluator cited there.
GATE=''
# The gate the work is HEADING INTO, whose `fix` section is the authoring roles'
# bar. It is the same gate while the loop runs; `research` runs before the first
# gate and is held to that gate's bar too.
STANDARDS_GATE=''
GATE_PROMOTE=''
GATE_HOLD=''
LOOP_STOP=''
LOOP_STOP_DETAIL=''
# The prose a stop-for-the-practitioner puts on the record, set where the stop is
# decided so that the reason and its explanation are written in one place.
LOOP_STOP_NOTE=''

# ==============================================================================
# the verbs
# ==============================================================================

# ==============================================================================
# `new`: admit the item, and then run the chain when his word says to
# ==============================================================================
#
# `new` is the same chain `resume` is, decided once from what he said and what
# `refined.md` carries:
#
#   --park, nothing else    it sits: he named no stop to go to.
#   --until X               the chain runs NOW, in this command, and prints the
#                           row where it stopped. A `--park` beside it is the
#                           ceiling on the promotes and the rest at X —
#                           `**Until:**` in this script's header.
#   nothing said            the chain runs only if `refined.md`'s `promote`
#                           section carries something a gate's evaluator could
#                           cite; otherwise nothing is raised and it sits at
#                           `new` with `until ran out`.
#
# Sets CHAIN, and returns what the commit returned.
CHAIN=no
create_item() {
	rubrics_check
	[ -n "$want_until" ] && registry_check
	[ -e "$item" ] && die "work item '$slug' already exists at .remit/work-items/$slug"
	[ -e "$itemarchive" ] && die "'$slug' is already archived at .remit/work-items/.archive/$slug"
	ensure_dir "$item" || die "could not create $item"
	tr -d '\015' >"$brief"
	if [ ! -s "$brief" ]; then
		rm -rf "$item"
		die "no brief on stdin"
	fi
	case "$(sed -n '/./{p;q;}' "$brief")" in
	'# '*) ;;
	*) rm -rf "$item"; die "the brief must begin with a '# Title' heading" ;;
	esac
	# WHAT IT DEPENDS ON is his and OPTIONAL — omitted is `none`. A line that is
	# THERE and cannot be read whole is refused. Nothing here writes the line.
	if ! depends_on_names "$brief"; then
		rm -rf "$item"
		die "the brief's '**Depends on:**' line cannot be read whole — $DEPENDS_ON_BAD. That line names work items by slug, comma-separated, or the word 'none'; omitting it altogether means none. Ask him; nothing here may answer it for him."
	fi
	# `--park` with no `--until` files the item without running it. `--park` beside
	# an `--until` is one ruling with it: the item is born ACTIVE and runs —
	# `**Until:**` in this script's header.
	if [ "$want_park" = yes ] && [ -z "$want_until" ]; then
		att=parked
	else
		att=active
	fi
	CHAIN=no
	if [ -n "$want_until" ]; then
		CHAIN=yes
	elif [ "$want_park" = no ] && [ -n "$(rubric_ids refined promote)" ]; then
		CHAIN=yes
	fi
	recorded_until=$(until_value "$want_until" "$want_park")
	put_header "$brief" "$att" new "$recorded_until" ''
	log_ensure
	# AFTER the header is written, because the digest is of his words and the
	# header lines are cut out of it either way — but the file has to be the one
	# every later read sees.
	resolve_authority
	[ -n "$recorded_until" ] &&
		printf 'Recorded at admission.\n' | log_append "ruling — until $recorded_until — $(now)"
	if [ "$CHAIN" != yes ] && [ "$want_park" = yes ]; then
		{
			printf 'Filed. A parked item moves for nothing — not for a promote, not for anything\nbut `remit resume`.\n\n'
			authority_lines
		} | log_append "stopped — parked — $(now)"
		say "created .remit/work-items/$slug — parked at stage new."
	elif [ "$CHAIN" = yes ]; then
		{
			if [ "$want_park" = yes ]; then
				printf 'Born active at `new`. The chain runs now, in this same command, as far as\n`%s` — and rests there: on reaching `%s` the item parks, and no promote may\ncarry it past.\n\n' "$want_until" "$want_until"
			elif [ -n "$want_until" ]; then
				printf 'Born active at `new`. The chain runs now, in this same command, as far as\n`%s`.\n\n' "$want_until"
			else
				printf 'Born active at `new`. Nothing was said about how far it may go, and\n`refined.md` carries a `promote` a gate could cite, so the chain asks that\ngate now, in this same command.\n\n'
			fi
			authority_lines
		} | log_append "admitted — $(now)"
		say "created .remit/work-items/$slug — active at stage new${recorded_until:+, until $recorded_until}."
	else
		{ printf 'Born active at `new`.\n\n'; authority_lines; } | log_append "stopped — until ran out — $(now)"
		say "created .remit/work-items/$slug — active at stage new."
	fi
	commit_and_push "remit: create $slug" ".remit/work-items/$slug"
}

# `new` that runs the chain IS `resume`, in the same invocation: the item was
# just written, the ruling is already on its header, and there is exactly one
# implementation of a gate in this script. The `--until` is not passed on — it
# was recorded at admission, and recording it twice would put two rulings in the
# record for one word of his.
if [ "$cmd" = new ]; then
	create_item
	_nrc=$?
	if [ "$CHAIN" != yes ]; then
		exit $_nrc
	fi
	[ "$_nrc" = 2 ] && exit 2
	[ "$_nrc" = 3 ] && PUSH_FAILED=yes
	cmd=resume
	want_until=''
	want_park=no
fi

# ==============================================================================
# answer — his words filed as a ruling, then the road resume takes
# ==============================================================================
#
# The law is AN EVALUATOR MAY ASK under THE THREE GATES; this is only its verb.
# Everything below READS before it writes, so a refusal changes nothing; the one
# write is the append to the authority and the entry that records it, and then
# the verb becomes `resume` — the same code, the same stops, the until already
# on the brief — because an answer that did not move the item would be a
# ruling nobody acted on.
record_answer() {
	[ -f "$brief" ] || die "no work item '$slug' — expected .remit/work-items/$slug/brief.md"
	[ "$(hdr "$brief" Stage)" = closed ] && die "'$slug' is closed. Closed work has left every view; nothing answers it."
	[ -f "$log" ] || die "'$slug' has no record, so it carries no question to answer"
	# The LAST `asked:` stop, and the questions it numbered. Read from the record
	# and never from memory: the number he gives is the number the entry gave.
	_ans_block=$(nocr "$log" | awk '
		/^## stopped — asked: / { inblock = 1; block = ""; next }
		/^## / { inblock = 0; next }
		inblock && /^- question [0-9]+: / { block = block $0 "\n" }
		END { printf "%s", block }
	')
	[ -n "$_ans_block" ] || die "'$slug' carries no open question: no \`asked:\` stop is on its record"
	_ans_q=$(printf '%s' "$_ans_block" | sed -n "s/^- question $answer_n: //p" | sed -n 1p)
	[ -n "$_ans_q" ] || die "'$slug' carries no question $answer_n — the record numbers $(printf '%s' "$_ans_block" | grep -c '^- question ') at its last stop"
	# WHOSE RULING STANDS ON THIS QUESTION ALREADY, if any. NOTHING IS REFUSED FOR
	# HAVING BEEN ANSWERED: every answer appends, the latest line stands, and the
	# record shows the sequence and whose each was — which is what makes an override
	# safe.
	_ans_prior=$(nocr "$log" | awk '
		/^## stopped — asked: / { after = 1; prior = ""; next }
		after && /^## ruling — Q'"$answer_n"' answered/ {
			prior = (index($0, "by the conductor") > 0) ? "conductor" : "practitioner"
		}
		END { print prior }
	')
	_ans_head="ruling — Q$answer_n answered"
	_ans_mark=''
	if [ "$answer_by" = conductor ]; then
		_ans_head="$_ans_head by the conductor, provisionally"
		_ans_mark=' by the conductor, provisionally'
	fi
	case "$_ans_prior" in
	conductor) _ans_head="$_ans_head, superseding the conductor's ruling" ;;
	practitioner) _ans_head="$_ans_head, superseding the practitioner's ruling" ;;
	esac
	resolve_authority
	case "$AUTHORITY" in
	AMBIGUOUS) die "'$slug' names more than one **Current phase:** — the smallest ruling that unsticks this is which one" ;;
	"DANGLING "*) die "'$slug' points at a phase file that is not there: ${AUTHORITY#DANGLING }" ;;
	esac
	[ -f "$AUTHORITY" ] || die "'$slug' has no authority file to carry a ruling"
	# THE ONE WRITE. A `## Rulings` heading once, at the end; then one line per
	# answer — the date, the question it answers (the evaluator's words, marked
	# as asked), whose the ruling is where it is not his, and the words as
	# given. A later answer to the same question is one more line below it: the
	# latest stands, and nothing above it is edited. Nothing else in the file
	# is touched.
	{
		nocr "$AUTHORITY" | grep -q '^## Rulings' || printf '\n## Rulings\n'
		printf '\n- %s — asked: %s — ruled%s: %s\n' "$(now)" "$_ans_q" "$_ans_mark" "$answer_text"
	} >>"$AUTHORITY" || die "could not write the ruling into $AUTHORITY_REL"
	resolve_authority
	{
		printf -- '- question %s: %s\n' "$answer_n" "$_ans_q"
		printf -- '- ruled%s: %s\n' "$_ans_mark" "$answer_text"
		[ "$answer_by" = conductor ] &&
			printf -- '- by: the conductor, under the standing elevation the practitioner gave it — provisional until he reviews it, and his to supersede\n'
		[ -n "$_ans_prior" ] &&
			printf -- '- supersedes: the %s'\''s ruling on this question above; the latest stands\n' "$_ans_prior"
		printf -- '- filed under `## Rulings` in `%s`, verbatim; the stage is unchanged and the chain resumes where it is\n' "$AUTHORITY_REL"
		printf '\n'
		authority_lines
	} | log_append "$_ans_head — $(now)"
	commit_step "remit: $slug $_ans_head" ".remit/work-items/$slug"
	say "ruling: question $answer_n answered${_ans_mark}, filed under \`## Rulings\` in \`$AUTHORITY_REL\`. Resuming."
	return 0
}
if [ "$cmd" = answer ]; then
	record_answer
	cmd=resume
	want_until=''
	want_park=no
fi

case "$cmd" in

park)
	[ -f "$brief" ] || die "no work item '$slug' — expected .remit/work-items/$slug/brief.md"
	st=$(hdr "$brief" Stage)
	valid_stage "$st" || die "'$slug' has no readable **Stage:** line — nothing here infers one"
	# Which of the two parks this is, decided BEFORE anything is asked that only
	# one of them has to answer. An item already parked moves no header, so it
	# never reaches `put_header` and the title question below is not its
	# question: asking it there would refuse a park that had nothing to write.
	park_moves=yes
	[ "$(hdr "$brief" Attention)" = parked ] && park_moves=no
	# Asked here rather than left to the `put_header` below, which is where it
	# would otherwise refuse — after the marker had gone.
	[ "$park_moves" = yes ] && require_title "$brief"
	# LAST of the preconditions, because it WRITES — the reason is stated once,
	# at `crash_take`.
	crash_take ||
		die "a resume of '$slug' is in progress — its marker is at .remit/work-items/$slug/.working"
	if [ "$park_moves" = no ]; then
		# Parking an item that is already parked moves no header — but if there
		# was a crashed marker it has just come off the board, and THAT is a
		# change, so it is recorded and committed like any other. Only where
		# there was no marker does this exit having written nothing.
		if [ -n "$CRASH_NOTE" ]; then
			resolve_authority
			{
				printf 'Already parked, so no header moved. What this park did was take a crashed\n'
				printf 'chain off the board.\n\n'
				printf -- '- a crashed chain'"'"'s marker was wiped by this park: %s\n\n' "$CRASH_NOTE"
				authority_lines
			} | log_append "stopped — parked, and a crashed chain wiped — $(now)"
			say "crashed: $CRASH_NOTE. The marker is gone — parking wiped it."
			say ".remit/work-items/$slug was already parked, at stage $st; the crash is off the board."
			commit_and_push "remit: $slug — a crashed chain's marker wiped at a park" ".remit/work-items/$slug"
			exit $?
		fi
		say ".remit/work-items/$slug is already parked — nothing to commit."
		exit 0
	fi
	put_header "$brief" parked "$st" "$(hdr "$brief" Until)" KEEP
	resolve_authority
	{
		printf 'Parked by the practitioner. It moves for nothing until it is resumed.\n\n'
		[ -n "$CRASH_NOTE" ] &&
			printf -- '- a crashed chain'"'"'s marker was wiped by this park: %s\n\n' "$CRASH_NOTE"
		authority_lines
	} | log_append "stopped — parked — $(now)"
	[ -n "$CRASH_NOTE" ] && say "crashed: $CRASH_NOTE. The marker is gone — parking wiped it."
	say ".remit/work-items/$slug is now parked, at stage $st."
	commit_and_push "remit: $slug -> parked" ".remit/work-items/$slug"
	exit $?
	;;

stop)
	# His word that the in-flight work is gone: ends the chain running on the item,
	# refuses only with no marker at all, leaves the header alone. IT DISPOSES ITS
	# OWN MARKER, always and first, which is what makes the crashed class mean one
	# thing; a marker whose chain is already gone is a CRASH, and this verb ends it
	# too, saying which it found.
	[ -f "$brief" ] || die "no work item '$slug' — expected .remit/work-items/$slug/brief.md"
	[ -f "$marker" ] ||
		die "nothing is running for '$slug' — there is no marker at .remit/work-items/$slug/.working. \`stop\` ends a chain in progress; at a stop there is nothing to end. To stop this item moving again, run: $ME park $slug"

	# ASKED BEFORE ANYTHING IS TAKEN AWAY, because it is the whole difference
	# between the two things this verb can be doing.
	stop_crashed=no
	stop_was=$(crashed_note "$marker")
	marker_alive "$marker" || stop_crashed=yes

	stop_pid=$(marker_field pid)
	case "$stop_pid" in '' | *[!0-9]*) stop_pid='' ;; esac
	stop_raise=$(marker_field raise)
	case "$stop_raise" in '' | *[!0-9]*) stop_raise='' ;; esac
	stop_step=$(marker_field step)
	[ -n "$stop_step" ] || stop_step='a step it did not record'
	# The pair the RUN was holding, so that anything the practitioner wrote while
	# it ran is still a change at his next resume.
	AUTHORITY_REL=$(marker_field authority)
	AUTHORITY_HASH=$(marker_field hash)

	stop_host=$(marker_field host)
	stop_ended='no resume was still alive at the pid in the marker'
	if [ -n "$stop_host" ] && [ "$stop_host" != "$(this_host)" ]; then
		# The marker travelled here in a commit. Its pid names a process on
		# another machine, and whatever holds that number HERE has nothing to do
		# with remit — so nothing is signalled, and the clean-up below still runs.
		stop_ended="the marker was written on $stop_host, not on this machine ($(this_host)), so no process here was signalled"
		stop_pid=''
		stop_raise=''
	fi

	# THE LOCK GOES FIRST, before anything is signalled. A chain whose raise dies
	# under it cannot tell that from a raise that failed by any other means, and
	# would escalate naming the seam — so the marker it re-reads is taken away
	# first, and the chain reads its absence as his word rather than as a fault.
	rm -f "$marker"
	if [ "$stop_crashed" = yes ]; then
		say "this chain had already $stop_was; \`stop\` ends it and disposes its marker."
	fi

	# THEN WHAT IT RAISED. A chain sits inside its raise for almost all of the
	# time it is running, and a raise left alive would go on writing into the
	# worktree this is about to discard — so the raised tree is ended, then the
	# chain follows it out, and only then is the worktree touched.
	stop_raised=$(end_raised "$stop_raise")
	say "$stop_raised."

	if [ -n "$stop_pid" ] && [ "$stop_pid" != "$$" ] && kill -0 "$stop_pid" 2>/dev/null; then
		if kill -TERM "$stop_pid" 2>/dev/null; then
			stop_ended="TERM was sent to the resume at pid $stop_pid"
		else
			stop_ended="the resume at pid $stop_pid could not be signalled from here"
		fi
	fi
	say "$stop_ended."

	# And it is WAITED FOR. A clean that raced a chain still running would report
	# a discard it had not made. Where the chain outlasts the wait this says so
	# rather than passing over it: what it writes from then on is not covered.
	stop_left=''
	stop_waited=0
	while [ -n "$stop_pid" ] && [ "$stop_pid" != "$$" ] && kill -0 "$stop_pid" 2>/dev/null; do
		if [ "$stop_waited" -ge 20 ]; then
			stop_left=", and the chain at pid $stop_pid had NOT ended after ${stop_waited}s — anything it writes from here is NOT covered by that"
			break
		fi
		sleep 1
		stop_waited=$((stop_waited + 1))
	done

	# The tree is reset to its last commit and everything untracked removed; what
	# was committed and delivered earlier is untouched.
	WT=$(worktree_path)
	stop_tree="there is no build worktree at $WT, so nothing was discarded"
	if [ -e "$WT/.git" ]; then
		if git -C "$WT" reset -q --hard HEAD >/dev/null 2>&1 && git -C "$WT" clean -qfd >/dev/null 2>&1; then
			stop_tree="the build worktree at $WT was reset to its last commit and its untracked files removed"
		else
			stop_tree="the build worktree at $WT could NOT be cleaned — its in-flight changes are still there"
		fi
	fi
	stop_tree="$stop_tree$stop_left"
	say "$stop_tree."

	stop_reason="stopped on the practitioner's word at $stop_step"
	[ "$stop_crashed" = yes ] && stop_reason="stopped a crashed chain at $stop_step"
	stop_stage=$(hdr "$brief" Stage)
	{
		[ "$stop_crashed" = yes ] &&
			printf -- '- the chain was NOT running when this ran: %s\n' "$stop_was"
		printf -- '- %s\n' "$stop_raised"
		printf -- '- %s\n' "$stop_ended"
		printf -- '- %s\n' "$stop_tree"
		printf -- '- stage: %s (UNTOUCHED — this is the stage it last stopped at)\n\n' "$stop_stage"
		authority_lines
	} | log_append "stopped — $stop_reason — $(now)"
	say ".remit/work-items/$slug is at stage $stop_stage, and nothing is running on it."
	commit_and_push "remit: $slug $stop_reason" ".remit/work-items/$slug"
	exit $?
	;;

close)
	# Closure is only ever the practitioner's instruction. Nothing here decides
	# an item is finished; this makes their decision durable and complete.
	[ -f "$brief" ] || die "no work item '$slug' — expected .remit/work-items/$slug/brief.md"
	[ -e "$itemarchive" ] && die "'$slug' is already archived at .remit/work-items/.archive/$slug — nothing changed"
	# Asked here rather than left to the `put_header` inside `do_close`, which is
	# where it would otherwise refuse — after the marker had gone.
	require_title "$brief"
	# LAST of the preconditions, because it WRITES — the reason is stated once,
	# at `crash_take`.
	crash_take ||
		die "a resume of '$slug' is in progress — its marker is at .remit/work-items/$slug/.working"
	# Read the delivery links before anything moves, so a bad input cannot leave
	# an item half-closed.
	delivery=''
	[ -t 0 ] || delivery=$(tr -d '\015')
	{
		printf 'Closed on the practitioner'"'"'s word.\n'
		[ -n "$CRASH_NOTE" ] &&
			printf '\n- a crashed chain'"'"'s marker was wiped by this closure: %s\n' "$CRASH_NOTE"
	} | log_append "ruling — close — $(now)"
	# NO STAMP. His word ends the work; it does not take it through the gate.
	closing_stage=$(hdr "$brief" Stage)
	do_close "the practitioner's word" "$delivery" ''
	[ -n "$CRASH_NOTE" ] && say "crashed: $CRASH_NOTE. The marker is gone — archiving wiped it."
	say "closed .remit/work-items/$slug — archived whole to .remit/work-items/.archive/$slug, at stage $closing_stage. $(seal_line)"
	commit_and_push "remit: close $slug" ".remit/work-items/$slug" ".remit/work-items/.archive/$slug"
	exit $?
	;;

list)
	list_items "$listing"
	exit 0
	;;

review)
	# THE REVIEW PROJECTION in this script's header is the law of this verb.
	[ -d "$ITEMS" ] || die "no work items: $ITEMS does not exist."
	[ "$want_attest" = yes ] && registry_check
	review_today=$(now)
	case "$review_window" in
	yesterday) review_from=$(day_before 1) || die "this host cannot name yesterday — \`since <date>\` names the day outright" ;;
	week) review_from=$(day_before 6) || die "this host cannot name a week ago — \`since <date>\` names the day outright" ;;
	since) review_from=$review_since ;;
	esac
	for _s in $review_slugs; do
		[ -f "$ITEMS/$_s/brief.md" ] || [ -f "$ITEMARCH/$_s/brief.md" ] ||
			die "no work item '$_s' — open or archived, there is none"
	done
	review_collect
	cut -f1-7 "$WORK/standing"
	[ "$want_attest" = yes ] || exit 0
	review_attest
	exit $?
	;;

report)
	rfile="$REPORTS/$report_name.md"
	rarch="$REPORTARCH/$report_name.md"
	case "$report_cmd" in
	new)
		[ -e "$rfile" ] && die "a field report named '$report_name' already exists at .remit/field-reports/$report_name.md"
		ensure_dir "$REPORTS" || die "could not create $REPORTS"
		tr -d '\015' >"$rfile"
		if [ ! -s "$rfile" ]; then
			rm -f "$rfile"
			die "no report on stdin"
		fi
		say "filed .remit/field-reports/$report_name.md — an observation, not work."
		commit_and_push "remit: report $report_name" ".remit/field-reports/$report_name.md"
		exit $?
		;;
	close)
		[ -f "$rfile" ] || die "no field report '$report_name' — expected .remit/field-reports/$report_name.md"
		[ -e "$rarch" ] && die "'$report_name' is already archived at .remit/field-reports/.archive/$report_name.md"
		ensure_dir "$REPORTARCH" || die "could not create $REPORTARCH"
		mv "$rfile" "$rarch" || die "could not archive the report"
		say "archived .remit/field-reports/$report_name.md to .remit/field-reports/.archive/."
		commit_and_push "remit: close report $report_name" \
			".remit/field-reports/$report_name.md" ".remit/field-reports/.archive/$report_name.md"
		exit $?
		;;
	esac
	;;

setup)
	# PROPOSES. Bare, it writes, commits and pushes nothing: the registry is his
	# file. `--write` is his save going through this script rather than a
	# redirection, which would empty the file this reads before it opens it: one
	# save, after every read, atomic, committing nothing.
	command -v jq >/dev/null 2>&1 ||
		die "no 'jq' on PATH — the registry is JSON, and this proposal is built with jq rather than by pasting a format that then has to parse. Install jq, or write .remit/settings.json by hand from the shape in bin/remit-invoke's header"
	[ -f "$INVOKE" ] ||
		die "no seam at $INVOKE — the host probe lives there, because the script that has to FIND each CLI at raise time is the one place that knows where they are"

	err() { printf '%s\n' "$1" >&2; }

	probe="$WORK/probe"
	if ! sh "$INVOKE" --probe-host >"$probe" 2>"$WORK/probe.err"; then
		sed 's/^/    /' "$WORK/probe.err" >&2
		die "the host probe failed; nothing is proposed from a host this script could not read"
	fi

	# What is registered now, flattened as the seam flattens it, read BEFORE
	# anything is written.
	cur="$WORK/cur"
	: >"$cur"
	cur_ok=no
	had_registry=no
	if [ -f "$SETTINGSFILE" ]; then
		had_registry=yes
		if jq -r '
			( (.harnesses // {}) | to_entries[] | "H\t\(.key)\t\(.value.cli // "")\t\((.value.models // []) | join(" "))" ),
			( (.defaults  // {}) | to_entries[] | "D\t\(.key)\t\(.value.harness // "")\t\(.value.model // "")" )
		' "$SETTINGSFILE" >"$cur" 2>/dev/null; then
			cur_ok=yes
		else
			: >"$cur"
			# Unreadable: the save refuses and the proposal is offered, because the seats in
			# it are recoverable by fixing one line and unrecoverable once overwritten.
			[ "$want_write" = yes ] &&
				die "$SETTINGS_REL is there and this script cannot read it as JSON, so nothing in it can be carried forward and --write would overwrite seats only you know. Fix the file, or move it aside, then run --write. Without the flag this command still proposes a registry on stdout"
			err "note: $SETTINGSFILE is there and this script could not read it as JSON, so nothing was carried forward from it. \`bin/remit-invoke\` refuses every raise while that is true, and its own message names the line."
		fi
	fi

	# `roles.md` retires INTO this file. Its lines are the practitioner's own and
	# they are carried, not dropped: a role with a line there and no seat here
	# becomes a proposed seat, and the report says where it came from.
	rol="$WORK/rol"
	: >"$rol"
	if [ -f "$ROLESFILE" ]; then
		nocr "$ROLESFILE" | awk '
			/^##[[:space:]]/ { sec = tolower($2); next }
			sec != "roles" { next }
			/^-[[:space:]]/ {
				line = $0
				sub(/^-[[:space:]]*/, "", line)
				i = index(line, ":")
				if (i == 0) next
				r = substr(line, 1, i - 1)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", r)
				v = substr(line, i + 1)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
				if (split(v, w, /[[:space:]]+/) != 2) next
				print r "\t" w[1] "\t" w[2]
			}
		' >"$rol"
	fi

	from_cur() { # $1 H|D  $2 key  $3 field number -> the value, or empty
		awk -F"$TAB" -v k="$1" -v n="$2" -v f="$3" '$1 == k && $2 == n { print $f; exit }' "$cur"
	}
	from_rol() { # $1 role  $2 field number (2 harness, 3 model) -> the value, or empty
		awk -F"$TAB" -v n="$1" -v f="$2" '$1 == n { print $f; exit }' "$rol"
	}

	REPORT=''
	note() { REPORT="$REPORT$1
"; }

	# --- the harnesses this host actually has --------------------------------
	#
	# The probe's records are tab separated and some fields are legally EMPTY, so
	# each is cut out by position: `read` on a tab swallows an empty one.
	prop="$WORK/prop"
	: >"$prop"
	present=''
	catalogued=''
	while IFS= read -r pline; do
		[ -n "$pline" ] || continue
		ph=$(printf '%s\n' "$pline" | cut -f1)
		pcli=$(printf '%s\n' "$pline" | cut -f2)
		pstate=$(printf '%s\n' "$pline" | cut -f3)
		pwhere=$(printf '%s\n' "$pline" | cut -f4)
		pauth=$(printf '%s\n' "$pline" | cut -f5)
		pids=$(printf '%s\n' "$pline" | cut -f6)
		pnote=$(printf '%s\n' "$pline" | cut -f7)
		if [ "$pstate" != present ]; then
			note "  $ph — ABSENT: $pnote"
			continue
		fi
		present="$present $ph"
		note "  $ph — present at $pwhere${pauth:+; $pauth}"
		pmodels=$pids
		psrc='probed from this host'
		[ -n "$pids" ] && catalogued="$catalogued $ph"
		if [ -z "$pmodels" ]; then
			pmodels=$(from_cur H "$ph" 4)
			psrc='carried from the registry already here; nothing on this host confirms it either way'
		fi
		if [ -z "$pmodels" ]; then
			pmodels=$(awk -F"$TAB" -v hh="$ph" '$2 == hh { print $3 }' "$rol" | awk 'NF' | sort -u | tr '\n' ' ' | sed 's/ *$//')
			[ -n "$pmodels" ] && psrc='carried from .remit/rules/roles.md, which retires into this file; nothing on this host confirms it either way'
		fi
		if [ -z "$pmodels" ]; then
			note "      no model id — $pnote. Write the ids you mean."
		else
			note "      models: $pmodels ($psrc)"
			note "      $pnote"
		fi
		printf 'H%s%s%s%s%s%s\n' "$TAB" "$ph" "$TAB" "$pcli" "$TAB" "$pmodels" >>"$prop"
	done <"$probe"

	prop_has() { # $1 harness -> 0 when the proposal carries it
		awk -F"$TAB" -v h="$1" '$1 == "H" && $2 == h { f = 1 } END { exit f ? 0 : 1 }' "$prop"
	}
	prop_model() { # $1 harness  $2 model -> 0 when the proposal registers it there
		awk -F"$TAB" -v h="$1" -v m="$2" '
			$1 == "H" && $2 == h { n = split($4, w, " "); for (i = 1; i <= n; i++) if (w[i] == m) f = 1 }
			END { exit f ? 0 : 1 }' "$prop"
	}
	prop_add_model() { # $1 harness  $2 model — the seat has to be registered too
		awk -F"$TAB" -v OFS="$TAB" -v h="$1" -v m="$2" '
			$1 == "H" && $2 == h { $4 = ($4 == "" ? m : $4 " " m) } { print }' "$prop" >"$prop.new" &&
			mv "$prop.new" "$prop"
	}

	# --- the seat each role takes --------------------------------------------
	incomplete=no
	note ''
	note 'the seat each role takes'
	for role in research build evaluate; do
		seat_h='' seat_m='' seat_src=''
		cur_h=$(from_cur D "$role" 3)
		cur_m=$(from_cur D "$role" 4)
		if [ -n "$cur_h" ] && [ -n "$cur_m" ] && prop_has "$cur_h" && prop_model "$cur_h" "$cur_m"; then
			seat_h=$cur_h seat_m=$cur_m seat_src='already registered, and still here'
		else
			rol_h=$(from_rol "$role" 2)
			rol_m=$(from_rol "$role" 3)
			if [ -n "$rol_h" ] && [ -n "$rol_m" ] && prop_has "$rol_h"; then
				seat_h=$rol_h seat_m=$rol_m
				seat_src='carried from .remit/rules/roles.md, which retires into this file'
				if ! prop_model "$rol_h" "$rol_m"; then
					prop_add_model "$rol_h" "$rol_m"
					seat_src="$seat_src; $rol_m was added to $rol_h, and nothing on this host confirms it"
				fi
			fi
		fi
		if [ -n "$seat_h" ]; then
			note "  $role: $seat_h $seat_m ($seat_src)"
		else
			incomplete=yes
			if [ -n "$cur_h" ]; then
				note "  $role: EMPTY — it was seated on $cur_h $cur_m, and that is not what this host offers. Name one you do want."
			else
				note "  $role: EMPTY — nothing here seats it. Name one."
			fi
		fi
		printf 'D%s%s%s%s%s%s\n' "$TAB" "$role" "$TAB" "$seat_h" "$TAB" "$seat_m" >>"$prop"
	done

	awk -F"$TAB" '$1 == "H" && $4 == "" { f = 1 } END { exit f ? 0 : 1 }' "$prop" && incomplete=yes

	# --- drift, only where there is a registry to drift from -----------------
	if [ "$cur_ok" = yes ]; then
		drift=''
		# Cut by position, as above.
		while IFS= read -r cline; do
			[ -n "$cline" ] || continue
			k=$(printf '%s\n' "$cline" | cut -f1)
			a=$(printf '%s\n' "$cline" | cut -f2)
			b=$(printf '%s\n' "$cline" | cut -f3)
			c=$(printf '%s\n' "$cline" | cut -f4)
			case "$k" in
			H)
				if ! prop_has "$a"; then
					drift="$drift  $a is registered and this host does not have it — every raise on that seat refuses until it is installed or taken out
"
				else
					# ONLY where a catalogue was actually read. A CLI that ships
					# none says nothing about its ids, and silence is not evidence
					# that a registered id is gone.
					case " $catalogued " in
					*" $a "*)
						for m in $c; do
							prop_model "$a" "$m" ||
								drift="$drift  $a registers $m and this host's own catalogue does not carry it — a raise on that model refuses
"
						done
						;;
					esac
				fi
				;;
			D)
				if [ -n "$b" ] && ! prop_has "$b"; then
					drift="$drift  defaults.$a seats $b, which this host does not have — that role cannot be raised at all
"
				fi
				;;
			esac
		done <"$cur"
		for h in $present; do
			awk -F"$TAB" -v hh="$h" '$1 == "H" && $2 == hh { f = 1 } END { exit f ? 0 : 1 }' "$cur" ||
				drift="$drift  $h is on this host and the registry does not carry it — nothing is raised on it, which may be exactly what was meant
"
		done
		note ''
		if [ -n "$drift" ]; then
			note "drift between $SETTINGSFILE and this host"
			note "$(printf '%s' "$drift")"
		else
			note "no drift: $SETTINGSFILE and this host agree."
		fi
	fi

	# --- the proposal ---------------------------------------------------------
	#
	# Built into a file FIRST, never onto a stream the caller aimed somewhere: the
	# save is this script's, on `--write`.
	proposal="$WORK/proposal.json"
	jq -R -s '
		(split("\n") | map(select(length > 0) | split("\t"))) as $rows
		| {
			harnesses: ( [ $rows[] | select(.[0] == "H")
			               | { key: .[1], value: { cli: .[2],
			                   models: ( if ((.[3] // "") | length) == 0 then [] else (.[3] | split(" ")) end ) } } ]
			             | from_entries ),
			defaults:  ( [ $rows[] | select(.[0] == "D")
			               | { key: .[1], value: { harness: (.[2] // ""), model: (.[3] // "") } } ]
			             | from_entries )
		  }
	' <"$prop" >"$proposal" ||
		die "the proposal could not be built. NOTHING was written: a registry half-built is worse than the one that is there"

	if [ "$want_write" = no ]; then
		cat "$proposal"
	fi

	err ''
	if [ "$want_write" = no ]; then
		err "$ME: a registry PROPOSED for $root — NOTHING was written."
	else
		err "$ME: a registry proposed for $root, and about to be SAVED to $SETTINGS_REL."
	fi
	err ''
	err 'what is on this host'
	printf '%s' "$REPORT" >&2
	err ''
	if [ "$incomplete" = yes ]; then
		err 'This proposal is NOT yet a registry. An empty `models` list and an empty seat'
		err 'are both refused on read, and refused loudly, so that nothing is ever raised on'
		err 'a seat nobody named. Fill them in.'
		err ''
	fi

	if [ "$want_write" = no ]; then
		err 'To take it: read it here, then have this script save it — and edit the saved'
		err 'file for anything the report above says it left empty:'
		err ''
		err "    sh bin/remit setup --write"
		err ''
		err 'Never by redirecting this command over the registry. `setup` READS'
		err "$SETTINGS_REL to carry forward what only you could have known, and a"
		err 'shell redirection empties that file before this script starts — so the'
		err 'seats you registered are gone before they can be read, and no drift can'
		err 'be reported against them.'
		err ''
		err 'This script proposes. Only the practitioner registers a seat.'
		exit 0
	fi

	# --- the save, on his word, and atomic -----------------------------------
	#
	# tmp + rename in the SAME directory, so the registry is either the file that
	# was there or the whole of the new one, and never a truncated half of either
	# — including when this script is interrupted mid-save.
	ensure_dir "$(dirname "$SETTINGSFILE")" ||
		die "could not create $(dirname "$SETTINGS_REL")"
	SAVETMP="$SETTINGSFILE.remit-setup.$$"
	cat "$proposal" >"$SAVETMP" || die "could not write beside $SETTINGS_REL — nothing was changed"
	mv -f "$SAVETMP" "$SETTINGSFILE" || die "could not put $SETTINGS_REL in place — nothing was changed"
	SAVETMP=''
	# A rewritten registry is his word that the seats are as he means them; any
	# refusal mark on this host is stale by that word. A REFUSED SEAT, below.
	rm -f "$common_dir/remit-refused" 2>/dev/null

	if [ "$had_registry" = yes ]; then
		err "REPLACED $SETTINGS_REL. What it registered was read first and carried forward"
		err 'where this host still has it; what was dropped is in the drift above, and the'
		err 'file it replaced is in this repository'"'"'s history.'
	else
		err "WROTE $SETTINGS_REL, where there was none."
	fi
	err ''
	if [ "$incomplete" = yes ]; then
		err 'It is on disk and it is not yet a registry: `bin/remit-invoke` refuses every'
		err 'raise that needs an empty entry, and names it. Fill them in.'
		err ''
	fi
	err 'Nothing was committed. The registry is yours to read before it is history —'
	err "review $SETTINGS_REL and commit it yourself."
	exit 0
	;;

rules)
	# The four that need no repository, and commit nothing. They exist so the
	# installer reads the shipped rubrics from their one home rather than
	# carrying a copy, and migrates a target's rubric by rubric.
	case "$rules_cmd" in
	ship)
		rubrics_shipped
		exit 0
		;;
	seed)
		RUBRICS=$rules_dir
		rubrics_seed
		# shellcheck disable=SC2086
		[ -n "$SEEDED" ] && printf '%s\n' $SEEDED
		exit 0
		;;
	read)
		rubrics_read_dir "$rules_dir"
		exit 0
		;;
	apply)
		rubrics_apply_dir "$rules_dir"
		exit 0
		;;
	esac
	rubrics_seed
	if [ -z "$SEEDED" ]; then
		say ".remit/rules/ is already there and nothing was written — what is in it is the practitioner's."
		exit 0
	fi
	say "laid down .remit/rules/ —$SEEDED"
	say "what ships: $(rubrics_shipped | awk -F"$TAB" '{ printf "%s%s under %s.md'"'"'s `%s`", (NR > 1 ? ", " : ""), $3, $1, $2 }')."
	say "Every other section is empty, and an empty section changes nothing: every gate waits for the practitioner until he writes one, in a retro he calls."
	# THE PROJECT's, not the record's — see `commit_project_and_push`.
	commit_project_and_push "remit: lay down .remit/rules/" ".remit/rules"
	exit $?
	;;

migrate)
	# NOT WHILE THE RECORD LIVES ELSEWHERE: this moves a repository's OWN legacy
	# layout and commits the `.remit` tree as one pathspec; migrating into a records
	# repository is an operation nobody has specified, so it refuses.
	[ -n "$RECORDS_REMOTE" ] &&
		die "migrate is refused while $LOCALSETTINGS points the record at $RECORDS_REMOTE — this verb moves a repository's own legacy layout in place, and moving a record between repositories is not something it does. Migrate first with the pointer removed, or move the record by hand."
	# ONE-TIME, IDEMPOTENT, ONE COMMIT. It refuses once work-items/ HOLDS SOMETHING
	# — the test is what is IN the directory, because `install.sh` creates an empty
	# one on every install. Dotted entries count: `.archive` may be the only thing
	# left behind.
	if [ -d "$ITEMS" ]; then
		for _e in "$ITEMS"/* "$ITEMS"/.*; do
			case "${_e##*/}" in '.' | '..') continue ;; esac
			# An unmatched glob comes back as itself; `-e` is what sorts a
			# real entry from that, so no name is special-cased away.
			[ -e "$_e" ] || continue
			die "already migrated — .remit/work-items/ holds work. This move happens once."
		done
	fi
	[ -d "$REMITDIR" ] || die "no .remit/ in this repository — there is nothing to migrate"
	moved=0
	ensure_dir "$ITEMS" || die "could not create .remit/work-items"

	migrate_one() { # $1 the item folder, already in its new home
		_d=$1
		_b="$_d/brief.md"
		[ -f "$_b" ] || return 0
		_state=$(nocr "$_b" | sed -n 's/^\*\*State:\*\* *//p' | sed -n 1p | sed 's/[[:space:]]*$//')
		_inferred=''
		_verdict=no
		if [ -f "$_d/evaluation.md" ]; then
			nocr "$_d/evaluation.md" | grep -q '^\*\*Verdict:\*\* *PASS' && _verdict=yes
			{
				[ -f "$_d/log.md" ] && cat "$_d/log.md"
				[ -f "$_d/log.md" ] || {
					printf '# Record — %s\n\n' "$(basename "$_d")"
					printf 'Append-only. Written by `bin/remit`; the entry shapes are in its header.\n'
				}
				printf '\n## migrated — evaluation.md — %s\n\n' "$(now)"
				printf 'The evaluation record this item carried before `log.md` existed, moved here\n'
				printf 'verbatim and unedited. `evaluation.md` is gone: its content is this, and one\n'
				printf 'claim lives in one place.\n\n'
				cat "$_d/evaluation.md"
			} >"$_d/log.md.tmp"
			mv "$_d/log.md.tmp" "$_d/log.md"
			rm -f "$_d/evaluation.md"
			_inferred="evaluation.md's content moved verbatim into log.md and the file removed"
		elif [ ! -f "$_d/log.md" ]; then
			{
				printf '# Record — %s\n\n' "$(basename "$_d")"
				printf 'Append-only. Written by `bin/remit`; the entry shapes are in its header.\n'
			} >"$_d/log.md"
		fi

		case "$_state" in
		closed)
			_at=''
			_st=closed
			_why="stage closed, and no attention at all, because a closed item is absent from every attention state"
			;;
		active | parked)
			_at=$_state
			if [ "$_verdict" = yes ] && [ -f "$_d/delivery.md" ]; then
				_st=accepted
				_why="attention taken from **State:** $_state; stage inferred \`accepted\` from a passing verdict in evaluation.md beside a delivery.md"
			elif [ "$_verdict" = yes ]; then
				_st=refined
				_why="attention taken from **State:** $_state; stage inferred \`refined\` from a passing verdict in evaluation.md"
			else
				_st=new
				_why="attention taken from **State:** $_state; stage inferred \`new\` — no passing verdict was recorded"
			fi
			;;
		'')
			_at=active
			_st=new
			_why="no **State:** line was present, so attention \`active\` and stage \`new\` were assumed"
			;;
		*)
			_at=active
			_st=new
			_why="**State:** read '$_state', which is not one this script knows, so attention \`active\` and stage \`new\` were assumed"
			;;
		esac
		put_header "$_b" "$_at" "$_st" '' \
			"$(now) — $_why${_inferred:+; $_inferred}. No **Until:** was ever recorded, so none is set."
		moved=$((moved + 1))
	}

	for dir in "$REMITDIR"/*/; do
		[ -d "$dir" ] || continue
		s=${dir%/}
		s=${s##*/}
		[ "$s" = work-items ] && continue
		if [ ! -f "$dir/brief.md" ]; then
			say "left in place: .remit/$s — no brief.md, so it is not a work item"
			continue
		fi
		mv "${dir%/}" "$ITEMS/$s" || die "could not move .remit/$s"
		migrate_one "$ITEMS/$s"
	done

	if [ -d "$REMITDIR/.archive" ]; then
		mv "$REMITDIR/.archive" "$ITEMARCH" || die "could not move .remit/.archive"
		for dir in "$ITEMARCH"/*/; do
			[ -d "$dir" ] || continue
			migrate_one "${dir%/}"
		done
	fi

	paths=".remit"
	if [ -d "$root/field-reports" ]; then
		ensure_dir "$REPORTS" || die "could not create $REPORTS"
		for f in "$root"/field-reports/*; do
			[ -e "$f" ] || continue
			mv "$f" "$REPORTS/" || die "could not move $f"
		done
		rmdir "$root/field-reports" 2>/dev/null ||
			say "note: field-reports/ still holds something and was left in place"
		say "moved field-reports/ into .remit/field-reports/, README and all."
		paths="$paths field-reports"
	fi

	rubrics_seed
	[ -n "$SEEDED" ] && say "laid down .remit/rules/ —$SEEDED"

	# `roles.md` retired into `.remit/settings.json`. A repository old enough to
	# migrate may still carry one; its lines are his own and are CARRIED into a
	# registry here — every id registered for the harness it named — and the file
	# goes. Every other model that harness may use is `remit setup`'s to read.
	if [ -f "$ROLESFILE" ] && [ ! -e "$SETTINGSFILE" ]; then
		if ! command -v jq >/dev/null 2>&1; then
			say "note: .remit/rules/roles.md is here and jq is not, so its lines were NOT carried into .remit/settings.json and roles.md was left where it is. Run \`$ME setup\` with jq installed."
		else
			carried="$WORK/carried"
			nocr "$ROLESFILE" | awk '
				/^##[[:space:]]/ { sec = tolower($2); next }
				sec != "roles" { next }
				/^-[[:space:]]/ {
					line = $0
					sub(/^-[[:space:]]*/, "", line)
					i = index(line, ":")
					if (i == 0) next
					r = substr(line, 1, i - 1)
					gsub(/^[[:space:]]+|[[:space:]]+$/, "", r)
					if (r != "research" && r != "build" && r != "evaluate") next
					v = substr(line, i + 1)
					gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
					if (split(v, w, /[[:space:]]+/) != 2) next
					print r "\t" w[1] "\t" w[2]
				}
			' >"$carried"
			if [ -s "$carried" ]; then
				ensure_dir "$(dirname "$SETTINGSFILE")"
				jq -R -s '
					(split("\n") | map(select(length > 0) | split("\t"))) as $rows
					| {
						harnesses: ( [ $rows[] | { key: .[1], value: .[2] } ]
						              | group_by(.key)
						              | map({ key: .[0].key,
						                      value: { cli: .[0].key, models: (map(.value) | unique) } })
						              | from_entries ),
						defaults:  ( ["research","build","evaluate"]
						              | map( . as $r
						                     | ($rows | map(select(.[0] == $r)) | first) as $hit
						                     | { key: $r,
						                         value: { harness: ($hit[1] // ""), model: ($hit[2] // "") } } )
						              | from_entries )
					  }
				' <"$carried" >"$SETTINGSFILE"
				say "carried .remit/rules/roles.md into .remit/settings.json — $(awk 'END { print NR }' "$carried") seat(s). Read it: it registers only what roles.md named, so a harness or model you also use is NOT in it yet, and \`$ME setup\` proposes one from what this host actually has."
			else
				say "note: .remit/rules/roles.md carried no readable role line, so .remit/settings.json was not written from it. \`$ME setup\` proposes one from what this host has."
			fi
		fi
	fi
	if [ -f "$ROLESFILE" ] && [ -e "$SETTINGSFILE" ]; then
		rm -f "$ROLESFILE"
		say "removed .remit/rules/roles.md — the seats live in .remit/settings.json now, and nothing reads that file any more."
	fi

	printf 'migrated %s item(s) into .remit/work-items/.\n' "$moved"
	say "the law documents stay at .remit/ root; the rubrics sit beside the work, in .remit/rules/."
	# shellcheck disable=SC2086
	commit_and_push "remit: migrate to work-items/ and the two-axis header" $paths
	exit $?
	;;

resume)
	rubrics_check
	registry_check
	[ -f "$brief" ] || die "no work item '$slug' — expected .remit/work-items/$slug/brief.md"
	att=$(hdr "$brief" Attention)
	st=$(hdr "$brief" Stage)
	valid_stage "$st" || die "'$slug' has no readable **Stage:** line — nothing here infers one"
	valid_attention "$att" || die "'$slug' has no readable **Attention:** line — nothing here infers one"
	[ "$st" = closed ] && die "'$slug' is closed. Closed work has left every view; nothing resumes it."
	# Asked here rather than left to the `put_header` this run may reach, which
	# is where it would otherwise refuse — after the marker had gone.
	require_title "$brief"

	resolve_authority
	case "$AUTHORITY" in
	AMBIGUOUS) die "'$slug' names more than one **Current phase:** — the smallest ruling that unsticks this is which one" ;;
	"DANGLING "*) die "'$slug' points at a phase file that is not there: ${AUTHORITY#DANGLING }" ;;
	esac

	# THE ONE VERB THAT CONTINUES A CRASHED RUN, never automatically. LAST of the
	# preconditions, because it WRITES (`crash_take`); the marker it wipes is
	# replaced by its own on the next line.
	crash_take ||
		die "a resume of '$slug' is already in progress — its marker is at .remit/work-items/$slug/.working, and the chain it names is running on this machine."

	marker_write starting
	trap 'marker_release; cleanup' EXIT

	changed=no
	if [ "$att" != active ]; then
		put_header "$brief" active "$st" "$(hdr "$brief" Until)" KEEP
		changed=yes
	fi
	if [ -n "$want_until" ]; then
		recorded_until=$(until_value "$want_until" "$want_park")
		put_header "$brief" active "$st" "$recorded_until" KEEP
		printf 'Recorded at a resume.\n' | log_append "ruling — until $recorded_until — $(now)"
		changed=yes
	fi
	[ "$changed" = yes ] && commit_step "remit: resume $slug" ".remit/work-items/$slug"

	# --- did the authority change since this item last came to rest? -----------
	#
	# NOTICED HERE, from the digest on the record: the stage goes back to `new`, so
	# gate 1 judges what he now wrote. Which KIND of change it was is not asked. An
	# unchanged digest moves nothing.
	was_auth=$(last_authority "$item")
	was_hash=$(last_authority_hash "$item")
	if [ -n "$was_hash" ] &&
		{ [ "$was_hash" != "$AUTHORITY_HASH" ] || [ "$was_auth" != "$AUTHORITY_REL" ]; }; then
		amend_from=$(hdr "$brief" Stage)
		put_header "$brief" active new "$(hdr "$brief" Until)" KEEP
		PR_DRAFT_NOTE=''
		[ "$amend_from" = accepted ] && pr_to_draft
		{
			printf -- '- the authority in hand is `%s`, and it is not what this item last stopped with\n' "$AUTHORITY_REL"
			printf -- '- it last stopped with `%s`\n' "${was_auth:-nothing recorded}"
			# Read BACK from the header, never printed from what was intended: a
			# record that says a stage moved is a record of it having moved.
			printf -- '- stage: %s -> %s, so the gate into `refined` judges it again\n' \
				"$amend_from" "$(hdr "$brief" Stage)"
			[ -n "$PR_DRAFT_NOTE" ] && printf -- '- %s\n' "$PR_DRAFT_NOTE"
			printf '\n'
			authority_lines
		} | log_append "amended — $AUTHORITY_REL — $(now)"
		say "amended: \`$AUTHORITY_REL\` is not what this item last stopped with. Stage: $amend_from -> new."
		[ -n "$PR_DRAFT_NOTE" ] && say "$PR_DRAFT_NOTE."
		commit_step "remit: $slug amended — stage -> new" ".remit/work-items/$slug"
	fi

	# --- where this run goes back in ------------------------------------------
	#
	# AFTER the amendment above: an amendment puts the item back at `new`, and the
	# round is read from the stage as it now stands.
	case "$(hdr "$brief" Stage)" in
	refined) resume_point accepted ;;
	accepted) resume_point closed ;;
	*) resume_point '' ;;
	esac
	RESUME_NOTE=$(resume_point_note)
	if [ -n "$CRASH_NOTE" ] || [ -n "$RESUME_NOTE" ]; then
		_rlabel='at the step the record names'
		[ -n "$CRASH_NOTE" ] && _rlabel='after a crash'
		{
			[ -n "$CRASH_NOTE" ] &&
				printf -- '- the marker this resume found was a crashed chain, and this run picked it up: %s\n' "$CRASH_NOTE"
			if [ -n "$RESUME_NOTE" ]; then
				printf -- '- %s\n' "$RESUME_NOTE"
			else
				printf -- '- the record names no round for this run to continue, so it begins at its gate'"'"'s first round\n'
			fi
			printf '\n'
			authority_lines
		} | log_append "resumed — $_rlabel — $(now)"
		[ -n "$CRASH_NOTE" ] && say "crashed: $CRASH_NOTE. Only \`resume\` continues one, and this is that resume."
		[ -n "$RESUME_NOTE" ] && say "resuming: $RESUME_NOTE."
		commit_step "remit: $slug resumed — $_rlabel" ".remit/work-items/$slug"
	fi

	STOP=''
	STOP_NOTE=''
	MOVED_BY=''
	while :; do
		chain_intact || escalate "authority changed"
		st=$(hdr "$brief" Stage)
		compute_limit
		r=$(rank "$st")

		# A phase waiting at the `accepted` stop — whether the item was resting
		# there when this resume began or has just arrived. The chain stops here
		# and the hand-off happens below: nothing is closed out from under work he
		# has queued, and nothing of that phase is built in this run.
		if [ "$st" = accepted ]; then
			PHASE_QUEUED=$(queued_phase)
			[ -n "$PHASE_QUEUED" ] && break
		fi

		case "$st" in
		new) next=refined ;;
		refined) next=accepted ;;
		accepted) next=closed ;;
		*)
			STOP=$LIM_REASON
			break
			;;
		esac
		nr=$(rank "$next")

		# Does the practitioner's own word reach the next stage? If it does not,
		# only a `promote` rubric this gate's evaluator cites can carry it — so
		# there has to be one to cite, or the gate is not worth asking and no
		# fresh context is raised at all.
		CARRY=until
		if [ "$nr" -gt "$LIM" ]; then
			CARRY=promote
			# THE CEILING: a recorded `, then park` is his word that no promote gets past
			# the stop he named, on this run and every later one — `**Until:**` in this
			# script's header.
			if [ "$UNTIL_PARK" = yes ] && [ "$r" -ge "$(rank "$UNTIL_STOP")" ]; then
				STOP=$LIM_REASON
				break
			fi
			if [ -z "$(rubric_ids "$next" promote)" ]; then
				STOP=$LIM_REASON
				break
			fi
		fi

		# --- the gate: one evaluate invoke, handed that gate's file -----------
		LOOP_STOP=''
		case "$st" in
		new)
			# THE FIRST OF THE TWO POINTS the `**Depends on:**` line is observed at: HERE,
			# before the research raise and before gate 1. A name that does not satisfy
			# leaves the item at `new` with nothing raised: the gate into `refined` judges
			# the brief and not the tree, and would pass one written against a guess. Held,
			# never escalated.
			if ! depends_on_ok new; then
				STOP=$DEPENDS_ON_STOP
				STOP_NOTE=$DEPENDS_ON_NOTE
				break
			fi
			# WHO AUTHORS AT THIS GATE: research only where the brief carries a
			# `**Research:**` line in his words. It authors `research.md` and never the
			# brief, and runs the loop gates 2 and 3 run — THE THREE GATES' exception.
			_g1author=none
			_g1now=no
			if nocr "$AUTHORITY" | grep -q '^\*\*Research:\*\*'; then
				_g1author=research
				[ -f "$item/research.md" ] || _g1now=yes
			fi
			run_gate refined "$_g1author" "$_g1now"
			_grc=$?
			if [ "$_grc" = 2 ]; then
				# The brief did not pass, and nothing here may rewrite it.
				STOP=$LOOP_STOP
				# The loop says it in its own words where the item carried
				# research and the verdict did not send the must-fix back to it;
				# where there was never an author, this is the sentence it has
				# always been.
				STOP_NOTE=$LOOP_STOP_NOTE
				[ -n "$STOP_NOTE" ] || STOP_NOTE="The gate into \`refined\` returned a must-fix: $LOOP_STOP
Nothing in this mechanism may change a brief — that is the practitioner's, and
his alone — so the item waits at \`new\` with the must-fix on the record above,
and no second round was run."
				break
			fi
			[ "$_grc" = 0 ] || escalate "$LOOP_STOP"
			;;
		refined)
			run_gate accepted build yes
			_grc=$?
			if [ "$_grc" = 2 ]; then
				STOP=$LOOP_STOP
				STOP_NOTE=$LOOP_STOP_NOTE
				break
			fi
			[ "$_grc" = 0 ] || escalate "$LOOP_STOP"
			;;
		accepted)
			# THE CLOSING GATE. It judges the folder that is already there —
			# `log.md` and every evaluator's note in it — so nothing is built in
			# front of it. It licenses the CLOSURE and never a merge: this
			# mechanism merges nothing. A must-fix raised here goes back to a
			# builder like any other.
			run_gate closed build no
			_grc=$?
			if [ "$_grc" = 2 ]; then
				STOP=$LOOP_STOP
				STOP_NOTE=$LOOP_STOP_NOTE
				break
			fi
			[ "$_grc" = 0 ] || escalate "$LOOP_STOP"
			;;
		esac

		# --- what the gate's evaluator cited, in the law's order --------------
		# A hold beats a promote; a promote beats the until; a missed fix already
		# sent the work back inside the loop above, before either of them.
		if [ -n "$GATE_HOLD" ]; then
			STOP="hold: $GATE_HOLD"
			STOP_NOTE="The evaluator at the gate into \`$next\` cited \`hold: $GATE_HOLD\`. The item stops
in the stage it is in, for the practitioner, whatever else was cited there."
			break
		fi
		if [ "$CARRY" = promote ]; then
			if [ -n "$GATE_PROMOTE" ]; then
				MOVED_BY="promote: $GATE_PROMOTE"
			else
				# It was asked and it cited nothing that carries: it rests here.
				STOP=$LIM_REASON
				break
			fi
		fi

		# --- the move -------------------------------------------------------
		case "$st" in
		new)
			put_header "$brief" active refined "$(hdr "$brief" Until)" KEEP
			commit_step "remit: $slug -> refined" ".remit/work-items/$slug"
			say "stage: refined."
			;;
		refined)
			mark_step "the move into accepted"
			# A run that EVALUATED a delivery it did not itself make opened no
			# pull request, so the one the record names is the one this move
			# flips. Nothing is guessed: no delivery recorded, nothing to flip.
			pr_from_record
			if [ -n "$PR_NUM" ]; then
				command -v gh >/dev/null 2>&1 || escalate "cannot act: gh"
				build_worktree || escalate "cannot act: could not prepare the build worktree"
				out=$(cd "$WT" && gh pr ready "$PR_NUM" 2>&1) ||
					escalate "cannot act: gh pr ready — $(printf '%s' "$out" | tr '\n' ' ')"
				say "pull request: #$PR_NUM is ready for review — a recorded passing verdict took it out of draft."
			fi
			put_header "$brief" active accepted "$(hdr "$brief" Until)" KEEP
			commit_step "remit: $slug -> accepted" ".remit/work-items/$slug"
			say "stage: accepted."
			;;
		accepted)
			mark_step "the move into closed"
			# The pull request is read back from the record for the closing entry's
			# delivery line, and for nothing else: NOTHING HERE MERGES. An item whose record
			# names no pull request still closes: the gate licensed it.
			pr_from_record
			# WHAT LICENSED THIS CLOSURE is written down, because two different
			# things can license one and they are not the same fact. Either the
			# practitioner's own `until` reached `closed`, or the closing gate's
			# evaluator cited a `promote` rubric that carried the item past what
			# he said. A record that says the first when the second happened
			# credits him with a decision a rubric made.
			if [ "$CARRY" = promote ] && [ -n "$GATE_PROMOTE" ]; then
				_lic="promote: $GATE_PROMOTE — the closing gate's evaluator cited that rubric, and it carried this item past what the practitioner said"
				_licshort="promote: $GATE_PROMOTE"
			else
				_lic="**Until:** closed — the practitioner's own word reached this stop and nothing held it"
				_licshort="until closed"
			fi
			if [ -n "$PR_NUM" ]; then
				_del="Delivered as pull request #$PR_NUM${PR_URL:+ ($PR_URL)}. It is out of draft and NOT merged: merging is the repository's and the practitioner's, never this mechanism's."
			else
				_del=''
			fi
			do_close "$_lic. Every finding nobody ruled on is sealed by this closure as pre-authorised, and never as a ruling made on each one" \
				"$_del" closed
			say "closed .remit/work-items/$slug — archived whole to .remit/work-items/.archive/$slug. $(seal_line)"
			commit_step "remit: close $slug ($_licshort)" \
				".remit/work-items/$slug" ".remit/work-items/.archive/$slug"
			marker_release
			say ""
			say "closed: $slug"
			[ "$PUSH_FAILED" = yes ] && exit 3
			exit 0
			;;
		esac
	done

	# The last look at the lock before this run records anything: the brief is
	# about to be written to, or a stop about to be recorded, and neither happens
	# over an authority that changed while the chain was running.
	chain_intact || escalate "authority changed"

	# --- the hand-off: a phase that was waiting at the `accepted` stop ----------
	#
	# The one thing this script writes inside a brief's body, and it happens with
	# nothing in flight: the phase is named in `## Phases`, the pointer moves
	# to it, the stage goes back to `new` and the pull request goes back to draft.
	# The run ENDS here — his next resume is what evaluates the phase.
	if [ -n "$PHASE_QUEUED" ]; then
		phase_adopt "$PHASE_QUEUED"
		put_header "$brief" active new "$(hdr "$brief" Until)" KEEP
		resolve_authority
		pr_to_draft
		st=new
		STOP="queued phase: $PHASE_QUEUED"
		STOP_NOTE="\`$PHASE_QUEUED\` was waiting beside the brief and is now this item's authority:
it is named in \`## Phases\`, the \`**Current phase:**\` pointer names it, and the
stage is back at \`new\` so the gate into \`refined\` judges it. $PR_DRAFT_NOTE.
Nothing of this phase was built in this run."
		say "phase: $PHASE_QUEUED is now the authority. Stage: new."
		say "$PR_DRAFT_NOTE."
	fi

	# REACHING X on a `--until X --park`: the attention goes back to `parked`, so the
	# ruling outlives this run. A stop short of X leaves the item active with the
	# rule that stopped it named — `**Until:**` in this script's header.
	if [ -z "$STOP_NOTE" ] && [ "$UNTIL_PARK" = yes ] && [ "$r" -ge "$(rank "$UNTIL_STOP")" ]; then
		put_header "$brief" parked "$st" "$(hdr "$brief" Until)" KEEP
		STOP='parked at until'
		{
			printf 'Reached the stop the practitioner named with `--park`, and parked there. No\npromote carries it further; only another `remit resume` moves it.\n\n'
			authority_lines
		} | log_append "stopped — $STOP — $(now)"
	elif [ -n "$STOP_NOTE" ]; then
		{ printf '%s\n\n' "$STOP_NOTE"; authority_lines; } | log_append "stopped — $STOP — $(now)"
	else
		# A promote carried it past what he said; where it came to rest, that is
		# why it is here, and that is what the row says.
		if [ -n "$MOVED_BY" ] && [ "$STOP" = 'until ran out' ]; then
			STOP=$MOVED_BY
			{
				printf 'The chain stopped here. It came this far because the gate'"'"'s evaluator cited\n`%s`, past what the practitioner said.\n\n' "$MOVED_BY"
				authority_lines
			} | log_append "stopped — $STOP — $(now)"
		else
			{ printf 'The chain stopped here.\n\n'; authority_lines; } | log_append "stopped — $STOP — $(now)"
		fi
	fi
	commit_step "remit: $slug stopped — $STOP" ".remit/work-items/$slug"
	marker_release
	say ""
	say "stopped: $STOP"
	print_row
	[ "$PUSH_FAILED" = yes ] && exit 3
	exit 0
	;;

*)
	usage
	;;
esac
