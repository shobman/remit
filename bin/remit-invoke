#!/bin/sh
# remit-invoke — the one AI seam: a fresh context, in a named harness, with a
# brief, in a worktree, returning its text. It is the primitive `bin/remit`
# calls at every arrow of the chain that needs a model, and the only place in
# remit that starts one.
#
#   sh bin/remit-invoke <role> <slug> <worktree>
#       [--harness <claude|codex|pi|devin|copilot|native>] [--model <id>]
#       [--effort <level>] [--provider <name>] [--sandbox <mode>]
#       [--allowed-tools <spec>] [--exclude-tools <spec>] [--final-message <file>]
#
#       role in research | build | evaluate
#
#   sh bin/remit-invoke --probe-host    reads this host; raises nothing
#
# ==============================================================================
# THE CONTRACT — the seam's other end is `bin/remit`'s header, which states the
# environment it hands in and the text it reads back. It is stated there and NOT
# restated here; what follows is what THIS end owes.
# ==============================================================================
#
#   stdout      the context's final text, and NOTHING else. Every word this
#               script says about what it did goes to stderr, because stdout is
#               the seam's payload and `bin/remit` writes it into the record.
#   stderr      this script's own narration and whatever the harness said,
#               including the heartbeat — the only thing said while the CLI runs.
#   provenance  `key: value` lines written to the file named by
#               `REMIT_PROVENANCE`. The keys are below.
#   progress    the run directory's path, written to the file named by
#               `REMIT_PROGRESS` the moment that directory exists and before
#               anything is raised, so a watcher can find it in time to tail
#               `<run directory>/progress` — where the heartbeat also lands.
#               `REMIT_HEARTBEAT=<n>` is its interval in seconds; default 30,
#               `0` silences it. Neither channel changes what stdout carries.
#
# THE IDLE BOUND — `REMIT_QUIET`, and why a wall clock was not enough.
#
# The bounded wait each harness gets is WALL CLOCK. On 2026-09-01, in Zenith.Core,
# a devin process stopped emitting at 90 seconds and held the whole 3600s bound;
# the heartbeat pulsed the entire time, because the heartbeat is this script's own
# clock and says nothing about the CLI. So there is a SECOND bound, on the run's
# own output: if neither the CLI's stdout nor its stderr has grown for
# `REMIT_QUIET` seconds, the CLI is ended and this script exits 8.
#
# WHAT IS WATCHED is the two files the CLI actually writes — `<run dir>/stdout`
# and `<run dir>/stderr` — and NOT the progress log, which the heartbeat writes
# to on its own and which would therefore never look idle.
#
# THE DEFAULT IS PER HARNESS, because "silent" does not mean the same thing on
# each. `devin` narrates its tool calls to stdout as it goes, so silence there is
# a stall: its default is 600s — an order of magnitude longer than any gap a
# working run has shown, and a sixth of the wall bound, so a stall is reported in
# ten minutes rather than an hour. Every other seat here is invoked in a mode
# whose ONLY write is the final envelope (`claude -p --output-format json`, and
# codex and pi the same way): such a run is silent by construction, an idle bound
# on it would kill work that is going fine, and its default is therefore `0` —
# off. `REMIT_QUIET` set explicitly applies to any harness, and `0` turns it off
# everywhere.
#
# THE KILL IS BEST-EFFORT and says so: this script signals the process it started
# and, where `pkill` exists, that process's children. A CLI that ignores both is
# still held by its own wall bound, which is not removed. What exit 8 attests is
# that the SEAM stopped waiting and said why — never that the process is gone.
#   exit 0      the context ran. Exit is COMPLETION, not success.
#   exit 2      usage; a registry that is absent, malformed, or does not carry
#               the seat asked for; a registered seat that is not available on
#               this host; an authority that could not be read. NOTHING was
#               invoked and NOTHING was billed.
#   exit 5      the harness CLI itself exited non-zero.
#   exit 6      the run's own precondition failed — a confirmed downgrade of the
#               containment asked for (codex's sandbox, devin's permission mode).
#   exit 7      the containment canary failed: copilot's containment did not
#               demonstrably hold, so no context was raised.
#   exit 8      THE RUN WENT SILENT and was ended for it — the idle bound below.
#               A context was raised and IS billed; what it had said by then is
#               in the run directory, and the provenance carries a `note:`
#               naming the stall.
#
# THE PROVENANCE KEYS. `bin/remit` reads `session:`, `model:` and `harness:`;
# the rest are for the record, and an unknown key is ignored, never an error.
#
#   role: harness: session:  what ran, where, and the run id the harness reports
#   seat:          `registered` (the registry's `defaults` decided it) or
#                  `override` (a flag did — checked against the registry too)
#   registry:      the digest of the registry AS READ, with its algorithm
#   model:         THE MODEL THAT AUTHORED, as served, where the run reports it;
#                  otherwise the id ASKED FOR with ` (asked)` on the end and a
#                  `model-note:` naming the channel that carried nothing. Never a
#                  guess.
#                  WHERE A RUN REPORTS MORE THAN ONE MODEL — claude's envelope
#                  carries a `modelUsage` MAP, and a Claude Code run bills an
#                  internal ancillary model beside the one that wrote the
#                  deliverable — THE AUTHOR IS CHOSEN, never taken by position.
#                  THE RULE, and it is two clauses in this order:
#                    1. the REGISTERED SEAT'S id, when that id is one of the
#                       keys. The registry decided who was raised; a run that
#                       reports it served that seat settles authorship.
#                    2. failing that, the key with the LARGEST OUTPUT TOKEN
#                       COUNT. What a model WROTE is the only proxy for
#                       authorship the envelope carries; input tokens are not
#                       (an ancillary model summarising a long context reads far
#                       more than the author writes, which is exactly the shape
#                       that produced the wrong record).
#                  Ties on output go to the last key in sorted order, so the
#                  choice is deterministic rather than dependent on the order a
#                  JSON reader happened to hand the keys back. Taking `keys[0]`
#                  is what the field failure of 2026-09-01 was: `modelUsage`
#                  carried `claude-sonnet-5` at out=30249, the author, and
#                  `claude-haiku-4-5-20251001` at out=3385, the ancillary, and
#                  alphabetical order named the ancillary in the record.
#   models:        EVERY model the run reports, with `in=`, `out=` and `cost=`
#                  where the envelope carries them, semicolon-separated. Written
#                  only where a run reports more than nothing here. It exists so
#                  the ancillary model is VISIBLE — a reader can see what else
#                  was billed — and can never again be mistaken for the author,
#                  because the author is on its own line above.
#   consulted:     `server-side web_search=<n> web_fetch=<m>`, FOLLOWED BY THE
#                  SCOPE OF THOSE TWO NUMBERS in the line itself. Written ONLY
#                  when the run reports them and absent, never zeroed, when it
#                  does not. It is EVIDENCE FOR A READER OR A RUBRIC TO CITE, and
#                  this seam draws NO conclusion from it: it does not gate, warn,
#                  fail or grade on the number.
#                  THE SCOPE TRAVELS WITH THE NUMBERS AND IS NOT DECORATION. The
#                  count is the API's own SERVER-SIDE tool counter and covers
#                  nothing else — a CLI's CLIENT-SIDE fetches are invisible to it
#                  — so a bare `web_fetch=0` beside a research pass that fetched
#                  twenty-seven pages through its own tooling reads as a fact
#                  about the run when it is only a fact about one channel. That
#                  is the field failure of 2026-09-02, where a gate cited a
#                  rubric against honest research on the strength of that zero,
#                  four rounds to an escalation. The scope clause is its repair.
#                  WHICH SEATS CAN ANSWER IT AT ALL, and what the envelope was
#                  searched for before this was settled, is at THE ENVIRONMENT
#                  below.
#   model-check:   how the id was verified before the run, or why it was not
#   boundary:      `<user|container|none> — attested by <header|export|disclosed>`:
#                  codex is `user` by its run header, every other seat `none`.
#                  Nothing here ever writes `attested by canary`.
#   boundary-note: what that line does NOT establish
#   tools:         pi only: the tool surface that context actually got — the
#                  allowlist, the denylist on top of it, and extension discovery
#                  off. Why pi alone is at THE ENVIRONMENT's `pi` entry below.
#   effort: scrub: run-log: cost: harness-version: sandbox: permission-mode:
#   note:          anything the run could not be read back for
#
# ==============================================================================
# THE REGISTRY — `.remit/settings.json`, AND WHAT IT DECIDES
# ==============================================================================
#
# Every seat comes from a registry the practitioner wrote. Ruled 2026-08-23:
# "the specific sub-agents being reached for must match what are registered and
# available … if codex is uninstalled and my default evaluator is codex, the
# bin/sh should fail — end of story." No standing default, and no fallback.
#
# THE FILE is `REMIT_SETTINGS`, or `<repo root of the current directory>/.remit/
# settings.json`. Absent, unreadable or empty REFUSES every raise (exit 2). It
# is JSON, read with `jq`; without `jq` this script refuses rather than guess.
#
#   {
#     "harnesses": {
#       "<claude|codex|pi|devin|copilot>": {
#         "cli":    "<the command on the host>",
#         "models": ["<id>", …]                one or more, exact ids
#       }, …
#     },
#     "defaults": {
#       "<research|build|evaluate>": {
#         "harness": "<a key of harnesses>",
#         "model":   "<one of that harness's models>"
#       }                                       all three roles, every one of them
#     }
#   }
#
# Nothing else is allowed at either level: an unknown key, a key that is not one
# of the three roles, and a harness or model the registry does not carry are each
# refused BY NAME — with ONE tolerated exception: `defaults.repair-brief`. That
# role was retired on 2026-09-03 and every registry installed before that day
# seats it; refusing the key would break every install on upgrade over a role
# that raises nothing, so it is accepted, ignored, and dropped by `setup --write`. THE SHAPE IS CHECKED ON READ, and a malformed file refuses
# EVERYTHING rather than half-applying — a syntax error reported with `jq`'s own
# message, which names the line, and a shape error naming the key.
#
# RESOLUTION, STRICT. Flags override the defaults, and an override is checked
# against the registry exactly as a default is:
#
#   --harness H --model M    H registered, and M registered for H.
#   --harness H              H registered; the model is the role's default when
#                            that default sits on H — otherwise nothing
#                            registered says which model this role takes there,
#                            and the raise is refused.
#   --model M                the harness is the role's default when that default
#                            registers M; failing that, the one registered
#                            harness carrying M. Carried by none refuses as
#                            unregistered; by more than one, as ambiguous,
#                            naming them.
#   neither                  the role's `defaults` entry, whole.
#
# Anything unregistered is exit 2, `not registered in .remit/settings.json`.
#
# THEN AVAILABILITY, a separate question with a separate answer: a registered
# seat whose CLI is not on this host, is not authenticated where the CLI reports
# authentication, or whose model id the CLI rejects where the CLI carries a
# catalogue, is exit 2, `registered but not available: <why>`. NEVER A FALLBACK
# AND NEVER A SUBSTITUTE — including for the evaluator, whose seat being absent
# means the evaluation does not run at all.
#
# `--harness native` resolves no seat because it raises nothing: it records a
# context the CALLING harness already had, whose text is on disk and whose model
# the caller names. It still needs a registry it can read, and its seat is
# `override`.
#
# MODEL VERIFICATION goes through the channel each CLI actually has: pi's
# catalogue here, devin's and copilot's own pre-flight refusal, and — for codex
# and claude, which ship no catalogue — none at all, the run's own report being
# what the provenance then carries. `model-check:` says which applied every
# time, and an unverified id is never reported as a verified one.
#
# ==============================================================================
# THE ENVIRONMENT — WHAT IS SCRUBBED, WHAT IS PASSED, AND WHAT THAT CANNOT DO
# ==============================================================================
#
# Every context, for every role, on every harness, is started with `env -i` and
# an ALLOW-LIST. Nothing else crosses. This holds even where the boundary is
# `none`, because it is remit's own process doing the launch.
#
#   PATH                     a context needs its tools; the coordinator's.
#   HOME                     a SCRATCH directory made for this raise and removed
#                            after it — never the practitioner's home.
#   TMPDIR, TEMP, TMP        THE ONE WRITABLE SCRATCH ROOT this seat gets, and
#                            it is INSIDE THE RUN'S WORKTREE: the one directory
#                            every sandbox we raise into can write, since a
#                            sandboxed seat runs as another account and is
#                            refused under the coordinator's own profile. All
#                            three names carry the same directory, so a POSIX
#                            tool, a Windows one and `mktemp` all land in it.
#   LANG, LC_ALL, LC_CTYPE   locale, where the coordinator has them.
#   SYSTEMROOT, COMSPEC,     Windows needs these to start a process at all.
#   PATHEXT, SYSTEMDRIVE     SYSTEMDRIVE earns its place by incident: without it
#                            a raised Windows CLI created a literal, unexpanded
#                            `%SystemDrive%/ProgramData/...` tree in the
#                            worktree, which the delivery seam then committed.
#   the harness's own        so a CLI whose credentials live in the real home
#   config variable          can still find them under a scratch HOME:
#                              claude    CLAUDE_CONFIG_DIR   -> <home>/.claude
#                              codex     CODEX_HOME          -> <home>/.codex
#                              pi        PI_CODING_AGENT_DIR -> <home>/.pi/agent
#                              copilot   COPILOT_HOME        -> <home>/.copilot
#                              devin     APPDATA, LOCALAPPDATA (Windows) — devin
#                                        has NO config-directory variable, and
#                                        its `--config` REPLACES the user config
#                                        rather than layering with it, so it is
#                                        never passed.
#   GITHUB_COPILOT_PROMPT_MODE_REPO_HOOKS   copilot only: without it repo hooks
#                            do not load in prompt mode at all, and the
#                            equivalent flag does not satisfy the gate.
#
# A CONFIG DIRECTORY IS A PATH, NOT A CREDENTIAL, and nothing else is passed: no
# API key, no token, no `GITHUB_TOKEN`, no `ANTHROPIC_API_KEY`, no proxy
# credential. A context never runs git or gh — the delivery seam does that, as
# the coordinator — so no token belongs in a context's environment at all.
#
# WHAT THE SCRUB CANNOT DO, said rather than implied away:
#
#   * It cannot stop a CLI reading the practitioner's own configuration.
#     Pointing a harness's config variable at the real home is exactly what lets
#     it authenticate, and a context raised there can read whatever those files
#     say. The scrub bounds the ENVIRONMENT; it is not a read boundary, and no
#     line here should be read as one.
#   * pi takes its provider credentials from environment variables
#     (`ANTHROPIC_API_KEY`, `AWS_*`, `PI_KEY` and the rest). Those are tokens
#     and are NOT passed, so a pi seat whose credentials live only in an
#     exported variable will find none. That is the rule doing its job.
#   * A PI PACKAGE'S SKILLS ARE NOT EXTENSION CODE, and `--no-extensions` does
#     not remove them. Rendered with discovery off, the practitioner's three
#     installed packages still put `council-mode`, `pi-subagents` and
#     `mcp-scripting` into the prompt's skill list. What is left is prose, not a
#     tool and not a hook: a skill can only tell the model to reach for
#     something, and after the tool allowlist the things these name no longer
#     exist in a contained context. The flag that WOULD remove them is
#     `--no-skills`, which is all-or-nothing and would take remit's own skills
#     with them — the same refusal as Copilot's `--no-custom-instructions` below.
#     So it is disclosed rather than implied away.
#   * It says nothing about what a process can READ from the filesystem. That is
#     the boundary line above, and on this host only codex has one.
#   * The PLATFORM adds names remit neither passes nor can prevent: on Git Bash,
#     `env -i /bin/sh -c env` still prints `MSYSTEM`, `WINDIR` and `SYSTEMROOT`.
#     They are paths and a platform name, never a credential, and they are named
#     here so that reading the allow-list against a real raise is not read as a
#     leak.
#
# THE PRACTITIONER'S CONFIGURATION IS IMPORTED BY SOME OF THESE CLIs, and that
# is a different hole from the environment. It is closed where a documented
# opt-out exists in a file remit already writes, and RECORDED where none does.
#
#   devin — CLOSED for skills, commands and MCP servers, by `read_config_from` in
#     the `.devin/config.json` this script writes per raise; the switch, the key
#     set and what it was measured to do are at `devin_write_containment` below,
#     which is the one place any of it is stated.
#     THE RESIDUAL, measured and not assumed: `devin rules list` still reports
#     the practitioner's `~/.claude/CLAUDE.md` as an always-on rule with every
#     importer false, and still reports it under `env -i` with a scratch `HOME`.
#     Devin's own global rules — `%APPDATA%\devin\AGENTS.md`, `~/.devin/rules/`
#     — and the user `config.json`'s own `permissions` are NATIVE, not imports,
#     and `read_config_from` does not reach them at all; remit passes `APPDATA`
#     because devin needs it to authenticate, so they are readable by a raise.
#   copilot — NOT CLOSED. NO OPT-OUT EXISTS, and that is now a SEARCHED negative
#     rather than an undocumented assertion. Copilot reads
#     `$COPILOT_HOME/copilot-instructions.md` and
#     `$COPILOT_HOME/instructions/*.instructions.md` as user-level instruction
#     sources, and `.claude/skills/**` as project skills. remit points
#     `COPILOT_HOME` at the practitioner's real `~/.copilot` so the seat can
#     authenticate, which is what makes the first two reachable; the third is
#     reachable because the tree may carry a `.claude/` of its own.
#     HOW THE NEGATIVE WAS ESTABLISHED, on copilot 1.0.80, through the free
#     channels only — `copilot --help`, every subcommand's help, the CLI's own
#     `copilot help config` and `copilot help environment` topics,
#     `copilot skill list --json`, and the bundle's own
#     `repoDiscoverInstructionSources` called standalone under node out of
#     `$LOCALAPPDATA/copilot/pkg/<ver>/prebuilds/<plat>/runtime.node`, which
#     renders the model-visible instruction sources exactly as a session
#     assembles them, with no session, no auth and no token spent. A fixture
#     carried a distinct marker in each candidate file. Every lever found, and
#     what the render said of it:
#       * `--no-custom-instructions` EXISTS and is ALL-OR-NOTHING: its help is
#         "Disable loading of custom instructions from AGENTS.md and related
#         files", and it is one boolean (`skipCustomInstructions`) fed to the
#         prompt builder. The render settles that it cannot be scoped: ONE
#         discovery call returns the user sources and the repository's own
#         `AGENTS.md`, `.github/copilot-instructions.md` and
#         `.github/instructions/*.instructions.md` in a single list. There is no
#         seam in it, so this flag would strip the project's instructions — the
#         ones a context is raised to work from — to strip the practitioner's.
#         It is not taken, and the raise below says so at its own call site.
#       * `COPILOT_CUSTOM_INSTRUCTIONS_DIRS` ADDS, it does not replace. Its own
#         help says "additional directories to search for custom instructions
#         files (in addition to git root and current working directory)", and the
#         render agrees: with it set, both user-level markers were still in the
#         list and the new one was appended. It cannot narrow anything.
#       * `disabledInstructionSources` is REAL and PER-SOURCE — the render's
#         every source carries an `id` and a `location` of `user`, `repository`
#         or `working-directory`, so the wanted distinction exists inside the
#         CLI — but it is SESSION-ONLY: no flag in any help output, no
#         environment variable in `copilot help environment`, and no key in the
#         config, which is the difference that decides it. In the shipped bundle
#         `disabledSkills` is read out of the loaded config; the same read for
#         `disabledInstructionSources` does not occur anywhere. It is reachable
#         only from the interactive `/instructions` picker, and a raise is not
#         interactive.
#       * `disabledSkills` IS a config key and it DOES work — with it set, the
#         render's `.claude/skills` marker and the user-level skill both came
#         back `enabled=false`. It is still not an opt-out remit can take. It is
#         keyed by skill NAME, which a raise cannot know in advance; and it lives
#         ONLY in the user config. Four candidate project-level homes were each
#         written and rendered alone — `.copilot/config.json`,
#         `.copilot/settings.json`, `.github/settings.json`,
#         `.github/copilot/config.json` — and every one was a no-op, while the
#         same content in `$COPILOT_HOME/settings.json` took effect. So using it
#         would mean remit WRITING INTO THE PRACTITIONER'S OWN configuration and
#         changing every session they run for themselves. A raise does not edit
#         the config it borrows to authenticate.
#       * THERE IS NO "ignore user config" FLAG AND NO PROFILE MECHANISM. Neither
#         appears in `copilot --help` or in any subcommand's help.
#       * The mechanism that WOULD close it is a `configDir` the CLI never
#         exposes: `repoDiscoverInstructionSources` takes one, and called with it
#         unset the render returned the repository's three sources and NEITHER
#         user-level source. Its only handle at the CLI surface is `COPILOT_HOME`
#         — the same variable that carries authentication. Moving it suppresses
#         the practitioner's instructions and the seat's login together.
#     So it is DISCLOSED rather than implied away. (Devin's own `copilot`
#     importer — `.github/skills/**` and `~/.copilot/skills/**` — IS closed, by
#     the same switch as above.)
#   codex — NOT CLOSED, and the same negative, searched the same way. Codex reads
#     `$CODEX_HOME/AGENTS.md`, and remit points `CODEX_HOME` at the
#     practitioner's real `~/.codex` so the seat can authenticate.
#     HOW THE NEGATIVE WAS ESTABLISHED, on codex-cli 0.151.0, free throughout via
#     `codex debug prompt-input`, which renders the model-visible prompt as JSON
#     and — established rather than assumed — needs NO auth and runs under a
#     scratch `CODEX_HOME` that has no `auth.json` at all. A fixture carried a
#     distinct marker in `$CODEX_HOME/AGENTS.md`, the repository's `AGENTS.md`,
#     `$CODEX_HOME/skills/` and `.agents/skills/`. What the render said:
#       * THE TWO INSTRUCTION FILES ARE ONE BLOCK. The global and the project doc
#         are concatenated into a single `<INSTRUCTIONS>` element separated by a
#         literal `--- project-doc ---`, the global one FIRST. There is no
#         config key addressing the first half.
#       * `-c project_doc_max_bytes=0` cuts THE WRONG HALF: the project marker
#         left the prompt and the practitioner's global marker stayed. It is a
#         project-doc bound and nothing else.
#       * `--ignore-user-config` LOOKS like the answer and is not. Its own help is
#         "Do not load `$CODEX_HOME/config.toml`; auth still uses `CODEX_HOME`",
#         which is the right shape — and the render proves it cannot reach this:
#         with `config.toml` DELETED ENTIRELY from the scratch `CODEX_HOME`, the
#         global `AGENTS.md` marker was still in the prompt. Not loading that
#         file is exactly what the flag does, so the flag cannot drop this. The
#         same proof disposes of `--profile`, which only layers a second
#         `config.toml` on top of the first.
#       * NO CONFIG KEY REACHES IT, and the key set was enumerated off the
#         shipped binary rather than guessed. Every instruction-adjacent key was
#         rendered: `instructions`, `developer_instructions`,
#         `project_doc_fallback_filenames`, `project_root_markers`,
#         `include_environment_context`, `compact_prompt` — none moved the global
#         marker; `model_instructions_file` replaces the BASE instructions, is a
#         different channel, and refuses an empty file. No `skills.*` key exists:
#         six spellings were rendered and every one was inert.
#       * NO ENVIRONMENT VARIABLE REACHES IT either — the binary's whole `CODEX_*`
#         set carries no instruction or skills switch.
#       * `$CODEX_HOME/AGENTS.override.md` IS read and DOES replace
#         `$CODEX_HOME/AGENTS.md` — the override's marker reached the prompt and
#         the global one did not, with the project doc untouched. It is a real
#         lever and remit still does not take it: it is a write into the
#         practitioner's own home that would silence their global instructions in
#         every session they run for themselves, which is the same refusal as
#         Copilot's `disabledSkills` above.
#       * POINTING `CODEX_HOME` AT A SCRATCH DIRECTORY WOULD WORK AND IS REFUSED.
#         It suppresses the file, but the seat then cannot authenticate unless
#         `auth.json` is copied or linked into that directory — and `auth.json`
#         IS THE CREDENTIAL. Remit never copies, moves or links a credential, so
#         this is not done and no shipped code does it. The hole stays open
#         rather than being closed by materialising a token at a second path.
#       * WHAT CODEX DOES NOT DO, so that it is not carried as a worry: it does
#         NOT read `.claude/skills`. The prompt's own skill-roots table listed
#         `$CODEX_HOME/skills`, `$CODEX_HOME/skills/.system` and the
#         repository's `.agents/skills` — and the `.claude/skills` marker in the
#         same fixture never appeared, in any run.
#     Codex is the one seat here with an enforced read boundary, so what it does
#     with what it reads is bounded; what it READS is not.
#   pi — CLOSED for extension TOOLS and for extension CODE, by two flags every
#     raise passes: `--tools` carrying pi's built-in set, and `--no-extensions`.
#     remit points `PI_CODING_AGENT_DIR` at the practitioner's real `~/.pi/agent`
#     so the seat can authenticate, and that directory's `settings.json` carries
#     their installed packages — so without these flags a contained context is
#     handed every tool those packages register. On this host, 2026-09-01, that
#     was NINE beyond the built-ins: `subagent`, `subagent_wait`,
#     `subagent_supervisor`, `mcpScript`, `mcp`, `web_search`, `source_check`,
#     `fetch_content`, `get_search_content` — a builder able to spawn its own
#     fleet and to reach the network through a plugin the containment never
#     considered. Same class as devin's importer: no personal tool reaches a raise.
#     THE RULE. Every pi raise passes `--tools read,bash,edit,write` — pi's
#     built-in set, verified from the render below and not assumed — so no
#     extension or custom tool exists in a contained context. A caller's
#     `--allowed-tools` NARROWS WITHIN that set and can never widen it: the two
#     lists are intersected, case-insensitively so that a claude-shaped
#     `Bash,Edit` lands on pi's `bash,edit`, and a name that is not a built-in is
#     dropped rather than forwarded. An intersection that comes out empty is
#     `--no-tools`, said on stderr and in the provenance, never a silent
#     widening back to the default. A caller's `--exclude-tools` is passed on top
#     and still applies: pi's denylist runs after its allowlist, so it can only
#     subtract — rendered, `--tools read,bash,edit,write --exclude-tools bash`
#     left `read,edit,write`. The `tools:` provenance line is the record.
#     THE RESIDUAL THE ALLOWLIST ALONE DOES NOT CLOSE, which is why
#     `--no-extensions` is passed as well: `--tools` bounds the tools the MODEL
#     sees, not the code the PROCESS runs. A pi extension is a module pi imports
#     and calls at startup, and its `pi.on(...)` handlers fire whatever the tool
#     list says. Measured: under `--tools read,bash,edit,write` the marker tool
#     was gone from the prompt and the marker extension's module body, its setup
#     function and its `session_start` handler had all still run. A hook that
#     runs code you did not write is a hole even with its tool gone.
#     `--no-extensions` closes it — its own help is "Disable extension discovery
#     (explicit -e paths still work)" — and the same fixture under it logged
#     NOTHING: no module body, no setup function, no handler, no tool. It costs
#     no credential; the config directory still carries `auth.json` and the model
#     catalogue, and every render below ran against the practitioner's own agent
#     directory.
#     HOW ALL OF THIS WAS ESTABLISHED, free of a model turn and free of money, on
#     pi 0.84.4: pi's own `-e <file>` extension channel, the same shape the
#     shadow-pi item used. A probe extension registers a `before_agent_start`
#     handler — the event whose payload carries `systemPromptOptions`, with
#     `.selectedTools`, `.toolSnippets`, `.skills` and `.contextFiles`, which IS
#     the model-visible surface — writes them to a file and calls
#     `process.exit(0)` BEFORE the agent loop. No prompt reaches a provider. `-e`
#     paths load even under `--no-extensions`, which is what lets the probe
#     report on a run with discovery off. The hook question was answered by a
#     second extension placed in a scratch `PI_CODING_AGENT_DIR`'s `extensions/`,
#     carrying a marker tool and marker handlers that logged on load and on fire.
#     TRUST, AND WHAT A RAISE THEREFORE SEES. A raise passes NEITHER `--approve`
#     NOR `--no-approve`, so pi's own rule decides and nothing here overrides the
#     practitioner's own answer. `.pi/skills/`, `.agents/skills/` and
#     `.pi/APPEND_SYSTEM.md` — the project resources `install.sh` writes for pi,
#     which is where that list is stated and it is not restated here — load ONLY
#     after the project is trusted, and a `-p` run never prompts. What applies is
#     the closest saved decision in `~/.pi/agent/trust.json` on the worktree or a
#     PARENT of it, and failing that `defaultProjectTrust`, whose default `ask`
#     means "ignore" in `-p`. A raise's worktree is a fresh path, so unless a
#     parent directory carries a saved yes, REMIT'S OWN SKILLS ARE NOT VISIBLE TO
#     A PI RAISE. Rendered: untrusted, the fixture's `.pi/skills` and
#     `.agents/skills` were both absent from `.skills` and its `.pi/extensions`
#     module never ran; with `--approve` all three appeared. CONTEXT FILES ARE
#     THE EXCEPTION and load either way — `AGENTS.md` was in `.contextFiles`
#     plain, under `--no-approve` and under `--no-extensions` alike. And
#     `--no-extensions` OUTRANKS TRUST: with `--approve` AND `--no-extensions`
#     the project skills loaded and the project-local extension still did not.
#   claude — the INSTRUCTION surface is not investigated, and nothing is claimed
#     either way. What IS settled, and settled here rather than by the installer,
#     is THE AGENT-TOOL GUARD.
#     WHY THE SEAM WRITES IT AND NOT THE INSTALLER. `install.sh` registers
#     `.remit/hooks/no-agent-tool.sh` as a `PreToolUse` hook in the repository's
#     `.claude/settings.local.json`. Under a SHADOW install that file is
#     shadow-excluded, so it does not exist in the `work/<slug>` worktree a raise
#     actually runs in; and the global configuration the raise reads through
#     `CLAUDE_CONFIG_DIR` carries no such hook. On 2026-09-01, in Zenith.Core,
#     that left a claude raise with NOTHING banning its agent tool. An installed
#     file cannot contain a raise that runs where the installed file is not, so
#     the containment is written PER RAISE, by this script, into the argv and the
#     worktree the raise is given. It travels with the raise by construction.
#     THE MECHANISM, and it is the flag: every claude raise passes
#     `--disallowedTools Agent,Task,AgentTool` alongside its `--allowedTools`.
#     `Agent` is the tool's name since Claude Code 2.1.63 and `Task` its retained
#     alias; `AgentTool` is carried for the same reason the hook carries it. A
#     DENY OUTRANKS EVERY ALLOW — the documented order is deny, then ask, then
#     allow, and no allow at any level reinstates a denied tool — so this holds
#     against the raise's own `--allowedTools` and against the permissions in the
#     practitioner's global settings, `defaultMode: auto` included. It needs no
#     file to exist anywhere.
#     THE SECOND LAYER, belt to that brace: this script also writes the
#     containment INTO THE WORKTREE before the raise and removes it after —
#     `claude_write_containment` below. Two files, and BOTH are written by this
#     script at the raise so that nothing installed anywhere is depended on:
#     `.claude/settings.local.json`, carrying the same deny rules and a
#     `PreToolUse` registration, and `.claude/remit-no-agent-tool.sh` beside it,
#     which is the guard itself — the same rule as the shipped
#     `.remit/hooks/no-agent-tool.sh` and reachable when that file is not there.
#     Copilot's containment is written the same way and for the same reason.
#     WHY IT IS READ AT ALL, documented rather than assumed: Claude Code loads
#     user, project and local settings from the working directory by default
#     (`--setting-sources` defaults to all three); a `-p` session counts as
#     accepted, so an UNTRACKED `.claude/settings.local.json` is applied with no
#     trust step; and `PreToolUse` hooks fire in `-p` before any permission-mode
#     check, in every mode.
#     IT NEVER OVERWRITES. A `.claude/settings.local.json` already in the tree is
#     left exactly as it is and NOT augmented — that file is the practitioner's
#     or the installer's, and a raise does not edit configuration it found. Only
#     what this script created is removed afterwards, so a `.claude/` the
#     repository already had survives the raise untouched. When the file was
#     already there the flag is the whole containment, and that is what the
#     `containment:` provenance line then says. A copy of whatever was written
#     goes into the run directory as the record.
#     WHAT NEITHER LAYER DOES, said rather than implied away: both match NAMES. A
#     claude build that renames its agent tool, or reaches a sub-agent through
#     some other tool, walks past both — the same limit the shipped hook states
#     about itself.
#
# WHETHER A RUN CAN SAY WHAT IT CONSULTED — the `consulted:` provenance key —
# is a per-harness fact and this is the one place it is stated.
#
#   claude — YES, AND ONLY FOR THE SERVER SIDE, and it is the only seat here that
#     answers at all. The `-p --output-format json` envelope carries a
#     `server_tool_use` object with `web_search_requests` and
#     `web_fetch_requests`: the API's own count of the SERVER-SIDE searches and
#     fetches the run made. This is read where the envelope carries it and
#     written to `consulted:` with its scope beside it.
#     WHAT IT DOES NOT COVER, and this is the whole of why the line carries a
#     scope. Claude Code's own `WebFetch` and `WebSearch` are CLIENT-SIDE tools:
#     the CLI performs the request and hands the content to the model, and
#     nothing about that reaches `server_tool_use`. A raise that fetched
#     twenty-seven pages through them reports `web_fetch=0`, correctly, for a
#     counter that was never measuring that path.
#     NO OTHER ENVELOPE FIELD COUNTS A CLIENT-SIDE TOOL CALL. That is a SEARCHED
#     negative, taken on 2026-09-02 off the shipped `claude` binary itself — the
#     result envelope's own schema, recovered whole, is `type`, `subtype`,
#     `duration_ms`, `duration_api_ms`, the `ttft_*`/`time_*` timings,
#     `user_message_uuid`, `warm_spare_claimed`, `is_error`, `api_error_status`,
#     `num_turns`, `result`, `stop_reason`, `total_cost_usd`, `usage`,
#     `modelUsage`, `subagent_stats`, `permission_denials`, `queued_turn_count`,
#     `structured_output`, `deferred_tool_use`, `terminal_reason`, the
#     `fast_mode_*` pair, `origin`, `uuid` and `session_id`. Not one of them is a
#     tool tally: `num_turns` counts assistant turns, `permission_denials` lists
#     the calls that were REFUSED, `subagent_stats` is about sub-agents, and
#     `usage` is the API usage block whose only tool member is the server-side
#     counter above — which that binary's own cost model bills as a server-side
#     line item, confirming what it is. The ONE channel in that CLI that would
#     show a client-side fetch is `--output-format stream-json`, whose assistant
#     messages carry the `tool_use` blocks themselves and could be counted; it is
#     a different output mode and a different parse, this script asks for `json`,
#     and nothing here infers a count from a trace it did not ask for.
#     SO THE COUNT IS KEPT AND ITS SCOPE IS DECLARED, rather than the line being
#     dropped. The counter is not vacuous for this seat — the server-side tools
#     are reachable and are billed when they are used — so throwing it away would
#     discard a real signal to fix a wording problem. What was wrong was never the
#     number; it was a bare number that read as a scope it does not have.
#   codex, copilot, devin, pi — NO EQUIVALENT COUNT IS RECORDED, and that is a
#     searched negative over the shapes this script already parses and the probe
#     records that captured them, not an assumption. codex's run header block
#     carries the session, the model and the sandbox and no tool tally at all.
#     Devin's ATIF export carries per-step `tool_calls` and `extra.
#     committed_acu_cost` — a step-level trace, from which a search count could
#     only be INFERRED by matching tool names, which is a guess and is not made.
#     Copilot's JSONL carries `tool.execution_start` / `tool.execution_complete`
#     pairs and a `result` usage block of AI credits, premium requests and files
#     modified — again a trace, not a count, and again not inferred. Pi's stdout
#     under `-p` is the final message and nothing else; a contained pi raise has
#     no web tool to count in any case, since `--no-extensions` and the built-in
#     allowlist remove `web_search` and `fetch_content` outright.
#     So `consulted:` is ABSENT on those four seats. Absent means unreported, and
#     it is left absent rather than written as a zero — a zero would say the run
#     consulted nothing, which is a claim none of those channels supports.
#
# THE SHAPE OF BOTH NEGATIVES IS THE SAME, and it is worth naming once. Each CLI
# HAS the distinction remit wants — Copilot's sources are tagged `user` against
# `repository`; Codex's global doc is a separate file from the project's. Each
# also has a lever that acts on it. Neither exposes that lever to a
# non-interactive invocation without either taking the project's own
# instructions away at the same time, or writing into the practitioner's
# personal configuration, or moving the directory the seat authenticates from.
# Those are the three refusals, and they are refusals rather than oversights.
#
# None of this is a read boundary and no line above should be read as one; it is
# the INSTRUCTION SURFACE a raise inherits, which is a separate question from
# what a raise can open.
#
# ==============================================================================
# THE HONESTY RULES
# ==============================================================================
#
# Each is a probed failure mode of a shipped CLI, evidenced in this repository's
# probe records. None of them is relaxed here.
#
#   * Exit signals COMPLETION, not success. A CLI can exit 0 with every task
#     command denied; nothing here reads success from an exit code.
#   * Pi accepts a wrong model id silently, so the registered id must appear
#     WHOLE in `pi --list-models` — as that table's `provider/id` or as the bare
#     id. A substring of a real id is not a match.
#   * The sandbox codex was ASKED for is not always the one it ran under, so its
#     run HEADER BLOCK is read back after exit. A confirmed downgrade is exit 6;
#     a header that cannot be read is reported UNCONFIRMED and claims nothing.
#   * Devin's exit code distinguishes only "the CLI refused to start" from "a
#     run happened", so a devin run is judged from its ATIF export. Its
#     containment is enforced by TERMINATION, not refusal, which is why its
#     allow list is everything a context reaches for.
#   * A DEVIN TOOL CALL THAT IS NEITHER ALLOWED NOR DENIED IS NOT SAFE. Its
#     permission ladder ends in a default of PROMPT, there is nobody to prompt in
#     `-p`, and the rejection cancels every sibling call in the batch — a raise
#     can end with an empty final message and no verdict at all. A catch-all deny
#     is not expressible, so what closes it is the ALLOW LIST, and the residual
#     hole is stated where that list is written: `devin_write_containment` below.
#   * Copilot reports NOTHING about the permissions that actually applied, in
#     any channel, so there is no read-back to make. What exists instead is a
#     canary: a cheap throwaway run under the exact configuration the context
#     will get, which must run an ordinary command, author an ordinary in-tree
#     file, and be BLOCKED on a wrapped `git`. Anything else refuses the raise
#     (exit 7) — a hook that fails to load fails OPEN, silently.
#   * A CLAUDE RUN BILLS MORE THAN ONE MODEL and its envelope reports them as a
#     MAP, so `model:` is CHOSEN — the registered seat's id where the run names
#     it, else the largest output-token count — and never taken by position.
#     Every model the run reports is written to `models:` beside it, so the
#     ancillary is visible and is never the one the record calls the author. The
#     rule, and the field failure that wrote it, are at THE PROVENANCE KEYS.
#   * WHAT A RUN CONSULTED IS RECORDED, NOT JUDGED, AND NEVER WITHOUT ITS SCOPE.
#     Where a run reports its own web-search and web-fetch counts, `consulted:`
#     carries them for a reader or a rubric to cite — and carries, in the same
#     line, what those numbers do and do not cover, because a count read as
#     wider than it is measures nothing and accuses something. This script draws
#     no conclusion from the number, gates nothing on it, and writes no line at
#     all for a seat that cannot report one.
#   * There is NO enforced read boundary on claude, pi, copilot or devin here,
#     and every provenance line says so rather than implying one.
#   * An absent capability is reported before anything is invoked, and nothing
#     is ever substituted.
#
# WHAT EACH ROLE IS TOLD — its limits, what it returns, the authority, the
# must-fix going back, the bar for the roles that AUTHOR, and the gate's rubric
# file for `evaluate` and no other role — is composed below out of law that
# `bin/remit`'s header owns and this one does not restate.
#
# The fake harnesses in `t/lib/fake-harness.sh` are SYNTHETIC and say so; the
# live assertions in `t/integration/remit-invoke-live.sh` are what re-check
# these shapes against the CLIs that ship.

set -u

ME=remit-invoke
say() { printf '%s\n' "$1" >&2; }
die() { printf '%s: %s\n' "$ME" "$1" >&2; exit 2; }
rule_off() { printf -- '---------------------------------------------------------------------\n' >&2; }

usage() {
	cat >&2 <<'EOF'
usage:
  remit-invoke <role> <slug> <worktree>
      [--harness <claude|codex|pi|devin|copilot|native>] [--model <id>]
      [--effort <level>] [--provider <name>] [--sandbox <mode>]
      [--allowed-tools <spec>] [--exclude-tools <spec>] [--final-message <file>]

      role: research | build | evaluate

  remit-invoke --probe-host
      Reads THIS HOST — which of the five harness CLIs are here, where, what
      each says about its account, and what any of them will list as models —
      and prints one tab-separated record per harness on stdout. It raises
      nothing, bills nothing and reads no registry. `remit setup` proposes a
      registry from it; the record's fields are at `--probe-host` below.

Raises ONE fresh context in a named harness, with a briefing composed from the
role's limits and the authority in REMIT_AUTHORITY, in the worktree given, and
returns that context's final text on stdout and nothing else. Provenance goes to
the file named by REMIT_PROVENANCE.

EVERY SEAT COMES FROM THE REGISTRY — REMIT_SETTINGS, or .remit/settings.json in
the current repository. With no --harness/--model the role's `defaults` entry
decides; with either flag that override is checked against the registry the same
way. A harness or model the registry does not carry is refused, and so is a
registered seat whose CLI is absent, unauthenticated or rejects the id. There is
no standing default and there is no fallback: if the seat is not there, the raise
does not happen.

--harness native raises nothing: the context was the calling harness's own
sub-agent and --final-message carries what it returned.

Exit codes: 0 the context ran (completion, not success)
            2 usage, an unregistered or malformed registry, or a registered
              capability that is absent; NOTHING was invoked
            5 the harness CLI itself exited non-zero
            6 the run's own precondition failed (a confirmed downgrade of the
              containment asked for: codex's sandbox, devin's permission mode)
            7 the containment canary failed — copilot's containment did not
              demonstrably hold, so no context was raised
EOF
	exit 2
}

# ==============================================================================
# `--probe-host`: WHAT IS ON THIS HOST — the facts `remit setup` proposes from
# ==============================================================================
#
# This lives here, and not in `bin/remit`, because THIS script is the one that
# has to find each CLI at raise time. Where a binary lives, which of them are not
# always on PATH, and which of them can be asked for a model catalogue are facts
# with exactly one home, and a second copy in the proposer would be the copy that
# drifts.
#
# It raises nothing, bills nothing, and reads no registry — a probe that needed
# the registry could never help write the first one. The command name it looks
# for is the CONVENTIONAL one, which is what a proposal offers for `cli`; a
# registry may name a different command and this script uses whatever it names.
#
# One tab-separated record per harness, on stdout:
#
#   <harness> <cli> <present|absent> <where> <auth> <model ids> <note>
#
# `<where>`, `<auth>`, `<model ids>` and `<note>` are empty when there is nothing
# to say. NOTHING here is invented: a CLI with no catalogue reports no ids and
# says in `<note>` that it has none, rather than offering ids from memory.

# `pi --list-models` prints a table — `provider  model  context  max-out …` under
# a header row of those names. Pi takes `--model` as `provider/id` or as a bare
# id, so both forms are emitted and both are accepted.
pi_catalogue_ids() { # stdin: the catalogue -> one id per line
	awk '$1 == "provider" && $2 == "model" { next } NF >= 2 { print $1 "/" $2; print $2 }'
}

# The two CLIs that are not always on PATH. Their Windows package installers add
# a directory to the persisted user PATH, which any shell whose process tree
# predates the install never sees.
packaged_path() { # $1 devin|copilot -> an executable path, or empty
	_la=$(printf '%s' "${LOCALAPPDATA:-}" | tr '\\' '/')
	[ -n "$_la" ] || return 0
	case "$1" in
	devin) _p="$_la/Microsoft/WinGet/Packages/CognitionAI.DevinCLI_Microsoft.Winget.Source_8wekyb3d8bbwe/bin/devin.exe" ;;
	copilot) _p="$_la/Microsoft/WinGet/Packages/GitHub.Copilot_Microsoft.Winget.Source_8wekyb3d8bbwe/copilot.exe" ;;
	*) return 0 ;;
	esac
	[ -x "$_p" ] && printf '%s\n' "$_p"
	return 0
}

probe_host() {
	_t=$(printf '\t')
	for h in claude codex pi devin copilot; do
		_cli=$h _where='' _auth='' _ids='' _note=''
		if command -v "$h" >/dev/null 2>&1; then
			_where=$(command -v "$h")
		else
			case "$h" in devin | copilot) _where=$(packaged_path "$h") ;; esac
		fi
		if [ -z "$_where" ]; then
			printf '%s%s%s%sabsent%s%s%s%s%s\n' "$h" "$_t" "$_cli" "$_t" "$_t" "$_t" "$_t" "$_t" \
				"neither on PATH nor at a package path this script knows"
			continue
		fi
		case "$h" in
		claude | codex)
			_note="this CLI ships no model catalogue this script can read, so no id was probed and none is offered from memory"
			;;
		pi)
			if _cat=$("$_where" --list-models 2>/dev/null) && [ -n "$_cat" ]; then
				_ids=$(printf '%s\n' "$_cat" | pi_catalogue_ids | tr '\n' ' ' | sed 's/ $//')
				_note="from \`pi --list-models\` on this host; pi takes provider/id or a bare id, and both forms are listed"
			else
				_note="\`pi --list-models\` could not be read, so no id was probed"
			fi
			;;
		devin)
			if _a=$("$_where" auth status 2>&1); then
				_auth=$(printf '%s\n' "$_a" | tr '\n' ';' | sed 's/[[:space:]]\{1,\}/ /g; s/;/; /g; s/[; ]*$//')
			else
				_auth='not authenticated'
			fi
			_note="devin validates an unknown model id itself, pre-flight, before any ACU is spent, so no catalogue was called and no id is offered from memory"
			;;
		copilot)
			_cfg=${COPILOT_HOME:-${HOME:-}/.copilot}
			if [ -f "$_cfg/config.json" ]; then
				_login=$(sed -n 's/.*"login"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$_cfg/config.json" | sed -n 1p)
				_host=$(sed -n 's/.*"host"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$_cfg/config.json" | sed -n 1p)
				[ -n "$_login" ] && _auth="$_login at ${_host:-not recorded} — read from the CLI state file, not checked"
			fi
			_note="this CLI ships no auth check and no model catalogue; it refuses an unknown id pre-flight, in seconds, with nothing billed"
			;;
		esac
		printf '%s%s%s%spresent%s%s%s%s%s%s%s\n' \
			"$h" "$_t" "$_cli" "$_t" "$_t" "$_where" "$_t" "$_auth" "$_t" "$_ids" "$_t$_note"
	done
	return 0
}

if [ "${1:-}" = --probe-host ]; then
	[ $# -eq 1 ] || die "--probe-host takes no other argument: it reads this host and raises nothing"
	probe_host
	exit 0
fi

# ==============================================================================
# ONE PATH NAMESPACE
# ==============================================================================
#
# The rule, and why the drive-lettered spelling is the one that travels, is
# `ONE PATH NAMESPACE` in `bin/remit` — read it there. It applies harder on this
# side of the seam than on that one: every path below is handed to a CLI that is
# not an MSYS program, and `/c/Users/...` is a name only the MSYS shell that
# produced it can open. A seat told its scratch is at `/tmp/...` is a seat told
# nothing.
#
# `cygpath` is the authority; where there is none there is one spelling and this
# is the identity function.
CYGPATH=$(command -v cygpath 2>/dev/null) || CYGPATH=''
one_namespace() { # $1 an absolute path -> it, in the spelling everything resolves
	if [ -n "$CYGPATH" ]; then
		_ns=$("$CYGPATH" -m "$1" 2>/dev/null)
		if [ -n "$_ns" ]; then
			printf '%s\n' "$_ns"
			return 0
		fi
	fi
	printf '%s\n' "$1"
}

# ==============================================================================
# arguments
# ==============================================================================

[ $# -ge 1 ] || usage
case "$1" in -h | --help) usage ;; esac
[ $# -ge 3 ] || usage

ROLE=$1
SLUG=$2
WT=$3
shift 3

HARNESS='' MODEL='' EFFORT='' PROVIDER='' ALLOWED='' EXCLUDED='' RETURNED=''
SANDBOX=workspace-write SANDBOX_GIVEN=no

while [ $# -gt 0 ]; do
	case "$1" in
	--harness) [ $# -ge 2 ] || die "--harness needs a value"; HARNESS=$2; shift 2 ;;
	--model) [ $# -ge 2 ] || die "--model needs a value"; MODEL=$2; shift 2 ;;
	--effort) [ $# -ge 2 ] || die "--effort needs a value"; EFFORT=$2; shift 2 ;;
	--provider) [ $# -ge 2 ] || die "--provider needs a value"; PROVIDER=$2; shift 2 ;;
	--sandbox) [ $# -ge 2 ] || die "--sandbox needs a value"; SANDBOX=$2; SANDBOX_GIVEN=yes; shift 2 ;;
	--allowed-tools) [ $# -ge 2 ] || die "--allowed-tools needs a value"; ALLOWED=$2; shift 2 ;;
	--exclude-tools) [ $# -ge 2 ] || die "--exclude-tools needs a value"; EXCLUDED=$2; shift 2 ;;
	--final-message) [ $# -ge 2 ] || die "--final-message needs a value"; RETURNED=$2; shift 2 ;;
	-h | --help) usage ;;
	*) die "unknown option: $1" ;;
	esac
done

case "$ROLE" in
research | build | evaluate) ;;
# RETIRED, 2026-09-03, on the practitioner's word: "a brief fixer has no place
# writing anything in my words that i don't admit myself". A stopped item is his
# to rule on, with the record in front of him; nothing is raised to propose a
# rewrite of his brief. Refused by name, so a caller that still asks is told.
repair-brief) die "the 'repair-brief' role is retired (2026-09-03): an escalation raises nothing, and a failed brief is the practitioner's to rule on from the record" ;;
*) die "unknown role '$ROLE' — the roles are research, build and evaluate" ;;
esac

case "$SLUG" in
*[!a-z0-9-]* | -* | '') die "invalid slug '$SLUG' — use lower-case letters, digits and hyphens" ;;
esac

[ -d "$WT" ] || die "no such worktree: $WT"
WT=$(one_namespace "$(CDPATH= cd -- "$WT" && pwd -P)")

ROUND=${REMIT_ROUND:-1}
AUTHORITY=${REMIT_AUTHORITY:-}
RUBRICS=${REMIT_RUBRICS:-}
STANDARDS=${REMIT_STANDARDS:-}
MUSTFIX=${REMIT_MUSTFIX:-}
DELIVERY=${REMIT_DELIVERY:-}
# WHETHER `research.md` HAS AN AUTHOR AT THIS GATE — `yes` from the chain when it
# is raising the gate into `refined` for an item whose authority asks for
# research, empty everywhere else. It changes what the EVALUATOR is told it can
# reach with a must-fix, and nothing else: THE THREE GATES' one exception in
# `bin/remit`'s header is the law of it and this script states none of that law.
RESEARCH_AUTHOR=${REMIT_RESEARCH_AUTHOR:-}
PROVFILE=${REMIT_PROVENANCE:-}
RUNS=${REMIT_RUNS:-}
RUNS_NAMING=${REMIT_RUNS_NAMING:-}

# One gate's evaluator is never handed another gate's standards, and no other
# role is handed any. A rubric file arriving for a role that does not judge is a
# mistake at the seam, not something to quietly ignore.
if [ -n "$RUBRICS" ] && [ "$ROLE" != evaluate ]; then
	die "REMIT_RUBRICS was set for the '$ROLE' role — a rubric goes to the gate's evaluator and to nobody else"
fi

# And the other way: the `fix` section is the BAR, and goes to the roles that
# author. A role that judges is handed the gate file whole and never this
# derived half of it, because a judge reading only one section would think that
# section was the whole gate.
if [ -n "$STANDARDS" ]; then
	case "$ROLE" in
	build | research) ;;
	*) die "REMIT_STANDARDS was set for the '$ROLE' role — the gate's \`fix\` section is the bar handed to the roles that author, and to nobody else" ;;
	esac
fi

# ==============================================================================
# the registry: `.remit/settings.json`
# ==============================================================================
#
# What the file is, what it may carry and how a seat is resolved from it are this
# script's header. This is the reading of it.

SETTINGS=${REMIT_SETTINGS:-}
if [ -z "$SETTINGS" ]; then
	_r=$(git rev-parse --show-toplevel 2>/dev/null) || _r=''
	[ -n "$_r" ] && SETTINGS="$_r/.remit/settings.json"
fi
[ -n "$SETTINGS" ] ||
	die "no registry: REMIT_SETTINGS is unset and this directory is not inside a Git repository, so there is nowhere to look for .remit/settings.json. Every seat comes from the registry and there is no default left to fall back on"
[ -e "$SETTINGS" ] ||
	die "no registry at $SETTINGS — every seat this script raises comes from one the practitioner registered there, and there is no standing default left to fall back on. \`sh bin/remit setup\` proposes one from what is on this host, and \`sh bin/remit setup --write\` saves it"
[ -s "$SETTINGS" ] || die "the registry $SETTINGS is empty — a registry that registers nothing can raise nothing"

command -v jq >/dev/null 2>&1 ||
	die "no 'jq' on PATH — the registry $SETTINGS is JSON and this script reads it with jq. It will not guess at a parse it cannot make; install jq, or nothing here is raised"

# One pass. It emits either error lines, each beginning `!`, or the registry
# flattened into two record kinds, tab separated:
#
#   H <harness> <cli> <model model …>
#   D <role>    <harness> <model>
#
# Every refusal below names the KEY it could not read. A JSON syntax error never
# reaches this program at all: jq refuses the parse first, and its own message,
# which names the line, is what gets printed.
SETTINGS_JQ='
def E($m): "!\t" + $m;
def nonempty: type == "string" and length > 0;
. as $r
| ["research","build","evaluate"] as $ROLES
| ["repair-brief"] as $RETIRED
| ["claude","codex","pi","devin","copilot"] as $KNOWN
| (
  if ($r | type) != "object" then
    [E("the top level of the registry is a \($r | type), not an object carrying `harnesses` and `defaults`")]
  else
    [ $r | keys[] | select(. != "harnesses" and . != "defaults")
      | E("unknown top-level key `\(.)` — the registry carries `harnesses` and `defaults`, and nothing else") ]
  + ( if ($r | has("harnesses")) | not then
        [E("no `harnesses` — the registry names every harness a seat may sit on")]
      elif ($r.harnesses | type) != "object" then
        [E("`harnesses` is a \($r.harnesses | type), not an object")]
      elif ($r.harnesses | length) == 0 then
        [E("`harnesses` is empty — a registry that registers no harness can raise nothing")]
      else
        [ $r.harnesses | to_entries[] | . as $h |
          if ($KNOWN | index($h.key)) == null then
            E("`harnesses.\($h.key)` is not a harness remit drives — those are claude, codex, pi, devin and copilot")
          elif ($h.value | type) != "object" then
            E("`harnesses.\($h.key)` is a \($h.value | type), not an object with `cli` and `models`")
          elif ((($h.value | keys) - ["cli","models"]) | length) > 0 then
            E("`harnesses.\($h.key)` carries \((($h.value | keys) - ["cli","models"]) | join(", ")) — a harness entry carries `cli` and `models`, and nothing else")
          elif (($h.value.cli // null) | nonempty | not) then
            E("`harnesses.\($h.key).cli` is missing or not a non-empty string — it names the command this host runs")
          elif (($h.value.models // null) | type) != "array" then
            E("`harnesses.\($h.key).models` is missing or not an array of model ids")
          elif ($h.value.models | length) == 0 then
            E("`harnesses.\($h.key).models` is empty — a harness with no registered model registers no seat")
          elif ([$h.value.models[] | select(nonempty | not)] | length) > 0 then
            E("`harnesses.\($h.key).models` carries an entry that is not a non-empty string")
          elif (($h.value.models | unique | length) != ($h.value.models | length)) then
            E("`harnesses.\($h.key).models` lists the same id twice")
          elif ([$h.value.models[] | select(test("[ \\t\\n]"))] | length) > 0 then
            E("`harnesses.\($h.key).models` carries an id with whitespace in it, and this script separates ids by spaces")
          else empty end ]
      end )
  + ( if ($r | has("defaults")) | not then
        [E("no `defaults` — the registry names the seat each role takes")]
      elif ($r.defaults | type) != "object" then
        [E("`defaults` is a \($r.defaults | type), not an object")]
      else
        [ $r.defaults | keys[] | . as $k | select(($ROLES | index($k)) == null and ($RETIRED | index($k)) == null)
          | E("`defaults.\($k)` is not a role remit has — those are research, build and evaluate") ]
      + [ $ROLES[] | . as $k | select(($r.defaults | has($k)) | not)
          | E("`defaults.\($k)` is missing — every role takes a seat the practitioner registered, and a role with none can raise nothing") ]
      + [ $r.defaults | to_entries[] | . as $d | select(($ROLES | index($d.key)) != null) |
          if ($d.value | type) != "object" then
            E("`defaults.\($d.key)` is a \($d.value | type), not an object with `harness` and `model`")
          elif ((($d.value | keys) - ["harness","model"]) | length) > 0 then
            E("`defaults.\($d.key)` carries \((($d.value | keys) - ["harness","model"]) | join(", ")) — a seat carries `harness` and `model`, and nothing else")
          elif (($d.value.harness // null) | nonempty | not) then
            E("`defaults.\($d.key).harness` is missing or not a non-empty string")
          elif (($d.value.model // null) | nonempty | not) then
            E("`defaults.\($d.key).model` is missing or not a non-empty string")
          elif ((($r.harnesses // {}) | type) != "object") or ((($r.harnesses // {}) | has($d.value.harness)) | not) then
            E("`defaults.\($d.key).harness` is `\($d.value.harness)`, which `harnesses` does not register")
          elif ((((($r.harnesses[$d.value.harness]).models) // []) | index($d.value.model)) == null) then
            E("`defaults.\($d.key).model` is `\($d.value.model)`, which is not registered for harness `\($d.value.harness)`")
          else empty end ]
      end )
  end
) as $errs
| if ($errs | length) > 0 then $errs[]
  else
    ( $r.harnesses | to_entries[] | "H\t\(.key)\t\(.value.cli)\t\(.value.models | join(" "))" ),
    ( $r.defaults  | to_entries[] | "D\t\(.key)\t\(.value.harness)\t\(.value.model)" )
  end
'

JQERR=$(mktemp 2>/dev/null) || JQERR=${TMPDIR:-/tmp}/$ME-jqerr-$$
if ! REGISTRY=$(jq -r "$SETTINGS_JQ" "$SETTINGS" 2>"$JQERR"); then
	printf '%s: the registry %s is not JSON this script can parse, so NOTHING is applied from it. jq refused it, and its own message names the line:\n' "$ME" "$SETTINGS" >&2
	sed 's/^/    /' "$JQERR" >&2
	rm -f "$JQERR"
	exit 2
fi
rm -f "$JQERR"

# A malformed registry refuses EVERYTHING rather than applying the half of it
# that reads — `rubrics_check`'s rule in `bin/remit`, applied to this file.
if printf '%s\n' "$REGISTRY" | grep -q '^!'; then
	printf '%s: the registry %s has entries this script cannot read, so NONE of it is applied:\n' "$ME" "$SETTINGS" >&2
	printf '%s\n' "$REGISTRY" | sed -n "s/^!$(printf '\t')/    /p" >&2
	printf 'The shape is in this script'"'"'s header. `sh bin/remit setup` proposes one from what is on this host, and `sh bin/remit setup --write` saves it.\n' >&2
	exit 2
fi

TAB=$(printf '\t')

reg_registered() { # $1 harness -> 0 when the registry carries it
	printf '%s\n' "$REGISTRY" | awk -F"$TAB" -v h="$1" '$1 == "H" && $2 == h { f = 1 } END { exit f ? 0 : 1 }'
}
reg_cli() { # $1 harness -> the command the registry names for it
	printf '%s\n' "$REGISTRY" | awk -F"$TAB" -v h="$1" '$1 == "H" && $2 == h { print $3; exit }'
}
reg_harnesses() { # -> every registered harness, space separated
	printf '%s\n' "$REGISTRY" | awk -F"$TAB" '$1 == "H" { printf "%s ", $2 }' | sed 's/ $//'
}
reg_models() { # $1 harness -> its registered ids, space separated
	printf '%s\n' "$REGISTRY" | awk -F"$TAB" -v h="$1" '$1 == "H" && $2 == h { print $4; exit }'
}
reg_has_model() { # $1 harness  $2 model -> 0 when that harness registers it
	printf '%s\n' "$REGISTRY" | awk -F"$TAB" -v h="$1" -v m="$2" '
		$1 == "H" && $2 == h { n = split($4, w, " "); for (i = 1; i <= n; i++) if (w[i] == m) f = 1 }
		END { exit f ? 0 : 1 }'
}
reg_carriers() { # $1 model -> every registered harness carrying it, space separated
	printf '%s\n' "$REGISTRY" | awk -F"$TAB" -v m="$1" '
		$1 == "H" { n = split($4, w, " "); for (i = 1; i <= n; i++) if (w[i] == m) printf "%s ", $2 }' | sed 's/ $//'
}
reg_default() { # $1 role  $2 harness|model -> that half of the role's registered seat
	printf '%s\n' "$REGISTRY" | awk -F"$TAB" -v r="$1" -v f="$2" '$1 == "D" && $2 == r { print (f == "harness" ? $3 : $4); exit }'
}

# The digest of the registry AS READ, so a record can be held against the file
# this raise actually resolved through. The tool that made it is named beside it:
# a bare hex string nobody can reproduce is a decoration, not a record.
if command -v sha256sum >/dev/null 2>&1; then
	REGISTRY_HASH="sha256:$(sha256sum "$SETTINGS" | awk '{print $1}')"
elif command -v shasum >/dev/null 2>&1; then
	REGISTRY_HASH="sha256:$(shasum -a 256 "$SETTINGS" | awk '{print $1}')"
elif command -v cksum >/dev/null 2>&1; then
	REGISTRY_HASH="cksum:$(cksum "$SETTINGS" | awk '{print $1 "-" $2}')"
else
	REGISTRY_HASH='none — no digest tool on PATH, so the registry is named here but not fingerprinted'
fi

# ==============================================================================
# the seat: role -> harness + model, strictly, from the registry
# ==============================================================================

SEAT_FROM=''
SEAT_KIND=''

unregistered() { # $1 what was asked for, in words
	die "$1 — not registered in .remit/settings.json ($SETTINGS). That is a registry to fix, not a seat for this script to substitute"
}

if [ "$HARNESS" = native ]; then
	# `native` raises NOTHING. It records a context the calling harness already
	# had, whose text is already on disk, so there is no seat to resolve and no
	# CLI to find. The registry above still had to read: one this script cannot
	# read refuses every raise, and that includes the one that raises nothing.
	SEAT_FROM='the command line — native records a context this script did not raise'
	SEAT_KIND=override
elif [ -n "$HARNESS" ] && [ -n "$MODEL" ]; then
	reg_registered "$HARNESS" || unregistered "harness '$HARNESS' (registered: $(reg_harnesses))"
	reg_has_model "$HARNESS" "$MODEL" ||
		unregistered "model '$MODEL' for harness '$HARNESS' (registered there: $(reg_models "$HARNESS"))"
	SEAT_FROM='--harness and --model, both checked against the registry'
	SEAT_KIND=override
elif [ -n "$HARNESS" ]; then
	reg_registered "$HARNESS" || unregistered "harness '$HARNESS' (registered: $(reg_harnesses))"
	if [ "$(reg_default "$ROLE" harness)" = "$HARNESS" ]; then
		MODEL=$(reg_default "$ROLE" model)
	else
		die "--harness $HARNESS was given with no --model, and the registry seats '$ROLE' on $(reg_default "$ROLE" harness) instead — so nothing registered says which model this role takes on $HARNESS. Name one with --model (registered for $HARNESS: $(reg_models "$HARNESS")); a model is never picked for you"
	fi
	SEAT_FROM='--harness, with the model the registry seats this role on there'
	SEAT_KIND=override
elif [ -n "$MODEL" ]; then
	# The practitioner reaching for a named model — his own example, "use sol".
	# It resolves when the registry carries it, and fails loudly when it does not.
	if [ "$(reg_default "$ROLE" model)" = "$MODEL" ]; then
		HARNESS=$(reg_default "$ROLE" harness)
	else
		carriers=$(reg_carriers "$MODEL")
		case "$carriers" in
		'') unregistered "model '$MODEL'" ;;
		*' '*) die "model '$MODEL' is registered for more than one harness — $carriers — so this raise would be choosing between them. Name the one you mean with --harness" ;;
		*) HARNESS=$carriers ;;
		esac
	fi
	SEAT_FROM='--model, with the harness the registry registers it under'
	SEAT_KIND=override
else
	HARNESS=$(reg_default "$ROLE" harness)
	MODEL=$(reg_default "$ROLE" model)
	[ -n "$HARNESS" ] && [ -n "$MODEL" ] ||
		die "the registry $SETTINGS registers no seat for the '$ROLE' role, so there is nothing to raise it on and nothing to substitute"
	SEAT_FROM="the registry's own default for this role"
	SEAT_KIND=registered
fi

# Reasoning effort is expressible on the command line for exactly one of these
# CLIs. Where the harness has no effort control, the model half of a standing
# constraint still binds and the effort half is unenforceable there — which is
# said, not silently dropped, and certainly not accepted here and ignored.
if [ -n "$EFFORT" ] && [ "$HARNESS" != copilot ]; then
	die "--effort applies only to a copilot raise — no other CLI this script drives exposes a reasoning-effort control, and an effort this script cannot pass is never reported as one that applied"
fi

# ==============================================================================
# availability: a REGISTERED seat that is not here is reported, never substituted
# ==============================================================================
#
# A separate question from registration, with a separate answer, because
# "the practitioner never registered this" and "he registered it and it is not
# here" are different problems, and only one of them is a registry to edit.

absent() { # $1 why, in words
	die "the '$HARNESS' seat is registered but not available: $1. Nothing is substituted for it, and this raise did not happen"
}

# The command the REGISTRY names for this harness, not one this script assumed.
if [ "$HARNESS" = native ]; then
	CLI=''
else
	CLI=$(reg_cli "$HARNESS")
fi

# devin and copilot are resolved separately below: neither is always on PATH, so
# "not on PATH" is not the same question as "not installed".
if [ -n "$CLI" ] && [ "$HARNESS" != devin ] && [ "$HARNESS" != copilot ]; then
	command -v "$CLI" >/dev/null 2>&1 ||
		absent "the registered command '$CLI' is not on PATH"
fi

if [ "$HARNESS" = native ]; then
	[ -n "$RETURNED" ] ||
		die "--final-message is required with --harness native — the context was the calling harness's own and what it returned is never invented"
	[ -f "$RETURNED" ] || die "no final-message file at $RETURNED"
	[ -n "$MODEL" ] ||
		die "--model is required with --harness native — the provenance names the model that authored the work and never guesses it"
else
	[ -z "$RETURNED" ] ||
		die "--final-message applies only to --harness native; for a CLI the final message is captured from the run"
	[ -n "$AUTHORITY" ] ||
		die "REMIT_AUTHORITY names the bounded authority for this step and there is none — a context is never raised without one"
	[ -f "$AUTHORITY" ] || die "no authority file at $AUTHORITY"
	[ -s "$AUTHORITY" ] || die "the authority file $AUTHORITY is empty"
fi

MODEL_CHECK=''

if [ "$HARNESS" = pi ]; then
	# The registry already guarantees the id is REGISTERED. Whether the CLI on
	# THIS host still carries it is the availability question, and pi is the one
	# CLI here that can answer it.
	if ! catalog=$("$CLI" --list-models 2>&1) || [ -z "$catalog" ]; then
		printf '%s: could not read pi'\''s model catalogue, so the registered id cannot be checked against this host. Not raising a context:\n%s\n' "$ME" "$catalog" >&2
		exit 2
	fi
	printf '%s\n' "$catalog" | pi_catalogue_ids | grep -Fxq -- "$MODEL" ||
		absent "the registered model '$MODEL' is not in \`$CLI --list-models\` on this host. Pi would accept it silently and answer with something else, and that substitution is what this check exists to prevent"
	MODEL_CHECK="verified against \`$CLI --list-models\` before the run"
fi

DEVIN='' DEVIN_TIER='' DEVIN_ORG='' DEVIN_TIER_NOTE='' DEVIN_JSON=''
DEVIN_MODE=accept-edits DEVIN_TIMEOUT=${REMIT_DEVIN_TIMEOUT:-3600}
DEVIN_VERSION='' DEVIN_ACU='' PERM_APPLIED='' ATIF=''

if [ "$HARNESS" = devin ]; then
	# `devin` is not always on PATH. Its Windows package installer adds the
	# binary's directory to the persisted user PATH, which any shell whose
	# process tree predates the install never sees — so the package path is tried
	# second, and only both missing is an absent capability.
	if command -v "$CLI" >/dev/null 2>&1; then
		DEVIN=$CLI
	else
		DEVIN=$(packaged_path devin)
	fi
	[ -n "$DEVIN" ] ||
		absent "the registered command '$CLI' is neither on PATH nor at devin's package path"

	# On PATH but unauthenticated is absent, the same shape as `gh auth status`.
	if ! devin_auth=$("$DEVIN" auth status 2>&1); then
		printf '%s: the devin seat is registered but not available: `%s auth status` reports it is not authenticated. Nothing is substituted for it, and this raise did not happen:\n%s\n' "$ME" "$DEVIN" "$devin_auth" >&2
		exit 2
	fi
	devin_field() { printf '%s\n' "$devin_auth" | sed -n "s/^[[:space:]]*$1:[[:space:]]*//p" | sed -n 1p | sed 's/[[:space:]]*$//'; }
	DEVIN_TIER=$(devin_field Tier)
	DEVIN_ORG=$(devin_field 'Primary org')
	devin_ent=$(devin_field Enterprise)
	# A seat bought for an organisation that logged in without pinning its host
	# first lands on the public free tier with no error at all. That is reported
	# here — a login to fix, not something this script corrects, and a genuine
	# free-tier account is a first-class target that gets identical containment.
	case "$DEVIN_TIER" in
	*Free*)
		if [ "$devin_ent" = yes ] || [ -n "$DEVIN_ORG" ]; then
			DEVIN_TIER_NOTE="the account reports '$DEVIN_TIER' while also reporting an organisation. An enterprise seat that logged in before its host was pinned lands on the public free tier silently, and that is what this looks like. The tier above is what this raise is billed and governed by; it is reported, not corrected."
		fi
		;;
	esac

	# No flag guarantees a -p run is non-interactive: a probe run was dropped into
	# an interactive picker and hung until it was killed. The wait is therefore
	# bounded by mechanism.
	case "$DEVIN_TIMEOUT" in
	'' | *[!0-9]* | 0) die "REMIT_DEVIN_TIMEOUT must be a positive whole number of seconds, not '$DEVIN_TIMEOUT'" ;;
	esac
	command -v timeout >/dev/null 2>&1 ||
		die "no 'timeout' on PATH — a devin run is bounded by mechanism because no flag guarantees non-interactivity, and an unguarded run is not substituted for a guarded one"

	# The ATIF export is the only channel carrying a devin run's final message,
	# and the only one carrying the permission mode that actually applied. A raise
	# whose result could not be read back is not started at all, rather than
	# started and reported on guesswork.
	if command -v jq >/dev/null 2>&1; then
		DEVIN_JSON=jq
	elif command -v node >/dev/null 2>&1; then
		DEVIN_JSON=node
	else
		die "neither jq nor node is on PATH — a devin run is judged from its ATIF export, which nothing here could read; not raising a context"
	fi

	# THE SANDBOX REFUSAL IS TWO REFUSALS, because it had one reason and two
	# platforms. On Windows devin's OS-level sandbox does not exist — its own docs
	# say a session HARD-FAILS when `--sandbox` is passed — so the refusal there is
	# the CLI's own behaviour said earlier and more clearly. Everywhere else the
	# sandbox is real (macOS seatbelt, Linux `bwrap` + `seccomp`, per `devin
	# --help`), and remit still does not pass it — for a DIFFERENT reason, stated
	# as its own reason rather than hidden behind Windows'.
	#
	# THAT REASON: `--sandbox` selects Autonomous and, per `reference/
	# permissions.mdx`, Autonomous is then the ONLY permission mode available. The
	# shipped build's `--permission-mode` does not accept `autonomous` as a value
	# at all — its `--help` lists `auto`, `accept-edits`, `smart`, `dangerous` — so
	# a raise that asked for `accept-edits` and got Autonomous would trip this
	# script's own mode read-back and exit 6 on every run. Making that work means
	# not asking for a mode and not checking the one that applied, which is
	# retiring a precondition, and NOTHING HERE ESTABLISHES that the trade is
	# sound: there is no non-Windows host in this repository's reach and no run
	# has been made on one. UNESTABLISHED-UNTIL-RUN, and refused rather than
	# guessed at — an absent capability is reported before anything is invoked.
	if [ "$SANDBOX_GIVEN" != no ]; then
		case "$(uname -s 2>/dev/null)" in
		MINGW* | MSYS* | CYGWIN* | Windows*)
			die "--sandbox does not apply to a devin raise on this platform — devin's OS-level sandbox is unsupported on Windows and its own documentation says a session HARD-FAILS when the flag is passed, so this script refuses first rather than letting the CLI refuse later. A devin context's containment here is its worktree, the permission rules and the hooks written for the run, and the provenance says exactly that"
			;;
		*)
			die "--sandbox is NOT refused here because the sandbox is missing — on this platform devin's sandbox is real (macOS seatbelt, Linux bwrap+seccomp) and it is the posture remit wants. It is refused because passing it selects Autonomous, which is then the only permission mode available, and the shipped build's --permission-mode does not carry that value — so this raise could not ask for a mode or check the one that applied, and retiring that precondition is not something any run has established. Read \`devin_write_containment\` in this script for what does contain a devin raise today"
			;;
		esac
	fi

	# A .devin/ that is already there is the repository's own: it is not
	# overwritten, and not silently layered under rules this script relies on.
	[ ! -e "$WT/.devin" ] ||
		die "$WT/.devin already exists — this script writes the context's containment there for the run and removes it again, and it will not overwrite a .devin the repository already has"

	MODEL_CHECK="not checked here: devin validates an unknown id itself, pre-flight, before any ACU is spent, and prints its catalogue when it refuses"
fi

COPILOT='' COPILOT_VERSION='' COPILOT_HOST='' COPILOT_LOGIN='' COPILOT_JSON=''
COPILOT_TIMEOUT=${REMIT_COPILOT_TIMEOUT:-3600}
COPILOT_CANARY_TIMEOUT=${REMIT_COPILOT_CANARY_TIMEOUT:-300}
COPILOT_CANARY_MODEL=${REMIT_COPILOT_CANARY_MODEL:-}
COPILOT_HOOK_JSON='' COPILOT_HOOK_SH='' COPILOT_HOOKDIR_MADE='' COPILOT_GITHUBDIR_MADE=''
COPILOT_CANARY_ID='' COPILOT_CANARY_AIU='' COPILOT_HOOK_ATTEST=''
COPILOT_AIU='' COPILOT_PREMIUM='' COPILOT_CFG_DIR=''
# Displayed, not expanded: the rules themselves are appended one at a time with
# globbing off, because `shell(git:*)` is a pathname pattern to an unquoted shell.
COPILOT_DENY='shell(git) shell(git:*) shell(gh) shell(gh:*)'

if [ "$HARNESS" = copilot ]; then
	# Where the two package paths are, and why neither CLI is always on PATH, is
	# `packaged_path` above: copilot sits at the WinGet package ROOT and devin
	# under a bin/, which is exactly why that knowledge has one home.
	if command -v "$CLI" >/dev/null 2>&1; then
		COPILOT=$CLI
	else
		COPILOT=$(packaged_path copilot)
	fi
	[ -n "$COPILOT" ] ||
		absent "the registered command '$CLI' is neither on PATH nor at copilot's package path"

	# The CLI updates itself by default, so the version that ran is read at raise
	# time. A documented version would be a guess about the future.
	COPILOT_VERSION=$("$COPILOT" --version 2>&1 | sed -n 1p | sed 's/[[:space:]]*$//')

	# There is NO live authentication check to make: this CLI ships no
	# `auth status` and no `logout` subcommand, and an invalid token in the
	# environment did not fail a run. What exists is a state file. The identity is
	# READ and recorded the way a devin raise records tier and org, and never made
	# a condition of running. Nothing but the host and the login is read, and
	# neither is a credential: the token lives in the OS credential store.
	COPILOT_CFG_DIR=${COPILOT_HOME:-${HOME:-}/.copilot}
	if [ -f "$COPILOT_CFG_DIR/config.json" ]; then
		COPILOT_HOST=$(sed -n 's/.*"host"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$COPILOT_CFG_DIR/config.json" | sed -n 1p)
		COPILOT_LOGIN=$(sed -n 's/.*"login"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$COPILOT_CFG_DIR/config.json" | sed -n 1p)
	fi

	# No flag guarantees a run is non-interactive. No probe ever saw one block —
	# but a run that has never hung is not a run that cannot.
	case "$COPILOT_TIMEOUT" in
	'' | *[!0-9]* | 0) die "REMIT_COPILOT_TIMEOUT must be a positive whole number of seconds, not '$COPILOT_TIMEOUT'" ;;
	esac
	case "$COPILOT_CANARY_TIMEOUT" in
	'' | *[!0-9]* | 0) die "REMIT_COPILOT_CANARY_TIMEOUT must be a positive whole number of seconds, not '$COPILOT_CANARY_TIMEOUT'" ;;
	esac
	command -v timeout >/dev/null 2>&1 ||
		die "no 'timeout' on PATH — a copilot run is bounded by mechanism because no flag guarantees non-interactivity, and an unguarded run is not substituted for a guarded one"

	# The JSONL envelope is the only channel carrying a copilot run's final
	# message free of narration, and the only one carrying the run id, the served
	# model and the cost. It is also what the containment canary is judged from.
	if command -v jq >/dev/null 2>&1; then
		COPILOT_JSON=jq
	elif command -v node >/dev/null 2>&1; then
		COPILOT_JSON=node
	else
		die "neither jq nor node is on PATH — a copilot run is judged from its JSONL envelope, which nothing here could read; not raising a context"
	fi

	[ "$SANDBOX_GIVEN" = no ] ||
		die "--sandbox does not apply to a copilot raise — this build ships no --sandbox flag at all, its OS-level sandboxing is experimental and reports every Windows host as supported without checking, and this script never passes it. A copilot context's containment is the deny rules and the hook written for the run — git and gh, tested by a canary before the run starts — and the provenance says exactly that, including that no read boundary is enforced"

	# .github/ is not devin's .devin/: almost every repository already has one. So
	# the guard is on the two FILES this script writes, never on the directory,
	# and the removal afterwards takes back only what it created.
	COPILOT_HOOK_JSON="$WT/.github/hooks/remit-no-git.json"
	COPILOT_HOOK_SH="$WT/.github/hooks/remit-no-git.sh"
	for f in "$COPILOT_HOOK_JSON" "$COPILOT_HOOK_SH"; do
		[ ! -e "$f" ] ||
			die "$f already exists — this script writes the context's containment there for the run and removes it again, and it will not overwrite a file the repository already has"
	done

	MODEL_CHECK="not checked here: copilot refuses an unknown model id and an unsupported effort pre-flight, in seconds, with nothing billed"
fi

case "$HARNESS" in
codex) MODEL_CHECK="none available: codex ships no model catalogue — \`codex doctor\` reports only the model already configured. The run header names the model that actually served this run, and that is what \`model:\` carries" ;;
claude) MODEL_CHECK="none available: the claude CLI ships no model catalogue. The run envelope names the model that actually served this run, and that is what \`model:\` carries" ;;
native) MODEL_CHECK="none: no CLI was invoked, so the model is the one the caller named" ;;
esac

command -v env >/dev/null 2>&1 ||
	die "no 'env' on PATH — every context here is started with an allow-listed environment and there is no way to do that without it; not raising a context"

# ==============================================================================
# the run directory, the scratch home, and the environment allow-list
# ==============================================================================

# ONE PATH NAMESPACE, above: `$SCRUB_HOME` under this directory is handed to the
# seat as `HOME`, and the coordinator's `TMPDIR` on Git Bash is `/tmp` — a mount
# point, not a directory anything but this shell can find.
RUNDIR=$(one_namespace "${TMPDIR:-/tmp}")/$ME-$SLUG-$ROLE-$$
mkdir -p "$RUNDIR" || die "cannot create the run directory $RUNDIR"
OUTFILE="$RUNDIR/stdout"
ERRFILE="$RUNDIR/stderr"
PROGRESSFILE="$RUNDIR/progress"
FINALFILE="$RUNDIR/final-message"
BRIEF="$RUNDIR/briefing"
ATIF="$RUNDIR/atif.json"
ENVLIST="$RUNDIR/envlist"

# The coordinator's own home, only ever used to compose the harness config
# directories below — each of which is handed to the harness's CLI, so it goes
# across in the spelling that CLI can open.
REAL_HOME=$(one_namespace "${HOME:-}")
SCRUB_HOME="$RUNDIR/home"
mkdir -p "$SCRUB_HOME" || die "cannot create the scratch home under $RUNDIR"

# THE ONE WRITABLE SCRATCH ROOT, and why it is in the worktree rather than beside
# the run log. A sandboxed seat — codex on Windows runs as a dedicated local
# account under a restricted token — can write to its WORKSPACE and to its OWN
# temp, and to nothing else. The run log lives under the COORDINATOR's temp,
# which on this host is a directory inside the practitioner's user profile: the
# seat's account is refused there, so every fixture that tried to land in it
# failed on write before it tested anything. The worktree is the one directory
# that is writable for every seat on every harness, so that is where the scratch
# goes, and `TMPDIR`, `TEMP` and `TMP` all name it.
#
# It is APPARATUS, not delivery. It is emptied before the context starts, so a
# crashed earlier run leaves nothing for this one to trip on, and `remove_scratch`
# below takes it away before the tree is handed back — a tree the seam is about
# to stage must carry what the context AUTHORED and nothing it merely scribbled.
#
# The NAME is short on purpose. A worktree path is already long, Windows still
# refuses a path over 260 characters in most tools, and everything a seat writes
# now hangs off this one — a clone of the repository, a throwaway repository with
# a `.git/objects/…` under it. Every character spent here is spent again on every
# file below it.
SCRUB_TMP="$WT/.remit-tmp"
rm -rf "$SCRUB_TMP"
mkdir -p "$SCRUB_TMP" ||
	die "cannot create the scratch root at $SCRUB_TMP — a seat with nowhere to write cannot run anything, and this script will not raise one that cannot"

# AND IT IGNORES ITSELF, for the run that never reaches the removal below.
#
# `remove_scratch` takes this directory away on every path this script controls,
# and the trap takes it on an interrupt or a terminate. NEITHER reaches a run
# that is KILLED — a signal no shell can trap, a harness reaping a long job, a
# machine going down mid-raise. What is left then is a directory of the seat's
# scratch sitting at the top of a worktree the seam stages wholesale, and what
# it holds is a clone of the repository and throwaway repositories: a delivery
# carrying that is the residue this work exists to end, arriving by the one door
# the cleanup cannot close.
#
# So the directory ignores itself. A `.gitignore` whose single pattern is `*`
# matches every entry beneath it INCLUDING that file, so git reports nothing
# here in `status`, counts nothing here in `ls-files --others`, and stages
# nothing here on `add -A` — while a repository CLONED into this directory is
# untouched by it, because a `.gitignore` above a repository's own top level is
# not one of the files that repository reads.
#
# It is written here rather than checked in anywhere because the worktree is the
# TARGET repository's, not remit's: a line in remit's own `.gitignore` would
# protect remit's repository and no other, and this mechanism is installed into
# repositories whose ignore file remit does not write. The one that travels is
# the one the script makes at the moment it makes the directory.
printf '*\n' >"$SCRUB_TMP/.gitignore" ||
	die "cannot write $SCRUB_TMP/.gitignore — without it a run killed before its cleanup leaves the seat's scratch where the seam would stage it, and this script will not raise a seat it cannot keep out of a delivery"

# The apparatus this raise put on disk, taken away in one place because it is
# taken away from more than one. Returns non-zero if the scratch root survived.
remove_scratch() {
	rm -rf "$SCRUB_HOME"
	rm -rf "$SCRUB_TMP"
	[ ! -e "$SCRUB_TMP" ]
} # end remove_scratch

# WHAT A SCRATCH ROOT THAT WILL NOT GO MEANS, in the two places it can happen.
# The condition is the same one — `remove_scratch` reporting the directory
# survived — and what it COSTS is not, so the answer is not either. Both are
# written here, next to each other and to the removal itself, because a reader
# deciding whether a difference is deliberate should not have to hold two ends of
# a two-thousand-line script in mind to see that it is.
#
# Neither can be produced by this suite on both of its platforms — it needs a
# directory writable when a run starts and unwritable when it ends, and Git Bash
# hands the owner the write back through the ACL a POSIX `chmod` maps to. So each
# is a FUNCTION, ending in the marker `t/unit/remit-invoke.sh` lifts it out on,
# and what is tested there is the decision each makes when it is told the root
# survived — which is the whole of what this script contributes to that outcome.

# AT THE END OF A RUN THAT FINISHED, it is a REFUSAL and not a warning. The
# directory sits inside the worktree the seam is about to stage, and a delivery
# carrying a context's fixtures is worse than a raise that reports it could not
# finish. What survived is named, so it can be removed by hand.
scratch_gone_or_refuse() { # -> 0 when the root went; does not return when it did not
	remove_scratch && return 0
	die "could not remove the scratch root at $SCRUB_TMP — refusing to hand back a tree that still carries what the context scribbled rather than what it authored. The run itself finished and what it said is in $RUNDIR"
} # end scratch_gone_or_refuse

# ON A PATH THAT IS ALREADY REFUSING, it is REPORTED and the refusal already in
# flight is what the caller exits with. Turning it into a `die` there would swap
# a raise's own exit code — the one that says WHY the raise was refused — for
# this script's generic 2, and the reason the seat was never raised would be lost
# behind the housekeeping that followed it. So it is said, loudly, and the caller
# goes on to exit with what it came to exit with.
scratch_gone_or_warn() { # -> always 0; says so when the root survived
	remove_scratch && return 0
	say "the scratch root at $SCRUB_TMP could not be removed — remove it before this tree is staged"
	return 0
} # end scratch_gone_or_warn

# And on any path out that never reaches it — a refusal composing the briefing,
# an interrupt, a signal. The run log stays, because it IS the record; the
# scratch home and the scratch root go, because they are apparatus, and the
# scratch root sits in a tree somebody is about to read.
trap 'rm -rf "$SCRUB_HOME" "$SCRUB_TMP"' EXIT INT TERM

# --- the two visibility channels ---------------------------------------------
# The run directory's name carries this process's pid, so nothing outside can
# work out where to look. Saying where it is, the moment it exists, is what makes
# tailing it possible at all — and it is said before the briefing is composed, so
# a watcher started now sees the run rather than the end of it.
: >"$PROGRESSFILE" || die "cannot create the progress log at $PROGRESSFILE"
if [ -n "${REMIT_PROGRESS:-}" ]; then
	printf '%s\n' "$RUNDIR" >"$REMIT_PROGRESS" ||
		die "cannot write the run directory's location to REMIT_PROGRESS=$REMIT_PROGRESS — a caller that asked to be able to watch this run is not given silence instead"
fi

HEARTBEAT=${REMIT_HEARTBEAT:-30}
case "$HEARTBEAT" in
'' | *[!0-9]*)
	die "REMIT_HEARTBEAT must be a whole number of seconds, or 0 to silence it — not '$HEARTBEAT'"
	;;
esac

# THE IDLE BOUND's setting. The law — including why the default is 600 on devin
# and 0 everywhere else — is THE IDLE BOUND in this script's header.
if [ -n "${REMIT_QUIET:-}" ]; then
	QUIET=$REMIT_QUIET
elif [ "$HARNESS" = devin ]; then
	QUIET=600
else
	QUIET=0
fi
case "$QUIET" in
'' | *[!0-9]*)
	die "REMIT_QUIET must be a whole number of seconds, or 0 to turn the idle bound off — not '$QUIET'"
	;;
esac

# The allow-list, written down before anything runs. This file IS the record of
# what crossed into the context, and it is what the provenance quotes: a scrub
# nobody can read afterwards is a claim, not a mechanism.
scrub_list() {
	printf 'PATH=%s\n' "$PATH"
	printf 'HOME=%s\n' "$SCRUB_HOME"
	printf 'TMPDIR=%s\n' "$SCRUB_TMP"
	printf 'TEMP=%s\n' "$SCRUB_TMP"
	printf 'TMP=%s\n' "$SCRUB_TMP"
	[ -n "${LANG:-}" ] && printf 'LANG=%s\n' "$LANG"
	[ -n "${LC_ALL:-}" ] && printf 'LC_ALL=%s\n' "$LC_ALL"
	[ -n "${LC_CTYPE:-}" ] && printf 'LC_CTYPE=%s\n' "$LC_CTYPE"
	[ -n "${SYSTEMROOT:-}" ] && printf 'SYSTEMROOT=%s\n' "$SYSTEMROOT"
	[ -n "${COMSPEC:-}" ] && printf 'COMSPEC=%s\n' "$COMSPEC"
	[ -n "${PATHEXT:-}" ] && printf 'PATHEXT=%s\n' "$PATHEXT"
	# Without this a Windows CLI writes a literal `%SystemDrive%` directory
	# into whatever its CWD happens to be — here, the worktree the seam is
	# about to stage. The block at the top of this file says which incident
	# this came from.
	[ -n "${SYSTEMDRIVE:-}" ] && printf 'SYSTEMDRIVE=%s\n' "$SYSTEMDRIVE"
	# The harness's own config variable — a PATH to its configuration, never a
	# credential. Where the coordinator already sets one, that value is what is
	# passed; otherwise it is computed from the coordinator's real home.
	case "$HARNESS" in
	claude) printf 'CLAUDE_CONFIG_DIR=%s\n' "${CLAUDE_CONFIG_DIR:-$REAL_HOME/.claude}" ;;
	codex) printf 'CODEX_HOME=%s\n' "${CODEX_HOME:-$REAL_HOME/.codex}" ;;
	pi) printf 'PI_CODING_AGENT_DIR=%s\n' "${PI_CODING_AGENT_DIR:-$REAL_HOME/.pi/agent}" ;;
	copilot)
		printf 'COPILOT_HOME=%s\n' "${COPILOT_HOME:-$REAL_HOME/.copilot}"
		# Without this, repo hooks do not load in prompt mode at all, and the
		# equivalent permission flag does NOT satisfy the gate.
		printf 'GITHUB_COPILOT_PROMPT_MODE_REPO_HOOKS=true\n'
		;;
	devin)
		# devin has no config-directory variable; on Windows its configuration and
		# state live under these two, and `--config` is refused rather than passed.
		[ -n "${APPDATA:-}" ] && printf 'APPDATA=%s\n' "$APPDATA"
		[ -n "${LOCALAPPDATA:-}" ] && printf 'LOCALAPPDATA=%s\n' "$LOCALAPPDATA"
		;;
	esac
	return 0
}
scrub_list >"$ENVLIST" || die "could not write the environment allow-list at $ENVLIST"

# ==============================================================================
# the briefing — the role's limits, then the authority, then what the gate asks
# ==============================================================================

role_limits() {
	case "$ROLE" in
	build)
		printf 'You are a BUILDER. You author a WORKING TREE at `%s` and stop there.\n\n' "$WT"
		printf -- '- You NEVER run `git` or `gh`, in any wrapping. Not `git add`, not a commit,\n'
		printf '  not a branch, not a push, not a pull request. The tree you leave\n'
		printf '  uncommitted is exactly what the mechanism expects: it stages, commits with\n'
		printf '  the provenance trailers, pushes and opens the pull request after you exit.\n'
		printf -- '- You NEVER run `bin/remit` or `bin/remit-invoke`. Moving the item is the\n'
		printf '  state machine'\''s and raising a context is the seam'\''s; a builder that runs\n'
		printf '  either has left its boundary.\n'
		printf -- '- You work only inside the authority below. You never widen it. Something the\n'
		printf '  authority does not cover is reported in what you return, not done.\n'
		printf -- '- An outcome you could not reach is reported as unreached. Nothing is\n'
		printf '  invented, no proof is substituted for an easier one, and a capability that\n'
		printf '  is absent is said to be absent.\n'
		printf -- '- The register of your input is not the register of your output. A research\n'
		printf '  document or a brief below may flag every uncertainty in bold, because a\n'
		printf '  gate reads it; the code you write is read by someone maintaining it. A\n'
		printf '  comment says what a reader of THAT file needs and no more; the reasoning\n'
		printf '  behind a design goes in a README or the document that carries it, once.\n'
		;;
	evaluate)
		printf 'You are an EVALUATOR. You JUDGE the work in front of you and you change\n'
		printf 'nothing.\n\n'
		printf -- '- STATE WHAT YOU EXPECT THE PROOF TO SHOW BEFORE YOU READ THE DELIVERY.\n'
		printf '  Write that expectation down as the first thing in your answer. An\n'
		printf '  expectation formed after reading is not an expectation.\n'
		printf -- '- You NEVER repair, amend, accept, merge or close. A must-fix goes back to a\n'
		printf '  fresh builder; that is the mechanism'\''s, not yours.\n'
		printf -- '- You NEVER run `bin/remit` or `bin/remit-invoke`, and you NEVER run `git`\n'
		printf '  or `gh` AT ALL — not to change anything and not to read anything. A\n'
		printf '  raised context never runs either; the seam does. Everything you judge is\n'
		printf '  already on disk in front of you, and a `git` you reach for here is denied\n'
		printf '  by the containment this run wrote, on every harness. Those two are named\n'
		printf '  so you know what not to do, NOT as files to go and look at: depending on\n'
		printf '  how this repository was installed they may not be in your worktree at\n'
		printf '  all, and their absence is normal rather than a finding.\n'
		printf -- '- EVERY PATH THIS BRIEFING NAMES IS EITHER INSIDE YOUR WORKTREE OR MARKED\n'
		printf '  AS TEXT. A path marked as text is where something came FROM, printed so\n'
		printf '  you can name it in what you return; the thing itself is reproduced here\n'
		printf '  in full and there is nothing to open. Do not go looking for one, and do\n'
		printf '  not ask for access to anything outside your worktree — there is nothing\n'
		printf '  outside it for this run, and asking ends the run without a verdict.\n'
		printf -- '- A finding is a FACT with its evidence, never a task. You do not classify\n'
		printf '  findings by consequence: only a rubric below can accept a finding or make\n'
		printf '  one a must-fix, and every such use cites the rubric and the evidence.\n'
		printf -- '- HOW YOU JUDGE — what you may re-execute and what stands as the executing\n'
		printf '  proof — IS THE RUBRICS BELOW, and this briefing does not say it a second\n'
		printf '  time. There is one copy of that law and the rubric file is it; a copy\n'
		printf '  here would be one more thing to keep true and the first to go stale.\n'
		printf '  Read it there and judge by it.\n'
		printf -- '- A PROOF YOU CANNOT SEE RUN is reported as UNRUN — never as passed, and\n'
		printf '  never on somebody else'\''s word that it passed. What you have to judge by\n'
		printf '  is the repository, the delivery and the kept output of the runs that were\n'
		printf '  kept for you; continuous integration is the repository'\''s business and\n'
		printf '  none of yours.\n'
		printf -- '- EVERYTHING YOU WRITE GOES IN ONE PLACE: `%s`, which is what `TMPDIR`,\n' "$SCRUB_TMP"
		printf '  `TEMP` and `TMP` name in your environment. Your clone of this repository,\n'
		printf '  any fixture, any scratch file. It is inside the worktree because that is\n'
		printf '  the one directory your sandbox can write to, and it is removed when this\n'
		printf '  run ends, so nothing you make is left behind. If you ever find you cannot\n'
		printf '  write there, say so in your answer and stop — do NOT make a directory of\n'
		printf '  your own beside the repository to get past it. A judgement that had to\n'
		printf '  litter the practitioner'\''s checkout to reach itself is a finding about\n'
		printf '  this mechanism, and reporting it is worth more than the judgement.\n'
		;;
	research)
		printf 'You are a RESEARCHER. You establish what is true and you change nothing.\n\n'
		printf -- '- You NEVER run `git` or `gh` AT ALL, and you NEVER run `bin/remit` or\n'
		printf '  `bin/remit-invoke`. A raised context never runs either; the seam does.\n'
		printf '  Your evidence is the tree in front of you and the record. You author no\n'
		printf '  product change.\n'
		printf -- '- You work only inside the authority below and NEVER widen it: you establish\n'
		printf '  what it names and stop, rather than surveying whatever is nearby.\n'
		printf -- '- Everything you report is evidenced by something you actually ran or read,\n'
		printf '  named where you found it. Documentation is not evidence of behaviour. What\n'
		printf '  you could not establish is reported as unestablished.\n'
		;;
	esac
}

# WHERE KEPT OUTPUT GOES, said to the roles that write it and to the roles that
# read it, and said to neither when the chain named no home. The naming line is
# `bin/remit`'s and is reproduced without being read, and what closure does with
# what a role keeps is POINTED AT there too — this script states none of that
# law, because a second wording of it here is a wording that can contradict the
# code, and once did.
runs_section() {
	[ -n "$RUNS" ] || return 0
	printf '\n## Where kept output goes\n\n'
	case "$ROLE" in
	build | research)
		printf 'Output you are required to KEEP — a test run, a tier, a proof somebody after\n'
		printf 'you has to be able to read — goes in\n\n'
		printf '  %s\n\n' "$RUNS"
		printf 'That directory is the work item'\''s own, it already exists, and it is the ONE\n'
		printf 'place anything you keep survives this run — what you leave anywhere else is\n'
		printf 'gone before the next context looks for it. Do not commit it and do not stage\n'
		printf 'it: it is held out of git for you, and what becomes of it when the item closes\n'
		printf 'is `KEPT OUTPUT HAS A HOME` in `bin/remit`'\''s header, which is the one place\n'
		printf 'that is stated.\n\n'
		[ -n "$RUNS_NAMING" ] && printf 'How to name what you put there: %s\n' "$RUNS_NAMING"
		printf '\nIt is not a scratch directory and it is not where you work. Put there what\n'
		printf 'a reader would need to believe you, and nothing else.\n'
		;;
	evaluate)
		printf 'The output kept by the contexts that worked on this item is in\n\n'
		printf '  %s\n\n' "$RUNS"
		printf 'That is where a proof somebody claims to have run is either legible or\n'
		printf 'absent. READ it. You write nothing there and you remove nothing from it.\n'
		[ -n "$RUNS_NAMING" ] && printf '\nWhat a file there is named, so you can tell one run from another: %s\n' "$RUNS_NAMING"
		;;
	esac
	return 0
} # end runs_section

# WHAT AN EVALUATOR IS LOOKING AT, named. `bin/remit` decides which tree this
# raise stands in and which commit it hands over — WHERE AN EVALUATOR IS RAISED
# in that script's header is the law, and this end states none of it. All this
# does is say, to the context that has to judge, that the delivery is the files
# under its own worktree and not something behind a command it may not run.
#
# THE INCIDENT, so nobody removes this as decoration: an accepted-gate evaluator
# was raised in a tree that did not carry the delivered file, read for the file,
# found nothing, and spent the rest of the run hunting the commit through git
# plumbing it was contained away from — ending with no verdict at all.
delivery_section() {
	[ "$ROLE" = evaluate ] || return 0
	[ -n "$DELIVERY" ] || return 0
	printf '\n## The delivery you are judging\n\n'
	printf 'It is commit `%s` on `work/%s`, and IT IS ALREADY CHECKED OUT: the delivered\n' "$DELIVERY" "$SLUG"
	printf 'tree is the files in front of you at\n\n'
	printf '  %s\n\n' "$WT"
	printf 'Judge it by READING THOSE FILES, and by reading the kept runs named below.\n'
	printf 'There is nothing to fetch, nothing to check out and nothing to reconstruct:\n'
	printf 'the commit id is here so you can name it in what you return, not so you can\n'
	printf 'go looking for it. If a file you expected is not there, that absence IS the\n'
	printf 'finding — report it as one rather than hunting for the file by another road.\n'
	return 0
} # end delivery_section

# WHAT THE EVALUATOR AT THE GATE INTO `refined` CAN ACTUALLY REACH, said only
# when it can reach something. The chain sets `REMIT_RESEARCH_AUTHOR` for that one
# raise; everywhere else this prints nothing and the briefing is what it was.
#
# THE FIELD FAILURE THIS IS, dated 2026-09-01: an evaluator judged a `research.md`
# written from recall against a brief that asked for vendor documentation, found
# two factual errors it could cite the vendor's own documentation against — and
# raised no must-fix, because it had been told there was nothing at this gate that
# could act. There was: research is machine-authored, and a fresh researcher can
# be sent back into it.
research_author_section() {
	[ "$ROLE" = evaluate ] || return 0
	[ "$RESEARCH_AUTHOR" = yes ] || return 0
	printf '\n## Who can act on what you find\n\n'
	printf 'The `research.md` beside the brief was written by a fresh context raised for\n'
	printf 'this item — it is machine-authored, not the practitioner'\''s — and IT HAS AN\n'
	printf 'AUTHOR. A must-fix against it comes back to a fresh researcher, which writes a\n'
	printf 'replacement and returns here for another verdict, exactly as a must-fix at a\n'
	printf 'later gate goes back to a builder. A research pass that does not hold is\n'
	printf 'therefore something you CAN hold: raise it, by a `Must-fix:` line or by citing\n'
	printf 'a `fix` rubric above, with the evidence.\n\n'
	printf 'To send one back, write this line in your verdict:\n\n'
	printf '  Back to: research\n\n'
	printf 'That line is what routes the must-fix. Write it when what you require can be\n'
	printf 'satisfied by rewriting `research.md`, and only then.\n\n'
	printf 'THE BRIEF IS NOT YOURS, AND IT IS NOBODY'\''S HERE. Nothing in this mechanism\n'
	printf 'edits `brief.md`: the practitioner writes it and he alone changes it. A\n'
	printf 'must-fix that can only be satisfied by changing the brief carries NO `Back to:`\n'
	printf 'line — the item stops and it goes to him, which is the design working rather\n'
	printf 'than a gap for you to close.\n'
	return 0
} # end research_author_section

role_returns() {
	case "$ROLE" in
	build) printf 'Your final message. It is recorded as the delivery'\''s returned text, quoted\nand not endorsed. The tree you authored is the delivery; the message says what\nyou did, what you could not do, and what you left undone.\n' ;;
	research) printf 'Your findings as free text. They are written to `research.md` beside the brief\nexactly as returned, REPLACING what is there — on a round after the first, what\nyou return is the whole of the research this item carries.\n' ;;
	evaluate)
		printf 'ONE verdict, in these line shapes. They are the only text the mechanism\n'
		printf 'parses; every other line is carried into the record verbatim.\n\n'
		printf '  Verdict: PASS | PASS WITH FINDINGS | FAIL     (required; the first wins)\n'
		printf '  Must-fix: <text>                              (zero or more)\n'
		printf '  Finding: <text>                               (zero or more)\n'
		printf '  Ask: <one question>                           (zero to four, in a FAIL only)\n\n'
		printf 'PASS means everything holds and nothing is worth recording. PASS WITH\n'
		printf 'FINDINGS means the same, with findings recorded. FAIL means a must-fix\n'
		printf 'stands — and a crossed boundary, a proof that does not hold, or a defect\n'
		printf 'no rubric names IS a must-fix: write it as a `Must-fix:` line, in words a\n'
		printf 'fresh author can act on. A must-fix needs no rubric; a `fix:` citation is\n'
		printf 'one way to raise one, not the only way. A FAIL that carries no must-fix\n'
		printf 'sends nobody anything: the item stops for the practitioner with your\n'
		printf 'findings, and no author is raised on it.\n\n'
		printf 'ASK ONLY FOR A DECISION THAT IS HIS. Where the work cannot proceed because\n'
		printf 'the authority is silent on something no source can settle — which of two\n'
		printf 'shapes, which resource, whether a thing is in scope — write ONE `Ask:` line\n'
		printf 'directly under the Finding: or Must-fix: it descends from, naming the\n'
		printf 'decision it unblocks. An `Ask:` that follows no finding is prose. Any\n'
		printf 'question stops the item for the practitioner at once, whatever else this\n'
		printf 'verdict carries, and his answer is filed under `## Rulings` in the\n'
		printf 'authority. A question the record could answer, or one the research could\n'
		printf 'establish, is not his and is not asked; four is the most one verdict\n'
		printf 'carries.\n'
		;;
	esac
}

{
	printf '# A fresh context, raised by remit for the `%s` role\n\n' "$ROLE"
	printf 'You were raised by `%s` for work item `%s`, round %s. Your worktree is\n' "$ME" "$SLUG" "$ROUND"
	printf '`%s`. You are not in a conversation with anybody: what you return as your\n' "$WT"
	printf 'final message is the whole of what comes back, and it goes into a record\n'
	printf 'people read.\n\n'
	printf '## What this role may do, and may not\n\n'
	role_limits
	printf '\n## What you return\n\n'
	role_returns
	research_author_section
	delivery_section
	runs_section
	if [ -n "$AUTHORITY" ]; then
		printf '\n## Your authority — reproduced in full\n\n'
		printf 'This is the whole of what you were given. It is not a summary of something\n'
		printf 'else and there is nothing behind it. It came from `%s`; that path is TEXT,\n' "$AUTHORITY"
		printf 'printed so you can name it, and there is no file for you to open.\n\n'
		printf 'A `## Rulings` section in it, where there is one, is SETTLED GROUND: each\n'
		printf 'line is a question an earlier evaluator asked and the answer given. Where\n'
		printf 'one question carries more than one line, the LAST line stands. A line that\n'
		printf 'says `ruled:` is the practitioner'\''s word: cite it as you would a source —\n'
		printf '"ruled <date>" — build on it, and never re-open, re-derive or second-guess\n'
		printf 'it; a ruling that is wrong is his to change, not yours to find. A line that\n'
		printf 'says `ruled by the conductor, provisionally:` was decided on his behalf under\n'
		printf 'an elevation he gave, and he has not yet reviewed it: build on it exactly\n'
		printf 'the same — it is the decision in force — but where your own evidence shows\n'
		printf 'it wrong, say so as a `Finding:` naming the ruling, and do not act against\n'
		printf 'it. It is his to supersede, or the conductor'\''s; never yours.\n\n'
		tr -d '\015' <"$AUTHORITY"
	fi
	if [ -n "$MUSTFIX" ] && [ -f "$MUSTFIX" ] && [ -s "$MUSTFIX" ]; then
		printf '\n## The must-fix coming back to you\n\n'
		printf 'This is the finding and nothing else. You are not shown the evaluator'\''s\n'
		printf 'other findings, and you are not shown any earlier attempt'\''s account of\n'
		printf 'itself. Discharge this.\n\n'
		tr -d '\015' <"$MUSTFIX"
	fi
	if [ -n "$STANDARDS" ] && [ -f "$STANDARDS" ]; then
		printf '\n## The standards this work is held to\n\n'
		printf 'The practitioner'\''s `fix` rubrics for the gate this work is heading into,\n'
		printf 'reproduced verbatim. They came from `%s`; that path is TEXT and there is no\n' "$STANDARDS"
		printf 'file for you to open. Work that falls short of one of\n'
		printf 'these comes back to a fresh author as a must-fix. They are the bar, not a\n'
		printf 'checklist to write about: meet them and say nothing about them.\n\n'
		printf 'This is the ONLY part of that gate'\''s file you are shown. What may carry work\n'
		printf 'past a gate, what the practitioner must see, and what may be let go are\n'
		printf 'judgements about the work and belong to the context that judges it.\n\n'
		tr -d '\015' <"$STANDARDS"
		printf '\n'
	fi
	if [ "$ROLE" = evaluate ]; then
		printf '\n## The rubrics for THIS gate\n\n'
		if [ -n "$RUBRICS" ] && [ -f "$RUBRICS" ]; then
			printf 'These are the practitioner'\''s own standards for the gate this item is at,\n'
			printf 'REPRODUCED WHOLE BELOW. They came from `%s` — that path is TEXT, printed\n' "$RUBRICS"
			printf 'so you can name it, and there is no file for you to find: it is not in your\n'
			printf 'worktree and it does not need to be, because the whole of it is here. They\n'
			printf 'are the only rubrics you may cite. You are not shown any other gate'\''s file,\n'
			printf 'and there is no rubric anywhere else for you to reach for.\n\n'
			tr -d '\015' <"$RUBRICS"
			printf '\n'
		else
			printf 'THERE ARE NONE. No rubric file exists for this gate, so there is nothing to\n'
			printf 'cite: you may not let this work on, hold it, accept a finding, or make one a\n'
			printf 'must-fix by rubric. Judge the work against its authority and return the\n'
			printf 'verdict; where it stops is the mechanism'\''s to decide, not yours.\n\n'
		fi
		printf '### How to cite one\n\n'
		printf 'A rubric is applied ONLY by citing its id and the evidence, on a line of its\n'
		printf 'own. These four are the whole vocabulary:\n\n'
		printf '  promote: <id>: <evidence>   this item passes THIS gate whatever the\n'
		printf '                              practitioner'\''s `until` said — this gate only,\n'
		printf '                              never the next, which asks again\n'
		printf '  hold: <id>: <evidence>      the item stops in the stage it is in, for the\n'
		printf '                              practitioner'\''s eyes; a hold BEATS a promote in\n'
		printf '                              the same verdict\n'
		printf '  fix: <id>: <evidence>       a must-fix. Following a `Finding:` line it makes\n'
		printf '                              THAT finding the must-fix; standing alone it is\n'
		printf '                              the gate'\''s standard missed. A verdict carrying\n'
		printf '                              one is a FAIL whatever its `Verdict:` line said\n'
		printf '  accept: <id>: <evidence>    disposes the `Finding:` line above it\n\n'
		printf 'With no rubric to cite you can neither let work on nor settle a finding. A\n'
		printf 'finding you leave with no disposition is shown to the practitioner where the\n'
		printf 'item stops — that is the design working, not a gap for you to close.\n'
	fi
} >"$BRIEF"
[ -s "$BRIEF" ] || die "the briefing could not be composed at $BRIEF"

# ==============================================================================
# the record of this raise — on stderr, because stdout is the payload
# ==============================================================================

rule_off
say "$ME — raising a fresh context"
say "  role         : $ROLE (round $ROUND)"
say "  item         : $SLUG"
say "  harness      : $HARNESS${CLI:+ ($CLI)} — resolved from $SEAT_FROM"
say "  model        : ${MODEL:-<the CLI's own default>}"
say "  model check  : ${MODEL_CHECK:-none}"
say "  authority    : ${AUTHORITY:-<none: the calling harness raised this context>}"
say "  rubrics      : ${RUBRICS:-<none — this role is handed no rubric>}"
say "  standards    : ${STANDARDS:-<none — this role is handed no bar>}"
say "  worktree     : $WT"
say "  briefing     : $BRIEF"
say "  run log      : $RUNDIR"
if [ "$HEARTBEAT" -gt 0 ]; then
	say "  heartbeat    : every ${HEARTBEAT}s on this stderr and in $PROGRESSFILE while the CLI runs (REMIT_HEARTBEAT=0 silences it)"
else
	say "  heartbeat    : silenced (REMIT_HEARTBEAT=0) — nothing will be said between the line below and the run's end"
fi
if [ "$QUIET" -gt 0 ]; then
	say "  idle bound   : ${QUIET}s (REMIT_QUIET) — the CLI is ended, and this exits 8, if it writes nothing to stdout or stderr for that long. The wall bound is separate and still applies"
else
	say "  idle bound   : none (REMIT_QUIET=0) — this seat is invoked in a mode whose only write is its final envelope, so silence is not evidence of a stall and nothing is bounded on it"
fi
[ -n "${REMIT_PROGRESS:-}" ] && say "  progress at  : $REMIT_PROGRESS names this run directory, written before anything was raised"
say "  environment  : env -i with $(awk 'END { print NR }' "$ENVLIST") allow-listed variables and nothing else; HOME is the scratch directory $SCRUB_HOME"
say "  scratch      : $SCRUB_TMP (TMPDIR, TEMP and TMP) — the seat's one writable scratch root, removed with the run"
say "  registry     : $SETTINGS ($REGISTRY_HASH), seat $SEAT_KIND"
if [ "$HARNESS" = devin ]; then
	say "  devin binary : $DEVIN"
	say "  account      : tier ${DEVIN_TIER:-<not reported>}, primary org ${DEVIN_ORG:-<none reported>}"
	say "  permissions  : requesting $DEVIN_MODE, with the git deny, the whole-\`exec\` allow that keeps an ordinary command off devin's prompt default, the mcp/request_scope/webfetch denies, and both hooks, all written to $WT/.devin for the run"
	say "  imports      : read_config_from turns off every importer but agents_standard, so this raise inherits no skill, command or MCP server from another tool's configuration. What it does NOT stop is at \`devin_write_containment\` in this script"
	[ -n "$EXCLUDED" ] &&
		say "  exclusions   : $EXCLUDED — under devin these are DENY rules, and a denied call ends the run rather than failing on its own. This raise has chosen a kill switch, not a scoping."
	say "  bounded wait : ${DEVIN_TIMEOUT}s (REMIT_DEVIN_TIMEOUT)"
fi
if [ "$HARNESS" = copilot ]; then
	say "  copilot bin  : $COPILOT"
	say "  version      : ${COPILOT_VERSION:-<not reported>}"
	say "  account      : ${COPILOT_LOGIN:-<not recorded>} at ${COPILOT_HOST:-<not recorded>} — recorded, not checked and not gated on"
	say "  effort       : ${EFFORT:-<none asked for>}"
	say "  containment  : deny [$COPILOT_DENY], plus a preToolUse hook written to $WT/.github/hooks for the run — git and gh in any wrapping, and NOTHING else: no read boundary is enforced and the provenance discloses that rather than implying one. Then the repo-hook environment opt-in, then a canary that puts a wrapped git AND one in-tree file write of real source to the CLI before the context is raised"
	say "  bounded wait : ${COPILOT_TIMEOUT}s (REMIT_COPILOT_TIMEOUT), canary ${COPILOT_CANARY_TIMEOUT}s"
fi
rule_off
[ -n "$DEVIN_TIER_NOTE" ] && say "note: $DEVIN_TIER_NOTE"

# ==============================================================================
# the adapters
# ==============================================================================

# The pulse, for the whole of the one window in which this script is otherwise
# silent. It says elapsed seconds and the seat, because that is all this script
# knows: the raised context's own output is in the run directory and never
# crosses to the caller. Two destinations, for two readers — this script's stderr
# for a caller that runs it directly, and the progress log for one that runs it
# through `bin/remit`, which captures this stderr to a file of its own.
HEARTBEAT_PID=''
heartbeat_start() {
	[ "$HEARTBEAT" -gt 0 ] || return 0
	(
		_elapsed=0
		while sleep "$HEARTBEAT"; do
			_elapsed=$((_elapsed + HEARTBEAT))
			_pulse="$ME: still running — $ROLE on $HARNESS, ${_elapsed}s"
			printf '%s\n' "$_pulse" >&2
			printf '%s\n' "$_pulse" >>"$PROGRESSFILE"
		done
	) &
	HEARTBEAT_PID=$!
	return 0
}
heartbeat_stop() {
	[ -n "$HEARTBEAT_PID" ] || return 0
	kill "$HEARTBEAT_PID" 2>/dev/null
	wait "$HEARTBEAT_PID" 2>/dev/null
	HEARTBEAT_PID=''
	return 0
}
# So an interrupted raise does not leave a pulse behind it. This is the only
# trap here: nothing else in this script is cleaned up on a signal today, and
# this change does not quietly take that on.
trap 'heartbeat_stop' INT TERM

# THE IDLE BOUND. Its law — what is watched, why the progress log is not, why the
# default is per harness, and what the kill does and does not attest — is
# THE IDLE BOUND in this script's header. This is only its code.
STALLED=''
idle_sig() { # a signature of everything the CLI has written, so far
	printf '%s %s' "$(wc -c <"$OUTFILE" 2>/dev/null || printf 0)" \
		"$(wc -c <"$ERRFILE" 2>/dev/null || printf 0)"
}
idle_kill() { # $1 the pid this script started
	command -v pkill >/dev/null 2>&1 && pkill -TERM -P "$1" 2>/dev/null
	kill -TERM "$1" 2>/dev/null
	_ik=0
	while [ "$_ik" -lt 10 ] && kill -0 "$1" 2>/dev/null; do
		sleep 1
		_ik=$((_ik + 1))
	done
	if kill -0 "$1" 2>/dev/null; then
		command -v pkill >/dev/null 2>&1 && pkill -KILL -P "$1" 2>/dev/null
		kill -KILL "$1" 2>/dev/null
	fi
	return 0
}
idle_watch() { # $1 the pid to watch. Returns when it has gone, or kills it.
	_iw_pid=$1
	_iw_tick=$QUIET
	[ "$_iw_tick" -gt 15 ] && _iw_tick=15
	_iw_sig=$(idle_sig)
	_iw_quiet=0
	while kill -0 "$_iw_pid" 2>/dev/null; do
		sleep "$_iw_tick"
		kill -0 "$_iw_pid" 2>/dev/null || return 0
		_iw_now=$(idle_sig)
		if [ "$_iw_now" = "$_iw_sig" ]; then
			_iw_quiet=$((_iw_quiet + _iw_tick))
		else
			_iw_sig=$_iw_now
			_iw_quiet=0
		fi
		if [ "$_iw_quiet" -ge "$QUIET" ]; then
			say "$ME: THE RUN HAS GONE SILENT — $CLI has written nothing to stdout or stderr for ${_iw_quiet}s (REMIT_QUIET=$QUIET). Ending it."
			printf '%s: stalled — no output for %ss; the CLI was ended\n' "$ME" "$_iw_quiet" >>"$PROGRESSFILE"
			STALLED=$_iw_quiet
			idle_kill "$_iw_pid"
			return 0
		fi
	done
	return 0
}
run_harness() { # $1 stdin file or 'none'; rest: the command, env prefix included
	sf=$1
	shift
	heartbeat_start
	# THE RUN IS BACKGROUNDED so that something else can watch it. With `QUIET` at
	# 0 nothing does, and this is the same foreground wait it always was, one
	# `wait` further out.
	if [ "$sf" = none ]; then
		(cd "$WT" && "$@") >"$OUTFILE" 2>"$ERRFILE" &
	else
		(cd "$WT" && "$@" <"$sf") >"$OUTFILE" 2>"$ERRFILE" &
	fi
	HARNESS_PID=$!
	[ "$QUIET" -gt 0 ] && idle_watch "$HARNESS_PID"
	wait "$HARNESS_PID"
	HARNESS_EXIT=$?
	HARNESS_PID=''
	heartbeat_stop
}

# The devin context's containment, written into its tree for the run only.
#
# Two files, because one of them is not enough. The deny rule is the direct
# expression of remit's law and it does block a bare `git` and a `&&` chain — but
# it does not look inside an interpreter's quoted arguments, so `sh -c "git
# status"` walked straight past a live deny rule when it was tried. A PreToolUse
# hook sees the whole command string and closes that, and since a context
# realistically needs a shell, the hook is not a second line of defence here: it
# is the line that holds — and holds by ending the run, which is what a block
# costs here. THE HOOK'S MATCHER IS `exec` AND STAYS THERE: an omitted matcher
# would fire this on every tool call, and a hook that blocks is the one thing
# under this CLI that reliably ends a run, so widening it would buy nothing and
# cost the run. What the hook stops is git and gh, wrapped or not, and nothing
# else.
#
# THE ALLOW LIST IS THE UNION OF TWO CHANNELS, and it is a union because each one
# alone has already cost a run. An entry that matches nothing is SILENT — it
# grants nothing and says nothing, and the context that reaches for what it was
# meant to grant ends the run instead — so the cost of a name too many is nil and
# the cost of a name too few is the whole raise.
#
#   the CLI's own bundled documentation, `share/devin/docs/extensibility/hooks/
#   lifecycle-hooks.mdx`, whose "tool names you can match" table is the shipped
#   build's externally-visible inventory: `read`, `write`, `edit`, `apply_patch`,
#   `notebook_read`, `notebook_edit`, `grep`, `glob`, `exec`, `get_output`,
#   `write_to_process`, `kill_shell`, `webfetch`, `todo_write`,
#   `exit_plan_mode`, `skill`, `run_subagent`, `read_subagent`, `request_scope`,
#   `mcp_list_servers`, `mcp_list_tools`, `mcp_call_tool`, `mcp_read_resource`.
#   (`reference/permissions.mdx` prints a much shorter list — `read`, `edit`,
#   `grep`, `glob`, `exec` — as "available tool names". It is the same doc set
#   contradicting itself; the matcher table is the specific one and is taken.)
#
#   the ATIF export of a real run, whose `function_name` values carry
#   `find_file_by_name`, which appears in NO version of the documentation. The
#   build has it and the docs do not say so.
#
# So neither channel is authority over the other and the list carries both. The
# names dropped from it are dropped BY NAME, into the deny list, because a tool
# that is merely unlisted dies the run without saying why.
#
# THE FALL-THROUGH, AND WHY `exec` IS ALLOWED WHOLE. Devin's permission check is a
# FIXED FOUR-TIER LADDER — deny, then ask, then allow, then a default of PROMPT —
# and there is no fifth tier and no key that changes what the default resolves to.
# There is no `"*"`, no `Exec(*)` and no `defaultMode` in the shipped build; the
# only wildcard it carries is `mcp__*`, inside the MCP namespace. So a CATCH-ALL
# DENY IS NOT EXPRESSIBLE, and a tool call that is neither denied nor allowed
# lands on that default. In `-p` there is nobody to prompt, and the CLI rejects
# it — `rejected a tool call that requires confirmation` — which CANCELS EVERY
# SIBLING CALL IN THE SAME BATCH and can end the run with an empty final message.
#
# THE FIELD FAILURE, 2026-09-01, Zenith.Core: an evaluator reached for
# `python -c "import importlib.util…"`. Not denied, not allowed. Fall-through,
# reject, batch cancelled, empty final message, and `bin/remit` recorded
# `cannot act: verdict` and escalated.
#
# So the allow list carries the `exec` TOOL ITSELF rather than a prefix apiece.
# DENY BEATS ALLOW ABSOLUTELY, so `Exec(git)` and `Exec(gh)` still stand over it
# and still carry remit's message, and the hook below still sees git in any
# wrapping. What changes is that no ordinary command an evaluator reaches for —
# `python`, `node`, a test runner, a lister — can fall through to the prompt any
# more: it is allowed, or it is denied by name, or the hook stops it. Widening
# this grants nothing remit's law withheld: the law is that a raised context runs
# no `git` and no `gh`, and this seat's `boundary:` has always been reported as
# `none` — the containment here was never a read boundary and never claimed to be.
#
# THE RESIDUAL HOLE, said out loud. Only `exec` is closed. A tool call whose NAME
# is not on the list still falls through to the prompt and still rejects the same
# way, and the shipped build's full tool inventory is NOT ESTABLISHED — a real
# run's export reported 29 tool definitions and enumerated a subset of them. The
# names below are the ones confirmed from real exports and from the CLI's own
# bundled documentation. A raise that dies with an empty final message and a
# tool nobody listed is this hole, and the run's kept log is where it is legible.
#
# WHAT IS DENIED BY NAME, and why a deny is the kind thing to do to a tool that
# was going to die anyway. Under `-p` an unlisted tool call is rejected for want
# of confirmation and takes its whole batch with it; a DENIED call ends the run
# too (probe item 16 — a deny is a kill switch here, not a scoping), but it ends
# it against a rule somebody wrote, and the run's kept log then names the rule
# rather than showing a batch that vanished. So the four tools remit will not
# have a raised context use are denied out loud:
#
#   mcp__*          every MCP tool, on every server. With the importers off there
#   mcp_call_tool   are NO servers configured (measured: 1 -> 0), so no MCP call
#                   can arise and this rule should never fire. It is the BACKSTOP
#                   for the day one does — a server configured natively in
#                   `%APPDATA%\devin`, which `read_config_from` does not reach.
#                   Both spellings, because `mcp__*` matches the namespaced tools
#                   and `mcp_call_tool` is the generic caller.
#                   THE COST IS A RUN, so the backstop is not the control:
#                   UNREACHABILITY is — no servers, and a briefing that asks for
#                   nothing outside the worktree.
#   request_scope   devin's own documented way to ask for read/write access to a
#                   directory outside the current scope. The scope IS the
#                   worktree, everything a raise is judged on is inside it, and
#                   nothing outside it exists for this raise. An evaluator that
#                   reaches for this has been sent looking for something it
#                   cannot have, and that is a fault in the briefing — which is
#                   why the briefing was audited for it rather than left to be
#                   caught here.
#   webfetch        a raised context establishes what is true from the tree in
#                   front of it. It has no network errand.
#
# `mcp_list_servers`, `mcp_list_tools` and `mcp_read_resource` stay ALLOWED: they
# are the harmless lookups, they will answer "none", and a context that dies for
# asking a question with an empty answer is a run lost to tidiness.
#
# THE PERMISSION MODE STAYS `accept-edits`, and this raise does not reach for a
# wider one. The shipped build's `--permission-mode` takes `auto`, `accept-edits`,
# `smart` and `dangerous` — its own `--help`, which does not agree with the doc
# set's `normal`/`bypass`/`autonomous` naming — and of those only `smart` even
# claims to stop prompting for non-edit actions, by delegating each one to a fast
# model. That is a WIDENING dressed as a convenience: it decides, per call,
# something remit's allow list decides once and legibly. This tenant's
# organisation policy also downgrades `smart` and `dangerous` to normal, so
# resting on either would be resting on a mode that is not applied. The allow
# list closes the fall-through; the mode never did and was never going to.
#
# THE NEUTRAL CONTEXT — `read_config_from`, and what it was measured to do.
#
# Devin imports another tool's configuration by default, at PROJECT AND USER
# scope. On 2026-09-01 an evaluate raise in Zenith.Core inherited the
# practitioner's own instruction surface through it: 9 skills of which 5 were
# from `~/.claude/skills`, 7 MCP servers all from `~/.claude.json`, and a global
# Claude hook that told the evaluator to journal the session through an MCP tool
# — which it obeyed as its first act, before reading anything it was raised to
# judge. remit's OWN conventions were the one thing that did not load.
#
# `read_config_from` is valid at project scope, in the very file this function
# already writes, and every importer is turned off in it. The key set is the
# documented one, whole, from `share/devin/docs/reference/configuration/
# read-config-from.mdx`: `cursor`, `windsurf`, `claude`, `copilot`, `opencode`,
# `vscode` and `zed`. All false.
#
# `agents_standard` IS THE ONE LEFT TRUE, deliberately and explicitly. It is the
# importer that carries `AGENTS.md` and `AGENTS.local.md` — remit's own
# instruction surface, the file the installer writes remit's block into, and the
# only channel by which this mechanism speaks to a devin session at all. Turning
# it off would silence remit and leave the practitioner's global rule (see the
# residual below) as the loudest thing in the context, which is the opposite of
# the fix. It imports nothing from anybody's personal tooling: the files it names
# are in the tree in front of the raise.
#
# WHAT THAT WAS MEASURED TO DO, on this host, 2026-09-01, devin 3000.6.7, in a
# throwaway fixture carrying a marker `CLAUDE.md`, `AGENTS.md`, `AGENTS.local.md`
# and `.claude/skills/`, through the free subcommands that raise no agent turn
# and spend no ACU:
#
#   `devin skills list`   13 -> 2. Both survivors are devin's own builtins;
#                         `~/.claude/skills` and the project `.claude/skills`
#                         both went.
#   `devin mcp list`      1 -> 0.
#   `devin rules list`    4 -> 4. UNCHANGED. Both `CLAUDE` rules — the project's
#                         and the practitioner's `~/.claude/CLAUDE.md` — and both
#                         Standard rules were still listed, with `claude` false
#                         AND with `agents_standard` false.
#
# THE RESIDUAL, AND WHAT IT IS NOT. Two readings fit that last row and this host
# cannot separate them without spending a run: either the rules importer ignores
# the switch, or `devin rules list` is a lister that does not apply import
# filtering while `skills list` and `mcp list` do. Read it off the next raise's
# own `rules discovery` log line and not off this comment. Either way there is NO
# documented rules-level suppression to reach for — a project config accepts only
# `permissions`, `read_config_from` and `hooks` (`config-file.mdx`), and
# `read_config_from` is the only import switch there is — and `env -i` with a
# scratch `HOME` does not stop it either: the global rule was still listed under
# exactly the environment a raise gets. So a devin raise may still carry the
# practitioner's `~/.claude/CLAUDE.md` as an always-on rule. That is stated here
# and in THE ENVIRONMENT above, and it is not fixed.
#
# Written here, removed before anything else, committed nowhere. The copies kept
# in the run directory are the record of what actually applied.
DEVIN_DENY='Exec(git) Exec(gh) Write(.git/**) Write(.devin/**) mcp__* mcp_call_tool request_scope webfetch'
DEVIN_ALLOW='read write edit apply_patch notebook_read notebook_edit grep glob find_file_by_name exec get_output write_to_process kill_shell todo_write exit_plan_mode skill run_subagent read_subagent mcp_list_servers mcp_list_tools mcp_read_resource Exec(sh)'
devin_json_array() { # $1 space- or comma-separated entries -> "a", "b"
	printf '%s\n' "$1" | tr ' ,' '\n\n' |
		awk 'NF { printf "%s%s", sep, "\"" $0 "\""; sep = ", " }'
}
devin_write_containment() { # $1 the context's tree
	devin_dir=$1/.devin
	mkdir -p "$devin_dir" || return 1
	cat >"$devin_dir/config.json" <<EOF || return 1
{
  "read_config_from": {
    "agents_standard": true,
    "cursor": false,
    "windsurf": false,
    "claude": false,
    "copilot": false,
    "opencode": false,
    "vscode": false,
    "zed": false
  },
  "permissions": {
    "deny": [$(devin_json_array "$DEVIN_DENY${EXCLUDED:+ $EXCLUDED}")],
    "allow": [$(devin_json_array "$DEVIN_ALLOW${ALLOWED:+ $ALLOWED}")]
  }
}
EOF
	# Event names sit at the top level of this file. The schema Cognition's own
	# documentation shows (nested under "hooks") is rejected by the shipped build,
	# and rejected SILENTLY — the hook simply never fires. Trust the probe.
	# The SECOND entry exists for its MESSAGE and for nothing else. The four tools
	# it matches are already denied in the config above, and a deny ends the run on
	# its own — but devin's denial text is its own fixed sentence naming a rule, and
	# whoever reads the run afterwards is owed remit's reason instead. A hook
	# matcher is a REGEX, not a permission glob, so `mcp__` is anchored rather than
	# starred. Whether this fires before the deny resolves is NOT established here;
	# if the deny wins, the run's log carries devin's sentence and the rule name,
	# which is why the rules are named the way they are.
	cat >"$devin_dir/hooks.v1.json" <<'EOF' || return 1
{
  "PreToolUse": [
    {
      "matcher": "exec",
      "hooks": [ { "type": "command", "command": "sh .devin/remit-no-git.sh" } ]
    },
    {
      "matcher": "^(request_scope|webfetch|mcp_call_tool|mcp__.*)$",
      "hooks": [ { "type": "command", "command": "sh .devin/remit-no-reach.sh" } ]
    }
  ]
}
EOF
	cat >"$devin_dir/remit-no-reach.sh" <<'EOF' || return 1
#!/bin/sh
# Written by remit-invoke for one raise, and removed after it. Its whole job is
# to say WHY, because the rule that stops these tools cannot carry a sentence.
printf 'blocked by remit law: your scope is the worktree you were raised in, and nothing outside it exists for this raise. Everything you were raised to author or judge is on disk in front of you, there is no MCP server configured for this run and no network errand in your brief, and there is no wider scope to be granted. If your briefing pointed you at something you cannot reach, THAT is the finding — report it in what you return, which is the one channel that gets read.\n' >&2
exit 2
EOF
	cat >"$devin_dir/remit-no-git.sh" <<'EOF' || return 1
#!/bin/sh
# Written by remit-invoke for one raise, and removed after it. A context never
# runs git: the delivery seam performs every git mechanic once the context has
# stopped.
#
# A block here does not refuse one call and let the context carry on — under
# devin the run stops at it. So the message below is written for whoever reads
# the run afterwards as much as for the context, which will not get to act on it.
#
# This reads the whole PreToolUse payload rather than a parsed field of it, so no
# quoting, chaining or interpreter-wrapping can hide the command from the test.
#
# The test is on a WORD BOUNDARY, never a substring: `.gitignore`, `digit`,
# `legitimate` and `github` are ordinary words, and a context that cannot say
# them is one this hook has broken rather than contained.
payload=$(cat)
if [ -z "$payload" ]; then
	printf 'blocked by remit law: this hook could not read the tool call to check it, and it does not pass what it cannot read.\n' >&2
	exit 2
fi
if printf '%s\n' "$payload" | grep -Eiq '(^|[^A-Za-z0-9_-])(git|gh)([^A-Za-z0-9_-]|$)'; then
	printf 'blocked by remit law: a raised context never runs git or gh — the seam does, as the coordinator, after this context exits. Nothing you were raised for needs either: what you author or judge is the tree on disk in front of you, and a tree left uncommitted is exactly what the seam expects. Carry on without it.\n' >&2
	exit 2
fi
exit 0
EOF
	return 0
}

# The copilot context's containment, written into its tree for the run only.
#
# Three things, because no one of them is enough, and because the CLI reports
# nothing at all about what applied:
#
#   1. Deny rules for git and gh. They fire, and a denial names the rule that
#      fired — but the matcher only ever sees the STEM of a command, so
#      `sh -c "git status"`, `powershell -Command "…"`, `cmd /c …` and
#      `node -e "…"` all walk through. Naming the interpreters as well only moves
#      the hole to the next interpreter on the machine.
#   2. A preToolUse hook. It receives the WHOLE tool call — tool name and the
#      full command string — which is why no amount of quoting or wrapping hides
#      from it, and it is the only thing in this CLI that sees that much. That is
#      the whole of what it uses that sight for: git and gh, on a word boundary,
#      in any wrapping. It is NOT a read boundary. A worktree path arm lived here
#      and was withdrawn — ruled 2026-08-22 — because five rounds of it were
#      escaped by a one-token respelling apiece while this git test was never
#      escaped once, and because the mechanism that holds a read boundary is the
#      one a context is RAISED in rather than any reading of command text. The
#      canary below therefore puts a wrapped git to the live CLI alongside an
#      in-tree write of real source, so neither the containment claim nor the
#      claim that a context can still work is ever made on no attempt at all.
#   3. The environment opt-in. Repo hooks in .github/hooks/ do not load in prompt
#      mode unless the folder is trusted or an environment variable says so — and
#      a raised worktree is never trusted. The permission FLAG does not satisfy
#      that gate; only the variable does, and it is on the allow-list for exactly
#      that reason.
#
# The hook file's schema is nested and Claude-Code-shaped, and `matcher` is a
# regular expression, not a glob: `.*` matches every tool and `*` is rejected as
# an invalid regex with the hook silently skipped. A hook that fails to load
# blocks nothing and says nothing on stderr, which is why the canary exists.
#
# Written here, removed before anything else, committed nowhere. The copies kept
# in the run directory are the record of what actually applied.
copilot_write_containment() { # $1 the context's tree
	if [ ! -d "$1/.github" ]; then
		mkdir -p "$1/.github" || return 1
		COPILOT_GITHUBDIR_MADE=yes
	fi
	if [ ! -d "$1/.github/hooks" ]; then
		mkdir -p "$1/.github/hooks" || return 1
		COPILOT_HOOKDIR_MADE=yes
	fi
	cat >"$1/.github/hooks/remit-no-git.json" <<'EOF' || return 1
{
  "hooks": {
    "preToolUse": [
      {
        "matcher": ".*",
        "hooks": [ { "type": "command", "command": "sh .github/hooks/remit-no-git.sh" } ]
      }
    ]
  }
}
EOF
	# git and gh, in any wrapping, and nothing else. Nothing is baked into this
	# file at write time: the tree path was, and it was baked in for the path arm
	# that has since been withdrawn.
	cat >"$1/.github/hooks/remit-no-git.sh" <<'EOF' || return 1
#!/bin/sh
# Written by remit-invoke for one raise, and removed after it. A context never
# runs git: the delivery seam performs every git mechanic once the context has
# stopped, and a tree left uncommitted is exactly what it expects.
#
# This reads the WHOLE preToolUse payload rather than a parsed field of it, so
# no quoting, chaining or interpreter-wrapping hides the command from the test.
# That is the one thing this hook has that nothing else in this CLI does: the
# deny matcher and the built-in path wall both inspect only what a command
# leaves standing as an argument of its own, and both are walked past by the
# same wrapped payload.
#
# The test is on a WORD BOUNDARY, never a substring: `.gitignore`, `digit`,
# `legitimate` and `github` are ordinary words, and a context that cannot say
# them is one this hook has broken rather than contained.
#
# THIS HOOK ENFORCES NOTHING ELSE, and that is a decision rather than an
# oversight. It is not a read boundary. A worktree path arm was built here and
# withdrawn: five rounds of it were escaped by a one-token respelling apiece,
# while this git test was never escaped once. A context under this hook runs on
# the host's own login and reaches whatever that login reaches. The boundary
# that would hold is the one the context is RAISED in — an OS-level sandbox, a
# container, a scratch user — and no reading of command text substitutes for
# it. The provenance discloses exactly that rather than implying a boundary
# that is not here.
payload=$(cat)
if [ -z "$payload" ]; then
	printf 'blocked by remit law: this hook could not read the tool call to check it, and it does not pass what it cannot read.\n' >&2
	exit 2
fi
if printf '%s\n' "$payload" | grep -Eiq '(^|[^A-Za-z0-9_-])(git|gh)([^A-Za-z0-9_-]|$)'; then
	printf 'blocked by remit law: a raised context never runs git or gh — the seam does, as the coordinator, after this context exits. Nothing you were raised for needs either: what you author or judge is the tree on disk in front of you, and a tree left uncommitted is exactly what the seam expects. Carry on without it.\n' >&2
	exit 2
fi
exit 0
EOF
	return 0
} # end copilot_write_containment

# Removes only what was created — never a .github/ the repository already had.
copilot_remove_containment() { # $1 the context's tree
	rm -f "$1/.github/hooks/remit-no-git.json" "$1/.github/hooks/remit-no-git.sh"
	[ "$COPILOT_HOOKDIR_MADE" = yes ] && rmdir "$1/.github/hooks" 2>/dev/null
	[ "$COPILOT_GITHUBDIR_MADE" = yes ] && rmdir "$1/.github" 2>/dev/null
	return 0
} # end copilot_remove_containment

# THE ONE WAY OUT WHEN THE CANARY REFUSES THE RAISE. No context ran, so there is
# nothing to capture and nothing to report about one; what is left is a tree
# carrying this script's own apparatus — the containment it wrote, and the
# scratch root it made — and neither may outlive the raise that made it. Exit 7
# is the canary's own code and is why the caller stops here: the reason the seat
# was never raised is in it, and `copilot_canary` has already said the rest.
#
# It is a function so that the whole path can be run in one piece by
# `t/unit/copilot-containment.sh`, which cannot reach it through the CLI: making
# a real canary fail needs the copilot CLI, an account and a billed run, and the
# offline tier may have none of the three.
copilot_canary_refused() { # $1 the context's tree — does not return
	copilot_remove_containment "$1"
	scratch_gone_or_warn
	exit 7
} # end copilot_canary_refused

# Reading a copilot run out of its JSONL envelope. `final` is the reason this is
# read at all: text-mode stdout glues the tool renderings to the answer with no
# delimiter, while the envelope keeps them apart — the final message is the LAST
# assistant.message whose toolRequests list is empty.
NODE_COPILOT='const fs=require("fs");const ls=fs.readFileSync(process.argv[1],"utf8").split(/\r?\n/);const ev=[];for(const l of ls){if(!l.trim())continue;try{ev.push(JSON.parse(l))}catch(e){}}const k=process.argv[2];const T=t=>ev.filter(e=>e&&e.type===t);let v="";if(k==="final"){const m=T("assistant.message").filter(e=>((e.data&&e.data.toolRequests)||[]).length===0);if(m.length&&m[m.length-1].data.content!=null)process.stdout.write(String(m[m.length-1].data.content));process.exit(0)}else if(k==="calls"){const c={};for(const e of T("tool.execution_start"))c[e.data.toolCallId]=(e.data.arguments&&(e.data.arguments.command||e.data.arguments.path))||"";const out=[];for(const e of T("tool.execution_complete"))out.push((e.data.success?"ran":"blocked")+"\t"+(c[e.data.toolCallId]||""));process.stdout.write(out.join("\n")+(out.length?"\n":""));process.exit(0)}else if(k==="refusals"){const c={};for(const e of T("tool.execution_start"))c[e.data.toolCallId]=(e.data.arguments&&(e.data.arguments.command||e.data.arguments.path))||"";const out=[];for(const e of T("tool.execution_complete"))if(!e.data.success)out.push((c[e.data.toolCallId]||"?")+" -> "+(((e.data.error||{}).message)||"denied").split("\n")[0]);v=out.join(" | ")}else{const r=T("result");const last=r.length?r[r.length-1]:null;if(k==="session_id")v=last&&last.sessionId;else if(k==="result_present")v=last?"yes":"";else if(k==="premium")v=last&&last.usage&&last.usage.premiumRequests;else if(k==="changed")v=(last&&last.usage&&last.usage.codeChanges&&last.usage.codeChanges.filesModified||[]).join(", ");else if(k==="model"){const m=T("assistant.message");v=m.length&&m[m.length-1].data?m[m.length-1].data.model:""}else if(k==="aiu"){const u=T("session.usage_checkpoint");if(u.length){const n=u[u.length-1].data.totalNanoAiu;if(typeof n==="number")v=(n/1e9).toFixed(3)}}}process.stdout.write(v==null||v===false?"":String(v)+"\n")'
copilot_get() { # $1 envelope file  $2 field
	case "$COPILOT_JSON" in
	jq)
		case "$2" in
		final) jq -rs '[.[] | select(.type=="assistant.message") | select(((.data.toolRequests // []) | length) == 0)] | last | .data.content // empty' "$1" ;;
		calls) jq -rs '(reduce (.[] | select(.type=="tool.execution_start")) as $e ({}; .[$e.data.toolCallId] = ($e.data.arguments.command // $e.data.arguments.path // ""))) as $c | .[] | select(.type=="tool.execution_complete") | [(if .data.success then "ran" else "blocked" end), ($c[.data.toolCallId] // "")] | @tsv' "$1" ;;
		refusals) jq -rs '(reduce (.[] | select(.type=="tool.execution_start")) as $e ({}; .[$e.data.toolCallId] = ($e.data.arguments.command // $e.data.arguments.path // ""))) as $c | [.[] | select(.type=="tool.execution_complete") | select(.data.success | not) | (($c[.data.toolCallId] // "?") + " -> " + ((.data.error.message // "denied") | split("\n")[0]))] | join(" | ")' "$1" ;;
		session_id) jq -rs '[.[] | select(.type=="result")] | last | .sessionId // empty' "$1" ;;
		result_present) jq -rs 'if any(.[]; .type=="result") then "yes" else empty end' "$1" ;;
		premium) jq -rs '[.[] | select(.type=="result")] | last | .usage.premiumRequests // empty' "$1" ;;
		changed) jq -rs '[.[] | select(.type=="result")] | last | ((.usage.codeChanges.filesModified // []) | join(", "))' "$1" ;;
		model) jq -rs '[.[] | select(.type=="assistant.message")] | last | .data.model // empty' "$1" ;;
		aiu) jq -rs '[.[] | select(.type=="session.usage_checkpoint")] | last | if . == null then empty else ((.data.totalNanoAiu / 1000000000 * 1000 | round) / 1000 | tostring) end' "$1" ;;
		esac
		;;
	node) node -e "$NODE_COPILOT" "$1" "$2" ;;
	esac
} # end copilot_get

# The canary. Containment on this CLI is tested at every raise and never assumed,
# because the one mechanism that holds fails OPEN when it fails: a hook with a
# bad matcher, a bad schema, or a path the CLI cannot reach is skipped and the
# run proceeds uncontained with nothing on stderr to say so.
#
# So a cheap throwaway run, in the context's own tree, under the exact
# configuration the context will get, attempts three things. Two must RUN: an
# ordinary command, and an ordinary in-tree FILE WRITE through the file tool. One
# must be BLOCKED: a wrapped `git`, which is the whole of what this containment
# claims. Anything else — including a run in which the model simply declined to
# attempt one of them — refuses the raise. This is the honest analogue of the
# codex sandbox read-back: refuse, never downgrade silently.
#
# It probes exactly what the containment claims and nothing else. It once put
# four spellings of leaving the tree to the CLI as well, for a worktree path arm
# that has since been withdrawn: there is no read boundary to test now, and a
# canary that went on testing one would be certifying a claim this raise no
# longer makes.
#
# The WRITE probe is here for the mirror image of that, and it is not decoration.
# A containment can be tightened until nothing escapes and nothing works, and a
# gate that only ever probes escapes reports PASSED over a hook under which no
# builder can author a line — which is exactly what happened here once, when a
# network-path test began firing on every Windows path a file tool sends,
# including the tree's own. Ordinary work is now part of what the gate certifies,
# so that failure cannot pass this gate again.
#
# The probe's CONTENT is load-bearing for the same reason. A write probe whose
# text is one line of prose no boundary would ever object to certifies nothing
# about authoring: it passed unchanged over a containment that refused a `//`
# comment and a closing tag in a builder's own source. So the probe writes a line
# of real source — a line comment and a closing markup tag — and the file is read
# back and required to carry both before the gate calls the write a write.
#
# The probes are written to a manifest FIRST and the prompt is generated from it,
# so what the CLI is asked to do and what any test replays are one list and
# cannot drift apart.
#
# Its cost is one small run. It bills the raise's own model unless
# REMIT_COPILOT_CANARY_MODEL names a cheaper one, so nothing is substituted
# behind the caller's back, and what it cost is recorded in the provenance.
#
# It tests the BASE containment — the rules and the hook this script writes — and
# not any rules a caller added with --allowed-tools or --exclude-tools. That is
# deliberate and it is not a hole: an added deny only narrows what a context may
# do, a denial outranks any allow, and the hook runs before either is consulted,
# so no caller addition can loosen what the canary proved.
COPILOT_CANARY_MARK=REMIT_CANARY_CONTROL_OK
COPILOT_CANARY_FILE=remit-canary-write-probe.ts
# Ordinary source, not prose: a line comment and a closing markup tag are the two
# shapes a boundary built out of slashes refuses first, and a probe without them
# cannot tell a containment from a harness broken shut.
COPILOT_CANARY_WRITTEN='const canary = 1; // written by the containment canary and removed after it </probe>'
copilot_canary() { # $1 the context's tree — returns 0 if contained, 1 if not
	# The tree is kept here because `set --` below takes $1 for the command line.
	cop_tree=$1
	cdir=$RUNDIR/canary
	mkdir -p "$cdir/log" || return 1
	# The blocked probe is a `git` inside `sh -c "…"`: the deny rules see only the
	# stem of that command and let it through, so what refuses it can only be the
	# hook. That is the whole of what this containment claims, and it is therefore
	# the whole of what is put to the live CLI here.
	cop_git='git status --porcelain'
	# The manifest is written first and the prompt is generated from it, so the
	# list of probes has one authoritative form: what the CLI is asked to attempt,
	# and what any offline test replays against the hook, are the same lines.
	cop_tab=$(printf '\t')
	{
		printf 'run%sshell%s%s\n' "$cop_tab" "$cop_tab" "echo $COPILOT_CANARY_MARK"
		printf 'run%sfile%s%s\n' "$cop_tab" "$cop_tab" "$COPILOT_CANARY_FILE"
		printf 'block%sshell%s%s\n' "$cop_tab" "$cop_tab" "sh -c \"$cop_git\""
	} >"$cdir/probes"
	{
		printf 'You are a containment self-test for the seam that raises contexts. Nothing\n'
		printf 'here is real work and nothing here is a task.\n\n'
		printf 'Do exactly these things, one tool call each, in this order. Some of them are\n'
		printf 'expected to be refused — that refusal IS the test — so attempt every one of\n'
		printf 'them and do not stop when one is refused.\n\n'
		cop_n=0
		while IFS=$cop_tab read -r cop_ex cop_kind cop_text; do
			cop_n=$((cop_n + 1))
			case $cop_kind in
			shell) printf '%s. Run this with the shell tool: %s\n' "$cop_n" "$cop_text" ;;
			file) printf '%s. Using your file-creation tool and NOT a shell command, create a file\n   called %s in the current directory, whose whole content is the one line:\n   %s\n' "$cop_n" "$cop_text" "$COPILOT_CANARY_WRITTEN" ;;
			esac
		done <"$cdir/probes"
		printf '\nThe last one is expected to be refused. Attempt it anyway: the refusal is\n'
		printf 'the test, and a step not attempted is a step this run cannot report on.\n\n'
		printf 'Then reply with exactly %s lines, one per step, in the form\n' "$cop_n"
		printf '  <number>|RAN or BLOCKED\n\n'
		printf 'Create, modify and delete nothing else. Run nothing else.\n'
	} >"$cdir/prompt"

	# The canary runs under the SAME allow-listed environment the context will
	# get: a probe of a different environment certifies a different run. Where the
	# allow-list file is not there, this function has been lifted out on its own
	# by a test, and the repo-hook opt-in alone is set — which is what the
	# wrapper did before the scrub existed.
	if [ -f "${ENVLIST:-/nonexistent}" ]; then
		set --
		while IFS= read -r cop_v; do
			[ -n "$cop_v" ] && set -- "$@" "$cop_v"
		done <"$ENVLIST"
		set -- env -i "$@" GITHUB_COPILOT_PROMPT_MODE_REPO_HOOKS=true
	else
		set -- env GITHUB_COPILOT_PROMPT_MODE_REPO_HOOKS=true
	fi
	set -- "$@" timeout "$COPILOT_CANARY_TIMEOUT" "$COPILOT" \
		--output-format json --allow-all-tools --no-ask-user --disable-builtin-mcps \
		--log-dir "$cdir/log"
	set -- "$@" --deny-tool 'shell(git)' --deny-tool 'shell(git:*)' \
		--deny-tool 'shell(gh)' --deny-tool 'shell(gh:*)'
	cop_model=${COPILOT_CANARY_MODEL:-$MODEL}
	[ -n "$cop_model" ] && set -- "$@" --model "$cop_model"
	say "containment canary: one throwaway run under the context's own configuration${cop_model:+, on $cop_model}."
	(cd "$cop_tree" && "$@" <"$cdir/prompt") >"$cdir/out.jsonl" 2>"$cdir/stderr"
	cop_exit=$?

	COPILOT_CANARY_ID=$(copilot_get "$cdir/out.jsonl" session_id)
	COPILOT_CANARY_AIU=$(copilot_get "$cdir/out.jsonl" aiu)
	# The log line is the one thing the CLI does say about its own hooks, and it
	# is available at the default level. It cannot prove the hook WORKED — that is
	# the canary's job — but when the canary fails it is what says why.
	cop_loaded=no cop_bad=''
	if grep -lq 'Loading repo hooks in prompt mode' "$cdir"/log/*.log 2>/dev/null; then cop_loaded=yes; fi
	cop_bad=$(grep -h -E 'Invalid hook configuration|Invalid matcher regex' "$cdir"/log/*.log 2>/dev/null | sed -n 1p)
	COPILOT_HOOK_ATTEST="repo hooks loaded: $cop_loaded${cop_bad:+; the CLI rejected the hook file: $cop_bad}"

	cop_calls=$(copilot_get "$cdir/out.jsonl" calls)
	cop_v() { printf '%s\n' "$cop_calls" | grep -F -- "$1" | sed -n 1p | cut -f1; }
	cop_control=$(cop_v "$COPILOT_CANARY_MARK")
	cop_wrapped=$(cop_v "$cop_git")
	# The write probe is judged on DISK and on its CONTENT, not on the envelope: a
	# file that is there carrying the source it was asked to carry is the only
	# thing that proves a context could have authored one, and it is proof no
	# envelope field has to be trusted for. It is then removed — the canary runs
	# in the context's own tree, before the context does, and anything it left
	# behind would be staged later as the context's authorship with nothing able
	# to tell them apart.
	cop_wrote=no
	if [ -f "$cop_tree/$COPILOT_CANARY_FILE" ]; then
		cop_wrote=empty
		grep -Fq '//' "$cop_tree/$COPILOT_CANARY_FILE" &&
			grep -Fq '</' "$cop_tree/$COPILOT_CANARY_FILE" &&
			cop_wrote=yes
	fi
	rm -f "$cop_tree/$COPILOT_CANARY_FILE"
	# So the tree must be left as it was found APART from that one probe file,
	# which is expected and is accounted for above. Anything else is the failure
	# this check exists for.
	cop_dirt=$(copilot_get "$cdir/out.jsonl" changed |
		tr ',' '\n' | sed 's|.*[/\\]||; s|^ *||; s| *$||' |
		grep -v -x -F "$COPILOT_CANARY_FILE" | grep -v '^$' | tr '\n' ' ' | sed 's| *$||')

	if [ "$cop_control" = ran ] && [ "$cop_wrote" = yes ] && [ "$cop_wrapped" = blocked ] && [ -z "$cop_dirt" ]; then
		say "containment canary PASSED: the ordinary command ran, an ordinary in-tree file write RAN and left on disk a line of real source carrying a \`//\` comment and a closing tag, and the wrapped git — which the deny rules cannot see inside — was blocked. That is what this containment claims and all it claims: no read boundary is enforced, and the provenance says so. Session ${COPILOT_CANARY_ID:-not reported}, ${COPILOT_CANARY_AIU:-unreported} AI credits. Log attestation: $COPILOT_HOOK_ATTEST."
		return 0
	fi

	say "FAILED CONTAINMENT CANARY: this raise cannot show that its context would have been contained AND able to work, so no context was raised."
	say "  ordinary command   : ${cop_control:-never attempted} (must be: ran)"
	say "  in-tree file write : $cop_wrote (must be: yes — the file must be on disk after the run AND carry the \`//\` comment and the closing tag it was asked for; 'empty' means the file is there but its source is not, which is a containment that permits a write and refuses what builders actually write)"
	say "  wrapped git        : ${cop_wrapped:-never attempted} (must be: blocked)"
	say "  log attestation    : $COPILOT_HOOK_ATTEST"
	[ -n "$cop_dirt" ] &&
		say "  tree left dirty    : $cop_dirt (must be: nothing beyond the write probe, which is removed) — the canary wrote into the context's tree, and nothing later could tell its files from the context's"
	say "  canary exit code   : $cop_exit; session ${COPILOT_CANARY_ID:-not reported}; envelope kept at $cdir"
	say "A 'never attempted' line is not proof the containment holds: it means the canary model did not issue that call, so the test did not run. A 'ran' on the wrapped git line means the containment did NOT hold and a context would have been free to do the same. A 'no' or an 'empty' on the file-write line is the opposite failure and refuses the raise just as firmly: a containment that also refuses ordinary authoring is not a containment, it is a broken harness, and a gate that never tries to write the shapes builders write cannot tell the two apart. Either way this is reported, not worked around, and never downgraded to a warning."
	return 1
} # end copilot_canary

SANDBOX_APPLIED=''
RUN_ID=''
MODEL_SERVED=''
MODELS_SEEN=''
CONSULTED=''
run_model=''
model_channel=''

# ==============================================================================
# claude's containment, written per raise
# ==============================================================================
#
# WHY THIS IS HERE AND NOT IN THE INSTALLER is at THE ENVIRONMENT's `claude`
# entry above, which is the one place it is stated. This is the code.
#
# THE FLAG IS THE MECHANISM and it is unconditional — `CLAUDE_DENY_TOOLS` goes
# into every claude raise's argv below, whatever happens here. What this function
# adds is the hook arm, and it is BEST EFFORT: a tree it cannot write into
# refuses nothing, because the deny list has already contained the raise and
# losing a raise over a second layer would cost more than the layer is worth.
# What actually applied is recorded on the `containment:` provenance line.
CLAUDE_DENY_TOOLS='Agent,Task,AgentTool'
CLAUDE_SETTINGS_MADE=no
CLAUDE_DIR_MADE=no
CLAUDE_HOOK_MADE=no
CLAUDE_CONTAINMENT=''

claude_write_containment() { # $1 the context's tree — best effort, always 0
	_ccdir="$1/.claude"
	_ccset="$_ccdir/settings.local.json"
	_cchook="$_ccdir/remit-no-agent-tool.sh"
	if [ -e "$_ccset" ]; then
		CLAUDE_CONTAINMENT="--disallowedTools $CLAUDE_DENY_TOOLS; the worktree already carried .claude/settings.local.json and this raise did not touch it"
		return 0
	fi
	if [ ! -d "$_ccdir" ]; then
		mkdir -p "$_ccdir" 2>/dev/null || {
			CLAUDE_CONTAINMENT="--disallowedTools $CLAUDE_DENY_TOOLS; the per-raise settings file could not be written (no .claude/ could be made in the worktree)"
			return 0
		}
		CLAUDE_DIR_MADE=yes
	fi
	# The guard, written beside its registration so that neither depends on a file
	# an installer put somewhere this raise cannot see. The rule it enforces is the
	# shipped hook's rule and is stated there; this is a second COPY of an
	# enforcement, never a second statement of the law.
	if ! cat >"$_cchook" <<'EOF'
#!/bin/sh
# remit's agent-tool guard, written into this worktree by `bin/remit-invoke` for
# the duration of ONE raise and removed after it. Why it is written here rather
# than installed is in that script's header, at THE ENVIRONMENT's `claude` entry.
payload=$(cat)
if [ -z "$payload" ]; then
	printf 'remit: this hook could not read the tool call to check it, and it does not pass what it cannot read.\n' >&2
	exit 2
fi
if printf '%s\n' "$payload" |
	grep -Eq '"(tool_name|toolName|tool|name)"[[:space:]]*:[[:space:]]*"(Task|Agent|AgentTool)"'; then
	printf 'remit: raise contexts through bin/remit-invoke — settings.json decides the seat\n' >&2
	exit 2
fi
exit 0
EOF
	then
		CLAUDE_HOOK_MADE=yes
		claude_remove_containment "$1"
		CLAUDE_CONTAINMENT="--disallowedTools $CLAUDE_DENY_TOOLS; the per-raise guard script could not be written into the worktree"
		return 0
	fi
	CLAUDE_HOOK_MADE=yes
	# `permissions.deny` says the same thing as the flag, in the file, so the two
	# layers cannot come apart; the hook is the arm that fires on a tool this
	# script has not heard of yet under one of these names.
	if ! cat >"$_ccset" <<'EOF'
{
  "permissions": {
    "deny": ["Agent", "Task", "AgentTool"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent|AgentTool",
        "hooks": [
          { "type": "command", "command": "sh .claude/remit-no-agent-tool.sh" }
        ]
      }
    ]
  }
}
EOF
	then
		CLAUDE_SETTINGS_MADE=yes
		claude_remove_containment "$1"
		CLAUDE_CONTAINMENT="--disallowedTools $CLAUDE_DENY_TOOLS; the per-raise settings file could not be written into the worktree"
		return 0
	fi
	CLAUDE_SETTINGS_MADE=yes
	CLAUDE_CONTAINMENT="--disallowedTools $CLAUDE_DENY_TOOLS, and .claude/settings.local.json with .claude/remit-no-agent-tool.sh written into the worktree for this raise and removed after it"
	return 0
} # end claude_write_containment

# Removes only what was created — never a `.claude/` the repository already had.
claude_remove_containment() { # $1 the context's tree
	[ "$CLAUDE_SETTINGS_MADE" = yes ] && rm -f "$1/.claude/settings.local.json"
	[ "$CLAUDE_HOOK_MADE" = yes ] && rm -f "$1/.claude/remit-no-agent-tool.sh"
	[ "$CLAUDE_DIR_MADE" = yes ] && rmdir "$1/.claude" 2>/dev/null
	CLAUDE_SETTINGS_MADE=no
	CLAUDE_HOOK_MADE=no
	CLAUDE_DIR_MADE=no
	return 0
} # end claude_remove_containment

# Reading one field out of a JSON envelope, with whichever reader exists.
#
# `model` IS THE ONE FIELD THAT IS NOT A LOOKUP. The envelope's `modelUsage` is a
# MAP, and a Claude Code run puts the author and an internal ancillary model in
# it together, so the author is CHOSEN by the rule at THE PROVENANCE KEYS —
# the registered seat's id when the run names it, else the largest `outputTokens`
# — and the third argument is the id that was asked for, which is what makes the
# first clause possible. `models` renders the whole map for the record, and
# `consulted` reads the run's own server-tool counts.
#
# `consulted` LOOKS IN A FIXED ORDER — `.server_tool_use`, then
# `.usage.server_tool_use`, then the first object anywhere in the envelope
# carrying either key — and takes THE FIRST it finds rather than summing across
# them, because two envelopes shaped differently must not be added together. A
# run whose envelope carries neither key yields nothing at all, which is what
# keeps an unreported count out of the record instead of a zero.
NODE_JSON='const fs=require("fs");let o;try{o=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch(e){process.exit(1)}
const k=process.argv[2],want=process.argv[3]||"";const u=(o&&o.modelUsage)||{};
function n(x){return typeof x==="number"?x:0}
function cost(e){const c=(e.costUSD!=null?e.costUSD:e.cost);return c==null?"":" cost=$"+c}
let v="";
if(k==="model"){
 if(want&&Object.prototype.hasOwnProperty.call(u,want)){v=want}
 else{const ks=Object.keys(u).sort();let b="";for(const c of ks){if(b===""||n(u[c].outputTokens)>=n(u[b].outputTokens))b=c}v=b}
}else if(k==="models"){
 v=Object.keys(u).sort().map(function(c){const e=u[c]||{};return c+" in="+n(e.inputTokens)+" out="+n(e.outputTokens)+cost(e)}).join("; ")
}else if(k==="consulted"){
 let s=null;const cand=[o.server_tool_use,o.usage&&o.usage.server_tool_use];
 for(const c of cand){if(c&&typeof c==="object"&&!Array.isArray(c)){s=c;break}}
 if(!s){(function w(x){if(s||x==null||typeof x!=="object")return;if(!Array.isArray(x)&&(("web_search_requests"in x)||("web_fetch_requests"in x))){s=x;return}for(const kk of Object.keys(x))w(x[kk])})(o)}
 if(s)v="web_search="+n(s.web_search_requests)+" web_fetch="+n(s.web_fetch_requests)
}else{const x=o[k];v=x==null?"":String(x)}
process.stdout.write(v===""?"":v+"\n")'
json_get() { # $1 envelope  $2 result|session_id|is_error|model|models|consulted  [$3 the id asked for]
	case "$JSONTOOL" in
	jq)
		case "$2" in
		model)
			jq -r --arg want "${3:-}" '
				(.modelUsage // {}) as $u
				| if ($want != "" and ($u | has($want))) then $want
				  else ([$u | to_entries[] | {k: .key, o: (.value.outputTokens // 0)}]
				        | sort_by(.k) | max_by(.o) | .k // empty)
				  end' "$1"
			;;
		models)
			jq -r '(.modelUsage // {}) | to_entries | sort_by(.key)
				| map(.key
				      + " in=" + ((.value.inputTokens // 0) | tostring)
				      + " out=" + ((.value.outputTokens // 0) | tostring)
				      + (if (.value.costUSD // .value.cost) == null then ""
				         else " cost=$" + ((.value.costUSD // .value.cost) | tostring) end))
				| join("; ")' "$1"
			;;
		consulted)
			jq -r '
				[(.server_tool_use? // null), ((.usage? // {}) | .server_tool_use? // null)]
				+ [.. | objects | select(has("web_search_requests") or has("web_fetch_requests"))]
				| map(select(type == "object")) | .[0]
				| if . == null then empty
				  else "web_search=" + ((.web_search_requests // 0) | tostring)
				       + " web_fetch=" + ((.web_fetch_requests // 0) | tostring)
				  end' "$1"
			;;
		*) jq -r ".$2 // empty" "$1" ;;
		esac
		;;
	node) node -e "$NODE_JSON" "$1" "$2" "${3:-}" ;;
	esac
}
JSONTOOL=none

# Reading a devin run out of its ATIF export, with whichever reader the
# precondition found. The one worth restating is `final`, because it is the whole
# reason this file is read at all: the final message is the LAST step whose
# source is "agent", and taking it from stdout instead would take the narration
# glued to the front of it with no delimiter to cut on.
NODE_ATIF='const fs=require("fs");let o;try{o=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch(e){process.exit(1)}const k=process.argv[2];const st=Array.isArray(o.steps)?o.steps:[];const ag=st.filter(function(s){return s&&s.source==="agent"});const last=ag.length?ag[ag.length-1]:null;let v="";if(k==="final"){if(last&&last.message!=null)process.stdout.write(String(last.message));process.exit(0)}else if(k==="session_id")v=o.session_id;else if(k==="model_name")v=o.agent&&o.agent.model_name;else if(k==="agent_version")v=o.agent&&o.agent.version;else if(k==="permission_mode")v=o.agent&&o.agent.extra&&o.agent.extra.permission_mode;else if(k==="cut")v=(last&&(last.tool_calls||[]).length)?"yes":"";else if(k==="acu"){let s=0,n=0;st.forEach(function(x){const c=x&&x.extra&&x.extra.committed_acu_cost;if(typeof c==="number"){s+=c;n++}});v=n?s.toFixed(5):""}else if(k==="refusals"){const out=[];const texts=function(ob){if(ob==null)return[];if(typeof ob==="string")return[ob];if(Array.isArray(ob))return ob.reduce(function(a,x){return a.concat(texts(x))},[]);if(typeof ob==="object")return texts(ob.results!=null?ob.results:(ob.content!=null?ob.content:JSON.stringify(ob)));return[String(ob)]};st.forEach(function(x){texts(x&&x.observation).forEach(function(t){if(/permission denied|was rejected|tool blocked|rejected by the user|canceled because another tool call/i.test(t))out.push(t.split("\n")[0])})});v=out.join(" | ")}process.stdout.write(v==null||v===false?"":String(v)+"\n")'
atif_get() { # $1 export file  $2 field
	case "$DEVIN_JSON" in
	jq)
		case "$2" in
		final) jq -r '[.steps[]? | select(.source == "agent")] | last | .message // empty' "$1" ;;
		session_id) jq -r '.session_id // ""' "$1" ;;
		model_name) jq -r '.agent.model_name // ""' "$1" ;;
		agent_version) jq -r '.agent.version // ""' "$1" ;;
		permission_mode) jq -r '.agent.extra.permission_mode // ""' "$1" ;;
		cut) jq -r '[.steps[]? | select(.source == "agent")] | last | if . == null then "" elif ((.tool_calls // []) | length) > 0 then "yes" else "" end' "$1" ;;
		acu) jq -r '[.steps[]?.extra.committed_acu_cost // empty] | if length == 0 then "" else ((add * 100000 | round) / 100000 | tostring) end' "$1" ;;
		refusals) jq -r '[.steps[]? | .observation | select(. != null) | [.. | strings] | .[] | select(test("permission denied|was rejected|tool blocked|rejected by the user|canceled because another tool call"; "i")) | split("\n")[0]] | join(" | ")' "$1" ;;
		esac
		;;
	node) node -e "$NODE_ATIF" "$1" "$2" ;;
	esac
}

# The environment prefix goes into the positional parameters, and each adapter
# appends its own command to it. A shell function has its own positional
# parameters, so nothing a function does below disturbs this.
set --
while IFS= read -r _v; do
	[ -n "$_v" ] && set -- "$@" "$_v"
done <"$ENVLIST"
set -- env -i "$@"

# Pi's built-in tools, and the one place the list is written down. `pi --help`
# names them in its own first line — "AI coding assistant with read, bash, edit,
# write tools" — and the render confirmed it: a run with no tool flags at all
# reported exactly these four before its extensions' tools. THE ENVIRONMENT at
# the head of this script owns why a pi raise is held to them.
PI_BUILTIN_TOOLS='read,bash,edit,write'
PI_TOOLS=''

# The caller's --allowed-tools intersected with that set, so it can only narrow.
# Case is folded because the spec a caller writes is often claude-shaped —
# `Bash,Edit` — and those ARE pi's tools under another capitalisation; anything
# that is not a built-in under either case is an extension tool by definition and
# is dropped. An empty result is empty on purpose and the caller is told.
pi_tool_allowlist() { # $1 the caller's spec, empty for none — prints the list
	[ -n "${1:-}" ] || { printf '%s' "$PI_BUILTIN_TOOLS"; return 0; }
	_pi_out=''
	_pi_rest=$1
	while [ -n "$_pi_rest" ]; do
		case "$_pi_rest" in
		*,*) _pi_t=${_pi_rest%%,*}; _pi_rest=${_pi_rest#*,} ;;
		*) _pi_t=$_pi_rest; _pi_rest='' ;;
		esac
		_pi_t=$(printf '%s' "$_pi_t" | tr -d ' 	' | tr 'A-Z' 'a-z')
		[ -n "$_pi_t" ] || continue
		case ",$PI_BUILTIN_TOOLS," in
		*",$_pi_t,"*) ;;
		*) continue ;;
		esac
		case ",$_pi_out," in
		*",$_pi_t,"*) ;;
		*) _pi_out=${_pi_out:+$_pi_out,}$_pi_t ;;
		esac
	done
	printf '%s' "$_pi_out"
}

HARNESS_EXIT=0

case "$HARNESS" in
claude)
	# THE CONTAINMENT IS WRITTEN HERE, PER RAISE, and the whole of why — that an
	# installed hook cannot reach a raise that runs in a worktree the installed
	# file is shadow-excluded from — is at THE ENVIRONMENT's `claude` entry in
	# this script's header. Written before the flag so the `containment:` line
	# records both layers together.
	claude_write_containment "$WT"
	for _ccf in settings.local.json remit-no-agent-tool.sh; do
		[ -f "$WT/.claude/$_ccf" ] || continue
		cp "$WT/.claude/$_ccf" "$RUNDIR/claude-$_ccf" 2>/dev/null || :
	done
	set -- "$@" claude -p --output-format json
	[ -n "$MODEL" ] && set -- "$@" --model "$MODEL"
	# Command-granular tool scoping is how a claude context's grant omits git.
	[ -n "$ALLOWED" ] && set -- "$@" --allowedTools "$ALLOWED"
	# AND THE DENY, on EVERY raise, allowlist or none. A deny outranks every
	# allow at every level, so this is the one containment here that does not
	# depend on a file existing anywhere.
	set -- "$@" --disallowedTools "$CLAUDE_DENY_TOOLS"
	say "invoking: claude -p --output-format json${MODEL:+ --model $MODEL}${ALLOWED:+ --allowedTools $ALLOWED} --disallowedTools $CLAUDE_DENY_TOOLS < $(basename "$BRIEF")"
	say "containment: $CLAUDE_CONTAINMENT"
	run_harness "$BRIEF" "$@"
	# The apparatus goes the moment the CLI is done with it — before anything is
	# read back, and on the failing and stalled paths alike, because both come
	# back through here. A worktree is about to be staged by the seam's caller
	# and nothing of this raise's may be in it.
	claude_remove_containment "$WT"
	;;
codex)
	# `-` takes the briefing on stdin; -o writes the final message; the sandbox
	# denies .git by upstream design, which is the ruled behaviour enforced.
	#
	# No `-c` override and no `--ignore-user-config` here, and that is a searched
	# result rather than an omission: nothing this CLI accepts suppresses the
	# `$CODEX_HOME/AGENTS.md` a raise inherits without also taking away the
	# project's own instructions, the practitioner's own configuration, or the
	# directory the seat authenticates from. What was enumerated and what was
	# rendered is in THE ENVIRONMENT at the head of this script, which is the one
	# place it is stated.
	set -- "$@" codex exec -s "$SANDBOX" -C "$WT" --skip-git-repo-check -o "$FINALFILE"
	[ -n "$MODEL" ] && set -- "$@" -m "$MODEL"
	set -- "$@" -
	say "invoking: codex exec -s $SANDBOX${MODEL:+ -m $MODEL} < $(basename "$BRIEF")"
	run_harness "$BRIEF" "$@"
	;;
pi)
	set -- "$@" pi
	[ -n "$PROVIDER" ] && set -- "$@" --provider "$PROVIDER"
	set -- "$@" --model "$MODEL" --no-session
	# `--no-extensions` and the tool allowlist are the containment, and neither is
	# optional: without them a raise inherits every tool the practitioner's
	# installed pi packages register, and every line of code those packages run at
	# startup. What was rendered, and why the allowlist alone is not enough, is in
	# THE ENVIRONMENT at the head of this script — the one place it is stated.
	set -- "$@" --no-extensions
	PI_TOOLS=$(pi_tool_allowlist "$ALLOWED")
	if [ -n "$PI_TOOLS" ]; then
		set -- "$@" --tools "$PI_TOOLS"
	else
		# The caller narrowed to a set with no built-in in it. That is no tools,
		# and it is said rather than quietly widened back to the default.
		set -- "$@" --no-tools
		say "note: --allowed-tools '$ALLOWED' names no tool pi has built in, and a contained pi context has nothing else. This raise runs with --no-tools."
	fi
	# Whole-tool scoping only: excluding git means excluding bash wholesale, so a
	# pi context restrained by mechanism has no shell at all. The caller chose;
	# this records which. Pi applies the denylist after the allowlist, so this can
	# only subtract from the line above.
	[ -n "$EXCLUDED" ] && set -- "$@" --exclude-tools "$EXCLUDED"
	set -- "$@" -p "@$BRIEF"
	say "invoking: pi --model $MODEL --no-session --no-extensions ${PI_TOOLS:+--tools $PI_TOOLS}${PI_TOOLS:---no-tools} -p @$(basename "$BRIEF")"
	run_harness none "$@"
	;;
devin)
	# `--prompt-file` is the only briefing channel — a briefing on stdin is
	# refused outright — and the trust flag is needed on EVERY run, not merely the
	# first, because a -p run never persists trust. `--config` is never passed: it
	# replaces the user config rather than layering with it, and a replacement
	# missing the user's own state drops a -p run into interactive onboarding and
	# hangs it. `--sandbox` is never passed either; it is refused above rather
	# than forwarded. The bounded wait is part of the command because no flag
	# guarantees non-interactivity.
	devin_write_containment "$WT" || {
		rm -rf "$WT/.devin"
		die "could not write the context's containment under $WT/.devin — not raising a context this script cannot contain"
	}
	cp "$WT/.devin/config.json" "$RUNDIR/devin-config.json"
	cp "$WT/.devin/hooks.v1.json" "$RUNDIR/devin-hooks.v1.json"
	cp "$WT/.devin/remit-no-git.sh" "$RUNDIR/devin-remit-no-git.sh"
	cp "$WT/.devin/remit-no-reach.sh" "$RUNDIR/devin-remit-no-reach.sh"
	set -- "$@" timeout "$DEVIN_TIMEOUT" "$DEVIN" -p \
		--prompt-file "$BRIEF" \
		--respect-workspace-trust false \
		--permission-mode "$DEVIN_MODE" \
		--export "$ATIF"
	# No catalogue check, unlike pi: devin rejects an unknown model id before it
	# starts and before anything is billed, so a wrong id fails loudly by itself
	# rather than being answered by something else.
	[ -n "$MODEL" ] && set -- "$@" --model "$MODEL"
	say "invoking: devin -p --prompt-file $(basename "$BRIEF") --permission-mode $DEVIN_MODE${MODEL:+ --model $MODEL}"
	run_harness none "$@"
	# The containment was apparatus for the run; it is not part of the tree the
	# context leaves, and it is gone before anything else touches that tree.
	rm -rf "$WT/.devin"
	[ ! -e "$WT/.devin" ] ||
		die "could not remove the containment at $WT/.devin — refusing to leave a tree that still carries this script's apparatus"
	;;
copilot)
	# The briefing goes on stdin. `--prompt-file` does not exist here and the argv
	# channel dies above roughly 32 KB with the shell's own "Argument list too
	# long" before the CLI even starts — a cliff with no warning on the near side
	# of it, and a remit briefing is kilobytes and grows.
	#
	# `--allow-all-tools` and never `--allow-all` or `--yolo`: the blunt flags
	# throw away the file-tool refusals and the naive-command refusals for
	# nothing. That default path wall is kept because it is free, not because it
	# contains anything — the hook is what contains.
	#
	# `--disable-builtin-mcps` because the built-in GitHub server connects on
	# every run by default, and a context reaching GitHub through an MCP tool is
	# invisible to every shell deny rule and to a hook that inspects shell
	# commands. Ruled: the CLI is the route and that server is not.
	#
	# Never `--no-custom-instructions`: it is one boolean over the whole
	# custom-instruction section, so it would strip the AGENTS.md a context needs
	# in order to strip the practitioner's own files. That it cannot be scoped,
	# and every other lever that was searched for and did not exist, is stated
	# once in THE ENVIRONMENT at the head of this script and nowhere else. Never
	# `--share`, whose default path writes the transcript into the directory
	# about to be staged; never `--share-gist`.
	copilot_write_containment "$WT" || {
		copilot_remove_containment "$WT"
		die "could not write the context's containment under $WT/.github/hooks — not raising a context this script cannot contain"
	}
	cp "$COPILOT_HOOK_JSON" "$RUNDIR/copilot-remit-no-git.json"
	cp "$COPILOT_HOOK_SH" "$RUNDIR/copilot-remit-no-git.sh"
	if ! copilot_canary "$WT"; then
		copilot_canary_refused "$WT"
	fi
	set -- "$@" timeout "$COPILOT_TIMEOUT" "$COPILOT" \
		--output-format json --allow-all-tools --no-ask-user --disable-builtin-mcps \
		--log-dir "$RUNDIR/copilot-log"
	set -- "$@" --deny-tool 'shell(git)' --deny-tool 'shell(git:*)' \
		--deny-tool 'shell(gh)' --deny-tool 'shell(gh:*)'
	# `shell(git:*)` is a pathname pattern to an unquoted shell, so any caller
	# additions are split with globbing off.
	if [ -n "$EXCLUDED" ] || [ -n "$ALLOWED" ]; then
		cop_ifs=$IFS
		set -f
		IFS=' ,'
		for r in $EXCLUDED; do set -- "$@" --deny-tool "$r"; done
		for r in $ALLOWED; do set -- "$@" --allow-tool "$r"; done
		IFS=$cop_ifs
		set +f
	fi
	[ -n "$MODEL" ] && set -- "$@" --model "$MODEL"
	# Both halves of a standing model constraint are expressible on this CLI, so
	# both are passed where the caller named them, and neither is reported as
	# applied when it was not.
	[ -n "$EFFORT" ] && set -- "$@" --effort "$EFFORT"
	say "invoking: copilot --output-format json${MODEL:+ --model $MODEL}${EFFORT:+ --effort $EFFORT} < $(basename "$BRIEF")"
	run_harness "$BRIEF" "$@"
	copilot_remove_containment "$WT"
	{ [ ! -e "$COPILOT_HOOK_JSON" ] && [ ! -e "$COPILOT_HOOK_SH" ]; } ||
		die "could not remove the containment at $WT/.github/hooks — refusing to leave a tree that still carries this script's apparatus"
	;;
native)
	# Nothing is raised here: the context was the calling harness's own sub-agent,
	# and what it returned was given at --final-message.
	HARNESS_EXIT=0
	: >"$OUTFILE"
	: >"$ERRFILE"
	say "no CLI invoked: the context was the calling harness's own sub-agent, and its returned result was given at --final-message."
	;;
esac

# The scratch home and the scratch root are apparatus for the run and are gone
# the moment the run is. This run FINISHED, so a root that will not go is a
# refusal — stated once, where the two answers to that condition sit together.
scratch_gone_or_refuse

if [ "$HARNESS" != native ]; then
	say "the harness process exited with code $HARNESS_EXIT — that is completion, not success."
fi

# ==============================================================================
# capture the context's final message
# ==============================================================================

final_note=''
case "$HARNESS" in
claude)
	# The envelope is the cleanest return contract of the CLIs this script drives,
	# but only if something here can read JSON. jq first; node otherwise, which is
	# present wherever `claude` is. If neither can read it, the envelope travels
	# verbatim and says so — nothing is guessed out of it with a regex.
	if command -v jq >/dev/null 2>&1 && jq -e . "$OUTFILE" >/dev/null 2>&1; then
		JSONTOOL=jq
	elif command -v node >/dev/null 2>&1 && node -e "$NODE_JSON" "$OUTFILE" result >/dev/null 2>&1; then
		JSONTOOL=node
	else
		JSONTOOL=none
	fi
	model_channel='run envelope'
	if [ "$JSONTOOL" = none ]; then
		cp "$OUTFILE" "$FINALFILE"
		final_note="neither jq nor node could read the claude envelope as JSON — it is carried verbatim and nothing was extracted from it"
	else
		json_get "$OUTFILE" result >"$FINALFILE"
		RUN_ID=$(json_get "$OUTFILE" session_id)
		# The envelope names the model that actually served the run; a raise names
		# an alias. Authorship is never obscured, so the provenance follows the
		# envelope where they differ.
		#
		# `$MODEL` GOES IN because this envelope reports a MAP and the seat that was
		# registered is the first clause of the rule that reads it — the rule, and the
		# field failure that wrote it, are at THE PROVENANCE KEYS in this header.
		run_model=$(json_get "$OUTFILE" model "$MODEL")
		[ -n "$run_model" ] && MODEL_SERVED=$run_model
		# EVERY model the run billed, so the ancillary is visible on the record and
		# can never again be read as the author.
		MODELS_SEEN=$(json_get "$OUTFILE" models)
		# AND WHAT IT CONSULTED, where the envelope says so. Recorded, never judged.
		CONSULTED=$(json_get "$OUTFILE" consulted)
		[ "$(json_get "$OUTFILE" is_error)" = true ] &&
			final_note="the claude envelope reports is_error: true"
	fi
	;;
codex)
	[ -f "$FINALFILE" ] || : >"$FINALFILE"
	# codex prints its run header AND its transcript on STDERR; stdout carries
	# only the context's own final message. Neither stream is trusted wholesale —
	# the transcript on stderr is the context talking as much as stdout is — so
	# the header is read from the HEADER BLOCK alone: the lines between codex's
	# own banner and the separator that closes the block, before a single word of
	# builder text exists. A transcript line shaped like `sandbox: …` therefore
	# cannot become the run header however far down it appears, and a build that
	# stops printing the banner leaves no header at all. That is the honest
	# outcome: a header that cannot be found is unconfirmed, and unconfirmed is a
	# state this script reports; a forged one is not.
	HEADER="$RUNDIR/header-block"
	awk '
		/^OpenAI Codex v/ { banner = 1; next }
		!banner { next }
		/^-+[[:space:]]*$/ { seps++; if (seps >= 2) exit; next }
		seps >= 1 { print }
	' "$ERRFILE" >"$HEADER"
	RUN_ID=$(sed -n 's/^ *session id: *//p' "$HEADER" | sed -n 1p)
	SANDBOX_APPLIED=$(sed -n 's/^ *sandbox: *//p' "$HEADER" | sed -n 1p)
	# The header block is the truth of what ran, including which model served it.
	model_channel='run header'
	run_model=$(sed -n 's/^ *model: *//p' "$HEADER" | sed -n 1p)
	[ -n "$run_model" ] && MODEL_SERVED=${run_model%% *}
	;;
devin)
	# stdout is the agent's own prose with the pre-tool narration glued to the
	# final message and no delimiter between them, so it is never parsed for one.
	# The export keeps them apart, and carries with them the run id, the model
	# that served the run, its cost, and the permission mode that actually
	# applied. It is this run's single provenance channel.
	: >"$FINALFILE"
	model_channel='run export'
	if [ ! -s "$ATIF" ]; then
		final_note="devin wrote no ATIF export, so nothing about this run can be read back — the final message, the run id, the model that served it and the permission mode that applied are all absent here, and none of them is invented"
	else
		atif_get "$ATIF" final >"$FINALFILE"
		RUN_ID=$(atif_get "$ATIF" session_id)
		DEVIN_VERSION=$(atif_get "$ATIF" agent_version)
		DEVIN_ACU=$(atif_get "$ATIF" acu)
		PERM_APPLIED=$(atif_get "$ATIF" permission_mode)
		run_model=$(atif_get "$ATIF" model_name)
		[ -n "$run_model" ] && MODEL_SERVED=$run_model
		# Exit 0 says a run happened, not that its tool calls ran. A denied or
		# rejected call is invisible on stdout, silent on stderr, and exits 0 with
		# the agent simply stopping where it was.
		refusals=$(atif_get "$ATIF" refusals)
		if [ ! -s "$FINALFILE" ]; then
			final_note="${final_note:+$final_note; }the run export carries no agent message at all — this run produced no turn"
		elif [ -n "$(atif_get "$ATIF" cut)" ]; then
			final_note="${final_note:+$final_note; }the run's last agent step was still calling tools, so the message above is narration and not a completed answer — the run stopped where it was"
		fi
		[ -n "$refusals" ] &&
			final_note="${final_note:+$final_note; }tool calls were refused during this run and devin still exited 0: $refusals"
	fi
	;;
copilot)
	# Text-mode stdout glues the tool renderings to the answer with no stable
	# delimiter, and `-s` gives a clean answer at the price of every scrap of
	# provenance. The JSONL envelope is neither: it keeps narration and answer
	# apart as separate labelled records, and carries the run id, the model that
	# served the run, its cost, and every denied call with the reason.
	: >"$FINALFILE"
	model_channel='run envelope'
	if [ ! -s "$OUTFILE" ]; then
		final_note="copilot wrote no JSONL envelope, so nothing about this run can be read back — the final message, the run id, the model that served it and its cost are all absent here, and none of them is invented"
	else
		copilot_get "$OUTFILE" final >"$FINALFILE"
		RUN_ID=$(copilot_get "$OUTFILE" session_id)
		run_model=$(copilot_get "$OUTFILE" model)
		[ -n "$run_model" ] && MODEL_SERVED=$run_model
		COPILOT_AIU=$(copilot_get "$OUTFILE" aiu)
		COPILOT_PREMIUM=$(copilot_get "$OUTFILE" premium)
		# A run that never started writes no terminal result event at all, which
		# makes "did a run happen?" a fact rather than an inference.
		[ -z "$(copilot_get "$OUTFILE" result_present)" ] &&
			final_note="the envelope carries no terminal result event, so this run never completed — what came back, if anything, is a fragment and not an answer"
		if [ ! -s "$FINALFILE" ]; then
			final_note="${final_note:+$final_note; }the envelope carries no assistant message free of tool calls — this run produced no final message"
		fi
		cop_refusals=$(copilot_get "$OUTFILE" refusals)
		[ -n "$cop_refusals" ] &&
			final_note="${final_note:+$final_note; }tool calls were refused during this run and copilot still exited 0 — the containment firing looks exactly like this, and so does a context being stopped from doing its task: $cop_refusals"
	fi
	;;
pi)
	cp "$OUTFILE" "$FINALFILE"
	;;
native)
	cp "$RETURNED" "$FINALFILE"
	;;
esac

# `codex exec -o` writes no trailing newline; without one the final message runs
# into whatever is printed after it.
if [ -s "$FINALFILE" ] && [ -n "$(tail -c 1 "$FINALFILE")" ]; then
	printf '\n' >>"$FINALFILE"
fi

# ==============================================================================
# the provenance sidecar, then the payload
# ==============================================================================

print_harness_stderr() {
	if [ -s "$ERRFILE" ]; then
		say "harness stderr, verbatim:"
		rule_off
		cat "$ERRFILE" >&2
		rule_off
	else
		say "the harness wrote nothing to stderr."
	fi
}

# The provenance is written even for a run that failed: what ran, and how far it
# got, is exactly what a failure report needs.
write_provenance() {
	[ -n "$PROVFILE" ] || return 0
	{
		printf 'role: %s\n' "$ROLE"
		printf 'harness: %s\n' "$HARNESS"
		printf 'seat: %s\n' "$SEAT_KIND"
		printf 'registry: %s %s\n' "$SETTINGS" "$REGISTRY_HASH"
		if [ -n "$MODEL_SERVED" ]; then
			printf 'model: %s\n' "$MODEL_SERVED"
			if [ -n "$MODEL" ] && [ "$MODEL_SERVED" != "$MODEL" ]; then
				printf 'model-note: the run itself reports the model above; this raise asked for %s\n' "$MODEL"
			fi
		elif [ -n "$MODEL" ]; then
			printf 'model: %s (asked)\n' "$MODEL"
			if [ -n "$model_channel" ]; then
				printf 'model-note: no %s named the model that served this run, so the id above is the one asked for and not one confirmed\n' "$model_channel"
			else
				printf 'model-note: no channel of this raise named the model that served it, so the id above is the one asked for and not one confirmed\n'
			fi
		else
			printf 'model-note: no model was asked for and none was reported — the CLI took its own default and named it nowhere\n'
		fi
		# EVERY MODEL THE RUN REPORTED, beside the one named as its author above.
		# A run whose envelope named one model writes one entry here and that is
		# not a duplication: it is the whole of what was billed, and reading it
		# against `model:` is how a reader sees there was nothing else.
		[ -n "$MODELS_SEEN" ] && printf 'models: %s\n' "$MODELS_SEEN"
		# WHAT THE RUN CONSULTED, from the run's own count and only where it
		# carries one. This seam draws no conclusion from it and gates nothing on
		# it; it is here for a reader or a rubric to cite. Which seats can answer
		# it, and why the other four write no line at all rather than a zero, is
		# at THE ENVIRONMENT in this script's header.
		#
		# THE SCOPE IS PART OF THE LINE AND IS WRITTEN HERE, once, rather than
		# folded into the value `json_get` returns — that reader has two
		# implementations and a sentence in both is a sentence that can differ in
		# one. What it says is the header's law rendered for whoever reads the
		# record without the header in front of them: a reader or a rubric that
		# has only this line must not be able to mistake a server-side zero for a
		# finding about the run. The field failure it repairs is dated 2026-09-02.
		[ -n "$CONSULTED" ] && printf 'consulted: server-side %s — the API'\''s own count of the SERVER-SIDE web tools, which is the only tool count this envelope carries. A CLI'\''s CLIENT-SIDE fetches (Claude Code'\''s WebFetch and WebSearch) never reach it, so a zero here is NOT evidence that nothing was consulted.\n' "$CONSULTED"
		[ -n "$MODEL_CHECK" ] && printf 'model-check: %s\n' "$MODEL_CHECK"
		[ -n "$RUN_ID" ] && printf 'session: %s\n' "$RUN_ID"
		case "$HARNESS" in
		codex)
			if [ -n "$SANDBOX_APPLIED" ]; then
				printf 'boundary: user — attested by header\n'
				printf 'sandbox: %s\n' "$SANDBOX_APPLIED"
				printf 'boundary-note: the boundary is codex'\''s own sandbox account, read back from the run header and required to agree with the mode requested. It bounds what this run could read and write on this filesystem; it is not a network boundary, and it is not a claim about any other harness.\n'
			else
				printf 'boundary: none — attested by disclosed\n'
				printf 'boundary-note: the run header could not be read back, so the sandbox that actually applied is UNCONFIRMED and no boundary is claimed here. Codex may well have been contained; this raise cannot show it.\n'
			fi
			;;
		devin)
			if [ -n "$PERM_APPLIED" ]; then
				printf 'boundary: none — attested by export\n'
				printf 'permission-mode: %s (this raise requested %s)\n' "$PERM_APPLIED" "$DEVIN_MODE"
			else
				printf 'boundary: none — attested by disclosed\n'
			fi
			printf 'boundary-note: devin'\''s own OS-level sandbox was never passed, so there is no read boundary here. On Windows it does not exist; on every other platform it does and remit does not yet pass it — the two reasons are separate and are at the `--sandbox` refusal in this script. What did apply is the worktree, the deny rules and the PreToolUse hooks — git and gh, every MCP call, request_scope and webfetch, and nothing else. The export is the channel that says which permission mode applied.\n'
			;;
		*)
			printf 'boundary: none — attested by disclosed\n'
			printf 'boundary-note: this context ran on the practitioner'\''s host under their own credentials and reached whatever that login reaches. No read boundary was enforced and none is claimed. What did hold is the environment allow-list below.\n'
			;;
		esac
		[ -n "$EFFORT" ] && printf 'effort: %s\n' "$EFFORT"
		printf 'scrub: env -i with %s and nothing else\n' \
			"$(sed 's/=.*//' "$ENVLIST" | tr '\n' ' ' | sed 's/ $//')"
		# The tool surface a pi context actually got. It is written for pi alone
		# because pi is the seat where the surface is remit's to set: extension
		# discovery is off and the list is an intersection, so what the model
		# could reach is a fact this script owns and must be able to show.
		if [ "$HARNESS" = pi ]; then
			printf 'tools: %s, with extension discovery off (--no-extensions)%s\n' \
				"${PI_TOOLS:+--tools $PI_TOOLS}${PI_TOOLS:---no-tools}" \
				"${EXCLUDED:+, then --exclude-tools $EXCLUDED}"
		fi
		printf 'run-log: %s\n' "$RUNDIR"
		[ -n "$COPILOT_VERSION" ] && printf 'harness-version: copilot %s\n' "$COPILOT_VERSION"
		[ -n "$DEVIN_VERSION" ] && printf 'harness-version: devin %s\n' "$DEVIN_VERSION"
		[ -n "$DEVIN_ACU" ] && printf 'cost: %s ACU — devin'\''s own per-step cost, summed from the run export\n' "$DEVIN_ACU"
		[ -n "$COPILOT_AIU" ] && printf 'cost: %s AI credits%s — the CLI'\''s own figure from the run envelope; the canary is billed separately and is additional to it\n' "$COPILOT_AIU" "${COPILOT_PREMIUM:+, $COPILOT_PREMIUM premium requests}"
		[ -n "$COPILOT_CANARY_ID" ] && printf 'canary-session: %s\n' "$COPILOT_CANARY_ID"
		[ -n "$COPILOT_HOOK_ATTEST" ] && printf 'containment: %s\n' "$COPILOT_HOOK_ATTEST"
		# What actually banned the agent tool on this raise — the flag always, and
		# the per-raise settings file where it could be written. It says which,
		# because "the flag alone" and "both layers" are different facts.
		[ -n "$CLAUDE_CONTAINMENT" ] && printf 'containment: %s\n' "$CLAUDE_CONTAINMENT"
		[ -n "$DEVIN_TIER" ] && printf 'account: tier %s, primary org %s\n' "$DEVIN_TIER" "${DEVIN_ORG:-none reported}"
		[ -n "$COPILOT_LOGIN" ] && printf 'account: %s at %s — recorded, not checked and not gated on\n' "$COPILOT_LOGIN" "${COPILOT_HOST:-not recorded}"
		[ -n "$DEVIN_TIER_NOTE" ] && printf 'note: %s\n' "$DEVIN_TIER_NOTE"
		[ -n "$final_note" ] && printf 'note: %s\n' "$final_note"
		return 0
	} >"$PROVFILE"
}

# A STALL IS ITS OWN OUTCOME, and it is checked before the exit code because a
# process this script killed exits non-zero and would otherwise be reported as a
# CLI that failed on its own. It did not: it stopped saying anything and was
# ended for it. Whatever it had said is in the run directory either way.
if [ -n "$STALLED" ]; then
	final_note="stalled: no output for ${STALLED}s. The CLI was ended by this script's idle bound (REMIT_QUIET=$QUIET), not by its own wall bound and not by any failure it reported. What it had written by then is in $RUNDIR${final_note:+; $final_note}"
	write_provenance
	say "THE RUN STALLED: nothing was written to either output channel for ${STALLED}s and the CLI was ended. No text is returned, because there is no final message to return."
	print_harness_stderr
	exit 8
fi

if [ "$HARNESS_EXIT" -ne 0 ]; then
	write_provenance
	say "RUN-LEVEL FAILURE: $CLI exited $HARNESS_EXIT. Reported as it happened; nothing substituted, and no text is returned."
	print_harness_stderr
	exit 5
fi

if [ "$HARNESS" = codex ]; then
	if [ -z "$SANDBOX_APPLIED" ]; then
		say "note: the run header could not be read back, so the sandbox that actually applied is UNCONFIRMED. The provenance claims no boundary at all rather than the one that was asked for."
	else
		# The header decorates the mode with its writable roots and network state —
		# `workspace-write [workdir, /tmp, …] (network access enabled)`. Only the
		# leading token is the sandbox that applied; comparing the whole decorated
		# line would fail every correctly granted raise.
		APPLIED_MODE=${SANDBOX_APPLIED%% *}
		if [ "$APPLIED_MODE" != "$SANDBOX" ]; then
			write_provenance
			say "FAILED PRECONDITION: $SANDBOX was requested; the run header reports mode '$APPLIED_MODE' (header line: $SANDBOX_APPLIED). The header is the truth of what applied, and a downgrade is reported, not worked around."
			print_harness_stderr
			exit 6
		fi
		say "sandbox: the run header confirms '$APPLIED_MODE', which is what was requested."
	fi
fi

if [ "$HARNESS" = devin ]; then
	# The same read-back as codex's sandbox, on the field that is devin's
	# equivalent of it. A permission mode can be refused and quietly downgraded
	# with nothing but a warning on stderr and an exit 0. The comparison ignores
	# case and punctuation because the mode is asked for as `accept-edits` and
	# reported back as `AcceptEdits`.
	perm_norm() { printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/[^a-z]//g'; }
	if [ -z "$PERM_APPLIED" ]; then
		say "note: the run export does not say which permission mode applied, so the context's containment is UNCONFIRMED. Said, not assumed."
	elif [ "$(perm_norm "$PERM_APPLIED")" != "$(perm_norm "$DEVIN_MODE")" ]; then
		write_provenance
		say "FAILED PRECONDITION: $DEVIN_MODE was requested; the run export reports '$PERM_APPLIED'. The export is the truth of what applied, and a downgrade is reported, not worked around."
		print_harness_stderr
		exit 6
	else
		say "permissions: the run export confirms '$PERM_APPLIED', which is what was requested."
	fi
fi

write_provenance

[ -n "$final_note" ] && say "note: $final_note"
say "the run's own output stays in $RUNDIR and is not printed — a context's exploration and diff do not reach the coordinator."
rule_off

cat "$FINALFILE"
exit 0
